+@pytest.mark.parametrize(
+    ("terminal", "change", "error"),
+    [
+        (False, None, None),
+        (True, None, None),
+        (True, "selection", "IDEMPOTENCY_CONFLICT"),
+        (True, "digest", "REPLAN_REQUIRED"),
+        (True, "signature", "REPLAN_REQUIRED"),
+    ],
+    ids=["progressed", "terminal", "changed-selection", "mismatched-receipt", "invalid-signature"],
+)
+def test_late_confirmation_replay_after_committed_progress(
+    contents_service: ContentsService,
+    product: ProductHarness,
+    monkeypatch: pytest.MonkeyPatch,
+    terminal: bool,
+    change: str | None,
+    error: str | None,
+) -> None:
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    from uuid import UUID
+
+    from brickvault_api.market.product_refresh import ProductRefreshError
+    from brickvault_api.market.product_refresh_models import digest
+    from brickvault_api.refresh_models import RefreshConfirmation
+
+    s = contents_service
+    plan = s.prepare("80000-1", selection("normal", "figure-line"))
+    body = ContentsConfirmation(selection=plan.selection, confirmation=plan.confirmation)
+    duplicate = ContentsService(s.product, s.repository, s.account, s.signing_key, s.provider)
+    held_body = body
+    if change == "selection":
+        held_body = body.model_copy(update={"selection": selection("normal")})
+    elif change == "digest":
+        receipt = body.confirmation.model_copy(update={"digest": "f" * 64})
+        receipt = receipt.model_copy(update={"signature": s.signature(receipt, key("set"))})
+        held_body = body.model_copy(update={"confirmation": receipt})
+    elif change == "signature":
+        held_body = body.model_copy(
+            update={"confirmation": body.confirmation.model_copy(update={"signature": "0" * 64})}
+        )
+    else:
+        # Exact normalized selection also admits a different occurrence ordering.
+        held_body = body.model_copy(
+            update={
+                "selection": body.selection.model_copy(
+                    update={"occurrences": list(reversed(body.selection.occurrences))}
+                )
+            }
+        )
+    looked_up, release = Barrier(2), Barrier(2)
+    original_lookup = duplicate._receipt_operation
+    lookups = 0
+
+    def held_lookup(set_id: UUID, receipt: RefreshConfirmation) -> UUID | None:
+        nonlocal lookups
+        lookups += 1
+        found = original_lookup(set_id, receipt)
+        if lookups == 1:
+            assert found is None
+            looked_up.wait(timeout=15)
+            release.wait(timeout=15)
+        return found
+
+    monkeypatch.setattr(duplicate, "_receipt_operation", held_lookup)
+    with ThreadPoolExecutor(1) as pool:
+        pending = pool.submit(duplicate.confirm_selected, "80000-1", held_body)
+        looked_up.wait(timeout=15)
+        try:
+            operation = s.confirm_selected("80000-1", body)
+            lease = s.acquire(operation)
+            assert lease
+            for _ in range(2 if terminal else 1):
+                s.repository.advance(lease, s.provider)
+                product.advance_clock(5)
+            assert s.contents_status(operation).terminal is terminal
+            assert (
+                digest(s.selected_plan("80000-1", body.selection)["plan"])
+                != plan.confirmation.digest
+            )
+            before = s.repository.status(operation)
+        finally:
+            release.wait(timeout=15)
+        if error:
+            with pytest.raises(ProductRefreshError, match=error):
+                pending.result(timeout=15)
+        else:
+            assert pending.result(timeout=15) == operation
+        assert lookups == (1 if change == "signature" else 2)
+    assert s.repository.status(operation) == before
+    with s.repository.database.connect() as c:
+        assert c.execute("SELECT count(*) AS n FROM product_refresh_operation").fetchone() == {
+            "n": 1
+        }
+        assert c.execute("SELECT count(*) AS n FROM provider_fetch_run").fetchone() == {
+            "n": 2 if terminal else 1
+        }
+
