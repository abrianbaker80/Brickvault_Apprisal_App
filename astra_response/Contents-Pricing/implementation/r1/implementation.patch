diff --git a/apps/web/e2e/contents-acceptance.mjs b/apps/web/e2e/contents-acceptance.mjs
new file mode 100644
index 0000000..3134f60
--- /dev/null
+++ b/apps/web/e2e/contents-acceptance.mjs
@@ -0,0 +1,81 @@
+// Explicit synthetic SOURCE/TEST workflow. No provider access or real credentials.
+import { chromium, expect } from '@playwright/test';
+import { mkdir } from 'node:fs/promises';
+const base = process.argv[2];
+if (!/^http:\/\/127\.0\.0\.1:\d+$/.test(base ?? ''))
+  throw new Error('Owned loopback TEST URL required');
+const browser = await chromium.launch({ headless: true });
+const context = await browser.newContext({ viewport: { width: 1440, height: 1050 } });
+await context.route('**/*', (route) =>
+  route.request().url().startsWith(base) ? route.continue() : route.abort(),
+);
+try {
+  const login = await context.request.post(`${base}/api/auth/login`, {
+    data: { password: process.env.CONTENTS_TEST_PASSWORD },
+    headers: { Origin: base, 'X-BrickVault-Login': '1' },
+  });
+  expect(login.status()).toBe(200);
+  const page = await context.newPage();
+  const failures = [];
+  page.on('pageerror', (error) => failures.push(error.message));
+  await page.goto(`${base}/sets/80000-1?section=contents`);
+  const panel = page.getByRole('region', { name: 'Selected contents pricing' });
+  await expect(panel).toBeVisible();
+  const items = panel.locator('.contents-items > li');
+  const figure = items.filter({ hasText: 'BrickLink MINIFIG fig-test-1' }).first();
+  const part = items
+    .filter({ hasText: 'BrickLink PART 3001 color 5' })
+    .filter({ has: page.locator('input:not(:disabled)') })
+    .first();
+  await figure.getByRole('checkbox').check();
+  await part.getByRole('checkbox').check();
+  await panel.getByRole('button', { name: 'Review selected refresh plan' }).click();
+  await expect(panel.getByText(/more than four new price requests/)).toBeVisible();
+  await expect(panel.getByRole('button', { name: 'Confirm selected refresh' })).toBeDisabled();
+  for (const name of ['New / Active', 'Used / Sold', 'Used / Active'])
+    await panel.getByRole('checkbox', { name, exact: true }).uncheck();
+  await panel.getByRole('button', { name: 'Review selected refresh plan' }).click();
+  await expect(panel.getByText(/0 identity · 2 new price requests/)).toBeVisible();
+  await panel.getByRole('button', { name: 'Confirm selected refresh' }).click();
+  await expect(
+    panel.getByText(/WORK PENDING · 1\/2 selected views finished · 1\/4 attempts/),
+  ).toBeVisible({ timeout: 15000 });
+  await page.reload();
+  await expect(
+    panel.getByText(/WORK PENDING · 1\/2 selected views finished · 1\/4 attempts/),
+  ).toBeVisible();
+  await page.waitForTimeout(1200);
+  await expect(panel.getByText(/1\/4 attempts/)).toBeVisible();
+  await panel.getByRole('button', { name: 'Resume selected refresh' }).click();
+  await expect(
+    panel.getByText(/COMPLETE · 2\/2 selected views finished · 2\/4 attempts/),
+  ).toBeVisible({ timeout: 15000 });
+  await expect(figure.getByText(/USD 2.50/)).toBeVisible();
+  await expect(part.getByText(/USD 2.50/)).toBeVisible();
+  await mkdir('.local/contents112', { recursive: true });
+  await panel.scrollIntoViewIfNeeded();
+  expect(
+    await figure.getByRole('checkbox').evaluate((el) => el.getBoundingClientRect().width),
+  ).toBeLessThanOrEqual(20);
+  await page.screenshot({ path: '.local/contents112/browser-desktop.png', fullPage: true });
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.reload();
+  await expect(
+    panel.getByText(/COMPLETE · 2\/2 selected views finished · 2\/4 attempts/),
+  ).toBeVisible();
+  await expect(figure.getByText(/USD 2.50/)).toBeVisible();
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(
+    true,
+  );
+  await panel.scrollIntoViewIfNeeded();
+  expect(
+    await figure.getByRole('checkbox').evaluate((el) => el.getBoundingClientRect().width),
+  ).toBeLessThanOrEqual(20);
+  await page.screenshot({ path: '.local/contents112/browser-narrow.png', fullPage: true });
+  expect(failures).toEqual([]);
+  console.log(
+    'PASS mixed MINIFIG/PART: over-cap plan, explicit confirm, partial reload, explicit resume, independent item prices, desktop 1440 and narrow 390; no page errors.',
+  );
+} finally {
+  await browser.close();
+}
