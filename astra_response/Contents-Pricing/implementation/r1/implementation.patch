@@ -0,0 +1,142 @@
+"""Private contents reads and explicit Confirm/Resume; no dispatch on read or plan."""
+
+from typing import Annotated
+from uuid import UUID
+
+from fastapi import APIRouter, BackgroundTasks, Depends, Request, Response
+from starlette.responses import JSONResponse
+
+from ..catalog.query_types import CatalogError
+from ..contents import ContentsService
+from ..contents_models import (
+    ContentsConfirmation,
+    ContentsPage,
+    ContentsPlan,
+    ContentsSelection,
+    ContentsStatus,
+)
+from ..market.contents_refresh import ContentsRefreshRepository
+from ..market.product_refresh import ProductRefreshError
+from ..refresh_models import RefreshProblem
+from .refresh import ExplicitProvider, problem
+from .sets import product_service
+
+router = APIRouter(
+    prefix="/api", responses={409: {"model": RefreshProblem}, 503: {"model": RefreshProblem}}
+)
+
+
+def contents_service(request: Request) -> ContentsService:
+    product = product_service(request)
+    settings = request.app.state.settings
+    return ContentsService(
+        product,
+        ContentsRefreshRepository(product.database),
+        settings.market_account_scope if settings.market_credentials_root else None,
+        request.app.state.refresh_signing_key,
+        ExplicitProvider(settings.market_credentials_root),
+    )
+
+
+Service = Annotated[ContentsService, Depends(contents_service)]
+
+
+@router.get("/sets/{set_number}/contents", operation_id="set_contents", response_model=ContentsPage)
+def contents(
+    set_number: str,
+    service: Service,
+    response: Response,
+    revision_id: UUID | None = None,
+    cursor: UUID | None = None,
+) -> ContentsPage | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.page(set_number, revision_id, cursor)
+    except (ProductRefreshError, CatalogError) as error:
+        return problem(error)
+
+
+@router.post(
+    "/sets/{set_number}/contents-market-refresh/plan",
+    operation_id="plan_contents_refresh",
+    response_model=ContentsPlan,
+)
+def plan(
+    set_number: str, body: ContentsSelection, service: Service, response: Response
+) -> ContentsPlan | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.prepare(set_number, body)
+    except (ProductRefreshError, CatalogError) as error:
+        return problem(error)
+
+
+@router.post(
+    "/sets/{set_number}/contents-market-refresh",
+    operation_id="confirm_contents_refresh",
+    response_model=ContentsStatus,
+)
+def confirm(
+    set_number: str,
+    body: ContentsConfirmation,
+    service: Service,
+    tasks: BackgroundTasks,
+    response: Response,
+) -> ContentsStatus | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        operation = service.confirm_selected(set_number, body)
+        lease = service.acquire(operation)
+        if lease:
+            tasks.add_task(service.run, lease)
+        return service.contents_status(operation)
+    except (ProductRefreshError, CatalogError) as error:
+        return problem(error)
+
+
+@router.get(
+    "/sets/{set_number}/contents-market-refresh",
+    operation_id="active_contents_refresh",
+    response_model=ContentsStatus | None,
+)
+def active(
+    set_number: str, service: Service, response: Response
+) -> ContentsStatus | None | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.active_contents(set_number)
+    except (ProductRefreshError, CatalogError) as error:
+        return problem(error)
+
+
+@router.get(
+    "/contents-market-refresh/{operation_id}",
+    operation_id="contents_refresh_status",
+    response_model=ContentsStatus,
+)
+def status(
+    operation_id: UUID, service: Service, response: Response
+) -> ContentsStatus | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.contents_status(operation_id)
+    except ProductRefreshError as error:
+        return problem(error)
+
+
+@router.post(
+    "/contents-market-refresh/{operation_id}/resume",
+    operation_id="resume_contents_refresh",
+    response_model=ContentsStatus,
+)
+def resume(
+    operation_id: UUID, service: Service, tasks: BackgroundTasks, response: Response
+) -> ContentsStatus | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        lease = service.acquire(operation_id)
+        if lease:
+            tasks.add_task(service.run, lease)
+        return service.contents_status(operation_id)
+    except ProductRefreshError as error:
+        return problem(error)
