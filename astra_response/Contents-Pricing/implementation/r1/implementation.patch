+CREATE OR REPLACE FUNCTION product_refresh_structure() RETURNS trigger LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE p_id uuid; o public.product_refresh_operation; r public.provider_budget_group;
+BEGIN
+ IF TG_TABLE_NAME='provider_budget_group' THEN
+  IF NEW.operation_type<>'PRODUCT_SET_REFRESH' THEN RETURN NULL; END IF;
+  p_id=COALESCE(NEW.parent_id,NEW.id);
+ ELSIF TG_TABLE_NAME='product_refresh_view' THEN
+  p_id=COALESCE(NEW.operation_id,OLD.operation_id);
+ ELSE p_id=NEW.id;
+ END IF;
+ SELECT * INTO r FROM public.provider_budget_group WHERE id=p_id;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=p_id;
+ IF r.id IS NULL AND o.id IS NULL THEN RETURN NULL; END IF;
+ IF o.id IS NULL OR r.parent_id IS NOT NULL OR r.operation_type<>'PRODUCT_SET_REFRESH'
+  OR r.operation_key<>o.canonical_set_id::text
+  OR (r.closed_at IS NULL)<>(o.state<>'CLOSED') OR r.closed_at IS DISTINCT FROM o.closed_at
+  OR (SELECT count(*) FROM public.product_refresh_view WHERE operation_id=p_id)<>4
+  OR (SELECT count(*) FROM public.provider_budget_group WHERE parent_id=p_id)<>2
+  OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group WHERE id=o.identity_budget_group_id AND parent_id=p_id)
+  OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group WHERE id=o.price_budget_group_id AND parent_id=p_id)
+  OR EXISTS(SELECT 1 FROM public.provider_budget_group WHERE parent_id=p_id AND closed_at IS DISTINCT FROM o.closed_at) THEN
+  RAISE EXCEPTION 'PRODUCT_OPERATION_STRUCTURE' USING ERRCODE='23514';
+ END IF;
+ RETURN NULL;
+END $$;
+-- statement-break
+CREATE OR REPLACE FUNCTION product_refresh_operation_guard() RETURNS trigger LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE m public.market_mapping_revision; r public.provider_budget_group; n timestamptz=public.product_refresh_clock();
+BEGIN
+ IF TG_OP='INSERT' THEN
+  SELECT * INTO r FROM public.provider_budget_group WHERE id=NEW.id;
+  IF NOT public.product_refresh_is_owner() OR NEW.plan_digest<>public.product_refresh_digest(NEW.plan_snapshot)
+    OR NEW.plan_snapshot IS DISTINCT FROM public.product_refresh_plan(NEW.canonical_set_id,NEW.snapshot_id,r.scope_id,NEW.account_scope)
+    OR (NEW.canonical_set_id::text,NEW.normalized_set_number,NEW.snapshot_id::text,NEW.source_version_id::text,
+      NEW.catalog_evidence_id::text,NEW.market_policy_id::text,NEW.product_policy_version,NEW.plan_semantic_version)
+       IS DISTINCT FROM (NEW.plan_snapshot->>'canonical_set_id',NEW.plan_snapshot->>'normalized_set_number',
+        NEW.plan_snapshot->>'snapshot_id',NEW.plan_snapshot->>'source_version_id',NEW.plan_snapshot->>'catalog_evidence_id',
+        NEW.plan_snapshot->>'market_policy_id',NEW.plan_snapshot->>'product_policy_version',NEW.plan_snapshot->>'semantic_version') THEN
+   RAISE EXCEPTION 'INVALID_PLAN' USING ERRCODE='23514';
+  END IF;
+ ELSE
+  IF (to_jsonb(NEW)-'state'-'pause_reason'-'terminal_outcome'-'closed_at'-'execution_owner'-'execution_token'-'execution_lease_until'-'resolved_mapping_id')
+    IS DISTINCT FROM
+     (to_jsonb(OLD)-'state'-'pause_reason'-'terminal_outcome'-'closed_at'-'execution_owner'-'execution_token'-'execution_lease_until'-'resolved_mapping_id') THEN
+   RAISE EXCEPTION 'PRODUCT_AUTHORIZATION_IMMUTABLE' USING ERRCODE='23514';
+  END IF;
+  IF NOT public.product_refresh_is_owner() THEN
+   IF OLD.state='CLOSED' OR NEW.state='CLOSED' OR NEW.expires_at<=n
+     OR NEW.resolved_mapping_id IS DISTINCT FROM OLD.resolved_mapping_id THEN
+    RAISE EXCEPTION 'PRODUCT_PROGRESS_FORBIDDEN' USING ERRCODE='23514';
+   END IF;
+   IF OLD.execution_lease_until>n AND OLD.execution_token IS NOT NULL THEN
+    IF OLD.execution_token::text IS DISTINCT FROM current_setting('brickvault.product_token',true) THEN
+     RAISE EXCEPTION 'STALE_EXECUTION_LEASE' USING ERRCODE='23514';
+    END IF;
+   ELSIF NEW.execution_token IS NULL OR NEW.execution_token IS NOT DISTINCT FROM OLD.execution_token
+     OR NEW.execution_lease_until<=n OR NEW.state<>'OPEN' THEN
+    RAISE EXCEPTION 'STALE_EXECUTION_LEASE' USING ERRCODE='23514';
+   END IF;
+   IF NEW.execution_lease_until>n+interval '120 seconds' THEN
+    RAISE EXCEPTION 'EXECUTION_LEASE_BOUND' USING ERRCODE='23514';
+   END IF;
+  END IF;
+  IF OLD.resolved_mapping_id IS NOT NULL AND NEW.resolved_mapping_id IS DISTINCT FROM OLD.resolved_mapping_id
+    AND NOT (public.product_refresh_is_owner() AND NEW.resolved_mapping_id IS NULL) THEN
+   RAISE EXCEPTION 'PRODUCT_MAPPING_IMMUTABLE' USING ERRCODE='23514';
+  END IF;
+  IF OLD.state='CLOSED' AND (to_jsonb(NEW)-'resolved_mapping_id') IS DISTINCT FROM (to_jsonb(OLD)-'resolved_mapping_id') THEN
+   RAISE EXCEPTION 'PRODUCT_OPERATION_CLOSED' USING ERRCODE='23514';
+  END IF;
+ END IF;
+ IF NEW.resolved_mapping_id IS NOT NULL AND (TG_OP='INSERT' OR NEW.resolved_mapping_id IS DISTINCT FROM OLD.resolved_mapping_id) THEN
+  SELECT * INTO m FROM public.market_mapping_revision WHERE id=NEW.resolved_mapping_id;
+  IF (m.set_id,m.snapshot_id,m.source_version_id,m.evidence_id,m.item_type,m.review_state,m.closed_at)
+    IS DISTINCT FROM (NEW.canonical_set_id,NEW.snapshot_id,NEW.source_version_id,NEW.catalog_evidence_id,'SET'::varchar,'verified'::varchar,NULL::timestamptz) THEN
+   RAISE EXCEPTION 'PRODUCT_MAPPING_BINDING' USING ERRCODE='23514';
+  END IF;
+ END IF;
+ RETURN NEW;
+END $$;
+-- statement-break
+CREATE OR REPLACE FUNCTION product_refresh_context(p_id uuid) RETURNS void LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE o public.product_refresh_operation;
+BEGIN
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=p_id;
+ IF o.id IS NULL OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group g
+    JOIN public.provider_scope_state s ON s.id=g.scope_id WHERE g.id=p_id AND s.policy_id=o.market_policy_id)
+  OR NOT EXISTS(SELECT 1 FROM public.catalog_snapshot WHERE id=o.snapshot_id AND state='accepted')
+  OR EXISTS(SELECT 1 FROM public.catalog_active_snapshot a JOIN public.catalog_snapshot c ON c.id=o.snapshot_id
+    JOIN public.catalog_source_version sv ON sv.id=c.source_version_id
+    WHERE a.provider_id=sv.provider_id AND a.scope=c.scope AND a.snapshot_id IS DISTINCT FROM o.snapshot_id)
+  OR (o.resolved_mapping_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.market_mapping_revision m
+    WHERE m.id=o.resolved_mapping_id AND m.review_state='verified' AND m.closed_at IS NULL
+     AND (m.set_id,m.snapshot_id,m.source_version_id,m.evidence_id)=(o.canonical_set_id,o.snapshot_id,o.source_version_id,o.catalog_evidence_id))) THEN
+  RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514';
+ END IF;
+END $$;
+-- statement-break
+CREATE OR REPLACE FUNCTION product_refresh_confirm(p_plan jsonb,p_key uuid,p_created timestamptz,p_digest text) RETURNS uuid
+ LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public AS $$
+DECLARE o public.product_refresh_operation; n timestamptz=public.product_refresh_clock();
+ r uuid=gen_random_uuid(); identity_group uuid=gen_random_uuid(); price_group uuid=gen_random_uuid();
+ scope uuid; set_id uuid; snapshot uuid; policy public.market_policy; current_plan jsonb; x jsonb;
+BEGIN
+ -- Global key lock precedes the provider lock; concurrent duplicate keys cannot race across sets.
+ PERFORM pg_advisory_xact_lock(hashtextextended(p_key::text,630008));
+ n=public.product_refresh_clock();
+ SELECT * INTO o FROM public.product_refresh_operation WHERE idempotency_key=p_key;
+ IF o.id IS NOT NULL THEN
+  IF (o.plan_snapshot,o.plan_digest,o.created_at) IS DISTINCT FROM (p_plan,p_digest,p_created) THEN
+   RAISE EXCEPTION 'IDEMPOTENCY_CONFLICT' USING ERRCODE='23514';
+  END IF;
+  RETURN o.id;
+ END IF;
+ IF p_key IS NULL OR substring(p_key::text,15,1)<>'4' OR substring(p_key::text,20,1) NOT IN ('8','9','a','b') OR p_created IS NULL OR p_created>n
+   OR n>=p_created+interval '15 minutes' THEN
+  RAISE EXCEPTION 'CONFIRMATION_EXPIRED' USING ERRCODE='23514';
+ END IF;
+ IF p_plan IS NULL OR octet_length(p_plan::text)>16384 OR p_digest IS DISTINCT FROM public.product_refresh_digest(p_plan) THEN
+  RAISE EXCEPTION 'INVALID_PLAN' USING ERRCODE='23514';
+ END IF;
+ scope=(p_plan->>'scope_id')::uuid; set_id=(p_plan->>'canonical_set_id')::uuid;
+ snapshot=(p_plan->>'snapshot_id')::uuid;
+ -- Same locks as catalog activation and market publication; no provider I/O is possible here.
+ PERFORM 1 FROM public.catalog_snapshot WHERE id=snapshot FOR SHARE;
+ PERFORM 1 FROM public.catalog_active_snapshot WHERE snapshot_id=snapshot FOR SHARE;
+ PERFORM 1 FROM public.provider_scope_state WHERE id=scope FOR UPDATE;
+ n=public.product_refresh_clock();
+ IF n>=p_created+interval '15 minutes' THEN
+  RAISE EXCEPTION 'CONFIRMATION_EXPIRED' USING ERRCODE='23514';
+ END IF;
+ SELECT op.* INTO o FROM public.product_refresh_operation op JOIN public.provider_budget_group g USING(id)
+   WHERE g.scope_id=scope AND op.canonical_set_id=set_id AND op.state<>'CLOSED';
+ IF o.id IS NOT NULL THEN
+  RAISE EXCEPTION 'OPERATION_IN_PROGRESS' USING ERRCODE='23514',DETAIL=o.id::text;
+ END IF;
+ current_plan=public.product_refresh_plan(set_id,snapshot,scope,(p_plan->>'account_scope')::uuid);
+ IF current_plan IS DISTINCT FROM p_plan THEN RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ SELECT * INTO policy FROM public.market_policy WHERE id=(p_plan->>'market_policy_id')::uuid;
+ INSERT INTO public.provider_budget_group
+  (id,scope_id,parent_id,case_id,budget_class,identity_limit,price_limit,retry_limit,total_limit,created_at,operation_type,operation_key)
+  VALUES(r,scope,NULL,NULL,'interactive',4,4,2,10,n,'PRODUCT_SET_REFRESH',set_id::text),
+   (identity_group,scope,r,NULL,'interactive',NULL,NULL,NULL,NULL,n,'PRODUCT_SET_REFRESH',set_id::text),
+   (price_group,scope,r,NULL,'interactive',NULL,NULL,NULL,NULL,n,'PRODUCT_SET_REFRESH',set_id::text);
+ INSERT INTO public.product_refresh_operation
+  (id,canonical_set_id,normalized_set_number,snapshot_id,source_version_id,catalog_evidence_id,
+   identity_budget_group_id,price_budget_group_id,account_scope,market_policy_id,idempotency_key,
+   product_policy_version,plan_semantic_version,plan_digest,plan_snapshot,created_at,confirmed_at,expires_at,retained_until,state,resolved_mapping_id)
+  VALUES(r,set_id,p_plan->>'normalized_set_number',snapshot,(p_plan->>'source_version_id')::uuid,
+   (p_plan->>'catalog_evidence_id')::uuid,identity_group,price_group,(p_plan->>'account_scope')::uuid,policy.id,p_key,
+   p_plan->>'product_policy_version',p_plan->>'semantic_version',p_digest,p_plan,p_created,n,n+interval '24 hours',
+   n+make_interval(secs=>GREATEST(86400,policy.metadata_seconds)),'OPEN',(p_plan->>'mapping_id')::uuid);
+ INSERT INTO public.product_refresh_view(operation_id,condition,basis)
+  SELECT r,pv->>'condition',pv->>'basis' FROM jsonb_array_elements(p_plan->'views') pv;
+ FOR x IN SELECT * FROM jsonb_array_elements(p_plan->'views') LOOP
+  IF x->>'action'='REUSE' THEN
+   UPDATE public.product_refresh_view SET cache_id=(x->>'cache_id')::uuid,
+    observation_id=(SELECT current_observation_id FROM public.provider_cache_entry WHERE id=(x->>'cache_id')::uuid),
+    completion_kind=CASE WHEN x->>'cache_state'='confirmed_empty' THEN 'CONFIRMED_EMPTY' ELSE 'REUSED_CACHE' END,completed_at=n
+    WHERE operation_id=r AND condition=x->>'condition' AND basis=x->>'basis';
+  ELSIF x->>'action' IN ('JOIN','BLOCKED') THEN
+   UPDATE public.product_refresh_view SET cache_id=(x->>'cache_id')::uuid,job_id=(x->>'job_id')::uuid,
+    admitted_generation=(x->>'generation')::bigint,current_generation=(x->>'generation')::bigint,
+    bound_budget_group=(x->>'budget_group')::uuid,
+    completed_generation=CASE WHEN x->>'action'='BLOCKED' THEN (x->>'generation')::bigint END,
+    completion_kind=CASE WHEN x->>'action'='BLOCKED' THEN 'FAILED' END,
+    completed_at=CASE WHEN x->>'action'='BLOCKED' THEN n END,
+    failure_code=CASE WHEN x->>'action'='BLOCKED' THEN 'joined_work_failed' END
+    WHERE operation_id=r AND condition=x->>'condition' AND basis=x->>'basis';
+  END IF;
+ END LOOP;
+ IF NOT EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=r AND completed_at IS NULL) THEN
+  PERFORM public.product_refresh_close(r);
+ END IF;
+ RETURN r;
+END $$;
