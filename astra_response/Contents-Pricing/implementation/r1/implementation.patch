+CREATE FUNCTION contents_refresh_plan(p_set uuid,p_snapshot uuid,p_scope uuid,p_account uuid,p_selection jsonb) RETURNS jsonb
+LANGUAGE plpgsql STABLE SET search_path=pg_catalog,public AS $$
+DECLARE f public.catalog_set_fact; s public.provider_scope_state; t jsonb; view jsonb; targets jsonb; views jsonb='[]';
+ k public.provider_cache_entry; j public.provider_refresh_job; cache_state text; action text; number text; result jsonb; prices integer;
+BEGIN
+ SELECT * INTO f FROM public.catalog_set_fact WHERE snapshot_id=p_snapshot AND set_id=p_set;
+ SELECT identifier INTO number FROM public.catalog_set WHERE id=p_set;
+ SELECT * INTO s FROM public.provider_scope_state WHERE id=p_scope;
+ IF f.set_id IS NULL OR number IS NULL OR p_account IS NULL OR s.provider IS DISTINCT FROM 'bricklink'
+ OR NOT EXISTS(SELECT 1 FROM public.catalog_snapshot WHERE id=p_snapshot AND state='accepted')
+ OR EXISTS(SELECT 1 FROM public.catalog_active_snapshot a JOIN public.catalog_snapshot c ON c.id=p_snapshot
+ JOIN public.catalog_source_version sv ON sv.id=c.source_version_id
+ WHERE a.provider_id=sv.provider_id AND a.scope=c.scope AND a.snapshot_id IS DISTINCT FROM p_snapshot) THEN
+ RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ targets=public.contents_refresh_targets(p_set,p_snapshot,p_selection);
+ FOR t IN SELECT * FROM jsonb_array_elements(targets) LOOP
+ FOR view IN SELECT * FROM jsonb_array_elements(p_selection->'views') ORDER BY value->>'condition',value->>'basis' LOOP
+ SELECT * INTO k FROM public.provider_cache_entry WHERE mapping_id=(t->>'mapping_id')::uuid
+ AND scope_id=p_scope AND account_scope=p_account AND item_type=t->>'item_type' AND item_no=t->>'item_no'
+ AND color_id IS NOT DISTINCT FROM (t->>'provider_color')::integer AND condition=view->>'condition' AND basis=view->>'basis'
+ AND currency='USD' AND country='US' AND region IS NULL AND endpoint='price' AND options='{}'::jsonb
