+ SELECT * INTO j FROM public.provider_refresh_job WHERE cache_id=k.id;
+ cache_state=public.product_refresh_cache_state(k.current_observation_id,s.policy_id);
+ action=CASE WHEN t->>'mapping_id' IS NULL THEN 'BLOCKED' WHEN cache_state IN ('fresh','confirmed_empty') THEN 'REUSE'
+ WHEN j.state IN ('queued','running','retry','deferred') THEN 'JOIN'
+ WHEN j.state='suspended' THEN 'BLOCKED' ELSE 'FETCH' END;
+ views=views||jsonb_build_array(jsonb_build_object('target_id',t->>'target_id','condition',view->>'condition','basis',view->>'basis',
+ 'action',action,'cache_state',cache_state,'cache_id',k.id,'observation_id',k.current_observation_id,'selection_generation',k.selection_generation,
+ 'job_id',j.id,'generation',j.generation,'budget_group',j.budget_group,'job_state',j.state));
+ END LOOP; END LOOP;
+ SELECT count(*) INTO prices FROM jsonb_array_elements(views) x WHERE x->>'action'='FETCH';
+ result=jsonb_build_object('semantic_version','contents-refresh-plan-v1','product_policy_version','product-contents-refresh-v1',
+ 'canonical_set_id',p_set,'normalized_set_number',number,'snapshot_id',p_snapshot,'source_version_id',f.source_version_id,
+ 'catalog_evidence_id',f.evidence_id,'scope_id',p_scope,'account_scope',p_account,'market_policy_id',s.policy_id,
+ 'selection',p_selection,'targets',targets,'views',views,'currency','USD','country','US',
+ 'adapter_version','bricklink-offline-3a-v1','normalization_version','market-evidence-v1',
+ 'authorized_identity_initials',0,'authorized_price_initials',prices,'maximum_attempts',CASE WHEN prices>0 THEN prices+2 ELSE 0 END,
+ 'ceilings',jsonb_build_object('identity',0,'price',4,'retries',2,'total',6));
