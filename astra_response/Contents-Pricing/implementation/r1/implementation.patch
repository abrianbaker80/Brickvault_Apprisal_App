+CREATE OR REPLACE FUNCTION product_refresh_structure() RETURNS trigger LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE p_id uuid; o public.product_refresh_operation; r public.provider_budget_group;
+BEGIN
+ IF TG_TABLE_NAME='provider_budget_group' THEN
+  IF NEW.operation_type NOT IN ('PRODUCT_SET_REFRESH','PRODUCT_CONTENTS_REFRESH') THEN RETURN NULL; END IF;
+  p_id=COALESCE(NEW.parent_id,NEW.id);
+ ELSIF TG_TABLE_NAME IN ('product_refresh_view','product_refresh_target') THEN
+  p_id=COALESCE(NEW.operation_id,OLD.operation_id);
+ ELSE p_id=NEW.id;
+ END IF;
+ SELECT * INTO r FROM public.provider_budget_group WHERE id=p_id;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=p_id;
+ IF r.id IS NULL AND o.id IS NULL THEN RETURN NULL; END IF;
+ IF o.id IS NULL OR r.parent_id IS NOT NULL OR r.operation_type<>(CASE o.scope WHEN 'CONTENTS' THEN 'PRODUCT_CONTENTS_REFRESH' ELSE 'PRODUCT_SET_REFRESH' END)
+  OR r.operation_key<>o.canonical_set_id::text
+  OR (r.closed_at IS NULL)<>(o.state<>'CLOSED') OR r.closed_at IS DISTINCT FROM o.closed_at
+  OR (SELECT count(*) FROM public.product_refresh_view WHERE operation_id=p_id)<>(CASE o.scope WHEN 'CONTENTS' THEN jsonb_array_length(o.plan_snapshot->'views') ELSE 4 END)
+  OR (SELECT count(*) FROM public.provider_budget_group WHERE parent_id=p_id)<>2
+  OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group WHERE id=o.identity_budget_group_id AND parent_id=p_id)
+  OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group WHERE id=o.price_budget_group_id AND parent_id=p_id)
+  OR EXISTS(SELECT 1 FROM public.provider_budget_group WHERE parent_id=p_id AND closed_at IS DISTINCT FROM o.closed_at) THEN
+  RAISE EXCEPTION 'PRODUCT_OPERATION_STRUCTURE' USING ERRCODE='23514';
+ END IF;
+ IF o.scope='CONTENTS' AND ((SELECT count(*) FROM public.product_refresh_target WHERE operation_id=p_id)<>jsonb_array_length(o.plan_snapshot->'targets') OR EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=p_id AND target_id IS NULL)) THEN RAISE EXCEPTION 'PRODUCT_OPERATION_STRUCTURE' USING ERRCODE='23514'; END IF;
+ RETURN NULL;
+END $$;
