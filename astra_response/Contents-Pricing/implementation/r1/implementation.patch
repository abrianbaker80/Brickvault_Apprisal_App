+}
+.contents-pricing input[type='checkbox'] {
+  width: 18px;
+  height: 18px;
+  flex: 0 0 18px;
+  padding: 0;
+  margin: 0;
+}
+.contents-pricing fieldset {
+  min-width: 0;
+  border: 1px solid var(--border, #526173);
+  border-radius: 0.6rem;
+  padding: 1rem;
+  margin: 1rem 0;
+}
+.contents-views {
+  display: flex;
+  flex-wrap: wrap;
