+CREATE OR REPLACE FUNCTION product_refresh_attempt_guard() RETURNS trigger LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE g public.provider_budget_group; o public.product_refresh_operation; v public.product_refresh_view;
+ r uuid; category text; used integer; maximum integer; p public.market_policy; n timestamptz=public.product_refresh_clock();
+BEGIN
+ SELECT * INTO g FROM public.provider_budget_group WHERE id=NEW.budget_group;
+ IF g.operation_type IS DISTINCT FROM 'PRODUCT_SET_REFRESH' THEN RETURN NEW; END IF;
+ r=COALESCE(g.parent_id,g.id);
+ IF TG_OP='INSERT' OR (NEW.outcome='dispatched' AND OLD.outcome='reserved') THEN
+  o=public.product_refresh_owned(r);
+  PERFORM public.product_refresh_context(r);
+  IF NEW.scope_id<>g.scope_id OR NEW.policy_id<>o.market_policy_id THEN
+   RAISE EXCEPTION 'PRODUCT_ATTEMPT_SCOPE' USING ERRCODE='23514'; END IF;
+  IF NEW.purpose='IDENTITY_DISCOVERY' THEN
+   IF NEW.budget_group<>o.identity_budget_group_id OR NEW.discovery_target_id<>o.canonical_set_id
+    OR NEW.discovery_account_scope<>o.account_scope OR NEW.discovery_operation<>'item' OR NEW.discovery_item_type<>'SET'
+    OR o.resolved_mapping_id IS NOT NULL OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(o.plan_snapshot->'selectors') x
+      WHERE x->>'item_type'=NEW.discovery_item_type AND x->>'item_no'=NEW.discovery_item_no) THEN
+    RAISE EXCEPTION 'PRODUCT_DISCOVERY_NOT_AUTHORIZED' USING ERRCODE='23514';
+   END IF;
+  ELSE
+   SELECT * INTO v FROM public.product_refresh_view WHERE operation_id=r AND cache_id=NEW.cache_id
+    AND job_id=NEW.job_id AND current_generation=NEW.generation AND bound_budget_group=NEW.budget_group;
+   IF NEW.budget_group<>o.price_budget_group_id OR v.operation_id IS NULL OR v.completed_at IS NOT NULL THEN
+    RAISE EXCEPTION 'PRODUCT_VIEW_NOT_AUTHORIZED' USING ERRCODE='23514';
+   END IF;
+  END IF;
+  IF TG_OP='INSERT' THEN
+   -- Scope-first callers already lock this row; guard direct runtime inserts as well.
+   PERFORM 1 FROM public.provider_scope_state WHERE id=NEW.scope_id FOR UPDATE;
+   SELECT * INTO p FROM public.market_policy WHERE id=NEW.policy_id;
+   category=CASE WHEN NEW.attempt_number>1 THEN 'retries'
+     WHEN NEW.purpose='IDENTITY_DISCOVERY' THEN 'identity' ELSE 'price' END;
+   maximum=CASE category WHEN 'retries' THEN 2 WHEN 'identity' THEN
+    (o.plan_snapshot->>'authorized_identity_initials')::integer ELSE (o.plan_snapshot->>'authorized_price_initials')::integer END;
+   SELECT count(*) INTO used FROM public.provider_fetch_run a JOIN public.provider_budget_group b ON b.id=a.budget_group
+    WHERE (b.id=r OR b.parent_id=r) AND CASE category WHEN 'retries' THEN a.attempt_number>1
+      WHEN 'identity' THEN a.attempt_number=1 AND a.purpose='IDENTITY_DISCOVERY'
+      ELSE a.attempt_number=1 AND a.purpose='MARKET_REFRESH' END;
+   IF used>=maximum OR (SELECT count(*) FROM public.provider_fetch_run a JOIN public.provider_budget_group b ON b.id=a.budget_group
+     WHERE b.id=r OR b.parent_id=r)>=10 THEN RAISE EXCEPTION 'run_budget_exhausted' USING ERRCODE='23514'; END IF;
+   IF (SELECT count(*) FROM public.provider_fetch_run WHERE budget_group=NEW.budget_group)>=p.interactive_limit THEN
+    RAISE EXCEPTION 'group_budget_exhausted' USING ERRCODE='23514'; END IF;
+   IF (SELECT count(*) FROM public.provider_fetch_run WHERE scope_id=NEW.scope_id AND reserved_at>n-interval '1 day')>=p.global_limit THEN
+    RAISE EXCEPTION 'daily_budget_exhausted' USING ERRCODE='23514'; END IF;
+  END IF;
+ END IF;
+ RETURN NEW;
+END $$;
