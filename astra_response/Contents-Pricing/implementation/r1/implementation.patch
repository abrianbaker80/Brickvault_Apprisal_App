+def test_contents_four_initials_two_retries_and_no_seventh(
+    contents_service: ContentsService, product: ProductHarness
+) -> None:
+    from brickvault_api.providers.bricklink.requests import Failure
+    from brickvault_api.providers.bricklink.transport import FetchResult
+
+    s = contents_service
+    p = s.prepare("80000-1", selection("normal", all_views=True))
+    op = s.confirm_selected(
+        "80000-1", ContentsConfirmation(selection=p.selection, confirmation=p.confirmation)
+    )
+    lease = s.acquire(op)
+    assert lease
+    s.repository.bind_views(lease)
+    group = s.repository.status(op)["operation"]["price_budget_group_id"]
+    for index in range(6):
+        attempt = s.repository.claim(
+            product.market.scope, lease.owner, group=group, operation_token=lease.token
+        )
+        assert attempt
+        request = s.repository.dispatch(attempt)
+        result = (
+            FetchResult(request, failure=Failure.CONNECT, attempts=1, retryable=True)
+            if index < 4
+            else s.provider.fetch(request)
+        )
+        s.repository.complete(attempt, result)
+        product.advance_clock(5)
+    assert (
+        s.repository.claim(
+            product.market.scope, lease.owner, group=group, operation_token=lease.token
+        )
+        is None
+    )
+    usage = s.repository.status(op)["usage"]
+    assert (
+        usage["total"] == 6
+        and usage["price"] == 4
+        and usage["retries"] == 2
+        and usage["identity"] == 0
+    )
+
