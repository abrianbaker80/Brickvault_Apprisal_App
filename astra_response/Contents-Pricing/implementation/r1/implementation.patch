+CREATE FUNCTION contents_refresh_confirm(p_plan jsonb,p_key uuid,p_created timestamptz,p_digest text) RETURNS uuid
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public AS $$
