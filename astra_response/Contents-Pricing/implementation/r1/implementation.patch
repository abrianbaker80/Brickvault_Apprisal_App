+import './contents.css';
+import { useEffect, useRef, useState } from 'react';
+import {
+  activeContents,
+  confirmContents,
+  contentsPage,
+  contentsStatus,
+  planContents,
+  resumeContents,
+} from './contents-api';
+import type { ContentsPage, ContentsPlan, ContentsSelection, ContentsStatus } from './contents-api';
+import { useRefreshWorkflow } from './useRefreshWorkflow';
+
+const api = { active: activeContents, status: contentsStatus };
+const marketViews = (['N', 'U'] as const).flatMap((condition) =>
+  (['sold', 'stock'] as const).map((basis) => ({ condition, basis })),
+);
+const label = (condition: string, basis: string) =>
+  `${condition === 'N' ? 'New' : 'Used'} / ${basis === 'sold' ? 'Sold' : 'Active'}`;
+const explain: Record<string, string> = {
+  PRICE_LIMIT:
+    'This selection needs more than four new price requests. Choose fewer items or market views, then review a new plan.',
+  SELECTION_LIMIT: 'Choose no more than four distinct targets.',
+  PLAN_SIZE_LIMIT: 'This selection exceeds the bounded plan size. Choose fewer occurrences.',
+  REPLAN_REQUIRED:
+    'Inventory, mappings or evidence changed. Reload contents and review a new plan.',
+  PROVIDER_UNAVAILABLE: 'Market refresh is unavailable. Recorded contents remain readable.',
+  MAPPING_UNRESOLVED:
+    'No selected item has an eligible verified mapping. Identity discovery is outside this workflow.',
+  BUDGET_EXHAUSTED: 'The available request allowance is exhausted. No allowance will be reset.',
+};
+
+export function ContentsPricing({ number, reload }: { number: string; reload: () => void }) {
+  const [page, setPage] = useState<ContentsPage | null>(null);
+  const [selected, setSelected] = useState<Map<string, string>>(new Map());
+  const [extras, setExtras] = useState(false);
+  const [views, setViews] = useState(marketViews);
+  const [readError, setReadError] = useState('');
+  const [readVersion, setReadVersion] = useState(0);
+  const [now, setNow] = useState(Date.now());
+  const readGeneration = useRef(0);
+  const model = useRefreshWorkflow<ContentsPlan, ContentsStatus>(
+    number,
+    () => {
+      setReadVersion((v) => v + 1);
+      reload();
+    },
+    api,
+  );
+  const {
+    plan,
+    setPlan,
+    operation,
+    setOperation,
+    busy,
+    act,
+    error,
+    progressUnknown,
+    setProgressUnknown,
+  } = model;
+  useEffect(() => {
+    const controller = new AbortController();
+    const generation = ++readGeneration.current;
+    void contentsPage(number, undefined, undefined, controller.signal)
+      .then((value) => {
+        if (!controller.signal.aborted && generation === readGeneration.current) {
+          setPage((previous) => {
+            if (previous && previous.revision_id !== value.revision_id) {
+              setSelected(new Map());
+              setPlan(null);
+            }
+            return value;
+          });
+          setReadError('');
+        }
+      })
+      .catch(() => {
+        if (!controller.signal.aborted)
+          setReadError('Contents could not be read. Reload contents to retry.');
+      });
+    return () => controller.abort();
+  }, [number, readVersion, setPlan]);
+  useEffect(() => {
+    const timer = window.setInterval(() => setNow(Date.now()), 1000);
+    return () => window.clearInterval(timer);
+  }, []);
+  function choose(id: string, target: string, checked: boolean) {
+    setPlan(null);
+    const next = new Map(selected);
+    if (checked) next.set(id, target);
+    else next.delete(id);
+    if (next.size > 32 || new Set(next.values()).size > 4) {
+      setReadError('Select at most four distinct targets and 32 occurrences.');
+      return;
+    }
+    setReadError('');
+    setSelected(next);
+  }
+  async function more() {
+    if (!page?.next_cursor || !page.revision_id) return;
+    const generation = ++readGeneration.current;
+    try {
+      const next = await contentsPage(number, page.revision_id, page.next_cursor);
+      if (generation === readGeneration.current) setPage(next);
+    } catch {
+      setReadError('The inventory page changed or could not be read. Reload contents.');
+    }
+  }
+  function selection(): ContentsSelection | null {
+    return page?.revision_id && selected.size && views.length
+      ? {
+          revision_id: page.revision_id,
+          occurrences: [...selected.keys()],
+          include_extras: extras,
+          views,
+        }
+      : null;
+  }
+  async function recheck() {
+    await act(async () => {
+      const value = operation
+        ? await contentsStatus(operation.operation_id)
+        : await activeContents(number);
+      if (model.mounted.current) {
+        setOperation(value);
+        setProgressUnknown(false);
+      }
+    });
+  }
+  return (
+    <section className="panel contents-pricing" aria-label="Selected contents pricing">
+      <h3>Price selected catalog contents</h3>
+      <p>
+        Catalog-expected contents only. These rows do not verify your lot’s completeness, condition
+        or authenticity. Prices are per item; no new component subtotal is calculated.
+      </p>
+      <p>
+        Up to four targets · four new price requests · two retries · zero identity requests.
+        New/Used and Sold/Active remain independent. Active prices are asking evidence.
+      </p>
+      <button
+        type="button"
+        onClick={() => {
+          setPlan(null);
+          setReadVersion((v) => v + 1);
+        }}
+      >
+        Reload contents
+      </button>
+      <button type="button" disabled={busy} onClick={() => void recheck()}>
+        Recheck saved progress
+      </button>
+      {(readError || error) && <p role="alert">{readError || explain[error] || error}</p>}
+      {!page && !readError && <p role="status">Reading recorded contents…</p>}
+      {page && (
+        <>
+          <p>
+            {page.total_recorded_rows} direct recorded rows · inventory {page.inventory_state}.
+            Nested contents and unresolved alternatives are not expanded.
+          </p>
+          <fieldset disabled={busy || !!operation?.running}>
+            <legend>Selected scope</legend>
+            <label>
+              <input
+                type="checkbox"
+                checked={extras}
+                onChange={(e) => {
+                  setExtras(e.target.checked);
+                  setSelected(new Map());
+                  setPlan(null);
+                }}
+              />{' '}
+              Include recorded extras
+            </label>
+            <div className="contents-views">
+              {marketViews.map((v) => (
+                <label key={v.condition + v.basis}>
+                  <input
+                    type="checkbox"
+                    checked={views.some((x) => x.condition === v.condition && x.basis === v.basis)}
+                    onChange={(e) => {
+                      setViews((old) =>
+                        e.target.checked
+                          ? [...old, v]
+                          : old.filter((x) => x.condition !== v.condition || x.basis !== v.basis),
+                      );
+                      setPlan(null);
+                    }}
+                  />
+                  {label(v.condition, v.basis)}
+                </label>
+              ))}
+            </div>
+            <p>
+              {selected.size} selected occurrences · {new Set(selected.values()).size} distinct
+              targets
+            </p>
+            <ul className="contents-items">
+              {page.rows.map((row) => (
+                <li key={row.occurrence_id}>
+                  <label>
+                    <input
+                      type="checkbox"
+                      checked={selected.has(row.occurrence_id)}
+                      disabled={!row.selectable || (!extras && !row.regular_quantity)}
+                      onChange={(e) => choose(row.occurrence_id, row.target_id, e.target.checked)}
+                    />
+                    <span>
+                      <strong>{row.identity}</strong>
+                      {row.color ? ` · ${row.color}` : ''}
+                    </span>
+                  </label>
+                  <p>
+                    {row.regular_quantity} regular · {row.extra_quantity} extras · {row.kind} ·{' '}
+                    {row.mapping === 'VERIFIED'
+                      ? row.provider_identity
+                      : 'Unresolved mapping — pricing blocked'}
+                  </p>
+                  {row.reason && <p>{row.reason.replaceAll('_', ' ')}</p>}
+                  <dl className="contents-evidence">
+                    {row.evidence.map((e) => {
+                      const expired = !!e.display_until && now >= Date.parse(e.display_until);
+                      const stale = !!e.stale_after && now >= Date.parse(e.stale_after);
+                      const state = expired
+                        ? 'display ineligible'
+                        : stale
+                          ? 'stale'
+                          : e.state.replaceAll('_', ' ');
+                      return (
+                        <div key={e.condition + e.basis}>
+                          <dt>{label(e.condition, e.basis)}</dt>
+                          <dd>
+                            {!expired && !stale && e.unit_price !== null
+                              ? `${e.currency} ${e.unit_price}`
+                              : 'Unknown'}{' '}
+                            · {state}
+                          </dd>
+                          <dd>
+                            Refresh: {e.refresh_state}
+                            {e.fetched_at
+                              ? ` · fetched ${new Date(e.fetched_at).toLocaleString()}`
+                              : ''}
+                          </dd>
+                          {!expired && (
+                            <dd>
+                              {e.window?.replaceAll('_', ' ')}
+                              {e.sample_count !== null ? ` · sample ${e.sample_count}` : ''} ·
+                              quantity-weighted average
+                            </dd>
+                          )}
+                        </div>
+                      );
+                    })}
+                  </dl>
+                </li>
+              ))}
+            </ul>
+          </fieldset>
+          {page.next_cursor && (
+            <button type="button" onClick={() => void more()}>
+              Next contents page
+            </button>
+          )}
+          <button
+            type="button"
+            ref={model.planTrigger}
+            disabled={busy || !selection() || !!operation?.running}
+            onClick={() =>
+              void act(async () => {
+                const scope = selection();
+                if (!scope) return;
+                const value = await planContents(number, scope);
+                if (model.mounted.current) setPlan(value);
+              })
+            }
+          >
+            Review selected refresh plan
+          </button>
+        </>
+      )}
+      {plan && (
+        <div className="contents-plan">
+          <h4 ref={model.planHeading} tabIndex={-1}>
+            Selected refresh plan
+          </h4>
+          <p>
+            {plan.identity_initials} identity · {plan.price_initials} new price requests ·{' '}
+            {plan.retry_reserve} retry reserve · {plan.maximum_attempts} maximum attempts
+          </p>
+          <p>
+            {explain[plan.state] || plan.state.replaceAll('_', ' ')}. Stricter account/provider
+            limits still apply.
+          </p>
+          <ul>
+            {plan.targets.map((t) => (
+              <li key={t.target_id}>
+                {t.item_type} {t.item_no ?? 'unresolved identity'}
+                {t.provider_color !== null ? ` color ${t.provider_color}` : ''} ·{' '}
+                {t.selected_quantity} selected recorded units · {t.mapping}
+                <ul>
+                  {plan.views
+                    .filter((v) => v.target_id === t.target_id)
+                    .map((v) => (
+                      <li key={v.condition + v.basis}>
+                        {label(v.condition, v.basis)}: {v.action} · {v.cache_state}
+                      </li>
+                    ))}
+                </ul>
+              </li>
+            ))}
+          </ul>
+          <p>
+            Expires {new Date(plan.expires_at).toLocaleTimeString()}. Joined work keeps its original
+            accounting.
+          </p>
+          <button
+            type="button"
+            disabled={busy || !plan.admissible || now >= Date.parse(plan.expires_at)}
+            onClick={() =>
+              void act(async () => {
+                const value = await confirmContents(number, plan);
+                if (model.mounted.current) {
+                  setOperation(value);
+                  setPlan(null);
+                }
+              })
+            }
+          >
+            Confirm selected refresh
+          </button>
+          <button type="button" onClick={() => setPlan(null)}>
+            Cancel plan
+          </button>
+        </div>
+      )}
+      {operation && (
+        <div role="status" aria-live="polite">
+          <h4>Selected refresh progress</h4>
+          <p>
+            {operation.state.replaceAll('_', ' ')} · {operation.complete_views}/
+            {operation.total_views} selected views finished · {operation.attempts_consumed}/
+            {operation.maximum_attempts} attempts · {operation.retries}/2 retries
+          </p>
+          <p>
+            {operation.selected_quantity} selected recorded units. This is selected-scope progress,
+            not full-inventory price coverage.
+          </p>
+          <ul>
+            {operation.targets.map((t) => (
+              <li key={t.target_id}>
+                {t.item_type} {t.item_no ?? 'unresolved'} · {t.selected_quantity} recorded units
+                <ul>
+                  {operation.views
+                    .filter((v) => v.target_id === t.target_id)
+                    .map((v) => (
+                      <li key={v.condition + v.basis}>
+                        {label(v.condition, v.basis)}: {v.state}
+                        {v.failure ? ` · ${v.failure}` : ''}
+                      </li>
+                    ))}
+                </ul>
+              </li>
+            ))}
+          </ul>
+          {progressUnknown && <p>Progress is unknown. Recheck saved progress before resuming.</p>}
+          {operation.resumable && !progressUnknown && (
+            <button
+              type="button"
+              disabled={busy}
+              onClick={() =>
+                void act(async () => {
+                  const value = await resumeContents(operation.operation_id);
+                  if (model.mounted.current) setOperation(value);
+                })
+              }
+            >
+              {['REPLAN_REQUIRED', 'EXPIRED'].includes(operation.state)
+                ? 'Reconcile saved operation'
+                : 'Resume selected refresh'}
+            </button>
+          )}
+          {operation.terminal && (
+            <p>
+              To retry missing evidence, choose the affected items/views and review a new plan.
