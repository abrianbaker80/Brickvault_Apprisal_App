+@pytest.mark.parametrize(
+    ("terminal", "change", "error"),
+    [
+        (False, None, None),
+        (True, None, None),
+        (True, "selection", "IDEMPOTENCY_CONFLICT"),
+        (True, "digest", "REPLAN_REQUIRED"),
+        (True, "signature", "REPLAN_REQUIRED"),
+    ],
+    ids=["progressed", "terminal", "changed-selection", "mismatched-receipt", "invalid-signature"],
