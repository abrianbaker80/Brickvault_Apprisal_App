+ UPDATE public.product_refresh_view SET cache_id=(v->>'cache_id')::uuid,observation_id=(v->>'observation_id')::uuid,
+ completion_kind=CASE WHEN v->>'cache_state'='confirmed_empty' THEN 'CONFIRMED_EMPTY' ELSE 'REUSED_CACHE' END,completed_at=n
+ WHERE operation_id=r AND target_id=(v->>'target_id')::uuid AND condition=v->>'condition' AND basis=v->>'basis';
+ ELSIF v->>'action'='BLOCKED' AND v->>'cache_id' IS NULL THEN
+ UPDATE public.product_refresh_view SET completion_kind='FAILED',failure_code='unresolved_mapping',completed_at=n
+ WHERE operation_id=r AND target_id=(v->>'target_id')::uuid AND condition=v->>'condition' AND basis=v->>'basis';
+ ELSIF v->>'action' IN ('JOIN','BLOCKED') THEN
+ UPDATE public.product_refresh_view SET cache_id=(v->>'cache_id')::uuid,job_id=(v->>'job_id')::uuid,
+ admitted_generation=(v->>'generation')::bigint,current_generation=(v->>'generation')::bigint,bound_budget_group=(v->>'budget_group')::uuid,
+ completed_generation=CASE WHEN v->>'action'='BLOCKED' THEN (v->>'generation')::bigint END,
+ completion_kind=CASE WHEN v->>'action'='BLOCKED' THEN 'FAILED' END,completed_at=CASE WHEN v->>'action'='BLOCKED' THEN n END,
+ failure_code=CASE WHEN v->>'action'='BLOCKED' THEN 'joined_work_failed' END
+ WHERE operation_id=r AND target_id=(v->>'target_id')::uuid AND condition=v->>'condition' AND basis=v->>'basis';
+ END IF;
+ END LOOP;
+ IF NOT EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=r AND completed_at IS NULL) THEN PERFORM public.product_refresh_close(r); END IF;
+ RETURN r;
+END $$;
