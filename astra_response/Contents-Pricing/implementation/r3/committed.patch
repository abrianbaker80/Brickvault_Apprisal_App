diff --git a/services/api/src/brickvault_api/market/contents_refresh.py b/services/api/src/brickvault_api/market/contents_refresh.py
new file mode 100644
index 0000000..88a0433
--- /dev/null
+++ b/services/api/src/brickvault_api/market/contents_refresh.py
@@ -0,0 +1,160 @@
+"""Contents binding over the shared worker, leases, attempts and result publication."""
+
+from typing import Any
+from uuid import UUID
+
+from ..providers.bricklink.requests import (
+    Basis,
+    BrickLinkColor,
+    Condition,
+    ItemType,
+    Operation,
+    Request,
+)
+from .product_refresh import ProductRefreshError, ProductRefreshRepository, product_errors
+from .product_refresh_models import ExecutionLease
+from .worker import Provider, Worker
+
+
+class ContentsRefreshRepository(ProductRefreshRepository):
+    def reconcile_operation(self, operation_id: UUID, lease: ExecutionLease | None = None) -> bool:
+        with product_errors(), self.database.connect() as c, c.transaction():
+            if lease:
+                self._owned(c, lease)
+            row = c.execute(
+                "SELECT contents_refresh_reconcile(%s) AS closed", (operation_id,)
+            ).fetchone()
+            assert row
+            return bool(row["closed"])
+
+    def resume(self, operation_id: UUID, *, owner: UUID | None = None) -> ExecutionLease | None:
+        if self.reconcile_operation(operation_id):
+            return None
+        return super().resume(operation_id, owner=owner)
+
+    def bind_views(self, lease: ExecutionLease) -> None:
+        with product_errors(), self.database.connect() as c, c.transaction():
+            op = self._owned(c, lease)
+            if op["scope"] != "CONTENTS":
+                raise ProductRefreshError("OPERATION_MISSING")
+            c.execute("SELECT product_refresh_context(%s)", (op["id"],))
+            views = c.execute(
+                """SELECT v.*,t.mapping_id,t.payload FROM product_refresh_view v
+                JOIN product_refresh_target t USING(operation_id,target_id)
+                WHERE v.operation_id=%s ORDER BY v.target_id,v.condition,v.basis FOR UPDATE OF v""",
+                (op["id"],),
+            ).fetchall()
+            for view in views:
+                if view["completed_at"] or view["job_id"]:
+                    continue
+                planned = next(
+                    v
+                    for v in op["plan_snapshot"]["views"]
+                    if (v["target_id"], v["condition"], v["basis"])
+                    == (str(view["target_id"]), view["condition"], view["basis"])
+                )
+                if planned["action"] != "FETCH":
+                    raise ProductRefreshError("REPLAN_REQUIRED")
+                # REUSE/JOIN are already bound in confirm. FETCH also keeps its exact
+                # pre-confirm cache/job generation; never adopt unrelated later work.
+                current = c.execute(
+                    """SELECT k.id,k.current_observation_id,k.selection_generation,
+                    j.id AS job_id,j.generation,j.budget_group,j.state FROM provider_cache_entry k
+                    LEFT JOIN provider_refresh_job j ON j.cache_id=k.id
+                    WHERE k.mapping_id=%s AND k.account_scope=%s AND k.condition=%s AND k.basis=%s
+                    AND k.currency='USD' AND k.country='US' AND k.region IS NULL AND k.options='{}'
+                    AND k.adapter_version='bricklink-offline-3a-v1' AND k.normalization_version='market-evidence-v1'""",
+                    (view["mapping_id"], op["account_scope"], view["condition"], view["basis"]),
+                ).fetchone()
+                expected = (
+                    planned["cache_id"],
+                    planned["observation_id"],
+                    planned["selection_generation"],
+                    planned["job_id"],
+                    planned["generation"],
+                    planned["budget_group"],
+                    planned["job_state"],
+                )
+                actual = (
+                    (
+                        str(current["id"]),
+                        str(current["current_observation_id"])
+                        if current["current_observation_id"]
+                        else None,
+                        current["selection_generation"],
+                        str(current["job_id"]) if current["job_id"] else None,
+                        current["generation"],
+                        str(current["budget_group"]) if current["budget_group"] else None,
+                        current["state"],
+                    )
+                    if current
+                    else (None,) * 7
+                )
+                if actual != expected:
+                    raise ProductRefreshError("REPLAN_REQUIRED")
+                target = view["payload"]
+                request = Request(
+                    Operation.PRICE,
+                    op["account_scope"],
+                    ItemType(target["item_type"]),
+                    target["item_no"],
+                    BrickLinkColor(target["provider_color"])
+                    if target["provider_color"] is not None
+                    else None,
+                    condition=Condition(view["condition"]),
+                    basis=Basis(view["basis"]),
+                )
+                result = self.resolve(
+                    view["mapping_id"],
+                    request,
+                    op["price_budget_group_id"],
+                    connection=c,
+                    operation_token=lease.token,
+                )
+                job = c.execute(
+                    "SELECT * FROM provider_refresh_job WHERE cache_id=%s", (result.cache_id,)
+                ).fetchone()
+                if not job or job["budget_group"] != op["price_budget_group_id"]:
+                    raise ProductRefreshError("REPLAN_REQUIRED")
+                c.execute(
+                    """UPDATE product_refresh_view SET cache_id=%s,job_id=%s,admitted_generation=%s,
+                    current_generation=%s,bound_budget_group=%s WHERE binding_id=%s""",
+                    (
+                        result.cache_id,
+                        job["id"],
+                        job["generation"],
+                        job["generation"],
+                        job["budget_group"],
+                        view["binding_id"],
+                    ),
+                )
+
+    def advance(self, lease: ExecutionLease, provider: Provider) -> dict[str, Any]:
+        try:
+            self.bind_views(lease)
+        except ProductRefreshError as error:
+            if str(error) == "REPLAN_REQUIRED":
+                self.reconcile_operation(lease.operation_id, lease)
+            raise
+        raw = self.status(lease.operation_id)
+        Worker(
+            self,
+            provider,
+            raw["root"]["scope_id"],
+            owner=lease.owner,
+            group=raw["operation"]["price_budget_group_id"],
+            operation_token=lease.token,
+        ).tick()
+        raw = self.status(lease.operation_id)
+        if all(v["completed_at"] for v in raw["views"]):
+            self.close(lease)
+            raw = self.status(lease.operation_id)
+        return raw
+
+    def status(self, operation_id: UUID) -> dict[str, Any]:
+        raw = super().status(operation_id)
+        if raw["operation"]["scope"] != "CONTENTS":
+            raise ProductRefreshError("OPERATION_MISSING")
+        if raw["progress"] == "CONFIRMED":
+            raw["progress"] = "REFRESHING"
+        return raw
