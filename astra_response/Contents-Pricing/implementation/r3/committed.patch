+def test_contents_http_reads_and_plans_preserve_all_market_state(
+    contents_service: ContentsService, product: ProductHarness
+) -> None:
+    from brickvault_api.api.contents import contents_service as dependency
+    from brickvault_api.main import create_app
+
+    from .auth_support import authenticated_client
+    from .test_calibration import state
+
+    app = create_app()
+    app.dependency_overrides[dependency] = lambda: contents_service
+    client = authenticated_client(app, product.market.owner.database, product.market.app.database)
+    try:
+        before = state(product.market)
+        page = client.get("/api/sets/80000-1/contents")
+        assert page.status_code == 200 and page.headers["cache-control"] == "no-store"
+        assert page.json()["physical_contents_verified"] is False
+        assert page.json()["inventory_state"] == "recorded"
+        bad = client.get(
+            "/api/sets/80000-1/contents", params={"revision_id": str(key("rev-child"))}
+        )
+        assert bad.status_code == 409
+        planned = client.post(
+            "/api/sets/80000-1/contents-market-refresh/plan",
+            json=selection("normal", "figure-line").model_dump(mode="json"),
+        )
+        assert planned.status_code == 200 and planned.json()["price_initials"] == 2
+        assert client.get("/api/sets/80000-1/contents-market-refresh").json() is None
+        assert state(product.market) == before
+    finally:
+        client.close()
