+ RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ prices=(p_plan->>'authorized_price_initials')::integer;
+ IF prices>4 THEN RAISE EXCEPTION 'PRICE_LIMIT' USING ERRCODE='23514'; END IF;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE canonical_set_id=sid AND scope='CONTENTS' AND state<>'CLOSED';
+ IF o.id IS NOT NULL THEN RAISE EXCEPTION 'OPERATION_IN_PROGRESS' USING ERRCODE='23514',DETAIL=o.id::text; END IF;
+ SELECT * INTO policy FROM public.market_policy WHERE id=(p_plan->>'market_policy_id')::uuid;
+ INSERT INTO public.provider_budget_group(id,scope_id,parent_id,case_id,budget_class,identity_limit,price_limit,retry_limit,total_limit,created_at,operation_type,operation_key)
+ VALUES(r,v_scope,NULL,NULL,'interactive',0,4,2,6,n,'PRODUCT_CONTENTS_REFRESH',sid::text),
+ (ig,v_scope,r,NULL,'interactive',NULL,NULL,NULL,NULL,n,'PRODUCT_CONTENTS_REFRESH',sid::text),
