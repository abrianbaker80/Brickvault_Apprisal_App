+ FOR x IN SELECT * FROM jsonb_array_elements(p_plan->'views') LOOP
+  IF x->>'action'='REUSE' THEN
+   UPDATE public.product_refresh_view SET cache_id=(x->>'cache_id')::uuid,
+    observation_id=(SELECT current_observation_id FROM public.provider_cache_entry WHERE id=(x->>'cache_id')::uuid),
+    completion_kind=CASE WHEN x->>'cache_state'='confirmed_empty' THEN 'CONFIRMED_EMPTY' ELSE 'REUSED_CACHE' END,completed_at=n
+    WHERE operation_id=r AND condition=x->>'condition' AND basis=x->>'basis';
+  ELSIF x->>'action' IN ('JOIN','BLOCKED') THEN
+   UPDATE public.product_refresh_view SET cache_id=(x->>'cache_id')::uuid,job_id=(x->>'job_id')::uuid,
+    admitted_generation=(x->>'generation')::bigint,current_generation=(x->>'generation')::bigint,
+    bound_budget_group=(x->>'budget_group')::uuid,
+    completed_generation=CASE WHEN x->>'action'='BLOCKED' THEN (x->>'generation')::bigint END,
+    completion_kind=CASE WHEN x->>'action'='BLOCKED' THEN 'FAILED' END,
+    completed_at=CASE WHEN x->>'action'='BLOCKED' THEN n END,
+    failure_code=CASE WHEN x->>'action'='BLOCKED' THEN 'joined_work_failed' END
+    WHERE operation_id=r AND condition=x->>'condition' AND basis=x->>'basis';
+  END IF;
+ END LOOP;
+ IF NOT EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=r AND completed_at IS NULL) THEN
+  PERFORM public.product_refresh_close(r);
+ END IF;
+ RETURN r;
+END $$;
