+            port=port,
+            database_url=SecretStr(db.url),
+            database_ownership_marker=SecretStr(db.ownership_marker),
+            auth_allow_loopback_http=True,
+            static_enabled=True,
+            web_build_dir=str(Path("apps/web/dist").resolve()),
+        )
+    )
+    app.dependency_overrides[dependency] = lambda: service
+    app.dependency_overrides[product_service] = lambda: s.product
+    server = uvicorn.Server(uvicorn.Config(app, access_log=False, log_level="error"))
+    thread = threading.Thread(target=lambda: server.run(sockets=[listener]), daemon=True)
+    thread.start()
+    try:
+        deadline = time.monotonic() + 20
+        while not server.started and thread.is_alive() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert server.started
+        result = subprocess.run(
+            ["node", "apps/web/e2e/contents-acceptance.mjs", f"http://127.0.0.1:{port}"],
