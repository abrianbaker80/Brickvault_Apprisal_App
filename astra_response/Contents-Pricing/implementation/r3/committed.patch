+CREATE FUNCTION contents_refresh_reconcile(p_id uuid) RETURNS boolean
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public AS $$
+DECLARE o public.product_refresh_operation; n timestamptz; invalid boolean=false; current_plan jsonb;
+BEGIN
+ PERFORM 1 FROM public.provider_scope_state WHERE id=(SELECT scope_id FROM public.provider_budget_group WHERE id=p_id) FOR UPDATE;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=p_id FOR UPDATE;
+ IF o.id IS NULL OR o.scope<>'CONTENTS' THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ IF o.state='CLOSED' THEN RETURN true; END IF;
+ n=public.product_refresh_clock();
+ IF o.execution_lease_until>n AND o.execution_token::text IS DISTINCT FROM current_setting('brickvault.product_token',true) THEN RETURN false; END IF;
+ BEGIN
+  PERFORM public.product_refresh_context(p_id);
+  current_plan=public.contents_refresh_plan(o.canonical_set_id,o.snapshot_id,(SELECT scope_id FROM public.provider_budget_group WHERE id=p_id),o.account_scope,o.plan_snapshot->'selection');
+  invalid=EXISTS(SELECT 1 FROM public.product_refresh_view v
+   JOIN LATERAL jsonb_array_elements(o.plan_snapshot->'views') old ON (old->>'target_id')::uuid=v.target_id AND old->>'condition'=v.condition AND old->>'basis'=v.basis
+   JOIN LATERAL jsonb_array_elements(current_plan->'views') fresh ON (fresh->>'target_id')::uuid=v.target_id AND fresh->>'condition'=v.condition AND fresh->>'basis'=v.basis
+   WHERE v.operation_id=p_id AND v.job_id IS NULL AND v.completed_at IS NULL AND old IS DISTINCT FROM fresh);
+ EXCEPTION WHEN check_violation THEN
+  IF SQLERRM NOT IN ('REPLAN_REQUIRED','INVALID_SELECTION','SELECTION_LIMIT','PLAN_SIZE_LIMIT') THEN RAISE; END IF;
+  invalid=true;
+ END;
+ IF NOT invalid AND o.expires_at>n THEN RETURN false; END IF;
+ -- A sent request is never refunded or resent. Wait for any live attempt fence.
+ IF EXISTS(SELECT 1 FROM public.provider_refresh_job WHERE budget_group=o.price_budget_group_id AND state='running' AND lease_until>n) THEN RETURN false; END IF;
+ UPDATE public.provider_fetch_run SET outcome='uncertain',finished_at=n,retryable=false
+ WHERE budget_group=o.price_budget_group_id AND outcome IN ('reserved','dispatched');
+ UPDATE public.provider_refresh_job SET state='blocked',failure='replan_required',updated_at=n,
+  lease_owner=NULL,lease_token=NULL,lease_until=NULL
+ WHERE budget_group=o.price_budget_group_id AND state IN ('queued','running','retry','deferred');
+ -- Joined jobs belong to their original operation and are never cancelled here.
+ UPDATE public.provider_budget_group SET closed_at=n WHERE (id=p_id OR parent_id=p_id) AND closed_at IS NULL;
+ UPDATE public.product_refresh_operation SET state='CLOSED',terminal_outcome=CASE WHEN o.expires_at<=n THEN 'EXPIRED' ELSE 'REPLAN_REQUIRED' END,
+  closed_at=n,pause_reason=NULL,execution_owner=NULL,execution_token=NULL,execution_lease_until=NULL WHERE id=p_id;
+ RETURN true;
+END $$;
