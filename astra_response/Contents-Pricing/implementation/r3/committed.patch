+CREATE FUNCTION contents_refresh_targets(p_set uuid,p_snapshot uuid,p_selection jsonb) RETURNS jsonb
+LANGUAGE plpgsql STABLE SET search_path=pg_catalog,public AS $$
+DECLARE rev public.catalog_inventory_revision; ids uuid[]; targets jsonb; extras boolean;
+BEGIN
+ IF jsonb_typeof(p_selection) IS DISTINCT FROM 'object' OR (p_selection-'revision_id'-'occurrences'-'include_extras'-'views')<>'{}'::jsonb
+ OR jsonb_typeof(p_selection->'occurrences') IS DISTINCT FROM 'array' OR jsonb_array_length(p_selection->'occurrences') NOT BETWEEN 1 AND 32
+ OR jsonb_typeof(p_selection->'include_extras') IS DISTINCT FROM 'boolean' OR jsonb_typeof(p_selection->'views') IS DISTINCT FROM 'array'
+ OR jsonb_array_length(p_selection->'views') NOT BETWEEN 1 AND 4 THEN
+ RAISE EXCEPTION 'INVALID_SELECTION' USING ERRCODE='23514'; END IF;
+ SELECT array_agg(x::uuid ORDER BY x) INTO ids FROM jsonb_array_elements_text(p_selection->'occurrences') x;
+ IF (SELECT count(DISTINCT x) FROM unnest(ids) x)<>cardinality(ids) OR
+ (SELECT count(DISTINCT x) FROM jsonb_array_elements(p_selection->'views') x)<>jsonb_array_length(p_selection->'views') OR
+ EXISTS(SELECT 1 FROM jsonb_array_elements(p_selection->'views') x WHERE
+ x NOT IN ('{"condition":"N","basis":"sold"}'::jsonb,'{"condition":"N","basis":"stock"}'::jsonb,
+ '{"condition":"U","basis":"sold"}'::jsonb,'{"condition":"U","basis":"stock"}'::jsonb)) THEN
+ RAISE EXCEPTION 'INVALID_SELECTION' USING ERRCODE='23514'; END IF;
+ extras=(p_selection->>'include_extras')::boolean;
+ SELECT * INTO rev FROM public.catalog_inventory_revision WHERE id=(p_selection->>'revision_id')::uuid
+ AND snapshot_id=p_snapshot AND set_id=p_set;
+ IF rev.id IS NULL OR NOT EXISTS(SELECT 1 FROM public.catalog_default_inventory WHERE snapshot_id=p_snapshot
+ AND set_id=p_set AND selection_state='selected' AND revision_id=rev.id) THEN
+ RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ IF (SELECT count(*) FROM public.catalog_inventory_line WHERE revision_id=rev.id AND id=ANY(ids)
+ AND COALESCE(minifigure_id,part_color_id) IS NOT NULL AND (regular_quantity>0 OR extras))<>cardinality(ids)
+ OR EXISTS(SELECT 1 FROM public.inventory_matching_candidate WHERE line_id=ANY(ids)) THEN
+ RAISE EXCEPTION 'INVALID_SELECTION' USING ERRCODE='23514'; END IF;
+ WITH selected AS (
+ SELECT COALESCE(l.minifigure_id,l.part_color_id) AS target_id,l.minifigure_id,l.part_color_id,l.part_id,l.color_id,
+ jsonb_agg(jsonb_build_object('id',l.id,'regular',l.regular_quantity,'extra',l.extra_quantity,'evidence_id',l.evidence_id) ORDER BY l.id) AS occurrences,
+ sum(l.regular_quantity)::bigint AS regular,sum(l.extra_quantity)::bigint AS extra
+ FROM public.catalog_inventory_line l WHERE l.revision_id=rev.id AND l.id=ANY(ids)
+ GROUP BY 1,2,3,4,5
+ ), resolved AS (
+ SELECT s.*, CASE WHEN (SELECT count(*) FROM public.market_mapping_revision m WHERE m.provider='bricklink'
+ AND m.closed_at IS NULL AND m.review_state='verified' AND COALESCE(m.minifigure_id,m.part_color_id)=s.target_id)=1
+ THEN (SELECT m.id FROM public.market_mapping_revision m WHERE m.provider='bricklink' AND m.closed_at IS NULL
+ AND m.review_state='verified' AND m.snapshot_id=p_snapshot AND m.source_version_id=rev.source_version_id
+ AND ((s.minifigure_id=m.minifigure_id AND m.item_type='MINIFIG' AND m.color_id IS NULL) OR
+ (s.part_color_id=m.part_color_id AND m.item_type='PART' AND s.part_id=m.part_id AND s.color_id=m.canonical_color_id AND m.color_id IS NOT NULL))) END AS mapping_id
+ FROM selected s)
+ SELECT COALESCE(jsonb_agg(jsonb_build_object('target_id',s.target_id,'minifigure_id',s.minifigure_id,
+ 'part_color_id',s.part_color_id,'part_id',s.part_id,'color_id',s.color_id,'occurrences',s.occurrences,
+ 'regular_quantity',s.regular,'extra_quantity',s.extra,'selected_quantity',s.regular+CASE WHEN extras THEN s.extra ELSE 0 END,
+ 'mapping_id',s.mapping_id,'item_type',CASE WHEN s.minifigure_id IS NOT NULL THEN 'MINIFIG' ELSE 'PART' END,
+ 'item_no',m.item_no,'provider_color',m.color_id) ORDER BY s.target_id),'[]'::jsonb)
+ INTO targets FROM resolved s LEFT JOIN public.market_mapping_revision m ON m.id=s.mapping_id;
+ IF jsonb_array_length(targets)>4 THEN RAISE EXCEPTION 'SELECTION_LIMIT' USING ERRCODE='23514'; END IF;
+ RETURN targets;
+END $$;
