+ FOR t IN SELECT * FROM jsonb_array_elements(p_plan->'targets') LOOP
+ INSERT INTO public.product_refresh_target(operation_id,target_id,mapping_id,snapshot_id,source_version_id,revision_id,minifigure_id,part_color_id,part_id,color_id,payload)
+ VALUES(r,(t->>'target_id')::uuid,(t->>'mapping_id')::uuid,snap,(p_plan->>'source_version_id')::uuid,(p_plan->'selection'->>'revision_id')::uuid,
+ (t->>'minifigure_id')::uuid,(t->>'part_color_id')::uuid,(t->>'part_id')::uuid,(t->>'color_id')::uuid,t);
+ END LOOP;
