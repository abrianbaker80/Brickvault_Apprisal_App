+def test_contents_stricter_freshness_and_target_retention(
+    contents_service: ContentsService, product: ProductHarness
+) -> None:
+    from datetime import timedelta
+
+    from brickvault_api.market.retention import purge
+
+    from .test_product_refresh import install_product_policy
+
+    s = contents_service
+    p = s.prepare("80000-1", selection("normal"))
+    op = s.confirm_selected(
+        "80000-1", ContentsConfirmation(selection=p.selection, confirmation=p.confirmation)
+    )
+    lease = s.acquire(op)
+    assert lease
+    s.repository.advance(lease, s.provider)
+    install_product_policy(product, fresh_seconds=60)
+    row = next(r for r in s.page("80000-1").rows if r.occurrence_id == key("normal"))
+    assert row.evidence[0].stale_after == product.market.clock() + timedelta(seconds=60)
+    product.advance_clock(61)
+    row = next(r for r in s.page("80000-1").rows if r.occurrence_id == key("normal"))
+    assert row.evidence[0].state == "stale" and row.evidence[0].unit_price is None
+    product.advance_clock(31 * 86400)
+    purge(product.market.owner, product.market.policy.id, uuid4())
+    with s.repository.database.connect() as c:
+        assert (
+            c.execute(
+                "SELECT 1 FROM product_refresh_target WHERE operation_id=%s", (op,)
+            ).fetchone()
+            is None
+        )
