+CREATE OR REPLACE FUNCTION product_refresh_view_guard() RETURNS trigger LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE o public.product_refresh_operation; k public.provider_cache_entry; j public.provider_refresh_job;
+ obs public.market_observation; a public.provider_fetch_run; planned jsonb;
+BEGIN
+ IF (NEW.operation_id,NEW.condition,NEW.basis) IS DISTINCT FROM (OLD.operation_id,OLD.condition,OLD.basis) THEN
+  RAISE EXCEPTION 'PRODUCT_VIEW_IDENTITY_IMMUTABLE' USING ERRCODE='23514'; END IF;
+ IF public.product_refresh_is_owner() AND
+   (to_jsonb(NEW)-'cache_id'-'job_id'-'admitted_generation'-'current_generation'-'bound_budget_group'-'fetch_id'-'observation_id')=
+   (to_jsonb(OLD)-'cache_id'-'job_id'-'admitted_generation'-'current_generation'-'bound_budget_group'-'fetch_id'-'observation_id')
+   AND (NEW.cache_id IS NULL OR NEW.cache_id IS NOT DISTINCT FROM OLD.cache_id)
+   AND (NEW.job_id IS NULL OR (NEW.job_id,NEW.admitted_generation,NEW.current_generation,NEW.bound_budget_group)
+       IS NOT DISTINCT FROM (OLD.job_id,OLD.admitted_generation,OLD.current_generation,OLD.bound_budget_group))
+   AND (NEW.fetch_id IS NULL OR NEW.fetch_id IS NOT DISTINCT FROM OLD.fetch_id)
+   AND (NEW.observation_id IS NULL OR NEW.observation_id IS NOT DISTINCT FROM OLD.observation_id) THEN
+  RETURN NEW; -- Owner maintenance may only clear references, never replace content.
+ END IF;
+ IF OLD.completed_at IS NOT NULL THEN RAISE EXCEPTION 'PRODUCT_VIEW_COMPLETED' USING ERRCODE='23514'; END IF;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=NEW.operation_id;
+ IF o.state='CLOSED' THEN RAISE EXCEPTION 'PRODUCT_OPERATION_CLOSED' USING ERRCODE='23514'; END IF;
+ IF OLD.cache_id IS NULL THEN
+  IF NOT public.product_refresh_is_owner() THEN PERFORM public.product_refresh_owned(o.id); END IF;
+ ELSIF (NEW.cache_id,NEW.job_id,NEW.admitted_generation,NEW.bound_budget_group)
+   IS DISTINCT FROM (OLD.cache_id,OLD.job_id,OLD.admitted_generation,OLD.bound_budget_group) THEN
+  RAISE EXCEPTION 'PRODUCT_VIEW_ASSOCIATION_IMMUTABLE' USING ERRCODE='23514';
+ END IF;
+ SELECT * INTO k FROM public.provider_cache_entry WHERE id=NEW.cache_id;
+ IF k.id IS NULL OR (k.mapping_id,k.account_scope,k.item_type,k.color_id,k.condition,k.basis,k.currency,k.country,k.region,k.adapter_version,k.normalization_version)
+  IS DISTINCT FROM (o.resolved_mapping_id,o.account_scope,'SET'::varchar,NULL::integer,NEW.condition,NEW.basis,'USD'::varchar,'US'::varchar,NULL::varchar,
+   'bricklink-offline-3a-v1'::varchar,'market-evidence-v1'::varchar)
+  OR k.scope_id IS DISTINCT FROM (SELECT scope_id FROM public.provider_budget_group WHERE id=o.id) THEN
+  RAISE EXCEPTION 'PRODUCT_VIEW_BINDING' USING ERRCODE='23514'; END IF;
+ SELECT x INTO planned FROM jsonb_array_elements(o.plan_snapshot->'views') x
+  WHERE x->>'condition'=NEW.condition AND x->>'basis'=NEW.basis;
+ IF NEW.job_id IS NOT NULL THEN
+  SELECT * INTO j FROM public.provider_refresh_job WHERE id=NEW.job_id;
+  IF (j.cache_id,j.generation,j.budget_group) IS DISTINCT FROM (NEW.cache_id,NEW.current_generation,NEW.bound_budget_group) THEN
+   RAISE EXCEPTION 'UNRELATED_JOB_GENERATION' USING ERRCODE='23514'; END IF;
+  IF OLD.job_id IS NULL AND ((planned->>'action' IN ('JOIN','BLOCKED')
+    AND (NEW.job_id::text,NEW.admitted_generation,NEW.bound_budget_group::text)
+       IS DISTINCT FROM (planned->>'job_id',(planned->>'generation')::bigint,planned->>'budget_group'))
+    OR planned->>'action'='REUSE') THEN RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+  IF NEW.current_generation IS DISTINCT FROM OLD.current_generation AND OLD.current_generation IS NOT NULL
+    AND (NOT public.product_refresh_is_owner() OR NEW.current_generation<>OLD.current_generation+1) THEN
+   RAISE EXCEPTION 'UNRELATED_JOB_GENERATION' USING ERRCODE='23514'; END IF;
+ END IF;
+ IF NEW.completed_at IS NOT NULL THEN
+  IF NEW.completed_at<o.confirmed_at OR NEW.completed_at>public.product_refresh_clock()
+    OR (NEW.job_id IS NOT NULL AND NEW.completed_generation IS DISTINCT FROM NEW.current_generation) THEN
+   RAISE EXCEPTION 'PRODUCT_COMPLETION_BINDING' USING ERRCODE='23514'; END IF;
+  IF NEW.completion_kind='FAILED' THEN
+   IF NEW.job_id IS NULL OR (j.state NOT IN ('failed','blocked','suspended') AND NOT (
+     j.state='succeeded' AND EXISTS(SELECT 1 FROM public.market_observation evidence
+       JOIN public.provider_fetch_run attempt ON attempt.id=evidence.fetch_id WHERE evidence.id=NEW.observation_id
+        AND evidence.id=j.result_id AND evidence.availability='unavailable' AND evidence.cache_id=NEW.cache_id
+        AND attempt.id=NEW.fetch_id AND attempt.job_id=j.id AND attempt.generation=NEW.current_generation
+        AND attempt.budget_group=NEW.bound_budget_group AND attempt.outcome='succeeded'))) THEN
+    RAISE EXCEPTION 'PRODUCT_COMPLETION_BINDING' USING ERRCODE='23514'; END IF;
+  ELSE
+   SELECT * INTO obs FROM public.market_observation WHERE id=NEW.observation_id;
+   IF obs.id IS NULL OR obs.cache_id<>NEW.cache_id THEN
+    RAISE EXCEPTION 'PRODUCT_COMPLETION_BINDING' USING ERRCODE='23514'; END IF;
+   IF NEW.completion_kind IS DISTINCT FROM (CASE WHEN obs.availability='confirmed_empty' THEN 'CONFIRMED_EMPTY'
+     WHEN obs.availability='available' AND NEW.job_id IS NULL THEN 'REUSED_CACHE'
+     WHEN obs.availability='available' THEN 'PRICED' ELSE 'FAILED' END) THEN
+    RAISE EXCEPTION 'PRODUCT_COMPLETION_BINDING' USING ERRCODE='23514'; END IF;
+   IF NEW.job_id IS NULL THEN
+    IF obs.id IS DISTINCT FROM k.current_observation_id OR public.product_refresh_cache_state(obs.id,o.market_policy_id) NOT IN ('fresh','confirmed_empty') THEN
+     RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+   ELSE
+    SELECT * INTO a FROM public.provider_fetch_run WHERE id=NEW.fetch_id;
+    IF (a.job_id,a.generation,a.budget_group,a.observation_id,a.outcome)
+      IS DISTINCT FROM (NEW.job_id,NEW.current_generation,NEW.bound_budget_group,obs.id,'succeeded'::varchar)
+      OR j.state<>'succeeded' OR j.result_id IS DISTINCT FROM obs.id THEN
+     RAISE EXCEPTION 'PRODUCT_COMPLETION_BINDING' USING ERRCODE='23514'; END IF;
+   END IF;
+  END IF;
+ END IF;
+ RETURN NEW;
+END $$;
