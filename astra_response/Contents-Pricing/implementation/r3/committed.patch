+from .market.repository import MarketRepository
+from .providers.bricklink.requests import Basis, Condition
+from .refresh import RefreshService
+from .refresh_models import RefreshConfirmation
+from .valuation.arithmetic import display
+from .valuation.evidence import mapped_contribution, request_for
+from .valuation.models import DEFAULT_POLICY, Contribution, EvidenceInput, MarketView, Occurrence
+
+
+def target_summary(t: dict[str, Any]) -> ContentsTarget:
+    return ContentsTarget(
+        **{k: t[k] for k in ContentsTarget.model_fields if k != "mapping"},
+        mapping="VERIFIED" if t["mapping_id"] else "UNRESOLVED",
+    )
+
+
+class ContentsService(RefreshService):
+    operation_scope = "CONTENTS"
+
+    def page(
+        self, number: str, revision_id: UUID | None = None, cursor: UUID | None = None
+    ) -> ContentsPage:
+        now = self.product.clock()
+        with self.product.catalog() as catalog:
+            matches = catalog.resolve_set_number(number)
+            if matches.state != QueryState.OK:
+                raise CatalogError("set_unknown")
+            metadata = catalog.get_set(matches.data[0].identity.id).data
+            assert metadata
+            revision = metadata.default.revision_id
+            if revision_id is not None and revision_id != revision:
+                raise ProductRefreshError("REPLAN_REQUIRED")
+            if cursor and revision_id is None:
+                raise ProductRefreshError("REPLAN_REQUIRED")
+            inventory = catalog.get_inventory(revision).data if revision else None
+            lines = sorted(inventory.lines, key=lambda line: str(line.id)) if inventory else []
+            selected = [line for line in lines if cursor is None or str(line.id) > str(cursor)][:51]
+            rows: list[ContentsRow] = []
+            with read_transaction(
+                self.product.database, self.product.connection, repeatable=True
+            ) as c:
+                ids = list({line.target.id for line in selected[:50]})
+                mappings = c.execute(
+                    """SELECT * FROM market_mapping_revision WHERE provider='bricklink'
+                    AND closed_at IS NULL AND review_state='verified'
+                    AND COALESCE(minifigure_id,part_color_id)=ANY(%s::uuid[])""",
+                    (ids,),
+                ).fetchall()
+                repository = MarketRepository(
+                    self.product.database, clock=lambda: now, connection=c
+                )
+                for line in selected[:50]:
+                    identity = c.execute(
+                        """SELECT namespace,identifier FROM catalog_minifigure WHERE id=%s
+                        UNION ALL SELECT namespace,identifier FROM catalog_part WHERE id=%s
+                        UNION ALL SELECT namespace,identifier FROM catalog_set WHERE id=%s""",
+                        (
+                            line.target.id if line.target.kind == "minifigure" else None,
+                            line.part_id,
+                            line.target.id if line.target.kind == "nested_set" else None,
+                        ),
+                    ).fetchone()
+                    color = (
+                        c.execute(
+                            "SELECT namespace,identifier FROM catalog_color WHERE id=%s",
+                            (line.color_id,),
+                        ).fetchone()
+                        if line.color_id
+                        else None
+                    )
+                    candidates = [
+                        m
+                        for m in mappings
+                        if (m["minifigure_id"] or m["part_color_id"]) == line.target.id
+                    ]
+                    mapping = None
+                    if len(candidates) == 1:
+                        m = candidates[0]
+                        if (
+                            m["snapshot_id"] == catalog.snapshot.id
+                            and m["source_version_id"] == catalog.snapshot.source_version_id
+                            and (
+                                (
+                                    line.target.kind == "minifigure"
+                                    and m["item_type"] == "MINIFIG"
+                                    and m["color_id"] is None
+                                )
+                                or (
+                                    line.target.kind == "part_color"
+                                    and m["item_type"] == "PART"
+                                    and m["part_id"] == line.part_id
+                                    and m["canonical_color_id"] == line.color_id
+                                    and m["color_id"] is not None
+                                )
+                            )
+                        ):
+                            mapping = MappingRevision.model_validate(
+                                {k: m[k] for k in MappingRevision.model_fields}
+                            )
+                    supported = (
+                        line.target.kind in ("minifigure", "part_color")
+                        and line.choice is None
+                        and line.target_state == "known"
+                    )
+                    evidence = []
+                    for condition in Condition:
+                        for basis in Basis:
+                            e = ContentsEvidence(
+                                condition=condition.value,
+                                basis=basis.value,
+                                state="unresolved_mapping",
+                            )
+                            if mapping and self.account:
+                                view = MarketView(condition, basis, self.account)
+                                request = request_for(mapping, view)
+                                cache = repository.read_only_lookup(
+                                    mapping.id,
+                                    request,
+                                    adapter_version=view.adapter_version,
+                                    normalization_version=view.normalization_version,
+                                )
+                                occurrence = Occurrence(
+                                    "minifigure"
+                                    if mapping.item_type == "MINIFIG"
+                                    else "part_color",
+                                    line.target.id,
+                                    1,
+                                    part_id=line.part_id,
+                                    color_id=line.color_id,
+                                )
+                                result = mapped_contribution(
+                                    Contribution(
+                                        occurrence,
+                                        view,
+                                        DEFAULT_POLICY.statistic,
+                                        EvidenceState.MAPPING,
+                                        (),
+                                        False,
+                                    ),
+                                    mapping,
+                                    view,
+                                    DEFAULT_POLICY,
+                                    now,
+                                    [EvidenceInput(mapping, view, request, cache)],
+                                )
+                                obs: dict[str, Any] = dict(cache.observation or {})
+                                fresh_until = obs.get("fresh_until")
+                                until = (
+                                    min(
+                                        t
+                                        for t in (
+                                            obs.get("display_eligible_until"),
+                                            obs.get("retained_until"),
+                                        )
+                                        if t is not None
+                                    )
+                                    if obs
+                                    else None
+                                )
+                                if obs and cache.eligibility_policy:
+                                    from .market.policy import deadlines
+
+                                    current = deadlines(
+                                        cache.eligibility_policy,
+                                        obs["request_started_at"],
+                                        obs["fetched_at"],
+                                        empty=obs["availability"] == "confirmed_empty",
+                                    )
+                                    until = min(until, current[1], current[2]) if until else None
+                                    fresh_until = (
+                                        min(fresh_until, current[0]) if fresh_until else None
+                                    )
+                                amount = display(result.unit_amount, "USD")
+                                e = ContentsEvidence(
+                                    condition=condition.value,
+                                    basis=basis.value,
+                                    state=result.state.value,
+                                    unit_price=str(amount) if amount is not None else None,
+                                    fetched_at=obs.get("fetched_at"),
+                                    stale_after=fresh_until,
+                                    display_until=until,
+                                    window=obs.get("window_description"),
+                                    sample_count=obs.get("sold_occurrence_count")
+                                    if basis == Basis.SOLD
+                                    else obs.get("active_inventory_count"),
+                                    refresh_state=cache.refresh_state,
+                                )
+                            elif mapping:
+                                e = e.model_copy(update={"state": "unavailable"})
+                            evidence.append(e)
+                    rows.append(
+                        ContentsRow(
+                            occurrence_id=line.id,
+                            target_id=line.target.id,
+                            kind=line.target.kind,
+                            identity=f"{identity['namespace']}:{identity['identifier']}"
+                            if identity
+                            else "Unresolved catalog identity",
+                            color=f"{color['namespace']}:{color['identifier']}" if color else None,
+                            regular_quantity=line.quantity.regular,
+                            extra_quantity=line.quantity.extra,
+                            selectable=supported,
+                            reason=None
+                            if supported
+                            else "unsupported_nested_or_alternate_inventory",
+                            mapping="VERIFIED" if mapping else "UNRESOLVED",
+                            provider_identity=f"BrickLink {mapping.item_type} {mapping.item_no}"
+                            + (f" color {mapping.color_id}" if mapping.color_id is not None else "")
+                            if mapping
+                            else None,
+                            evidence=evidence,
+                        )
+                    )
+            return ContentsPage(
+                set_number=metadata.match.identity.identifier,
+                snapshot_id=catalog.snapshot.id,
+                revision_id=revision,
+                rows=rows,
+                total_recorded_rows=len(lines),
+                next_cursor=selected[49].id if len(selected) > 50 else None,
+                inventory_state="recorded" if inventory else "unavailable",
+                as_of=now,
+            )
+
+    def selected_plan(self, number: str, selection: ContentsSelection) -> dict[str, Any]:
+        sid, snapshot = self.identity(number)
+        if self.account is None:
+            raise ProductRefreshError("PROVIDER_UNAVAILABLE")
+        with product_errors(), self.repository.database.connect() as c, c.transaction():
+            c.execute("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY")
+            scope = c.execute(
+                "SELECT id FROM provider_scope_state WHERE provider='bricklink'"
+            ).fetchone()
+            if not scope:
+                raise ProductRefreshError("PROVIDER_UNAVAILABLE")
+            row = c.execute(
+                "SELECT contents_refresh_plan(%s,%s,%s,%s,%s) AS plan,product_refresh_now() AS created_at",
+                (sid, snapshot, scope["id"], self.account, Jsonb(selection.normalized())),
+            ).fetchone()
+            assert row
+            return row
+
+    def prepare(self, number: str, selection: ContentsSelection) -> ContentsPlan:
+        raw = self.selected_plan(number, selection)
+        p = raw["plan"]
+        count = p["authorized_price_initials"]
+        receipt = RefreshConfirmation(
+            key=uuid4(), digest=digest(p), created_at=raw["created_at"], signature="0" * 64
+        )
+        receipt = receipt.model_copy(
+            update={"signature": self.signature(receipt, UUID(p["canonical_set_id"]))}
+        )
+        state, cooldown = self.availability(UUID(p["scope_id"]), count, count)
+        if count > 4:
+            state = "PRICE_LIMIT"
+        elif all(v["action"] == "BLOCKED" for v in p["views"]):
+            state = "MAPPING_UNRESOLVED"
+        elif not count:
+            state = (
+                "ALREADY_CURRENT" if all(v["action"] == "REUSE" for v in p["views"]) else "READY"
+            )
+        return ContentsPlan(
+            set_number=p["normalized_set_number"],
+            selection=selection,
+            targets=[target_summary(t) for t in p["targets"]],
+            views=[
+                ContentsPlannedView(**{k: v[k] for k in ContentsPlannedView.model_fields})
+                for v in p["views"]
+            ],
+            price_initials=count,
+            retry_reserve=2 if count else 0,
+            maximum_attempts=p["maximum_attempts"],
+            state=state,
+            admissible=state in ("READY", "ALREADY_CURRENT"),
+            confirmation=receipt,
+            expires_at=receipt.created_at + timedelta(minutes=15),
+            cooldown_until=cooldown,
+        )
+
+    def _contents_receipt_operation(self, set_id: UUID, body: ContentsConfirmation) -> UUID | None:
+        existing = self._receipt_operation(set_id, body.confirmation)
+        if existing:
+            raw = self.repository.status(existing)
+            if raw["operation"]["plan_snapshot"]["selection"] != body.selection.normalized():
+                raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+        return existing
+
+    def confirm_selected(self, number: str, body: ContentsConfirmation) -> UUID:
+        sid, _ = self.identity(number)
+        receipt = body.confirmation
+        existing = self._contents_receipt_operation(sid, body)
+        if existing:
+            return existing
+        if not hmac.compare_digest(receipt.signature, self.signature(receipt, sid)):
+            raise ProductRefreshError("REPLAN_REQUIRED")
+        try:
+            return self._confirm_selected_new(number, body)
+        except ProductRefreshError:
+            # A duplicate can commit and advance after the initial receipt miss.
+            # Recover only its exact receipt and normalized selection, even if terminal.
+            existing = self._contents_receipt_operation(sid, body)
+            if existing:
+                return existing
+            raise
+
+    def _confirm_selected_new(self, number: str, body: ContentsConfirmation) -> UUID:
+        receipt = body.confirmation
+        raw = self.selected_plan(number, body.selection)
+        p = raw["plan"]
+        if digest(p) != receipt.digest:
+            raise ProductRefreshError("REPLAN_REQUIRED")
+        count = p["authorized_price_initials"]
+        if count > 4:
+            raise ProductRefreshError("PRICE_LIMIT")
+        state, _ = self.availability(UUID(p["scope_id"]), count, count)
+        if count and state != "READY":
+            raise ProductRefreshError(state)
+        with product_errors(), self.repository.database.connect() as c, c.transaction():
+            row = c.execute(
+                "SELECT contents_refresh_confirm(%s,%s,%s,%s) AS id",
+                (Jsonb(p), receipt.key, receipt.created_at, receipt.digest),
+            ).fetchone()
+            assert row
+            return UUID(str(row["id"]))
+
+    def contents_status(self, operation_id: UUID) -> ContentsStatus:
+        raw = self.repository.status(operation_id)
+        op = raw["operation"]
+        used = raw["usage"]
+        now = self.repository.clock()
+        terminal = op["state"] == "CLOSED"
+        running = bool(
+            not terminal and op["execution_lease_until"] and op["execution_lease_until"] > now
+        )
+        state = (
+            op["terminal_outcome"]
+            or op["pause_reason"]
+            or ("REFRESHING" if running else "WORK_PENDING")
+        )
+        _, cooldown = self.availability(raw["root"]["scope_id"], 0, 0)
+        if not terminal:
+            try:
+                with product_errors(), self.repository.database.connect() as c, c.transaction():
+                    c.execute("SET TRANSACTION READ ONLY")
+                    c.execute("SELECT product_refresh_context(%s)", (operation_id,))
+            except ProductRefreshError:
+                state = "REPLAN_REQUIRED"
+            if op["expires_at"] <= now:
+                state = "EXPIRED"
+        return ContentsStatus(
+            operation_id=operation_id,
+            set_number=op["normalized_set_number"],
+            state=state,
+            terminal=terminal,
+            running=running,
+            resumable=not terminal and not running,
+            attempts_consumed=used["total"],
+            maximum_attempts=op["plan_snapshot"]["maximum_attempts"],
+            retries=used["retries"],
+            complete_views=sum(v["completed_at"] is not None for v in raw["views"]),
+            total_views=len(raw["views"]),
+            selected_quantity=sum(t["selected_quantity"] for t in op["plan_snapshot"]["targets"]),
+            targets=[target_summary(t) for t in op["plan_snapshot"]["targets"]],
+            views=[
+                ContentsProgress(
+                    target_id=v["target_id"],
+                    condition=v["condition"],
+                    basis=v["basis"],
+                    state=v["completion_kind"] or "PENDING",
+                    failure=v["failure_code"],
+                )
+                for v in raw["views"]
+            ],
+            cooldown_until=cooldown,
+        )
+
+    def active_contents(self, number: str) -> ContentsStatus | None:
+        sid, _ = self.identity(number)
+        with self.repository.database.connect() as c:
+            row = c.execute(
+                "SELECT id FROM product_refresh_operation WHERE canonical_set_id=%s AND scope='CONTENTS' ORDER BY confirmed_at DESC,id DESC LIMIT 1",
+                (sid,),
+            ).fetchone()
+        return self.contents_status(row["id"]) if row else None
