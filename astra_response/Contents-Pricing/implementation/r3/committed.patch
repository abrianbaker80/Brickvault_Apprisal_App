+CREATE OR REPLACE FUNCTION product_refresh_job_authorization() RETURNS trigger LANGUAGE plpgsql
+ SET search_path=pg_catalog,public AS $$
+DECLARE g public.provider_budget_group; o public.product_refresh_operation; j public.provider_refresh_job;
+BEGIN
+ SELECT * INTO j FROM public.provider_refresh_job WHERE id=NEW.id;
+ IF j.id IS NULL THEN RETURN NULL; END IF;
+ SELECT * INTO g FROM public.provider_budget_group WHERE id=j.budget_group;
+ IF g.operation_type IS DISTINCT FROM 'PRODUCT_SET_REFRESH' THEN RETURN NULL; END IF;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=COALESCE(g.parent_id,g.id);
+ IF o.id IS NULL OR j.budget_group<>o.price_budget_group_id OR NOT EXISTS(
+  SELECT 1 FROM public.product_refresh_view v WHERE v.operation_id=o.id AND v.cache_id=j.cache_id
+   AND v.job_id=j.id AND v.current_generation=j.generation AND v.bound_budget_group=j.budget_group) THEN
+  RAISE EXCEPTION 'PRODUCT_JOB_NOT_AUTHORIZED' USING ERRCODE='23514'; END IF;
+ RETURN NULL;
+END $$;
