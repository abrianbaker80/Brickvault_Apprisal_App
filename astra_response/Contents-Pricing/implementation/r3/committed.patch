diff --git a/apps/web/src/contents-api.ts b/apps/web/src/contents-api.ts
new file mode 100644
index 0000000..4fc9e49
--- /dev/null
+++ b/apps/web/src/contents-api.ts
@@ -0,0 +1,77 @@
+import createClient from 'openapi-fetch';
+import type { components, paths } from '@brickvault/contracts';
+import { sessionFetch } from './session-client';
+import { RefreshError } from './refresh-api';
+
+export type ContentsPage = components['schemas']['ContentsPage'];
+export type ContentsSelection = components['schemas']['ContentsSelection'];
+export type ContentsPlan = components['schemas']['ContentsPlan'];
+export type ContentsStatus = components['schemas']['ContentsStatus'];
+const client = createClient<paths>({ fetch: sessionFetch });
+function result<T>(data: T | undefined, error: unknown): T {
+  if (data !== undefined) return data;
+  if (error && typeof error === 'object' && 'code' in error && typeof error.code === 'string')
+    throw new RefreshError(error.code, 'operation_id' in error ? String(error.operation_id) : null);
+  throw new RefreshError('PROVIDER_UNAVAILABLE');
+}
+function options(signal?: AbortSignal) {
+  return {
+    cache: 'no-store' as const,
+    redirect: 'error' as const,
+    signal: signal
+      ? AbortSignal.any([signal, AbortSignal.timeout(30000)])
+      : AbortSignal.timeout(30000),
+  };
+}
+export async function contentsPage(
+  set_number: string,
+  revision_id?: string,
+  cursor?: string,
+  signal?: AbortSignal,
+) {
+  const { data, error } = await client.GET('/api/sets/{set_number}/contents', {
+    params: {
+      path: { set_number },
+      query: { revision_id: revision_id ?? null, cursor: cursor ?? null },
+    },
+    ...options(signal),
+  });
+  return result(data, error);
+}
+export async function planContents(set_number: string, body: ContentsSelection) {
+  const { data, error } = await client.POST('/api/sets/{set_number}/contents-market-refresh/plan', {
+    params: { path: { set_number } },
+    body,
+    ...options(),
+  });
+  return result(data, error);
+}
+export async function confirmContents(set_number: string, plan: ContentsPlan) {
+  const { data, error } = await client.POST('/api/sets/{set_number}/contents-market-refresh', {
+    params: { path: { set_number } },
+    body: { selection: plan.selection, confirmation: plan.confirmation },
+    ...options(),
+  });
+  return result(data, error);
+}
+export async function activeContents(set_number: string, signal?: AbortSignal) {
+  const { data, error } = await client.GET('/api/sets/{set_number}/contents-market-refresh', {
+    params: { path: { set_number } },
+    ...options(signal),
+  });
+  return result(data, error);
+}
+export async function contentsStatus(operation_id: string, signal?: AbortSignal) {
+  const { data, error } = await client.GET('/api/contents-market-refresh/{operation_id}', {
+    params: { path: { operation_id } },
+    ...options(signal),
+  });
+  return result(data, error);
+}
+export async function resumeContents(operation_id: string) {
+  const { data, error } = await client.POST('/api/contents-market-refresh/{operation_id}/resume', {
+    params: { path: { operation_id } },
+    ...options(),
+  });
+  return result(data, error);
+}
