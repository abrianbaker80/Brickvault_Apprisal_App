+        assert result.returncode == 0, result.stdout + result.stderr
+        print(result.stdout)
+        operation = service.active_contents("80000-1")
+        assert operation and operation.terminal and operation.attempts_consumed == 2
+    finally:
+        server.should_exit = True
+        thread.join(timeout=10)
+        listener.close()
+        assert not thread.is_alive()
