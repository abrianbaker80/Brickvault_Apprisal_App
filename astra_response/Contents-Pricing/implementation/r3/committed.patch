+    for _ in range(4):
+        product.app.advance(legacy_lease, s.provider)
+        product.advance_clock(5)
+    original = product.app.status(legacy)["operation"]
+    with s.repository.database.connect() as c:
+        with pytest.raises(psycopg.errors.InsufficientPrivilege), c.transaction():
+            c.execute("DELETE FROM product_refresh_target")
+    engine = create_database_engine(product.market.owner.database.url, "test", "owner")
+    with s.repository.database.connect() as c:
+        role = c.execute("SELECT current_user AS name").fetchone()
+    assert role
+    try:
+        with engine.begin() as c:
+            config = migration_config()
+            config.attributes["connection"] = c
+            command.downgrade(config, "0019_reviewed_dataset_foundation")
+            command.upgrade(config, "head")
+            grant_runtime(c, role["name"])
+            assert (
+                c.scalar(text("SELECT version_num FROM alembic_version"))
+                == "0020_contents_market_refresh"
+            )
+        product.advance_clock()
+        restored = product.app.status(legacy)["operation"]
+        assert restored == original
+        p = s.prepare("80000-1", selection("normal"))
+        s.confirm_selected(
