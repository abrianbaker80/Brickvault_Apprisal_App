+"""Safe selected contents contracts; no provider account or raw evidence fields."""
+
+from datetime import datetime
+from typing import Literal
+from uuid import UUID
+
+from pydantic import Field, model_validator
+
+from .product import PublicModel
+from .refresh_models import RefreshConfirmation
+
+
+class ContentsView(PublicModel):
+    condition: Literal["N", "U"]
+    basis: Literal["sold", "stock"]
+
+
+class ContentsSelection(PublicModel):
+    revision_id: UUID
+    occurrences: list[UUID] = Field(min_length=1, max_length=32)
+    include_extras: bool = False
+    views: list[ContentsView] = Field(min_length=1, max_length=4)
+
+    @model_validator(mode="after")
+    def unique(self) -> "ContentsSelection":
+        if len(set(self.occurrences)) != len(self.occurrences) or len(
+            {(v.condition, v.basis) for v in self.views}
+        ) != len(self.views):
+            raise ValueError("duplicate_selection")
+        return self
+
+    def normalized(self) -> dict[str, object]:
+        return {
+            "revision_id": str(self.revision_id),
+            "occurrences": sorted(str(i) for i in self.occurrences),
+            "include_extras": self.include_extras,
+            "views": [
+                v.model_dump() for v in sorted(self.views, key=lambda v: (v.condition, v.basis))
+            ],
+        }
+
+
+class ContentsEvidence(ContentsView):
+    state: str
+    unit_price: str | None = None
+    currency: Literal["USD"] = "USD"
+    statistic: Literal["quantity_weighted_average"] = "quantity_weighted_average"
+    fetched_at: datetime | None = None
+    stale_after: datetime | None = None
+    display_until: datetime | None = None
+    window: str | None = None
+    sample_count: int | None = None
+    refresh_state: str = "idle"
+
+
+class ContentsRow(PublicModel):
+    occurrence_id: UUID
+    target_id: UUID
+    kind: str
+    identity: str
+    color: str | None = None
+    regular_quantity: int
+    extra_quantity: int
+    selectable: bool
+    reason: str | None
+    mapping: Literal["VERIFIED", "UNRESOLVED"]
+    provider_identity: str | None = None
+    evidence: list[ContentsEvidence]
+
+
+class ContentsPage(PublicModel):
+    set_number: str
+    snapshot_id: UUID
+    revision_id: UUID | None
+    rows: list[ContentsRow]
+    total_recorded_rows: int
+    next_cursor: UUID | None = None
+    inventory_state: str
+    as_of: datetime
+    physical_contents_verified: Literal[False] = False
+
+
+class ContentsPlannedView(ContentsView):
+    target_id: UUID
+    action: Literal["REUSE", "JOIN", "FETCH", "BLOCKED"]
+    cache_state: str
+
+
+class ContentsTarget(PublicModel):
+    target_id: UUID
+    item_type: Literal["MINIFIG", "PART"]
+    item_no: str | None
+    provider_color: int | None
+    regular_quantity: int
+    extra_quantity: int
+    selected_quantity: int
+    mapping: Literal["VERIFIED", "UNRESOLVED"]
+
+
+class ContentsPlan(PublicModel):
+    set_number: str
+    selection: ContentsSelection
+    targets: list[ContentsTarget]
+    views: list[ContentsPlannedView]
+    identity_initials: Literal[0] = 0
+    price_initials: int
+    retry_reserve: int
+    maximum_attempts: int
+    state: str
+    admissible: bool
+    confirmation: RefreshConfirmation
+    expires_at: datetime
+    cooldown_until: datetime | None = None
+
+
+class ContentsConfirmation(PublicModel):
+    selection: ContentsSelection
+    confirmation: RefreshConfirmation
+
+
+class ContentsProgress(ContentsView):
+    target_id: UUID
+    state: str
+    failure: str | None
+
+
+class ContentsStatus(PublicModel):
+    operation_id: UUID
+    set_number: str
+    state: str
+    terminal: bool
+    running: bool
+    resumable: bool
+    attempts_consumed: int
+    maximum_attempts: int
+    retries: int
+    complete_views: int
+    total_views: int
+    selected_quantity: int
+    targets: list[ContentsTarget]
+    views: list[ContentsProgress]
+    cooldown_until: datetime | None = None
