diff --git a/apps/web/src/useRefreshWorkflow.ts b/apps/web/src/useRefreshWorkflow.ts
new file mode 100644
index 0000000..6f3c0c2
--- /dev/null
+++ b/apps/web/src/useRefreshWorkflow.ts
@@ -0,0 +1,126 @@
+import { useEffect, useRef, useState } from 'react';
+import { RefreshError } from './refresh-api';
+
+export function useRefreshWorkflow<
+  P,
+  S extends { operation_id: string; terminal: boolean; running: boolean },
+>(
+  number: string | null,
+  reload: () => void,
+  api: {
+    active: (number: string, signal?: AbortSignal) => Promise<S | null>;
+    status: (id: string, signal?: AbortSignal) => Promise<S>;
+    message?: (code: string) => string;
+  },
+) {
+  const [plan, setPlan] = useState<P | null>(null);
+  const [operation, setOperation] = useState<S | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [progressUnknown, setProgressUnknown] = useState(false);
+  const planHeading = useRef<HTMLHeadingElement>(null);
+  const planTrigger = useRef<HTMLButtonElement>(null);
+  const locked = useRef(false);
+  const mounted = useRef(true);
+  const actionGeneration = useRef(0);
+  const completed = useRef<string | null>(null);
+  const reloadRef = useRef(reload);
+  useEffect(() => {
+    reloadRef.current = reload;
+  }, [reload]);
+  useEffect(() => {
+    if (plan) planHeading.current?.focus();
+  }, [plan]);
+  useEffect(() => {
+    mounted.current = true;
+    if (!number) return;
+    const controller = new AbortController();
+    const generation = actionGeneration.current;
+    void api
+      .active(number, controller.signal)
+      .then((value) => {
+        if (!controller.signal.aborted && generation === actionGeneration.current)
+          setOperation(value);
+      })
+      .catch(() => {
+        /* Appraisal remains usable if refresh is not configured. */
+      });
+    return () => {
+      mounted.current = false;
+      controller.abort();
+    };
+  }, [number, api]);
+  useEffect(() => {
+    if (!operation) return;
+    if (operation.terminal) {
+      if (completed.current !== operation.operation_id) {
+        completed.current = operation.operation_id;
+        reloadRef.current();
+      }
+      return;
+    }
+    if (!operation.running || progressUnknown) return;
+    const controller = new AbortController();
+    const timer = window.setTimeout(() => {
+      void api
+        .status(operation.operation_id, controller.signal)
+        .then((value) => {
+          if (!controller.signal.aborted) setOperation(value);
+        })
+        .catch(() => {
+          if (!controller.signal.aborted) {
+            setError('Progress is temporarily unavailable. Recheck progress before resuming.');
+            setProgressUnknown(true);
+          }
+        });
+    }, 1000);
+    return () => {
+      window.clearTimeout(timer);
+      controller.abort();
+    };
+  }, [operation, progressUnknown, api]);
+  async function act(work: () => Promise<void>) {
+    if (locked.current) return;
+    actionGeneration.current += 1;
+    locked.current = true;
+    setBusy(true);
+    setError('');
+    try {
+      await work();
+    } catch (cause) {
+      if (mounted.current) {
+        const code = cause instanceof RefreshError ? cause.code : 'PROVIDER_UNAVAILABLE';
+        setError(api.message?.(code) ?? code);
+        if (cause instanceof RefreshError && cause.operationId) {
+          try {
+            const value = await api.status(cause.operationId);
+            if (mounted.current) {
+              setOperation(value);
+              setPlan(null);
+            }
+          } catch {
+            /* Keep the safe error and allow a fresh read-only plan. */
+          }
+        }
+      }
+    } finally {
+      locked.current = false;
+      if (mounted.current) setBusy(false);
+    }
+  }
+  return {
+    number,
+    plan,
+    setPlan,
+    operation,
+    setOperation,
+    busy,
+    error,
+    progressUnknown,
+    setProgressUnknown,
+    planHeading,
+    planTrigger,
+    mounted,
+    act,
+  };
+}
