diff --git a/services/api/src/brickvault_api/persistence/runtime_grants.py b/services/api/src/brickvault_api/persistence/runtime_grants.py
index 1323609..b3eda3d 100644
--- a/services/api/src/brickvault_api/persistence/runtime_grants.py
+++ b/services/api/src/brickvault_api/persistence/runtime_grants.py
@@ -13,0 +14,15 @@ def grant_runtime(connection: Connection, role: str) -> None:
+    if connection.scalar(text("SELECT to_regclass('public.listing')")):
+        for name in (
+            "listing",
+            "blob",
+            "image_asset",
+            "image_relation",
+            "listing_image",
+            "upload_receipt",
+        ):
+            connection.execute(text(f'REVOKE ALL ON public.{name} FROM PUBLIC, "{role}"'))
+            connection.execute(text(f'GRANT SELECT, INSERT ON public.{name} TO "{role}"'))
+        # Row locking a listing requires UPDATE privilege, but no metadata edit route exists.
+        connection.execute(text(f'GRANT UPDATE(id) ON public.listing TO "{role}"'))
+        connection.execute(text(f'GRANT UPDATE(display_order) ON public.listing_image TO "{role}"'))
+        connection.execute(text(f'GRANT UPDATE(privacy) ON public.image_asset TO "{role}"'))
