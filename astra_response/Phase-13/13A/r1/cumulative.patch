+def image_bytes(
+    format_name: str = "JPEG", color: str = "red", size: tuple[int, int] = (640, 320)
+) -> bytes:
+    output = io.BytesIO()
+    Image.new("RGBA" if format_name == "PNG" else "RGB", size, color).save(
+        output, format=format_name
+    )
+    return output.getvalue()
