+                  setError(message(error));
+                }
+              }}
+            />
+          </label>
+          <p>Single-frame JPEG, PNG or WebP. Up to 25 MiB and 40 megapixels per image.</p>
+          <button onClick={() => void load()}>Refresh gallery and positions</button>
+          {queue && <QueueView queue={queue} />}
+        </>
+      )}
+    </section>
+  );
+}
