+        </label>
+        <button type="submit">{busy ? 'Creating…' : 'Save listing'}</button>
+      </fieldset>
+      {error && <p role="alert">{error}</p>}
+    </form>
+  );
+}
+
+function QueueView({ queue }: { queue: UploadQueue }) {
+  const items = useSyncExternalStore(queue.subscribe, queue.snapshot);
+  return (
