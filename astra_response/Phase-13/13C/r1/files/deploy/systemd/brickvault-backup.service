[Unit]
Description=BrickVault encrypted dual-destination production backup
Wants=network-online.target
After=network-online.target postgresql@18-main.service
Requires=postgresql@18-main.service
RequiresMountsFor=/var/lib/postgresql /opt/brickvault

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/brickvault/current/api
ExecStart=/opt/brickvault/current/api/venv/bin/brickvault-production-backup backup
ExecStopPost=/opt/brickvault/current/api/venv/bin/python -m brickvault_api.image_backup resume
RuntimeDirectory=brickvault-image-capture
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStopSec=5min
TimeoutStartSec=4h
UMask=0077
StateDirectory=brickvault-backup-runner
StateDirectoryMode=0700
CacheDirectory=brickvault-backup
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/brickvault-backup-runner /var/cache/brickvault-backup /etc/brickvault/backup/receipts /etc/brickvault/backup/proofs

# Intentionally no [Install] section: the timer is the future operator gate.
