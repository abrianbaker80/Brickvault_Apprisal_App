+        from brickvault_api.image_backup import configured_root
+        from sqlalchemy import text
+
+        cfg = admin._load_config(admin.CONFIG_PATH)
+        with admin._owner_connection(cfg) as owner:
+            owner.execute(text("SET TRANSACTION READ ONLY"))
+            revisions = admin._revisions(owner)
