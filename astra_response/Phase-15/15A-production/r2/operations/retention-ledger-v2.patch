--- a/scripts/complete_run_retention.py
+++ b/scripts/complete_run_retention.py
@@ -90,0 +91,112 @@ def select_keep(receipts: dict[str, dict[str, Any]], now: datetime) -> set[str]:
+def partial_snapshot_ids(
+    disposition: Any,
+    receipts: dict[str, Any],
+    repositories: dict[str, Any],
+    marker: str,
+    snapshots: dict[str, list[dict[str, Any]]],
+    pins: dict[str, Any],
+    all_ids: set[str],
+    now: datetime,
+) -> dict[str, set[str]]:
+    """Admit only protected, byte-verified failed history; never a recovery receipt."""
+    admitted: dict[str, set[str]] = {d: set() for d in DESTINATIONS}
+    if disposition is None:
+        return admitted
+    if (
+        not isinstance(disposition, dict)
+        or set(disposition)
+        != {"schema", "purpose", "database", "ownership_marker", "repositories", "runs"}
+        or type(disposition["schema"]) is not int
+        or disposition["schema"] != 1
+        or disposition["purpose"] != "failed-production-backup-disposition"
+        or disposition["database"] != "brickvault_appraisal_prod"
+        or disposition["ownership_marker"] != marker
+        or disposition["repositories"] != repositories
+        or not isinstance(disposition["runs"], dict)
+    ):
+        raise RetentionError("Failed-run disposition identity is invalid.")
+    observed_ids: set[str] = set()
+    for run, record in disposition["runs"].items():
+        if (
+            not isinstance(run, str)
+            or HEX32.fullmatch(run) is None
+            or run in receipts
+            or run in pins["runs"]
+            or not isinstance(record, dict)
+            or set(record)
+            != {
+                "status",
+                "recorded_at_utc",
+                "revisions_at_capture",
+                "evidence_sha256",
+                "snapshots",
+            }
+            or record["status"] != "FAILED_INCOMPLETE"
+            or record["revisions_at_capture"] != ["0017_listing_images"]
+            or not isinstance(record["evidence_sha256"], str)
+            or HEX64.fullmatch(record["evidence_sha256"]) is None
+            or not isinstance(record["snapshots"], dict)
+            or set(record["snapshots"]) != DESTINATIONS
+        ):
+            raise RetentionError(
+                "Failed-run disposition is invalid or overlaps successful history."
+            )
+        recorded = stamp(record["recorded_at_utc"], now)
+        complete = True
+        present = 0
+        for destination in sorted(DESTINATIONS):
+            entries = record["snapshots"][destination]
+            if not isinstance(entries, dict):
+                raise RetentionError("Failed-run snapshot inventory is invalid.")
+            available = {row["id"]: row for row in snapshots[destination]}
+            artifacts: set[str] = set()
+            for identity, evidence in entries.items():
+                if (
+                    not isinstance(identity, str)
+                    or HEX64.fullmatch(identity) is None
+                    or identity in observed_ids
+                    or identity in all_ids
+                    or identity in pins["canaries"][destination]
+                    or identity not in available
+                    or not isinstance(evidence, dict)
+                    or set(evidence)
+                    != {"artifact", "metadata_sha256", "bytes", "sha256"}
+                    or evidence["artifact"] not in ARTIFACTS | {"image-blobs.tar"}
+                    or evidence["artifact"] in artifacts
+                    or type(evidence["bytes"]) is not int
+                    or evidence["bytes"] <= 0
+                    or any(
+                        not isinstance(evidence[k], str)
+                        or HEX64.fullmatch(evidence[k]) is None
+                        for k in ["metadata_sha256", "sha256"]
+                    )
+                ):
+                    raise RetentionError(
+                        "Failed-run snapshot evidence is invalid or overlaps protected history."
+                    )
+                row = available[identity]
+                artifact = evidence["artifact"]
+                if (
+                    digest(row) != evidence["metadata_sha256"]
+                    or row.get("paths")
+                    not in [[f"/{run}/{artifact}"], [f"{run}/{artifact}"]]
+                    or row.get("tags") != [run]
+                    or row.get("hostname") != "brickvault-appraisal"
+                    or row.get("username") != "root"
+                    or row.get("summary", {}).get("total_bytes_processed")
+                    != evidence["bytes"]
+                    or stamp(row.get("time"), now) > recorded
+                ):
+                    raise RetentionError("Failed-run snapshot identity changed.")
+                observed_ids.add(identity)
+                artifacts.add(artifact)
+                admitted[destination].add(identity)
+                present += 1
+            complete = complete and artifacts == ARTIFACTS | {"image-blobs.tar"}
+        if complete or not present:
+            raise RetentionError(
+                "Failed-run disposition must describe retained incomplete history."
+            )
+    return admitted
+
+
@@ -108,2 +220,5 @@ def make_plan(
