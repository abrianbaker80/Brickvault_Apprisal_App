+        marker,
+        snapshots,
+        pins,
+        all_ids,
+        now,
+    )
@@ -156 +282,4 @@ def make_plan(
-        if set(rows) != set(expected[destination]) | set(canaries):
+        if (
+            set(rows)
+            != set(expected[destination]) | set(canaries) | partial_ids[destination]
+        ):
@@ -185,0 +315,2 @@ def make_plan(
