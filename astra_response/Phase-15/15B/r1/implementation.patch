@@ -0,0 +1,64 @@
+package com.abrianbaker.brickvault.appraisal;
+
+/** Process-only one-frame admission. All calls run on the service's main looper. */
+final class CaptureSession {
+    enum State { IDLE, CONSENT, ACTIVE, ARMED, ENCODING, READY }
+    private long generation;
+    private long requestedAt;
+    private boolean visible;
+    private byte[] original;
+    private State state = State.IDLE;
+    State state() { return state; }
+    long generation() { return generation; }
+    boolean currentAction(long token) {
+        return token == generation && state != State.IDLE && state != State.CONSENT;
+    }
+    long begin() { clear(); state = State.CONSENT; return generation; }
+    boolean activate(long token) {
+        if (token != generation || state != State.CONSENT) return false;
+        state = State.ACTIVE;
+        return true;
+    }
+    void visibility(boolean value) {
+        visible = value;
+        if (!value) invalidateFrame();
+    }
+    void invalidateFrame() {
+        if (state == State.ARMED) state = State.ACTIVE;
+        requestedAt = Long.MAX_VALUE;
+    }
+    boolean arm(long now) {
+        if (!visible || state != State.ACTIVE) return false;
+        requestedAt = now;
+        state = State.ARMED;
+        return true;
+    }
+    boolean admit(long token, long timestamp) {
+        if (token != generation || !visible || state != State.ARMED || timestamp <= requestedAt)
+            return false;
+        state = State.ENCODING;
+        return true;
+    }
+    boolean complete(long token, byte[] bytes) {
+        if (token != generation || state != State.ENCODING || bytes == null
+                || bytes.length == 0 || bytes.length > ShareIntake.MAX_FILE_BYTES) return false;
+        original = bytes;
+        state = State.READY;
+        return true;
+    }
+    byte[] take() {
+        if (state != State.READY) return null;
+        byte[] result = original;
+        original = null;
+        clear();
+        return result;
+    }
+    void clear() {
+        generation++;
+        if (original != null) java.util.Arrays.fill(original, (byte) 0);
+        original = null;
+        visible = false;
+        requestedAt = Long.MAX_VALUE;
+        state = State.IDLE;
+    }
+}
