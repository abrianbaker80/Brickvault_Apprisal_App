@@ -0,0 +1,73 @@
+package com.abrianbaker.brickvault.appraisal;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CaptureSessionTest {
+    private CaptureSession active() {
+        CaptureSession session = new CaptureSession();
+        assertTrue(session.activate(session.begin()));
+        session.visibility(true);
+        return session;
+    }
+    @Test public void consentRequiredForEverySession() {
+        CaptureSession session = new CaptureSession();
+        assertFalse(session.activate(0));
+        long old = session.begin(); session.clear();
+        assertFalse(session.activate(old));
+        assertFalse(session.arm(1));
+        assertTrue(session.activate(session.begin()));
+    }
+    @Test public void onlyOneFreshExplicitlyArmedFrame() {
+        CaptureSession session = active(); long token = session.generation();
+        assertFalse(session.admit(token, 99));
+        assertTrue(session.arm(100));
+        assertFalse(session.admit(token, 99)); assertFalse(session.admit(token, 100));
+        assertTrue(session.admit(token, 101));
+        assertFalse(session.admit(token, 102)); assertFalse(session.arm(103));
+        assertTrue(session.complete(token, new byte[] {1}));
+        assertFalse(session.arm(104));
+    }
+    @Test public void stopRevocationAndRestartRefuseLateCompletion() {
+        CaptureSession session = active(); long token = session.generation();
+        assertTrue(session.currentAction(token));
+        session.arm(10); assertTrue(session.admit(token, 11)); session.clear();
+        assertFalse(session.complete(token, new byte[] {1})); assertNull(session.take());
+        assertFalse(session.currentAction(token));
+        session.activate(session.begin());
+        assertFalse(session.currentAction(token));
+        CaptureSession restarted = new CaptureSession();
+        assertNull(restarted.take()); assertFalse(restarted.currentAction(0));
+    }
+    @Test public void visibilityAndResizeRequireAnotherExplicitAction() {
+        CaptureSession session = active(); long token = session.generation();
+        session.arm(10); session.visibility(false);
+        assertFalse(session.admit(token, 11)); assertFalse(session.arm(12));
+        session.visibility(true); assertFalse(session.admit(token, 13));
+        session.arm(14); session.invalidateFrame(); assertFalse(session.admit(token, 15));
+        assertTrue(session.arm(16)); assertTrue(session.admit(token, 17));
+    }
+    @Test public void originalHasBoundedSingleOwnershipAndDiscardClearsIt() {
+        CaptureSession session = active(); long token = session.generation();
+        session.arm(1); session.admit(token, 2);
+        assertFalse(session.complete(token, new byte[0]));
+        byte[] bytes = {1, 2}; assertTrue(session.complete(token, bytes));
+        assertSame(bytes, session.take()); assertNull(session.take());
+        token = session.begin(); session.activate(token); session.visibility(true);
+        session.arm(1); session.admit(token, 2); session.complete(token, bytes); session.clear();
+        assertArrayEquals(new byte[] {0, 0}, bytes);
+    }
+    @Test public void screenshotHandoffRequiresVerifiedForegroundAndReusesShareChunks() {
+        ShareIntake intake = new ShareIntake(); Object owner = new Object();
+        intake.attach(owner, () -> {}); byte[] png = {1, 2, 3};
+        assertFalse(intake.receiveCapture(png));
+        intake.foreground(owner, true); intake.session(true);
+        assertTrue(intake.receiveCapture(png)); assertFalse(intake.receiveCapture(png));
+        ShareIntake.View view = intake.view(); assertEquals(1, view.items.size());
+        assertEquals("image/png", view.items.get(0).mimeType);
+        assertArrayEquals(png, intake.chunk(view.id, view.items.get(0).id, 0, 3));
+        intake.foreground(owner, false);
+        assertThrows(IllegalArgumentException.class, () -> intake.chunk(view.id, view.items.get(0).id, 0, 3));
+        intake.foreground(owner, true); intake.session(false); assertNull(intake.view());
+    }
+}
