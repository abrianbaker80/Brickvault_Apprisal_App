--- /dev/null
+++ b/apps/web/src/NativeCapture.tsx
@@ -0,0 +1,95 @@
+import { useEffect, useState } from 'react';
+import { Capacitor, registerPlugin } from '@capacitor/core';
+import { useConnection } from './Connectivity';
+import { nativeShareSnapshot } from './native-share';
+import { privateSessionValid } from './private-views';
+
+type Status = { supported: boolean; state: string; notice: string };
+interface CapturePort {
+  status(): Promise<Status>;
+  start(): Promise<void>;
+  stop(): Promise<void>;
+  review(): Promise<void>;
+}
+const capture = registerPlugin<CapturePort>('BrickVaultCapture');
+
+/** TEST-only controls. A capture enters the accepted review; it never dispatches HTTP. */
+export function NativeCapture() {
+  const online = useConnection().state === 'ONLINE_VERIFIED';
+  const [status, setStatus] = useState<Status | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const enabled = Capacitor.isNativePlatform() && import.meta.env.MODE === 'android-qualification';
+  useEffect(() => {
+    if (!enabled) return;
+    let active = true;
+    const poll = () => {
+      if (document.visibilityState === 'hidden') return;
+      void capture.status().then(
+        (value) => {
+          if (active) setStatus(value);
+        },
+        () => {
+          if (active) setError('Capture is unavailable. Use Share/manual upload.');
+        },
+      );
+    };
+    poll();
+    const timer = window.setInterval(poll, 1000);
+    return () => {
+      active = false;
+      window.clearInterval(timer);
+    };
+  }, [enabled]);
+  if (!enabled) return null;
+  const verified = online && privateSessionValid() && nativeShareSnapshot().verified;
+  async function action(kind: 'start' | 'stop' | 'review') {
+    setBusy(true);
+    setError('');
+    try {
+      if (kind !== 'stop' && (!verified || !nativeShareSnapshot().foreground))
+        throw new Error('Verify session first');
+      await capture[kind]();
+      setStatus(await capture.status());
+    } catch {
+      setError(
+        'Capture unavailable or session unverified. Check connection or use Share/manual upload.',
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <section aria-label="TEST single-app capture" className="native-share-review">
+      <h2>TEST single-app capture</h2>
+      <p>
