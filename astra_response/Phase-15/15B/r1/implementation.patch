+++ b/apps/android/android/app/src/main/java/com/abrianbaker/brickvault/appraisal/CaptureService.java
@@ -0,0 +1,252 @@
+package com.abrianbaker.brickvault.appraisal;
+
+import android.app.*;
+import android.content.*;
+import android.content.pm.ServiceInfo;
+import android.graphics.Bitmap;
+import android.graphics.PixelFormat;
+import android.hardware.display.DisplayManager;
+import android.hardware.display.VirtualDisplay;
+import android.media.Image;
+import android.media.ImageReader;
+import android.media.projection.MediaProjection;
+import android.media.projection.MediaProjectionManager;
+import android.os.*;
+import android.view.WindowManager;
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+
+/** TEST-only visible projection. OS buffers are drained, never analyzed before Capture. */
+public final class CaptureService extends Service {
+    static final CaptureSession SESSION = new CaptureSession();
+    static final String START = "capture.start", CAPTURE = "capture.frame", STOP = "capture.stop";
+    static final Handler MAIN = new Handler(Looper.getMainLooper());
+    static String notice = "Capture disabled. Share/manual upload remains available.";
+    private static final int NOTIFICATION = 1502;
+    private static final long MAX_PIXELS = 12_000_000;
+    private static final long SESSION_MS = 120_000, FRAME_MS = 5_000;
+    private MediaProjection projection;
+    private VirtualDisplay display;
+    private ImageReader reader;
+    private long token;
+    private int width, height;
+    private boolean encoding;
+    private static BroadcastReceiver lockReceiver;
+    private static Context lockContext;
+    private final Runnable deadline = () -> stop("Capture timed out. Start again for fresh consent.");
+    private final Runnable frameDeadline = () -> stop("No fresh visible frame. Capture stopped.");
+    private final MediaProjection.Callback callback = new MediaProjection.Callback() {
+        @Override public void onStop() { stop("Projection stopped or revoked."); }
+        @Override public void onCapturedContentVisibilityChanged(boolean visible) {
+            SESSION.visibility(visible);
+            if (!visible) {
+                MAIN.removeCallbacks(frameDeadline);
+                notice = "Selected content is unavailable. Return to it, then press Capture again.";
+            }
+        }
+        @Override public void onCapturedContentResize(int w, int h) {
+            if (encoding || projection == null) return;
+            SESSION.invalidateFrame();
+            MAIN.removeCallbacks(frameDeadline);
+            try { resize(w, h); }
+            catch (RuntimeException error) { stop("Selected content dimensions are unsupported."); }
+        }
+    };
+
+    static void discard(Context context) {
+        SESSION.clear();
+        unwatchLock();
+        context.stopService(new Intent(context, CaptureService.class));
+        notice = "Capture discarded. Share/manual upload remains available.";
+    }
+
+    @androidx.annotation.RequiresApi(33)
+    static void watchLock(Context context, long generation) {
+        unwatchLock();
+        lockContext = context.getApplicationContext();
+        lockReceiver = new BroadcastReceiver() {
+            @Override public void onReceive(Context owner, Intent event) { discard(owner); }
+        };
+        lockContext.registerReceiver(lockReceiver, new IntentFilter(Intent.ACTION_SCREEN_OFF), RECEIVER_NOT_EXPORTED);
+        MAIN.postDelayed(() -> {
+            if (SESSION.generation() == generation) discard(context.getApplicationContext());
+        }, SESSION_MS);
+    }
+
+    static void unwatchLock() {
+        if (lockReceiver != null) lockContext.unregisterReceiver(lockReceiver);
+        lockReceiver = null; lockContext = null;
+    }
+
+    @Override public int onStartCommand(Intent intent, int flags, int startId) {
+        if (!BuildConfig.CAPTURE_SPIKE || Build.VERSION.SDK_INT < 37 || intent == null) {
+            stop("Single-app capture is unsupported or disabled.");
+            return START_NOT_STICKY;
+        }
+        if ((STOP.equals(intent.getAction()) || CAPTURE.equals(intent.getAction()))
+                && !SESSION.currentAction(intent.getLongExtra("generation", -1))) {
+            // A delayed notification action must not create a dormant service or affect a new session.
+            if (projection == null && !encoding) stopSelf(startId);
+            return START_NOT_STICKY;
+        }
+        if (STOP.equals(intent.getAction()) || CAPTURE.equals(intent.getAction()))
+            token = intent.getLongExtra("generation", -1);
+        if (STOP.equals(intent.getAction())) stop("Capture stopped.");
+        else if (CAPTURE.equals(intent.getAction())) {
+            if (projection == null) {
+                if (!encoding) stopSelf(startId);
+                return START_NOT_STICKY;
+            }
+            if (projection != null && !locked() && SESSION.arm(System.nanoTime())) {
+                notice = "Waiting for one fresh frame.";
+                MAIN.postDelayed(frameDeadline, FRAME_MS);
+            }
+        } else if (START.equals(intent.getAction())) {
+            token = intent.getLongExtra("generation", -1);
+            if (projection != null || !SESSION.activate(token) || locked()) {
+                stop("Capture session is no longer valid.");
+                return START_NOT_STICKY;
+            }
+            try {
+                NotificationManager notifications = getSystemService(NotificationManager.class);
+                notifications.createNotificationChannel(new NotificationChannel(
+                        "single-app-capture", "Active single-app capture", NotificationManager.IMPORTANCE_LOW));
+                startForeground(NOTIFICATION, notification(), ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION);
+                Intent consent = intent.getParcelableExtra("consent", Intent.class);
+                if (consent == null) throw new IllegalArgumentException("missing consent");
+                projection = getSystemService(MediaProjectionManager.class).getMediaProjection(Activity.RESULT_OK, consent);
+                projection.registerCallback(callback, MAIN);
+                android.graphics.Rect bounds = getSystemService(WindowManager.class).getMaximumWindowMetrics().getBounds();
+                resize(bounds.width(), bounds.height());
+                notice = "Single-app session active. Open selected content; use notification Capture or Stop.";
+                MAIN.postDelayed(deadline, SESSION_MS);
+            } catch (RuntimeException error) { stop("Single-app projection unavailable. Use Share/manual upload."); }
+        }
+        return START_NOT_STICKY;
+    }
+
+    private boolean locked() {
+        return getSystemService(KeyguardManager.class).isKeyguardLocked()
+                || !getSystemService(PowerManager.class).isInteractive();
+    }
+
+    @androidx.annotation.RequiresApi(26)
+    private Notification notification() {
+        PendingIntent open = PendingIntent.getActivity(this, 0, new Intent(this, MainActivity.class), PendingIntent.FLAG_IMMUTABLE);
+        return new Notification.Builder(this, "single-app-capture")
+                .setSmallIcon(android.R.drawable.ic_menu_camera).setContentTitle("BrickVault single-app capture")
+                .setContentText("One screenshot only after Capture. Stop discards pending content.")
+                .setContentIntent(open).setOngoing(true)
+                .addAction(new Notification.Action.Builder(null, "Capture", action(CAPTURE, 1)).build())
+                .addAction(new Notification.Action.Builder(null, "Stop", action(STOP, 2)).build()).build();
+    }
+    private PendingIntent action(String action, int request) {
+        return PendingIntent.getService(this, request, new Intent(this, CaptureService.class).setAction(action)
+                        .putExtra("generation", token),
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_CANCEL_CURRENT);
+    }
+    private void resize(int w, int h) {
+        if (w <= 0 || h <= 0 || (long) w * h > MAX_PIXELS) throw new IllegalArgumentException("dimensions");
+        if (w == width && h == height && reader != null) return;
+        width = w; height = h;
+        ImageReader previous = reader;
+        reader = ImageReader.newInstance(w, h, PixelFormat.RGBA_8888, 2);
+        final ImageReader current = reader;
+        current.setOnImageAvailableListener(source -> frame(source, current), MAIN);
+        int density = getResources().getDisplayMetrics().densityDpi;
+        if (display == null) display = projection.createVirtualDisplay("BrickVault one frame", w, h, density,
+                DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR, reader.getSurface(), null, MAIN);
+        else { display.setSurface(null); display.resize(w, h, density); display.setSurface(reader.getSurface()); }
+        if (previous != null) { previous.setOnImageAvailableListener(null, null); previous.close(); }
+    }
+    private void frame(ImageReader source, ImageReader expected) {
+        if (source != reader || source != expected) return;
+        Bitmap bitmap = null;
+        try (Image image = source.acquireLatestImage()) {
+            if (image == null || locked() || image.getWidth() != width || image.getHeight() != height
+                    || !SESSION.admit(token, image.getTimestamp())) return;
+            MAIN.removeCallbacks(frameDeadline);
+            Image.Plane plane = image.getPlanes()[0];
+            int rowBytes = Math.multiplyExact(width, 4);
+            if (plane.getPixelStride() != 4 || plane.getRowStride() < rowBytes) throw new IllegalArgumentException("format");
+            ByteBuffer input = plane.getBuffer();
+            ByteBuffer packed = ByteBuffer.allocate(Math.multiplyExact(rowBytes, height));
+            int initial = input.position();
+            for (int row = 0; row < height; row++) {
+                ByteBuffer line = input.duplicate();
+                line.position(initial + row * plane.getRowStride()); line.limit(line.position() + rowBytes);
+                packed.put(line);
+            }
+            packed.flip();
+            bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+            bitmap.copyPixelsFromBuffer(packed);
+        } catch (RuntimeException error) {
+            if (bitmap != null) bitmap.recycle();
+            stop("Frame unavailable or protected. Nothing retained.");
+            return;
+        }
+        if (bitmap == null) return;
+        encoding = true;
+        releaseProjection();
+        Bitmap captured = bitmap;
+        long admittedToken = token;
+        // One bounded encoding, no frame history or image analysis. A protected blank is never bypassed.
+        new Thread(() -> {
+            byte[] bytes = null;
+            try (ByteArrayOutputStream output = new ByteArrayOutputStream() {
+                @Override public synchronized void write(byte[] data, int offset, int length) {
+                    if ((long) size() + length > ShareIntake.MAX_FILE_BYTES) throw new IllegalStateException("size");
+                    super.write(data, offset, length);
+                }
+                @Override public synchronized void write(int data) {
+                    if (size() >= ShareIntake.MAX_FILE_BYTES) throw new IllegalStateException("size");
+                    super.write(data);
+                }
+            }) {
+                if (captured.compress(Bitmap.CompressFormat.PNG, 100, output)
+                        && output.size() <= ShareIntake.MAX_FILE_BYTES) bytes = output.toByteArray();
+            } catch (Exception error) { /* Honest unavailable state below; never log pixels. */ }
+            finally { captured.recycle(); }
+            byte[] encoded = bytes;
+            MAIN.post(() -> {
+                if (SESSION.generation() != admittedToken) {
+                    if (encoded != null) java.util.Arrays.fill(encoded, (byte) 0);
+                    return;
+                }
+                if (locked() || !SESSION.complete(admittedToken, encoded)) {
+                    if (encoded != null) java.util.Arrays.fill(encoded, (byte) 0);
+                    stop("Capture discarded or unavailable.");
+                    return;
+                }
+                notice = "Screenshot ready. Return to BrickVault to review; protected regions may be blank.";
+                MAIN.removeCallbacks(deadline);
+                stopForeground(STOP_FOREGROUND_REMOVE);
+                stopSelf();
+            });
+        }, "brickvault-one-png").start();
+    }
+    private void releaseProjection() {
+        if (projection != null) projection.unregisterCallback(callback);
+        if (display != null) { display.release(); display = null; }
+        if (reader != null) { reader.setOnImageAvailableListener(null, null); reader.close(); reader = null; }
+        if (projection != null) { MediaProjection old = projection; projection = null; old.stop(); }
+    }
+    private void stop(String reason) {
+        if (SESSION.generation() == token) {
+            SESSION.clear(); notice = reason;
+            unwatchLock();
+        }
+        MAIN.removeCallbacks(deadline); MAIN.removeCallbacks(frameDeadline);
+        releaseProjection();
+        stopForeground(STOP_FOREGROUND_REMOVE); stopSelf();
+    }
+    @Override public void onDestroy() {
+        MAIN.removeCallbacks(frameDeadline); MAIN.removeCallbacks(deadline);
+        releaseProjection();
+        if (SESSION.generation() == token && SESSION.state() != CaptureSession.State.READY) {
+            SESSION.clear(); unwatchLock();
+        }
+        super.onDestroy();
+    }
+    @Override public IBinder onBind(Intent intent) { return null; }
+}
