+package com.abrianbaker.brickvault.appraisal;
+
+import android.app.Activity;
+import android.app.KeyguardManager;
+import android.content.Intent;
+import android.media.projection.MediaProjectionConfig;
+import android.media.projection.MediaProjectionManager;
+import android.os.Build;
+import android.Manifest;
+import com.getcapacitor.*;
+import com.getcapacitor.annotation.ActivityCallback;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import com.getcapacitor.annotation.Permission;
+import com.getcapacitor.annotation.PermissionCallback;
+
+@CapacitorPlugin(name = "BrickVaultCapture", permissions = {
+    @Permission(alias = "notifications", strings = { Manifest.permission.POST_NOTIFICATIONS })
+})
+public final class BrickVaultCapturePlugin extends Plugin {
+    // Brian's follow-up amendment permits the normal chooser and relies on his APP choice.
+    // Configuration requests APP only, but is not proof that the system enforces it.
+    private long consentGeneration = -1;
+    private boolean foreground;
+
+    @androidx.annotation.RequiresApi(37)
+    static MediaProjectionConfig singleAppConfiguration() {
+        return new MediaProjectionConfig.Builder()
+                .setSourceEnabled(MediaProjectionConfig.PROJECTION_SOURCE_APP, true)
+                .setSourceEnabled(MediaProjectionConfig.PROJECTION_SOURCE_DISPLAY, false)
+                .setSourceEnabled(MediaProjectionConfig.PROJECTION_SOURCE_APP_CONTENT, false)
+                .setAudioRequested(false)
+                .setInitiallySelectedSource(MediaProjectionConfig.PROJECTION_SOURCE_APP).build();
+    }
+    @androidx.annotation.ChecksSdkIntAtLeast(api = 37)
+    private boolean supported() {
+        return BuildConfig.CAPTURE_SPIKE && Build.VERSION.SDK_INT >= 37;
+    }
+    @Override protected void handleOnResume() { foreground = true; }
+    @Override protected void handleOnPause() { foreground = false; }
+    @Override protected void handleOnDestroy() {
+        consentGeneration = -1;
+        if (getActivity().isFinishing()) CaptureService.discard(getContext());
+    }
+    @PluginMethod public void status(PluginCall call) {
+        getActivity().runOnUiThread(() -> {
+            JSObject value = new JSObject();
+            value.put("supported", supported());
+            value.put("state", CaptureService.SESSION.state().name());
+            value.put("notice", CaptureService.notice);
+            call.resolve(value);
+        });
+    }
+    @PluginMethod public void start(PluginCall call) {
+        if (!supported()) { call.reject("CAPTURE_UNSUPPORTED"); return; }
+        if (getPermissionState("notifications") != PermissionState.GRANTED) {
+            requestPermissionForAlias("notifications", call, "notificationResult"); return;
+        }
+        beginCapture(call);
+    }
+    @PermissionCallback private void notificationResult(PluginCall call) {
+        if (getPermissionState("notifications") != PermissionState.GRANTED) {
+            call.reject("VISIBLE_NOTIFICATION_REQUIRED"); return;
+        }
+        beginCapture(call);
+    }
+    private void beginCapture(PluginCall call) {
+        getActivity().runOnUiThread(() -> {
+            if (!supported() || !foreground || !BrickVaultSharePlugin.captureAllowed()
+                    || CaptureService.SESSION.state() != CaptureSession.State.IDLE) {
+                call.reject("CAPTURE_UNAVAILABLE"); return;
+            }
+            try {
+                if (!getContext().getSystemService(android.app.NotificationManager.class).areNotificationsEnabled()) {
+                    call.reject("VISIBLE_NOTIFICATION_REQUIRED"); return;
+                }
+                consentGeneration = CaptureService.SESSION.begin();
+                CaptureService.watchLock(getContext(), consentGeneration);
+                Intent chooser = getContext().getSystemService(MediaProjectionManager.class)
+                        .createScreenCaptureIntent(singleAppConfiguration());
+                startActivityForResult(call, chooser, "consentResult");
+            } catch (RuntimeException | LinkageError error) {
+                CaptureService.discard(getContext());
+                call.reject("SINGLE_APP_CONFIGURATION_UNSUPPORTED");
+            }
+        });
+    }
+    @ActivityCallback private void consentResult(PluginCall call, androidx.activity.result.ActivityResult result) {
+        // Human-only chooser. A replaced/destroyed/expired session cannot reuse consent.
+        if (!supported() || call == null || consentGeneration != CaptureService.SESSION.generation()
+                || result.getResultCode() != Activity.RESULT_OK || result.getData() == null) {
+            CaptureService.discard(getContext());
+            if (call != null) call.resolve();
+            return;
+        }
+        try {
+            getContext().startForegroundService(new Intent(getContext(), CaptureService.class)
+                    .setAction(CaptureService.START).putExtra("consent", result.getData())
+                    .putExtra("generation", consentGeneration));
+            call.resolve();
+        } catch (RuntimeException error) {
+            CaptureService.discard(getContext()); call.reject("CAPTURE_SERVICE_UNAVAILABLE");
+        } finally { consentGeneration = -1; }
+    }
+    @PluginMethod public void stop(PluginCall call) {
+        getActivity().runOnUiThread(() -> { CaptureService.discard(getContext()); call.resolve(); });
+    }
+    @PluginMethod public void review(PluginCall call) {
+        getActivity().runOnUiThread(() -> {
+            if (!foreground || !BrickVaultSharePlugin.captureAllowed()
+                    || getContext().getSystemService(KeyguardManager.class).isKeyguardLocked()) {
+                call.reject("VERIFY_FOREGROUND_TEST_SESSION"); return;
+            }
+            byte[] bytes = CaptureService.SESSION.take();
+            CaptureService.unwatchLock();
+            if (bytes == null || !BrickVaultSharePlugin.admitCapture(bytes)) {
+                if (bytes != null) java.util.Arrays.fill(bytes, (byte) 0);
+                call.reject("CAPTURE_INTAKE_UNAVAILABLE"); return;
+            }
+            call.resolve();
+        });
+    }
+}
diff --git a/apps/android/android/app/src/main/java/com/abrianbaker/brickvault/appraisal/CaptureService.java b/apps/android/android/app/src/main/java/com/abrianbaker/brickvault/appraisal/CaptureService.java
