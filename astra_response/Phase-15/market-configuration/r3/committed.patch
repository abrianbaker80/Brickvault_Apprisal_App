+
+
+@pytest.mark.parametrize(
+    "failure", ["missing", "owner", "mode", "traversal", "hardlink", "malformed", "duplicate"]
+)
+def test_market_credential_refuses_missing_unsafe_or_unusable_input(
+    market_configuration: tuple[Path, Path, dict[Path, tuple[int, int]]], failure: str
+) -> None:
+    environment, secret, metadata = market_configuration
+    if failure == "missing":
+        secret.unlink()
+    elif failure == "owner":
+        metadata[secret] = (0, 0o600)
+    elif failure == "mode":
+        metadata[secret] = (123, 0o640)
+    elif failure == "traversal":
+        metadata[secret.parent.parent] = (0, 0o700)
+    elif failure == "hardlink":
+        os.link(secret, secret.parent / "second-link.env")
+    elif failure == "duplicate":
+        with environment.open("a", encoding="utf-8") as stream:
+            stream.write(f"  BVA_MARKET_CREDENTIALS_ROOT = {secret.parents[2]} \n")
+    else:
+        secret.write_text("invalid=synthetic\n", encoding="utf-8")
+    with pytest.raises(backup.BackupError, match="market credential recovery input"):
+        backup._market_credential_file(environment)
+
+
