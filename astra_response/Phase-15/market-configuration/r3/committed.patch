+def test_market_credential_is_exact_local_loader_valid_service_owned_file(
+    market_configuration: tuple[Path, Path, dict[Path, tuple[int, int]]],
+) -> None:
+    environment, secret, _ = market_configuration
+    assert backup._market_credential_file(environment) == secret
+    # Its narrowly admitted service ownership never relaxes other backup inputs.
+    with pytest.raises(backup.BackupError):
