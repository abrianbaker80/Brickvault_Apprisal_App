+def _market_service_identity() -> tuple[int, int]:
+    import pwd
+
+    account = pwd.getpwnam("brickvault")
+    return account.pw_uid, account.pw_gid
+
+
+def _market_credential_file(environment_file: Path) -> Path | None:
+    """Admit only the configured ordinary, private, API-readable BrickLink file.
+
+    The normal root-owned-file validator remains unchanged. This one file is
+    owned by the API account; its private parent must also be traversable by it.
+    Parsing is local and never authenticates or contacts the provider.
+    """
+    failed = False
+    result: Path | None = None
+    try:
+        _regular_root_file(environment_file, (0o400, 0o600, 0o640))
+        before = environment_file.lstat()
+        with environment_file.open("rb") as stream:
+            opened = os.fstat(stream.fileno())
+            if opened.st_nlink != 1 or (opened.st_dev, opened.st_ino) != (
+                before.st_dev,
+                before.st_ino,
+            ):
+                raise ValueError
+            raw = stream.read(16 * 1024 + 1)
+        if len(raw) > 16 * 1024:
+            raise ValueError
+        names = ("BVA_MARKET_CREDENTIALS_ROOT", "BVA_MARKET_ACCOUNT_SCOPE")
+        settings: dict[str, str] = {}
+        for line in raw.decode("utf-8").splitlines():
+            key, separator, value = line.partition("=")
+            key, value = key.strip(), value.strip()
+            if separator and key in names:
+                if key in settings or not value:
+                    raise ValueError
+                settings[key] = value
+        if settings:
+            if set(settings) != set(names):
+                raise ValueError
+            value = settings[names[0]]
+            root = Path(value)
+            if (
+                str(root) != value
+                or ".." in root.parts
+                or not production_credentials_root_is_safe(value)
+                or str(UUID(settings[names[1]])) != settings[names[1]]
+            ):
+                raise ValueError
+            result = bricklink_configuration.check_location(root)
+            uid, gid = _market_service_identity()
+            info = result.lstat()
+            if (
+                not stat.S_ISREG(info.st_mode)
+                or info.st_nlink != 1
+                or info.st_uid != uid
+                or info.st_gid != gid
+                or stat.S_IMODE(info.st_mode) not in (0o400, 0o600)
+            ):
+                raise ValueError
+            for parent in (result.parent, *result.parent.parents):
+                info = parent.lstat()
+                execute = 0o100 if info.st_uid == uid else 0o010 if info.st_gid == gid else 0o001
+                if (
+                    not stat.S_ISDIR(info.st_mode)
+                    or info.st_uid not in (0, uid)
+                    or info.st_mode & 0o022
+                    or not info.st_mode & execute
+                ):
+                    raise ValueError
+            bricklink_configuration.load_configuration(root)
+    except (OSError, ValueError, KeyError):
+        failed = True
+    if failed:
+        raise BackupError("Configured market credential recovery input is missing or unsafe.")
+    return result
+
+
