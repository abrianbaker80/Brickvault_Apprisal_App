[Unit]
Description=BrickVault daily repository health
Wants=network-online.target
After=network-online.target postgresql@18-main.service
RequiresMountsFor=/var/lib/postgresql /opt/brickvault
OnFailure=brickvault-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/brickvault/current/api/venv/bin/python /opt/brickvault/current/deploy/production_health.py --deep
TimeoutStartSec=5min
StateDirectory=brickvault-operations
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/brickvault-operations /var/cache/brickvault-backup
