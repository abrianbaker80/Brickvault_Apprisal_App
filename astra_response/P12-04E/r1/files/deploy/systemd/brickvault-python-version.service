[Unit]
Description=BrickVault official CPython 3.13 maintenance check
Wants=network-online.target
After=network-online.target
OnFailure=brickvault-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/brickvault/current/api/venv/bin/python /opt/brickvault/current/deploy/python_maintenance.py
TimeoutStartSec=100s
StateDirectory=brickvault-operations
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/brickvault-operations
