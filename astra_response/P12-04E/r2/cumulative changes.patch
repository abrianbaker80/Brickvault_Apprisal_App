 def backup() -> str:
+    """Serialize backup creation with complete-run retention across all CLI callers."""
+    admin._require_root()
+    import fcntl
+
+    descriptor = os.open(
+        "/run/brickvault-backup-retention.lock",
+        os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
+        0o600,
+    )
+    try:
+        info = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(info.st_mode)
+            or info.st_uid != 0
+            or info.st_nlink != 1
+            or stat.S_IMODE(info.st_mode) != 0o600
+        ):
+            raise BackupError("Unsafe backup/retention lock.")
+        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        return _backup_locked()
+    finally:
+        os.close(descriptor)
+
+
+def _backup_locked() -> str:
     config = _preflight()
     revisions = _current_revisions(config)
