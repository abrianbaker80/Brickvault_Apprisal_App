+"""Private root classification and actual-outcomes report contracts."""
+
+from datetime import date, datetime
+from typing import Annotated, Literal
+from uuid import UUID
+
+from pydantic import Field, field_validator
+
+from brickvault_api.economics_v1 import DealModel
+
+Classification = Literal["UNKNOWN", "REAL", "SYNTHETIC", "EXCLUDED"]
+ClassificationExclusions = dict[Literal["UNKNOWN", "SYNTHETIC", "EXCLUDED"], int]
+
+
+class ClassificationAppend(DealModel):
+    id: UUID
+    expected_revision: Annotated[int, Field(strict=True, ge=0, le=2_147_483_645)]
+    classification: Classification
+    reason: Annotated[str, Field(min_length=1, max_length=500)]
+    evidence_ref: Annotated[str, Field(pattern=r"^[A-Za-z0-9_-]{1,80}$")]
+
+    @field_validator("reason")
+    @classmethod
+    def nonblank_reason(cls, value: str) -> str:
+        value = value.strip()
+        if not value:
+            raise ValueError("reason_required")
+        return value
+
+
+class ClassificationEntry(DealModel):
+    id: UUID
+    revision: int
+    recorded_at: datetime
+    classification: Classification
+    reason: str
+    evidence_ref: str
+
+
+class ClassificationResponse(DealModel):
+    root_forecast_id: UUID
+    classification: Classification
+    revision: int
+    latest: ClassificationEntry | None
+    history: tuple[ClassificationEntry, ...]
+    next_before_revision: int | None
+
+
+class ReportExcludedCounts(DealModel):
+    unknown: int
+    synthetic: int
+    excluded: int
+
+
+class ReportSubtotal(DealModel):
+    amount: str | None
+    currency: Literal["USD"] = "USD"
+    label: Literal["COMPLETE", "PARTIAL", "UNAVAILABLE"]
+    cohort_count: int
+    eligible_count: int
+    included_count: int
+    missing_count: int
+    not_applicable_count: int
+    excluded_by_classification: ReportExcludedCounts
+
+
+class ReportCountSubtotal(DealModel):
+    value: int | None
+    label: Literal["COMPLETE", "PARTIAL", "UNAVAILABLE"]
+    cohort_count: int
+    eligible_count: int
+    included_count: int
+    missing_count: int
+    not_applicable_count: int
+    excluded_by_classification: ReportExcludedCounts
+
+
+class OutcomeComparisonSummary(DealModel):
+    cohort_count: int
+    candidate_count: int
+    comparable_count: int
+    noncomparable_count: int
+    unavailable_count: int
+    not_applicable_count: int
+    excluded_reason_counts: dict[str, int]
+    diagnostic_reason_counts: dict[str, int]
+    mean_signed_error: str | None
+    label: Literal["COMPLETE", "PARTIAL", "UNAVAILABLE"]
+    excluded_by_classification: ReportExcludedCounts
+
+
+class OutcomeComparisonBasis(DealModel):
+    sale: OutcomeComparisonSummary
+    net: OutcomeComparisonSummary
+    profit: OutcomeComparisonSummary
+
+
+class OutcomeComparisonReport(DealModel):
+    selected_market: OutcomeComparisonBasis
+    manual_assumption: OutcomeComparisonBasis
+    unassigned_basis: OutcomeComparisonBasis
+    no_outcome_count: int
+
+
+class OutcomesReportSummary(DealModel):
+    total_roots: int
+    selected_roots: int
+    outside_date_range: int
+    classification_counts: dict[Classification, int]
+    real_outcome_counts: dict[
+        Literal["NOT_RECORDED", "NOT_BOUGHT", "NOT_SOLD", "PARTIALLY_SOLD", "COMPLETE"], int
+    ]
+    unsold_acquisition: ReportSubtotal
+    partially_sold_acquisition: ReportSubtotal
+    partial_gross_to_date: ReportSubtotal
+    completed_gross: ReportSubtotal
+    completed_net: ReportSubtotal
+    completed_profit: ReportSubtotal
+    paid_labor: ReportSubtotal
+    unpaid_labor_minutes: ReportCountSubtotal
+    comparisons: OutcomeComparisonReport
+
+
+class OutcomesReportRow(DealModel):
+    root_forecast_id: UUID
+    saved_at: datetime
+    classification: Classification
+    classification_revision: int
+    classification_id: UUID | None
+    classification_reason: str | None
+    classification_evidence_ref: str | None
+    outcome_revision: int | None
+    outcome_id: UUID | None
+    purchase_decision: Literal["BOUGHT", "NOT_BOUGHT"] | None
+    sale_status: Literal["NOT_SOLD", "PARTIALLY_SOLD", "COMPLETE"] | None
+    results_state: (
+        Literal["NOT_BOUGHT", "NOT_SOLD", "PARTIALLY_SOLD", "INCOMPLETE", "COMPLETE"] | None
+    )
+    acquired_on: date | None
+    sold_on: date | None
+    missing_fields: tuple[str, ...]
+    acquisition: str | None
+    gross: str | None
+    net: str | None
+    profit: str | None
+    labor_costs: str | None
+    labor_minutes: int | None
+    sale_basis: Literal["SELECTED_MARKET", "MANUAL"] | None
+    market_basis: Literal["sold", "stock"] | None
+    sale_comparison: Literal["COMPARABLE", "NONCOMPARABLE", "UNAVAILABLE"] | None
+    net_comparison: Literal["COMPARABLE", "NONCOMPARABLE", "UNAVAILABLE"] | None
+    profit_comparison: Literal["COMPARABLE", "NONCOMPARABLE", "UNAVAILABLE"] | None
+    sale_comparison_reasons: tuple[str, ...]
+    net_comparison_reasons: tuple[str, ...]
+    profit_comparison_reasons: tuple[str, ...]
+
+
+class OutcomesReportResponse(DealModel):
+    from_date: date | None
+    to_date: date | None
+    snapshot: str
+    offset: int
+    page_size: int
+    next_offset: int | None
+    summary: OutcomesReportSummary
+    rows: tuple[OutcomesReportRow, ...]
+
+
+DealOutcomeErrorCode = Literal[
+    "CLASSIFICATION_NOT_FOUND",
+    "CLASSIFICATION_CONFLICT",
+    "CLASSIFICATION_ID_REUSED",
+    "CLASSIFICATION_FIXTURE_STICKY",
+    "REPORT_CHANGED",
+    "REPORT_UNAVAILABLE",
+]
+
+
+class DealOutcomeProblemDetail(DealModel):
+    code: DealOutcomeErrorCode
+    message: str
+    request_id: UUID
+
+
+class DealOutcomeProblem(DealModel):
+    error: DealOutcomeProblemDetail
