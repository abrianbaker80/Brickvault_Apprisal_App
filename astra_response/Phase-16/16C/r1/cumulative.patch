+    @staticmethod
+    def _latest_rows(c: CatalogConnection, owner: UUID) -> list[dict[str, Any]]:
+        return c.execute(
+            """WITH roots AS (
+                SELECT id,saved_at FROM public.deal_forecast
+                WHERE owner_id=%s AND saved_at IS NOT NULL AND root_id IS NULL AND parent_id IS NULL
+            ), outcomes AS (
