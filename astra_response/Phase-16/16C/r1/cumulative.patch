@@ -0,0 +1,351 @@
+"""Saved-root reporting and classification on owned disposable TEST PostgreSQL."""
+
+from datetime import UTC
+from uuid import UUID, uuid4
+
+import pytest
+
+import brickvault_api.deal_outcomes as report_module
+from brickvault_api.datasets.models import DatasetError
+from brickvault_api.datasets.subjects import root_for_owner
+from brickvault_api.deal_outcomes import DealOutcomeError, DealOutcomesService
+from brickvault_api.deal_outcomes_models import ClassificationAppend
+from brickvault_api.outcome_models import OutcomeActuals, OutcomeAppend
+from brickvault_api.outcomes import OutcomeService
+
+from .test_catalog_queries import owner_engine as owner_engine
+from .test_catalog_schema import synthetic as synthetic
+from .test_forecast_api import assert_problem, endpoint, logged_in
+from .test_forecasts import ForecastHarness
+from .test_forecasts import forecasts as forecasts
+from .test_market import market as market
+from .test_product import no_provider_network as no_provider_network
+
+
+def append_classification(
+    service: DealOutcomesService,
+    h: ForecastHarness,
+    root: UUID,
+    classification: str,
+    revision: int = 0,
+    identifier: UUID | None = None,
+) -> ClassificationAppend:
+    body = ClassificationAppend(
+        id=identifier or uuid4(),
+        expected_revision=revision,
+        classification=classification,  # type: ignore[arg-type]
+        reason="Synthetic TEST decision",
+        evidence_ref="test-evidence",
+    )
+    service.append_classification(h.token, h.csrf, root, body)
+    return body
+
+
+def append_outcome(
+    service: OutcomeService, h: ForecastHarness, root: UUID, revision: int, actuals: OutcomeActuals
+) -> None:
+    service.append(
+        h.token,
+        h.csrf,
+        root,
+        OutcomeAppend(
+            id=uuid4(),
+            expected_revision=revision,
+            actuals=actuals,
+            correction_reason="Synthetic correction" if revision else None,
+        ),
+    )
+
+
+def test_root_classification_routes_replay_owner_and_sticky_guards(
+    forecasts: ForecastHarness,
+    no_provider_network: None,
+) -> None:
+    h = forecasts
+    root = h.save(h.preview().status.id)
+    child_preview = h.service.preview_revision(h.token, h.csrf, root.id, h.request())
+    child = h.save(child_preview.status.id)
+    other = h.save(h.preview().status.id)
+    unsaved = h.preview()
+    with h.market.app.database.connect() as connection:
+        with pytest.raises(DatasetError, match="DATASET_NOT_FOUND"):
+            root_for_owner(connection, uuid4(), root.id)
+
+    with logged_in(h) as client:
+        path = endpoint(str(child.id)) + "/classification"
+        empty = client.get(path)
+        assert empty.status_code == 200 and empty.headers["cache-control"] == "no-store"
+        assert empty.json()["root_forecast_id"] == str(root.id)
+        assert empty.json()["classification"] == "UNKNOWN"
+        assert empty.json()["revision"] == 0
+        assert_problem(
+            client.get(endpoint(str(unsaved.status.id)) + "/classification"),
+            404,
+            "CLASSIFICATION_NOT_FOUND",
+        )
+        assert_problem(
+            client.get(endpoint(str(uuid4())) + "/classification"),
+            404,
+            "CLASSIFICATION_NOT_FOUND",
+        )
+
+        body = ClassificationAppend(
+            id=uuid4(),
+            expected_revision=0,
+            classification="REAL",
+            reason="Owned synthetic fixture confirms route behavior",
+            evidence_ref="synthetic-proof",
+        ).model_dump(mode="json")
+        first = client.post(path, json=body)
+        assert first.status_code == 200, first.text
+        assert first.headers["cache-control"] == "no-store"
+        assert first.json()["id"] == body["id"]
+        assert first.json()["revision"] == 1
+        assert first.headers["cache-control"] == "no-store"
+        assert client.post(path, json=body).json() == first.json()
+        assert_problem(
+            client.post(path, json={**body, "reason": "Different facts"}),
+            409,
+            "CLASSIFICATION_ID_REUSED",
+        )
+        assert_problem(
+            client.post(path, json={**body, "id": str(uuid4())}, headers={"X-CSRF-Token": ""}),
+            403,
+            "FORBIDDEN",
+        )
+
+        current = client.get(endpoint(str(root.id)) + "/classification").json()
+        assert current["classification"] == "REAL"
+        assert [entry["revision"] for entry in current["history"]] == [1]
+        assert current["latest"]["evidence_ref"] == body["evidence_ref"]
+        assert_problem(
+            client.post(
+                endpoint(str(root.id)) + "/classification",
+                json={**body, "id": str(uuid4()), "expected_revision": 0},
+            ),
+            409,
+            "CLASSIFICATION_CONFLICT",
+        )
+
+        synthetic = {
+            **body,
+            "id": str(uuid4()),
+            "expected_revision": 0,
+            "classification": "SYNTHETIC",
+        }
+        created = client.post(endpoint(str(other.id)) + "/classification", json=synthetic)
+        assert created.status_code == 200, created.text
+        assert_problem(
+            client.post(
+                endpoint(str(other.id)) + "/classification",
+                json={
+                    **synthetic,
+                    "id": str(uuid4()),
+                    "expected_revision": 1,
+                    "classification": "REAL",
+                },
+            ),
+            409,
+            "CLASSIFICATION_FIXTURE_STICKY",
+        )
+        assert_problem(
+            client.get(endpoint(str(uuid4())) + "/classification"),
+            404,
+            "CLASSIFICATION_NOT_FOUND",
+        )
+
+
+def test_report_aggregates_latest_per_root_exact_subtotals_date_and_stale_pages(
+    forecasts: ForecastHarness,
+    no_provider_network: None,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    h = forecasts
+    service = DealOutcomesService(h.market.app.database)
+    outcomes = OutcomeService(h.market.app.database)
+
+    roots: list[UUID] = []
+    for index in range(6):
+        if index:
+            h.advance(86400)
+            h.login()
+        root = h.save(h.preview().status.id)
+        roots.append(root.id)
+        if index == 0:
+            child = h.save(
+                h.service.preview_revision(h.token, h.csrf, root.id, h.request()).status.id
+            )
+            assert h.row(child.id)["root_id"] == root.id
+
+    append_classification(service, h, roots[0], "REAL")
+    append_classification(service, h, roots[1], "REAL")
+    append_classification(service, h, roots[2], "REAL")
+    append_classification(service, h, roots[3], "SYNTHETIC")
+    append_classification(service, h, roots[4], "REAL")
+    # Root six remains UNKNOWN and has no outcome.
+
+    append_outcome(outcomes, h, roots[0], 0, OutcomeActuals(purchase_decision="NOT_BOUGHT"))
+    append_outcome(
+        outcomes,
+        h,
+        roots[0],
+        1,
+        OutcomeActuals(
+            purchase_decision="BOUGHT",
+            sale_status="NOT_SOLD",
+            purchase_price="0",
+            acquisition_extra_costs="0",
+            labor_costs="0",
+            labor_minutes=15,
+        ),
+    )
+    append_outcome(
+        outcomes,
+        h,
+        roots[1],
+        0,
+        OutcomeActuals(
+            purchase_decision="BOUGHT",
+            sale_status="PARTIALLY_SOLD",
+            purchase_price="10",
+            acquisition_extra_costs="0",
+            item_sale_proceeds="30",
+            shipping_charged="0",
+            selling_fees="0",
+            shipping_paid="0",
+            other_selling_costs="0",
+            replacement_costs="0",
+            labor_costs="0",
+            labor_minutes=30,
+        ),
+    )
+    append_outcome(
+        outcomes,
+        h,
+        roots[2],
+        0,
+        OutcomeActuals(
+            purchase_decision="BOUGHT",
+            sale_status="COMPLETE",
+            purchase_price="10",
+            acquisition_extra_costs="0",
+            item_sale_proceeds="5",
+            shipping_charged="0",
+            selling_fees="10",
+            shipping_paid="0",
+            other_selling_costs="0",
+            replacement_costs="0",
+            labor_costs="0",
+            labor_minutes=0,
+        ),
+    )
+    # The synthetic result is intentionally profitable but stays outside real totals.
+    append_outcome(
+        outcomes,
+        h,
+        roots[3],
+        0,
+        OutcomeActuals(
+            purchase_decision="BOUGHT",
+            sale_status="COMPLETE",
+            purchase_price="1",
+            acquisition_extra_costs="0",
+            item_sale_proceeds="100",
+            shipping_charged="0",
+            selling_fees="0",
+            shipping_paid="0",
+            other_selling_costs="0",
+            replacement_costs="0",
+            labor_costs="0",
+            labor_minutes=0,
+        ),
+    )
+
+    with monkeypatch.context() as m:
+        m.setattr(report_module, "PAGE_SIZE", 2)
+        first = service.report(h.token)
+        assert len(first.rows) == 2 and first.next_offset == 2
+        assert first.summary.total_roots == 6
+        assert first.summary.selected_roots == 6
+        assert first.summary.classification_counts == {
+            "UNKNOWN": 1,
+            "REAL": 4,
+            "SYNTHETIC": 1,
+            "EXCLUDED": 0,
+        }
+        assert first.summary.real_outcome_counts["NOT_RECORDED"] == 1
+        assert first.summary.real_outcome_counts["NOT_BOUGHT"] == 0
+        assert first.summary.real_outcome_counts["NOT_SOLD"] == 1
+        assert first.summary.real_outcome_counts["PARTIALLY_SOLD"] == 1
+        assert first.summary.real_outcome_counts["COMPLETE"] == 1
+        assert first.summary.unsold_acquisition.amount == "0.00"
+        assert first.summary.unsold_acquisition.label == "COMPLETE"
+        assert first.summary.partial_gross_to_date.amount == "30.00"
+        assert first.summary.completed_profit.amount == "-15.00"
+        assert first.summary.completed_profit.label == "COMPLETE"
+        assert first.summary.completed_profit.excluded_by_classification.synthetic == 1
+        assert first.summary.unpaid_labor_minutes.value == 45
+        assert first.summary.comparisons.no_outcome_count == 1
+        manual_profit = first.summary.comparisons.manual_assumption.profit
+        assert manual_profit.candidate_count == 3
+        assert (
+            manual_profit.comparable_count
+            + manual_profit.noncomparable_count
+            + manual_profit.unavailable_count
+            == manual_profit.candidate_count
+        )
+        assert sum(manual_profit.excluded_reason_counts.values()) == (
+            manual_profit.noncomparable_count + manual_profit.unavailable_count
+        )
+        second = service.report(h.token, offset=first.next_offset, snapshot=first.snapshot)
+        assert len(second.rows) == 2
+        loss_row = next(row for row in second.rows if row.root_forecast_id == roots[2])
+        assert loss_row.profit_comparison_reasons
+        assert second.summary.completed_profit.amount == first.summary.completed_profit.amount
+        assert second.summary.selected_roots == first.summary.selected_roots
+
+        row = h.row(roots[1])
+        target_date = row["saved_at"].astimezone(UTC).date()
+        exact_day = service.report(h.token, from_date=target_date, to_date=target_date)
+        assert exact_day.summary.selected_roots == 1
+        assert exact_day.summary.outside_date_range == 5
+        assert exact_day.rows[0].root_forecast_id == roots[1]
+
+        append_classification(service, h, roots[0], "EXCLUDED", revision=1)
+        with pytest.raises(DealOutcomeError, match="REPORT_CHANGED"):
+            service.report(h.token, offset=second.next_offset or 4, snapshot=first.snapshot)
+
+
+def test_report_api_is_no_store_and_restarts_stale_page(
+    forecasts: ForecastHarness,
+    no_provider_network: None,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    h = forecasts
+    roots = [h.save(h.preview().status.id) for _ in range(2)]
+    service = DealOutcomesService(h.market.app.database)
+    for root in roots:
+        append_classification(service, h, root.id, "REAL")
+    with logged_in(h) as client, monkeypatch.context() as m:
+        m.setattr(report_module, "PAGE_SIZE", 1)
+        first = client.get("/api/deal-outcomes/report")
+        assert first.status_code == 200, first.text
+        assert first.headers["cache-control"] == "no-store"
+        report = first.json()
+        assert report["summary"]["total_roots"] == 2
+        assert report["next_offset"] == 1
+        page = client.get(
+            "/api/deal-outcomes/report",
+            params={"offset": 1, "snapshot": report["snapshot"]},
+        )
+        assert page.status_code == 200, page.text
+        assert page.json()["summary"] == report["summary"]
+        append_classification(service, h, roots[0].id, "EXCLUDED", revision=1)
+        assert_problem(
+            client.get(
+                "/api/deal-outcomes/report",
+                params={"offset": 1, "snapshot": report["snapshot"]},
+            ),
+            409,
+            "REPORT_CHANGED",
+        )
