index 0000000000000000000000000000000000000000..e594f531c0bed6f968ee50d24cb4279d2bb5954b
--- /dev/null
+++ b/services/api/src/brickvault_api/datasets/subjects.py
@@ -0,0 +1,190 @@
+"""Shared authenticated append-only subject ledger operations."""
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+from typing import Any
+from uuid import UUID
+
+import psycopg
+from psycopg.types.json import Jsonb
+
+from brickvault_api.auth import AuthError, AuthService, Session
+from brickvault_api.auth import digest as token_digest
+from brickvault_api.catalog.connection import CatalogConnection, CatalogDatabase
+from brickvault_api.datasets.models import TABLES, DatasetError, SubjectReview, digest
+
+
+def authorize(
+    c: CatalogConnection, database: CatalogDatabase, token: str | None, csrf: str | None
+) -> Session:
+    clock = c.execute("SELECT public.forecast_clock() AS now").fetchone()
+    assert clock is not None
+    session = AuthService(database, clock=lambda: clock["now"]).check_in_transaction(c, token, csrf)
+    if csrf is not None:
+        assert token is not None
+        c.execute(
+            "SELECT set_config('brickvault.dataset_session',%s,true),"
+            "set_config('brickvault.dataset_auth_until',%s,true)",
+            (
+                token_digest(token),
+                min(session.idle_expires_at, session.absolute_expires_at).isoformat(),
+            ),
+        )
+    return session
+
+
+def lock(c: CatalogConnection, owner: UUID) -> None:
+    c.execute("SELECT pg_advisory_xact_lock(hashtextextended(%s,19))", (str(owner),))
+
+
+def rows(c: CatalogConnection, query: str, owner: UUID) -> list[dict[str, Any]]:
+    result = c.execute(query + " LIMIT 10001", (owner,)).fetchall()
+    if len(result) > 10000:
+        raise DatasetError("DATASET_METADATA_LIMIT")
+    return result
+
+
+def status(
+    c: CatalogConnection, owner: UUID, identifier: UUID
+) -> tuple[str, dict[str, Any]] | None:
+    for table in TABLES:
+        if table == "dataset_item":
+            continue
+        row = c.execute(
+            f"SELECT * FROM public.{table} WHERE id=%s AND owner_id=%s", (identifier, owner)
+        ).fetchone()
+        if row:
+            return table, row
+    return None
+
+
+def projection(table: str, row: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "table": table,
+        "id": str(row["id"]),
+        "revision": row.get("revision"),
+        "data": row["data"],
+    }
+
+
+def latest_subject(
+    c: CatalogConnection, owner: UUID, *, listing_id: UUID | None, root_forecast_id: UUID | None
+) -> dict[str, Any] | None:
+    return c.execute(
+        "SELECT * FROM public.dataset_subject_revision WHERE owner_id=%s "
+        "AND listing_id IS NOT DISTINCT FROM %s AND root_forecast_id IS NOT DISTINCT FROM %s "
+        "ORDER BY revision DESC LIMIT 1",
+        (owner, listing_id, root_forecast_id),
+    ).fetchone()
+
+
+def append_subject(c: CatalogConnection, owner: UUID, request: SubjectReview) -> dict[str, Any]:
+    if request.listing_id is not None:
+        owned = c.execute(
+            "SELECT 1 FROM public.listing WHERE id=%s AND owner_id=%s",
+            (request.listing_id, owner),
+        ).fetchone()
+    else:
+        owned = c.execute(
+            "SELECT 1 FROM public.deal_forecast WHERE id=%s AND owner_id=%s AND saved_at IS NOT NULL "
+            "AND root_id IS NULL AND parent_id IS NULL",
+            (request.root_forecast_id, owner),
+        ).fetchone()
+    if not owned:
+        raise DatasetError("DATASET_NOT_FOUND")
+
+    prior = latest_subject(
+        c,
+        owner,
+        listing_id=request.listing_id,
+        root_forecast_id=request.root_forecast_id,
+    )
+    if (prior["revision"] if prior else 0) != request.expected_revision:
+        raise DatasetError("DATASET_CONFLICT")
+    if (
+        prior
+        and prior["data"]["classification"] == "SYNTHETIC"
+        and request.classification != "SYNTHETIC"
+    ):
+        raise DatasetError("DATASET_FIXTURE_STICKY")
+
+    value = request.model_dump(mode="json")
+    row = c.execute(
+        "INSERT INTO public.dataset_subject_revision "
+        "(id,owner_id,listing_id,root_forecast_id,revision,request_hash,request,data) "
+        "VALUES(%s,%s,%s,%s,%s,%s,%s,%s) RETURNING *",
+        (
+            request.id,
+            owner,
+            request.listing_id,
+            request.root_forecast_id,
+            request.expected_revision + 1,
+            digest(value),
+            Jsonb(value),
+            Jsonb(value),
+        ),
+    ).fetchone()
+    assert row is not None
+    return row
+
+
+@contextmanager
+def subject_transaction(
+    database: CatalogDatabase,
+    token: str | None,
+    csrf: str | None,
+    *,
+    write: bool = False,
+) -> Iterator[tuple[CatalogConnection, Session]]:
+    if database.role != "runtime":
+        raise DatasetError("DATASET_RUNTIME_ROLE_REQUIRED")
+    if write and csrf is None:
+        raise AuthError(403)
+    try:
+        with database.connect() as c, c.transaction():
+            session = authorize(c, database, token, csrf)
+            lock(c, session.principal_id)
+            yield c, session
+            authorize(c, database, token, csrf)
+    except psycopg.errors.CheckViolation as error:
+        if error.diag.message_primary == "DATASET_UNAUTHORIZED":
+            raise AuthError() from None
+        if error.diag.message_primary == "DATASET_FIXTURE_STICKY":
+            raise DatasetError("DATASET_FIXTURE_STICKY") from None
+        if error.diag.message_primary == "DATASET_CONFLICT":
+            raise DatasetError("DATASET_CONFLICT") from None
+        raise DatasetError("DATASET_INTEGRITY_CONFLICT") from None
+    except psycopg.errors.UniqueViolation:
+        raise DatasetError("DATASET_ID_REUSED") from None
+    except (
+        psycopg.errors.LockNotAvailable,
+        psycopg.errors.DeadlockDetected,
+        psycopg.errors.QueryCanceled,
+        psycopg.errors.SerializationFailure,
+    ):
+        raise DatasetError("DATASET_UNAVAILABLE") from None
+    except (psycopg.errors.UndefinedTable, psycopg.errors.InsufficientPrivilege):
+        raise DatasetError("DATASET_UNAVAILABLE") from None
+
+
+def replay(c: CatalogConnection, owner: UUID, request: SubjectReview) -> dict[str, Any] | None:
+    entry = status(c, owner, request.id)
+    if entry is None:
+        return None
+    if entry[0] != TABLES[0] or entry[1]["request_hash"] != digest(request.model_dump(mode="json")):
+        raise DatasetError("DATASET_ID_REUSED")
+    return projection(*entry)
+
+
+def root_for_owner(c: CatalogConnection, owner: UUID, identifier: UUID) -> dict[str, Any]:
+    row = c.execute(
+        """SELECT root.* FROM public.deal_forecast f
+        JOIN public.deal_forecast root ON root.id=COALESCE(f.root_id,f.id)
+          AND root.owner_id=f.owner_id
+        WHERE f.id=%s AND f.owner_id=%s AND f.saved_at IS NOT NULL
+          AND root.saved_at IS NOT NULL AND root.root_id IS NULL AND root.parent_id IS NULL""",
+        (identifier, owner),
+    ).fetchone()
+    if row is None:
+        raise DatasetError("DATASET_NOT_FOUND")
+    return row
