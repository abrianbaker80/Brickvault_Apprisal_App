index 0000000000000000000000000000000000000000..241ea10759958313c56d0a824063109c58aa9b83
--- /dev/null
+++ b/services/api/src/brickvault_api/api/deal_outcomes.py
@@ -0,0 +1,178 @@
+"""Private outcome report and saved-root classification routes."""
+
+from datetime import date
+from typing import Annotated, Any
+from uuid import UUID
+
+from fastapi import APIRouter, Depends, HTTPException, Query, Request, Response
+from starlette.responses import JSONResponse
+
+from brickvault_api.api.errors import ErrorResponse
+from brickvault_api.auth import AuthError
+from brickvault_api.catalog.connection import CatalogDatabase
+from brickvault_api.deal_outcomes import DealOutcomeError, DealOutcomesService
+from brickvault_api.deal_outcomes_models import (
+    ClassificationAppend,
+    ClassificationEntry,
+    ClassificationResponse,
+    DealOutcomeErrorCode,
+    DealOutcomeProblem,
+    DealOutcomeProblemDetail,
+    OutcomesReportResponse,
+)
+
+from .auth import SESSION_COOKIE, cookie
+
+router = APIRouter()
+RESPONSES: dict[int | str, dict[str, Any]] = {
+    404: {"model": DealOutcomeProblem},
+    409: {"model": DealOutcomeProblem},
+    422: {"model": ErrorResponse},
+    503: {"model": DealOutcomeProblem | ErrorResponse},
+}
+
+
+def service(request: Request) -> DealOutcomesService:
+    settings = request.app.state.settings
+    if settings.database_ownership_marker is None:
+        raise HTTPException(503)
+    return DealOutcomesService(
+        CatalogDatabase(
+            settings.database_url.get_secret_value(),
+            settings.purpose,
+            settings.database_ownership_marker.get_secret_value(),
+            role="runtime",
+        )
+    )
+
+
+Service = Annotated[DealOutcomesService, Depends(service)]
+
+
+def problem(request: Request, error: DealOutcomeError) -> JSONResponse:
+    details: dict[str, tuple[int, DealOutcomeErrorCode, str]] = {
+        "CLASSIFICATION_NOT_FOUND": (
+            404,
+            "CLASSIFICATION_NOT_FOUND",
+            "Saved deal not found.",
+        ),
+        "CLASSIFICATION_CONFLICT": (
+            409,
+            "CLASSIFICATION_CONFLICT",
+            "Classification changed. Reload before making a new decision.",
+        ),
+        "CLASSIFICATION_ID_REUSED": (
+            409,
+            "CLASSIFICATION_ID_REUSED",
+            "Submission identity was already used with different facts.",
+        ),
+        "CLASSIFICATION_FIXTURE_STICKY": (
+            409,
+            "CLASSIFICATION_FIXTURE_STICKY",
+            "Synthetic classification is permanent.",
+        ),
+        "REPORT_CHANGED": (
+            409,
+            "REPORT_CHANGED",
+            "The report changed between pages. Restart from the first page.",
+        ),
+    }
+    status, code, message = details.get(
+        error.code, (503, "REPORT_UNAVAILABLE", "Outcomes reporting is temporarily unavailable.")
+    )
+    return JSONResponse(
+        DealOutcomeProblem(
+            error=DealOutcomeProblemDetail(
+                code=code,
+                message=message,
+                request_id=UUID(request.state.request_id),
+            )
+        ).model_dump(mode="json"),
+        status_code=status,
+        headers={"Cache-Control": "no-store"},
+    )
+
+
+@router.get(
+    "/api/deal-outcomes/report",
+    operation_id="get_deal_outcomes_report",
+    response_model=OutcomesReportResponse,
+    responses=RESPONSES,
+)
+def report(
+    request: Request,
+    response: Response,
+    service: Service,
+    from_date: Annotated[date | None, Query()] = None,
+    to_date: Annotated[date | None, Query()] = None,
+    offset: Annotated[int, Query(ge=0, le=2_147_483_647)] = 0,
+    snapshot: Annotated[str | None, Query(pattern=r"^[a-f0-9]{64}$")] = None,
+) -> OutcomesReportResponse | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.report(
+            cookie(request, SESSION_COOKIE),
+            from_date=from_date,
+            to_date=to_date,
+            offset=offset,
+            snapshot=snapshot,
+        )
+    except DealOutcomeError as error:
+        return problem(request, error)
+    except AuthError as error:
+        raise HTTPException(error.status) from None
+    except ValueError as error:
+        if str(error) == "invalid_date_range":
+            raise HTTPException(422) from None
+        raise HTTPException(422) from None
+
+
+@router.get(
+    "/api/deal-forecasts/{identifier}/classification",
+    operation_id="get_deal_classification",
+    response_model=ClassificationResponse,
+    responses=RESPONSES,
+)
+def get_classification(
+    identifier: UUID,
+    request: Request,
+    response: Response,
+    service: Service,
+    before_revision: Annotated[int | None, Query(ge=1, le=2_147_483_646)] = None,
+) -> ClassificationResponse | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.classification(
+            cookie(request, SESSION_COOKIE), identifier, before_revision=before_revision
+        )
+    except DealOutcomeError as error:
+        return problem(request, error)
+    except AuthError as error:
+        raise HTTPException(error.status) from None
+
+
+@router.post(
+    "/api/deal-forecasts/{identifier}/classification",
+    operation_id="append_deal_classification",
+    response_model=ClassificationEntry,
+    responses=RESPONSES,
+)
+def append_classification(
+    identifier: UUID,
+    body: ClassificationAppend,
+    request: Request,
+    response: Response,
+    service: Service,
+) -> ClassificationEntry | JSONResponse:
+    response.headers["Cache-Control"] = "no-store"
+    try:
+        return service.append_classification(
+            cookie(request, SESSION_COOKIE),
+            request.headers.get("x-csrf-token"),
+            identifier,
+            body,
+        )
+    except DealOutcomeError as error:
+        return problem(request, error)
+    except AuthError as error:
+        raise HTTPException(error.status) from None
