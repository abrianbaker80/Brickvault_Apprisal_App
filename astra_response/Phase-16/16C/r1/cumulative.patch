+            purchase_decision=actuals.purchase_decision if actuals else None,
+            sale_status=actuals.sale_status if actuals else None,
+            results_state=results.state if results else None,
+            acquired_on=actuals.acquired_on if actuals else None,
+            sold_on=actuals.sold_on if actuals else None,
+            missing_fields=results.missing_fields if results else (),
+            acquisition=_known_amount(results.acquisition.amount) if results else None,
+            gross=_known_amount(results.gross.amount) if results else None,
+            net=_known_amount(results.net.amount) if results else None,
+            profit=_known_amount(results.profit.amount) if results else None,
+            labor_costs=actuals.labor_costs if actuals else None,
+            labor_minutes=actuals.labor_minutes if actuals else None,
+            sale_basis=comparison.sale_basis if comparison else None,
+            market_basis=comparison.basis if comparison else None,
+            sale_comparison=comparison.sale.state if comparison else None,
+            net_comparison=comparison.net.state if comparison else None,
+            profit_comparison=comparison.profit.state if comparison else None,
+            sale_comparison_reasons=comparison.sale.reasons if comparison else (),
+            net_comparison_reasons=comparison.net.reasons if comparison else (),
+            profit_comparison_reasons=comparison.profit.reasons if comparison else (),
+        )
+
+    @staticmethod
+    def _comparison_summary(
+        cohort_count: int,
+        real_rows: list[dict[str, Any]],
+        excluded: ReportExcludedCounts,
+        basis: str,
+        metric: str,
+    ) -> OutcomeComparisonSummary:
+        field = METRIC_FIELDS[metric]
+        candidates: list[dict[str, Any]] = []
+        for row in real_rows:
+            results: OutcomeResults | None = row["results_model"]
+            if results is None:
+                continue
+            comparison = results.comparison
+            group = (
+                "manual_assumption"
+                if comparison.sale_basis == "MANUAL"
+                else "selected_market"
+                if comparison.sale_basis == "SELECTED_MARKET"
+                else "unassigned_basis"
+            )
+            if group == basis:
+                candidates.append(row)
+
+        states: Counter[str] = Counter()
+        exclusive_reasons: Counter[str] = Counter()
+        diagnostic_reasons: Counter[str] = Counter()
+        errors: list[Decimal] = []
+        for row in candidates:
+            results = row["results_model"]
+            comparison = results.comparison
+            metric_value = getattr(comparison, field if field != "item_sale_proceeds" else "sale")
+            states[metric_value.state] += 1
+            if metric_value.state != "COMPARABLE":
+                reason = metric_value.reasons[0] if metric_value.reasons else "UNSPECIFIED"
+                exclusive_reasons[f"{metric_value.state}:{reason}"] += 1
+                diagnostic_reasons.update(metric_value.reasons)
+            if metric_value.state == "COMPARABLE":
+                if (
+                    metric_value.error_exact is None
+                    or metric_value.actual_amount is None
+                    or metric_value.expected_amount is None
+                    or comparison.basis != "sold"
+                ):
+                    raise DealOutcomeError("REPORT_UNAVAILABLE")
+                error_exact = _decimal(metric_value.error_exact)
+                actual_exact = _decimal(metric_value.actual_amount)
+                expected_exact = _decimal(metric_value.expected_amount)
+                with localcontext(arithmetic_context(2200)):
+                    if actual_exact - expected_exact != error_exact:
+                        raise DealOutcomeError("REPORT_UNAVAILABLE")
+                errors.append(error_exact)
+
+        comparable = states["COMPARABLE"]
+        unavailable = states["UNAVAILABLE"]
+        noncomparable = states["NONCOMPARABLE"]
+        if comparable + unavailable + noncomparable != len(candidates):
+            raise DealOutcomeError("REPORT_UNAVAILABLE")
+        if sum(exclusive_reasons.values()) != unavailable + noncomparable:
+            raise DealOutcomeError("REPORT_UNAVAILABLE")
+        if errors:
+            with localcontext(arithmetic_context(2200)):
+                total_error = sum(errors, Decimal(0))
+            with localcontext(arithmetic_context(2200, exact=False)):
+                mean = signed_money(total_error / Decimal(len(errors)))
+            label: Literal["COMPLETE", "PARTIAL", "UNAVAILABLE"] = (
+                "PARTIAL" if unavailable or noncomparable else "COMPLETE"
+            )
+        else:
+            mean = None
+            label = "UNAVAILABLE"
+        real_count = len(real_rows)
+        return OutcomeComparisonSummary(
+            cohort_count=cohort_count,
+            candidate_count=len(candidates),
+            comparable_count=comparable,
+            noncomparable_count=noncomparable,
+            unavailable_count=unavailable,
+            not_applicable_count=real_count - len(candidates),
+            excluded_reason_counts=dict(sorted(exclusive_reasons.items())),
+            diagnostic_reason_counts=dict(sorted(diagnostic_reasons.items())),
+            mean_signed_error=mean,
+            label=label,
+            excluded_by_classification=excluded,
+        )
+
+    @classmethod
+    def _summary(cls, rows: list[dict[str, Any]], total_count: int) -> OutcomesReportSummary:
+        classes: Counter[str] = Counter({name: 0 for name in CLASSIFICATIONS})
+        for row in rows:
+            classes[row["classification"]] += 1
+        excluded = _excluded_counts(classes)
+        real_rows = [row for row in rows if row["classification"] == "REAL"]
+        counts: Counter[OutcomeState] = Counter()
+        for row in real_rows:
+            actuals: OutcomeActuals | None = row["actuals_model"]
+            if actuals is None:
+                state: OutcomeState = "NOT_RECORDED"
+            elif actuals.purchase_decision == "NOT_BOUGHT":
+                state = "NOT_BOUGHT"
+            else:
+                sale_status = actuals.sale_status
+                if sale_status is None:
+                    raise DealOutcomeError("REPORT_UNAVAILABLE")
+                state = sale_status
+            counts[state] += 1
+
+        def outcome_candidates(
+            predicate: Callable[[OutcomeActuals], bool], getter: Callable[[dict[str, Any]], object]
+        ) -> list[tuple[dict[str, Any], str | None]]:
+            selected: list[tuple[dict[str, Any], str | None]] = []
+            for row in real_rows:
+                actuals: OutcomeActuals | None = row["actuals_model"]
+                results: OutcomeResults | None = row["results_model"]
+                if actuals is not None and predicate(actuals):
+                    value = getter({"actuals": actuals, "results": results})
+                    selected.append((row, _known_amount(value)))
+            return selected
+
+        def outcome_count_candidates(
+            predicate: Callable[[OutcomeActuals], bool], getter: Callable[[dict[str, Any]], object]
+        ) -> list[tuple[dict[str, Any], int | None]]:
+            selected: list[tuple[dict[str, Any], int | None]] = []
+            for row in real_rows:
+                actuals: OutcomeActuals | None = row["actuals_model"]
+                if actuals is not None and predicate(actuals):
+                    value = getter({"actuals": actuals, "results": row["results_model"]})
+                    if value is not None and (
+                        not isinstance(value, int) or isinstance(value, bool) or value < 0
+                    ):
+                        raise DealOutcomeError("REPORT_UNAVAILABLE")
+                    selected.append((row, value))
+            return selected
+
+        def bought(actuals: OutcomeActuals) -> bool:
+            return actuals.purchase_decision == "BOUGHT"
+
+        def unsold(actuals: OutcomeActuals) -> bool:
+            return bought(actuals) and actuals.sale_status == "NOT_SOLD"
+
+        def partial(actuals: OutcomeActuals) -> bool:
+            return bought(actuals) and actuals.sale_status == "PARTIALLY_SOLD"
+
+        def complete(actuals: OutcomeActuals) -> bool:
+            return bought(actuals) and actuals.sale_status == "COMPLETE"
+
+        def result_amount(key: str) -> Callable[[dict[str, Any]], object]:
+            return lambda item: getattr(item["results"], key).amount if item["results"] else None
+
+        unsold_acquisition = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(unsold, result_amount("acquisition")),
+        )
+        partial_acquisition = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(partial, result_amount("acquisition")),
+        )
+        partial_gross = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(partial, result_amount("gross")),
+        )
+        completed_gross = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(complete, result_amount("gross")),
+        )
+        completed_net = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(complete, result_amount("net")),
+        )
+        completed_profit = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(complete, result_amount("profit")),
+        )
+        paid_labor = _subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_candidates(bought, lambda item: item["actuals"].labor_costs),
+        )
+        labor_minutes = _count_subtotal(
+            cohort_count=len(rows),
+            real_count=len(real_rows),
+            excluded=excluded,
+            candidates=outcome_count_candidates(bought, lambda item: item["actuals"].labor_minutes),
+        )
+        comparisons = OutcomeComparisonReport(
+            selected_market=OutcomeComparisonBasis(
+                **{
+                    metric: cls._comparison_summary(
+                        len(rows), real_rows, excluded, "selected_market", metric
+                    )
+                    for metric in COMPARISON_METRICS
+                }
+            ),
+            manual_assumption=OutcomeComparisonBasis(
+                **{
+                    metric: cls._comparison_summary(
+                        len(rows), real_rows, excluded, "manual_assumption", metric
+                    )
+                    for metric in COMPARISON_METRICS
+                }
+            ),
+            unassigned_basis=OutcomeComparisonBasis(
+                **{
+                    metric: cls._comparison_summary(
+                        len(rows), real_rows, excluded, "unassigned_basis", metric
+                    )
+                    for metric in COMPARISON_METRICS
+                }
+            ),
+            no_outcome_count=sum(1 for row in real_rows if row["actuals_model"] is None),
+        )
+        return OutcomesReportSummary(
+            total_roots=total_count,
+            selected_roots=len(rows),
+            outside_date_range=total_count - len(rows),
+            classification_counts={name: classes[name] for name in CLASSIFICATIONS},
+            real_outcome_counts={state: counts[state] for state in OUTCOME_STATES},
+            unsold_acquisition=unsold_acquisition,
+            partially_sold_acquisition=partial_acquisition,
+            partial_gross_to_date=partial_gross,
+            completed_gross=completed_gross,
+            completed_net=completed_net,
+            completed_profit=completed_profit,
+            paid_labor=paid_labor,
+            unpaid_labor_minutes=labor_minutes,
+            comparisons=comparisons,
+        )
+
+    def classification(
+        self,
+        token: str | None,
+        identifier: UUID,
+        *,
+        before_revision: int | None = None,
+    ) -> ClassificationResponse:
+        if before_revision is not None and not 1 <= before_revision <= 2_147_483_646:
+            raise ValueError("invalid_before_revision")
+        try:
+            with subject_transaction(self.database, token, None) as (c, session):
+                root = root_for_owner(c, session.principal_id, identifier)["id"]
+                latest = latest_subject(
+                    c, session.principal_id, listing_id=None, root_forecast_id=root
+                )
+                history = c.execute(
+                    "SELECT * FROM public.dataset_subject_revision WHERE owner_id=%s "
+                    "AND root_forecast_id=%s AND listing_id IS NULL "
+                    "AND (%s::integer IS NULL OR revision<%s) "
+                    "ORDER BY revision DESC LIMIT 21",
+                    (session.principal_id, root, before_revision, before_revision),
+                ).fetchall()
+                latest_request = _validated_subject(latest, root) if latest else None
+                entries = []
+                for row in history[:20]:
+                    request = _validated_subject(row, root)
+                    entries.append(_classification_entry(row, request))
+                return ClassificationResponse(
+                    root_forecast_id=root,
+                    classification=latest_request.classification if latest_request else "UNKNOWN",
+                    revision=latest["revision"] if latest else 0,
+                    latest=_classification_entry(latest, latest_request)
+                    if latest and latest_request
+                    else None,
+                    history=tuple(entries),
+                    next_before_revision=history[19]["revision"] if len(history) > 20 else None,
+                )
+        except psycopg.errors.UndefinedTable:
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+        except psycopg.errors.InsufficientPrivilege:
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+        except DatasetError as error:
+            raise DealOutcomeError(
+                "CLASSIFICATION_NOT_FOUND"
+                if str(error) == "DATASET_NOT_FOUND"
+                else "REPORT_UNAVAILABLE"
+            ) from None
+
+    def append_classification(
+        self,
+        token: str | None,
+        csrf: str | None,
+        identifier: UUID,
+        body: ClassificationAppend,
+    ) -> ClassificationEntry:
+        try:
+            with subject_transaction(self.database, token, csrf, write=True) as (c, session):
+                root = root_for_owner(c, session.principal_id, identifier)["id"]
+                request = SubjectReview(
+                    id=body.id,
+                    expected_revision=body.expected_revision,
+                    reason=body.reason,
+                    root_forecast_id=root,
+                    classification=body.classification,
+                    evidence_ref=body.evidence_ref,
+                )
+                prior = replay(c, session.principal_id, request)
+                if prior is None:
+                    row = append_subject(c, session.principal_id, request)
+                else:
+                    replayed = c.execute(
+                        "SELECT * FROM public.dataset_subject_revision WHERE id=%s AND owner_id=%s "
+                        "AND root_forecast_id=%s AND listing_id IS NULL",
+                        (request.id, session.principal_id, root),
+                    ).fetchone()
+                    if replayed is None:
+                        raise DealOutcomeError("CLASSIFICATION_ID_REUSED")
+                    row = replayed
+                validated = _validated_subject(row, root)
+                return_entry = _classification_entry(row, validated)
+            return return_entry
+        except psycopg.errors.UndefinedTable:
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+        except psycopg.errors.InsufficientPrivilege:
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+        except DatasetError as error:
+            code = {
+                "DATASET_NOT_FOUND": "CLASSIFICATION_NOT_FOUND",
+                "DATASET_CONFLICT": "CLASSIFICATION_CONFLICT",
+                "DATASET_ID_REUSED": "CLASSIFICATION_ID_REUSED",
+                "DATASET_FIXTURE_STICKY": "CLASSIFICATION_FIXTURE_STICKY",
+                "DATASET_UNAVAILABLE": "REPORT_UNAVAILABLE",
+            }.get(str(error), "REPORT_UNAVAILABLE")
+            raise DealOutcomeError(code) from None
+
+    def report(
+        self,
+        token: str | None,
+        *,
+        from_date: date | None = None,
+        to_date: date | None = None,
+        offset: int = 0,
+        snapshot: str | None = None,
+    ) -> OutcomesReportResponse:
+        if from_date is not None and to_date is not None and from_date > to_date:
+            raise ValueError("invalid_date_range")
+        if offset < 0 or (offset > 0 and snapshot is None):
+            raise DealOutcomeError("REPORT_CHANGED")
+        try:
+            with subject_transaction(self.database, token, None) as (c, session):
+                source_rows = self._latest_rows(c, session.principal_id)
+                computed = self._fingerprint(source_rows, from_date, to_date)
+                if snapshot is not None and snapshot != computed:
+                    raise DealOutcomeError("REPORT_CHANGED")
+                selected = [
+                    row
+                    for row in source_rows
+                    if self._date_in_range(row["saved_at"], from_date, to_date)
+                ]
+                parsed_selected = [self._parse_row(row) for row in selected]
+                summary = self._summary(parsed_selected, len(source_rows))
+                if offset > len(parsed_selected):
+                    raise DealOutcomeError("REPORT_CHANGED")
+                page = parsed_selected[offset : offset + PAGE_SIZE]
+                next_offset = (
+                    offset + PAGE_SIZE if offset + PAGE_SIZE < len(parsed_selected) else None
+                )
+                return OutcomesReportResponse(
+                    from_date=from_date,
+                    to_date=to_date,
+                    snapshot=computed,
+                    offset=offset,
+                    page_size=PAGE_SIZE,
+                    next_offset=next_offset,
+                    summary=summary,
+                    rows=tuple(self._root_item(row) for row in page),
+                )
+        except DealOutcomeError:
+            raise
+        except (psycopg.errors.UndefinedTable, psycopg.errors.InsufficientPrivilege):
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+        except DatasetError:
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+        except (InvalidOperation, OverflowError, TypeError):
+            raise DealOutcomeError("REPORT_UNAVAILABLE") from None
