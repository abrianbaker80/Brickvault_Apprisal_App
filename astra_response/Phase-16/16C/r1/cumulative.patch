+++ b/apps/web/src/deal-outcomes-api.ts
@@ -0,0 +1,102 @@
+import createClient from 'openapi-fetch';
+import type { components, paths } from '@brickvault/contracts';
+import { sessionFetch } from './session-client';
+
+export type OutcomesReport = components['schemas']['OutcomesReportResponse'];
+export type OutcomesReportRow = components['schemas']['OutcomesReportRow'];
+export type Classification = components['schemas']['ClassificationAppend']['classification'];
+export type ClassificationAppend = components['schemas']['ClassificationAppend'];
+export type ClassificationResponse = components['schemas']['ClassificationResponse'];
+
+export class DealOutcomesRequestError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string | null,
+  ) {
+    super(
+      status === 409 && code === 'REPORT_CHANGED'
+        ? 'Saved outcomes changed between pages. The report has restarted.'
+        : status === 409
+          ? 'Classification changed. Reload it before making a new decision.'
+          : status === 404
+            ? 'Saved deal not found.'
+            : 'The outcomes report is unavailable. Existing saved deals remain available.',
+    );
+  }
+}
+
+const client = () => createClient<paths>({ fetch: sessionFetch });
+const options = (signal: AbortSignal) => ({
+  signal,
+  cache: 'no-store' as const,
+  redirect: 'error' as const,
+});
+
+function fail(status: number, error: unknown): never {
+  const code = (error as { error?: { code?: string } } | undefined)?.error?.code ?? null;
+  throw new DealOutcomesRequestError(status, code);
+}
+
+export async function getOutcomesReport(
+  filters: {
+    from_date: string;
+    to_date: string;
+    offset: number;
+    snapshot: string | null;
+  },
+  signal: AbortSignal,
+): Promise<OutcomesReport> {
+  const query = {
+    ...(filters.from_date ? { from_date: filters.from_date } : {}),
+    ...(filters.to_date ? { to_date: filters.to_date } : {}),
+    ...(filters.offset ? { offset: filters.offset } : {}),
+    ...(filters.snapshot ? { snapshot: filters.snapshot } : {}),
+  };
+  const { data, error, response } = await client().GET('/api/deal-outcomes/report', {
+    ...options(signal),
+    params: { query },
+  });
+  if (!data) fail(response.status, error);
+  if (data.offset !== filters.offset || data.page_size !== 100)
+    throw new Error('Invalid outcomes report page');
+  return data;
+}
+
+export async function getClassification(
+  root: string,
+  signal: AbortSignal,
+  beforeRevision?: number,
+): Promise<ClassificationResponse> {
+  const { data, error, response } = await client().GET(
+    '/api/deal-forecasts/{identifier}/classification',
+    {
+      ...options(signal),
+      params: {
+        path: { identifier: root },
+        query: beforeRevision === undefined ? {} : { before_revision: beforeRevision },
+      },
+    },
+  );
+  if (!data) fail(response.status, error);
+  if (data.root_forecast_id !== root) throw new Error('Invalid classification root');
+  return data;
+}
+
+export async function appendClassification(
+  root: string,
+  body: ClassificationAppend,
+  signal: AbortSignal,
+): Promise<components['schemas']['ClassificationEntry']> {
+  const { data, error, response } = await client().POST(
+    '/api/deal-forecasts/{identifier}/classification',
+    {
+      ...options(signal),
+      params: { path: { identifier: root } },
+      body,
+    },
+  );
+  if (!data) fail(response.status, error);
+  if (data.id !== body.id || data.revision !== body.expected_revision + 1)
+    throw new Error('Uncertain classification identity');
+  return data;
+}
