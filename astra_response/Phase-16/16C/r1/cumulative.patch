+                    id,root_forecast_id,revision,actuals,results
+                FROM public.deal_outcome_revision
+                WHERE owner_id=%s ORDER BY root_forecast_id,revision DESC
+            ), subjects AS (
+                SELECT DISTINCT ON(root_forecast_id)
+                    id,root_forecast_id,revision,recorded_at,request_hash,request,data
+                FROM public.dataset_subject_revision
+                WHERE owner_id=%s AND root_forecast_id IS NOT NULL AND listing_id IS NULL
+                ORDER BY root_forecast_id,revision DESC
+            )
+            SELECT roots.id AS root_forecast_id,roots.saved_at,
+                   outcomes.id AS outcome_id,outcomes.revision AS outcome_revision,
+                   outcomes.actuals,outcomes.results,
+                   subjects.id AS classification_id,subjects.revision AS classification_revision,
+                   subjects.recorded_at AS classification_recorded_at,
+                   subjects.request_hash AS classification_request_hash,
+                   subjects.request AS classification_request,subjects.data AS classification_data
+            FROM roots
+            LEFT JOIN outcomes ON outcomes.root_forecast_id=roots.id
+            LEFT JOIN subjects ON subjects.root_forecast_id=roots.id
+            ORDER BY roots.saved_at DESC,roots.id""",
+            (owner, owner, owner),
+        ).fetchall()
+
+    @staticmethod
+    def _parse_row(row: dict[str, Any]) -> dict[str, Any]:
+        parsed = dict(row)
+        if row["classification_id"] is None:
+            parsed["classification"] = "UNKNOWN"
+            parsed["classification_revision"] = 0
+            parsed["classification_request"] = None
+        else:
+            subject_row = {
+                "id": row["classification_id"],
+                "revision": row["classification_revision"],
+                "recorded_at": row["classification_recorded_at"],
+                "request_hash": row["classification_request_hash"],
+                "request": row["classification_request"],
+                "data": row["classification_data"],
+            }
+            request = _validated_subject(subject_row, row["root_forecast_id"])
+            parsed["classification"] = request.classification
+            parsed["classification_request"] = request
+        if row["outcome_id"] is not None:
+            try:
+                actuals = OutcomeActuals.model_validate_json(canonical(row["actuals"]))
+                results = OutcomeResults.model_validate_json(canonical(row["results"]))
+                if (
+                    results.comparison.original_id != row["root_forecast_id"]
+                    or actuals.currency != "USD"
+                    or results.currency != actuals.currency
+                    or results.calculation_version != "outcome-calculation-v1"
+                    or results.rounding_version != "whole-set-usd-rounding-v1"
+                    or (actuals.purchase_decision == "NOT_BOUGHT" and results.state != "NOT_BOUGHT")
+                    or (
+                        actuals.purchase_decision == "BOUGHT"
+                        and actuals.sale_status in ("NOT_SOLD", "PARTIALLY_SOLD")
+                        and results.state != actuals.sale_status
+                    )
+                    or (
+                        actuals.purchase_decision == "BOUGHT"
+                        and actuals.sale_status == "COMPLETE"
+                        and results.state not in ("INCOMPLETE", "COMPLETE")
+                    )
+                ):
+                    raise ValueError("outcome_baseline_mismatch")
+            except (KeyError, TypeError, ValueError):
+                raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+            parsed["actuals_model"] = actuals
+            parsed["results_model"] = results
+        else:
+            parsed["actuals_model"] = None
+            parsed["results_model"] = None
+        return parsed
+
+    @staticmethod
+    def _fingerprint(
+        rows: list[dict[str, Any]], from_date: date | None, to_date: date | None
+    ) -> str:
+        identity = {
+            "version": "deal-outcomes-report-v1",
+            "from_date": from_date.isoformat() if from_date else None,
+            "to_date": to_date.isoformat() if to_date else None,
+            "roots": [
+                [
+                    str(row["root_forecast_id"]),
+                    row["saved_at"].isoformat(),
+                    str(row["outcome_id"]) if row["outcome_id"] else None,
+                    row["outcome_revision"],
+                    str(row["classification_id"]) if row["classification_id"] else None,
+                    row["classification_revision"] or 0,
+                ]
+                for row in rows
+            ],
+        }
+        return sha256(canonical(identity)).hexdigest()
+
+    @staticmethod
