@@ -0,0 +1,205 @@
+"""One synthetic outcomes/classification UI flow with owned TEST PostgreSQL."""
+
+import json
+import os
+import socket
+import subprocess
+from pathlib import Path
+from threading import Event, Thread
+from uuid import UUID, uuid4
+
+import pytest
+import uvicorn
+from pydantic import SecretStr
+
+from brickvault_api.api.forecasts import forecast_service
+from brickvault_api.auth import AuthService
+from brickvault_api.deal_outcomes import DealOutcomesService
+from brickvault_api.deal_outcomes_models import ClassificationAppend
+from brickvault_api.main import create_app
+from brickvault_api.outcome_models import OutcomeActuals, OutcomeAppend
+from brickvault_api.outcomes import OutcomeService
+from brickvault_api.settings import RuntimeSettings
+
+from .test_catalog_queries import owner_engine as owner_engine
+from .test_catalog_schema import synthetic as synthetic
+from .test_forecasts import ForecastHarness
+from .test_forecasts import forecasts as forecasts
+from .test_forecasts import no_provider_network as no_provider_network
+from .test_market import market as market
+from .test_product import forbid_market_actions
+
+
+def test_deal_outcomes_desktop_and_narrow_browser_flow(
+    forecasts: ForecastHarness,
+    monkeypatch: pytest.MonkeyPatch,
+    no_provider_network: None,
+) -> None:
+    h = forecasts
+    root_path = Path(__file__).resolve().parents[4]
+    output = root_path / ".local/phase16c-outcomes"
+    output.mkdir(parents=True, exist_ok=True)
+    root = h.save(h.preview().status.id)
+    outcomes = OutcomeService(h.market.app.database)
+    outcomes.append(
+        h.token,
+        h.csrf,
+        root.id,
+        OutcomeAppend(
+            id=uuid4(),
+            expected_revision=0,
+            actuals=OutcomeActuals(
+                purchase_decision="BOUGHT",
+                sale_status="COMPLETE",
+                purchase_price="100",
+                acquisition_extra_costs="0",
+                item_sale_proceeds="80",
+                shipping_charged="0",
+                selling_fees="10",
+                shipping_paid="5",
+                other_selling_costs="0",
+                replacement_costs="0",
+                labor_costs="0",
+                labor_minutes=30,
+            ),
+        ),
+    )
+    before_forecast = h.row(root.id)
+    with h.market.owner.database.connect() as connection:
+        before_outcomes = connection.execute(
+            "SELECT * FROM public.deal_outcome_revision WHERE root_forecast_id=%s ORDER BY revision",
+            (root.id,),
+        ).fetchall()
+
+    original_append = DealOutcomesService.append_classification
+    injected = False
+
+    def conflict_once(
+        service: DealOutcomesService,
+        token: str | None,
+        csrf: str | None,
+        identifier: UUID,
+        body: ClassificationAppend,
+    ) -> object:
+        nonlocal injected
+        if (
+            not injected
+            and body.expected_revision == 0
+            and body.classification == "REAL"
+            and body.reason == "Initial classification attempt"
+        ):
+            injected = True
+            original_append(
+                service,
+                token,
+                csrf,
+                identifier,
+                ClassificationAppend(
+                    id=uuid4(),
+                    expected_revision=0,
+                    classification="EXCLUDED",
+                    reason="Competing TEST classification",
+                    evidence_ref="test-race",
+                ),
+            )
+        return original_append(service, token, csrf, identifier, body)
+
+    monkeypatch.setattr(DealOutcomesService, "append_classification", conflict_once)
+    forbid_market_actions(monkeypatch)
+    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    listener.bind(("127.0.0.1", 0))
+    port = listener.getsockname()[1]
+    settings = RuntimeSettings(
+        purpose="test",
+        port=port,
+        auth_allow_loopback_http=True,
+        static_enabled=True,
+        web_build_dir=str(root_path / "apps/web/dist"),
+        database_url=SecretStr(h.market.app.database.url),
+        database_ownership_marker=SecretStr(h.market.app.database.ownership_marker),
+    )
+    app = create_app(settings)
+    app.dependency_overrides[forecast_service] = lambda: h.service
+    ready = Event()
+    server = uvicorn.Server(uvicorn.Config(app, access_log=False, log_config=None))
+    startup = server.startup
+
+    async def start(sockets: list[socket.socket] | None = None) -> None:
+        await startup(sockets)
+        app.state.auth = AuthService(h.market.app.database, clock=h.market.clock)
+        ready.set()
+
+    monkeypatch.setattr(server, "startup", start)
+    thread = Thread(target=lambda: server.run(sockets=[listener]), daemon=True)
+    thread.start()
+    report: dict[str, object] = {}
+    try:
+        assert ready.wait(20), "Owned TEST API did not start"
+        allowed_env = {
+            "PATH",
+            "SYSTEMROOT",
+            "WINDIR",
+            "TEMP",
+            "TMP",
+            "USERPROFILE",
+            "LOCALAPPDATA",
+            "APPDATA",
+        }
+        environment = {
+            key: value for key, value in os.environ.items() if key.upper() in allowed_env
+        }
+        environment.update(
+            {
+                "BVA_E2E_API_URL": f"http://127.0.0.1:{port}",
+                "BVA_E2E_PASSWORD": h.password,
+                "BVA_TEST_TIME": h.market.clock().isoformat(),
+                "BVA_OUTCOME_ROOT": str(root.id),
+            }
+        )
+        result = subprocess.run(
+            ["node", str(root_path / "apps/web/e2e/deal-outcomes-real.mjs")],
+            cwd=root_path,
+            env=environment,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            timeout=150,
+        )
+        diagnostics = "\n".join(
+            line
+            for line in result.stdout.splitlines()
+            if line.startswith("PHASE16C_UI_DIAGNOSTIC ")
+        )
+        assert result.returncode == 0, f"{result.stderr}\n{diagnostics}"
+        report = json.loads(result.stdout)
+        assert report["classification_conflict_recovered"] is True
+        assert report["classification_readback"] is True
+        assert report["missing_information_visible"] is True
+        assert report["desktop_and_320px"] is True
+        assert injected
+        assert before_forecast == h.row(root.id)
+        with h.market.owner.database.connect() as connection:
+            after_outcomes = connection.execute(
+                "SELECT * FROM public.deal_outcome_revision WHERE root_forecast_id=%s ORDER BY revision",
+                (root.id,),
+            ).fetchall()
+            classifications = connection.execute(
+                "SELECT revision,data FROM public.dataset_subject_revision "
+                "WHERE root_forecast_id=%s AND listing_id IS NULL ORDER BY revision",
+                (root.id,),
+            ).fetchall()
+        assert before_outcomes == after_outcomes
+        assert [(row["revision"], row["data"]["classification"]) for row in classifications] == [
+            (1, "EXCLUDED"),
+            (2, "REAL"),
+        ]
+        report["forecast_and_outcome_history_unchanged"] = True
+        report["classification_revisions_verified"] = 2
+    finally:
+        server.should_exit = True
+        thread.join(timeout=15)
+        listener.close()
+        assert not thread.is_alive(), "Owned TEST API did not stop"
+    assert report
+    report["owned_api_stopped"] = True
+    (output / "browser-result.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
diff --git a/services/api/tests/integration/test_deal_outcomes_report.py b/services/api/tests/integration/test_deal_outcomes_report.py
