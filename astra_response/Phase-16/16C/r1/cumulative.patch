+
+
+def test_root_classification_history_never_uses_listing_graph_metadata_cap(
+    monkeypatch: Any,
+) -> None:
+    queries: list[str] = []
+
+    def rows(_connection: CatalogConnection, query: str, _owner: Any) -> list[dict[str, Any]]:
+        queries.append(query)
+        return []
+
+    monkeypatch.setattr(dataset_service, "rows", rows)
+    dataset_service.graph(cast(CatalogConnection, object()), uuid4())
+    subject_queries = [query for query in queries if "dataset_subject_revision" in query]
