+class DealOutcomeError(ValueError):
+    def __init__(self, code: str) -> None:
+        self.code = code
+        super().__init__(code)
+
+
+def _decimal(value: object) -> Decimal:
+    if not isinstance(value, str):
+        raise DealOutcomeError("REPORT_UNAVAILABLE")
+    try:
+        parsed = Decimal(value)
+    except InvalidOperation:
+        raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+    if not parsed.is_finite():
+        raise DealOutcomeError("REPORT_UNAVAILABLE")
+    return parsed
+
+
+def _validated_subject(row: dict[str, Any], root_id: UUID) -> SubjectReview:
+    try:
+        request = SubjectReview.model_validate_json(canonical(row["request"]))
+        data = SubjectReview.model_validate_json(canonical(row["data"]))
+        if (
+            request != data
+            or request.id != row["id"]
+            or request.root_forecast_id != root_id
+            or request.listing_id is not None
+        ):
+            raise ValueError("subject_mismatch")
+        if row["request_hash"] != digest(request.model_dump(mode="json")):
+            raise ValueError("subject_hash")
+        if row["revision"] != request.expected_revision + 1:
+            raise ValueError("subject_revision")
+        return data
+    except (KeyError, TypeError, ValueError):
+        raise DealOutcomeError("REPORT_UNAVAILABLE") from None
+
+
+def _classification_entry(row: dict[str, Any], request: SubjectReview) -> ClassificationEntry:
+    return ClassificationEntry(
+        id=row["id"],
+        revision=row["revision"],
+        recorded_at=row["recorded_at"],
+        classification=request.classification,
+        reason=request.reason,
+        evidence_ref=request.evidence_ref,
+    )
+
+
+def _excluded_counts(counts: Counter[str]) -> ReportExcludedCounts:
+    return ReportExcludedCounts(
+        unknown=counts["UNKNOWN"],
+        synthetic=counts["SYNTHETIC"],
+        excluded=counts["EXCLUDED"],
+    )
+
+
+def _known_amount(value: object) -> str | None:
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        raise DealOutcomeError("REPORT_UNAVAILABLE")
+    _decimal(value)
+    return value
+
+
+def _subtotal(
+    *,
+    cohort_count: int,
+    real_count: int,
+    excluded: ReportExcludedCounts,
+    candidates: list[tuple[dict[str, Any], str | None]],
+) -> ReportSubtotal:
+    included = [Decimal(value) for _, value in candidates if value is not None]
+    eligible = len(candidates)
+    missing = eligible - len(included)
+    if included:
+        with localcontext(arithmetic_context(2200)):
+            amount = signed_money(sum(included, Decimal(0)))
+        label: Literal["COMPLETE", "PARTIAL", "UNAVAILABLE"] = "PARTIAL" if missing else "COMPLETE"
+    else:
+        amount = None
+        label = "UNAVAILABLE"
+    return ReportSubtotal(
+        amount=amount,
+        label=label,
+        cohort_count=cohort_count,
+        eligible_count=eligible,
+        included_count=len(included),
+        missing_count=missing,
+        not_applicable_count=real_count - eligible,
+        excluded_by_classification=excluded,
+    )
+
+
+def _count_subtotal(
+    *,
+    cohort_count: int,
+    real_count: int,
+    excluded: ReportExcludedCounts,
+    candidates: list[tuple[dict[str, Any], int | None]],
+) -> ReportCountSubtotal:
+    included = [value for _, value in candidates if value is not None]
+    eligible = len(candidates)
+    missing = eligible - len(included)
+    if included:
+        value: int | None = sum(included)
+        label: Literal["COMPLETE", "PARTIAL", "UNAVAILABLE"] = "PARTIAL" if missing else "COMPLETE"
+    else:
+        value = None
+        label = "UNAVAILABLE"
+    return ReportCountSubtotal(
+        value=value,
+        label=label,
+        cohort_count=cohort_count,
+        eligible_count=eligible,
+        included_count=len(included),
+        missing_count=missing,
+        not_applicable_count=real_count - eligible,
+        excluded_by_classification=excluded,
+    )
