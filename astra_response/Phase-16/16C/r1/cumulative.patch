diff --git a/apps/web/e2e/deal-outcomes-real.mjs b/apps/web/e2e/deal-outcomes-real.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f2370d63305b9c349beba2b4c7abc07d7323103c
--- /dev/null
+++ b/apps/web/e2e/deal-outcomes-real.mjs
@@ -0,0 +1,157 @@
+import { mkdir } from 'node:fs/promises';
+import { chromium, expect } from '@playwright/test';
+
+const baseURL = process.env.BVA_E2E_API_URL;
+if (!/^http:\/\/127\.0\.0\.1:[0-9]+$/u.test(baseURL ?? ''))
+  throw Error('Owned loopback TEST API required');
+const root = process.env.BVA_OUTCOME_ROOT;
+const clock = new Date(process.env.BVA_TEST_TIME);
+const output = '.local/phase16c-outcomes';
+await mkdir(output, { recursive: true });
+const browser = await chromium.launch();
+try {
+  const context = await browser.newContext({
+    baseURL,
+    viewport: { width: 1440, height: 1000 },
+    serviceWorkers: 'block',
+  });
+  const page = await context.newPage();
+  page.setDefaultTimeout(10_000);
+  const errors = [];
+  const forbidden = [];
+  const classificationWrites = [];
+  page.on('pageerror', (error) => errors.push(error.message));
+  await page.route('**/*', (route) => {
+    const request = route.request();
+    const url = new URL(request.url());
+    if (
+      url.origin !== baseURL ||
+      /market-refresh|product-refresh|catalog\/(?:download|import)/u.test(url.pathname)
+    ) {
+      forbidden.push(`${request.method()} ${url.origin}${url.pathname}`);
+      return route.abort();
+    }
+    if (url.pathname.endsWith('/classification') && request.method() === 'POST')
+      classificationWrites.push(url.pathname);
+    return route.continue();
+  });
+  await page.clock.install({ time: clock });
+  await page.goto('/deals');
+  await page.getByLabel('Password', { exact: true }).fill(process.env.BVA_E2E_PASSWORD);
+  await page.getByRole('button', { name: 'Sign in', exact: true }).click();
+
+  const report = page.getByRole('region', { name: 'Outcomes report', exact: true });
+  await expect(report.getByRole('heading', { name: 'Outcomes report', exact: true })).toBeVisible();
+  const row = report.locator('.outcomes-report-row').first();
+  await expect(row).toBeVisible();
+  await expect(row).toContainText('Unknown');
+  await row.getByRole('button', { name: 'Review classification', exact: true }).click();
+  await expect(row.getByText('Current: Unknown · revision 0.', { exact: false })).toBeVisible();
+  const classSelect = row.locator('.outcomes-classification select');
+  console.error(
+    `PHASE16C_UI_DIAGNOSTIC ${JSON.stringify({
+      controls: await classSelect.count(),
+      enabled: (await classSelect.count()) ? await classSelect.isEnabled() : false,
+    })}`,
+  );
+  await classSelect.selectOption('REAL');
+  await row.getByLabel('Reason', { exact: true }).fill('Initial classification attempt');
+  await row.getByLabel('Opaque evidence reference key', { exact: true }).fill('e2e-outcome-note');
+  const conflictResponse = page.waitForResponse(
+    (response) =>
+      response.request().method() === 'POST' &&
+      response.url().endsWith(`/api/deal-forecasts/${root}/classification`),
+  );
+  await row.getByRole('button', { name: 'Save classification', exact: true }).click();
+  expect((await conflictResponse).status()).toBe(409);
+  await expect(row.getByRole('button', { name: 'Reload current classification' })).toBeVisible();
+  const conflictReload = page.waitForResponse(
+    (response) =>
+      response.request().method() === 'GET' &&
+      response.url().endsWith(`/api/deal-forecasts/${root}/classification`),
+  );
+  await row.getByRole('button', { name: 'Reload current classification' }).click();
+  expect((await conflictReload).status()).toBe(200);
+  await expect(row.getByText('Current: Excluded · revision 1.', { exact: false })).toBeVisible();
+  await classSelect.selectOption('REAL');
+  await row.getByLabel('Reason', { exact: true }).fill('Verified saved TEST outcome');
+  await row.getByLabel('Opaque evidence reference key', { exact: true }).fill('e2e-outcome-note-2');
+  const savedResponse = page.waitForResponse(
+    (response) =>
+      response.request().method() === 'POST' &&
+      response.url().endsWith(`/api/deal-forecasts/${root}/classification`),
+  );
+  const readback = page.waitForResponse(
+    (response) =>
+      response.request().method() === 'GET' &&
+      response.url().endsWith(`/api/deal-forecasts/${root}/classification`),
+  );
+  const refreshedReport = page.waitForResponse(
+    (response) =>
+      response.request().method() === 'GET' &&
+      new URL(response.url()).pathname === '/api/deal-outcomes/report',
+  );
+  await row.getByRole('button', { name: 'Save classification', exact: true }).click();
+  const saved = await savedResponse;
+  expect(saved.status()).toBe(200);
+  expect((await saved.json()).classification).toBe('REAL');
+  expect((await readback).status()).toBe(200);
+  await expect(report.getByText('Real outcome records (1 roots)', { exact: false })).toBeVisible();
+  expect((await refreshedReport).status()).toBe(200);
+  await expect(report.getByText('Completed sales profit', { exact: true })).toBeVisible();
+  await expect(report.getByText('−$35.00 USD', { exact: true })).toBeVisible();
+  await expect(row).toContainText('Real');
+  await expect(row.getByText(/Missing information:.*sale channel/u)).toBeVisible();
+
+  await row.getByRole('link', { name: 'Open deal and outcome history', exact: true }).click();
+  const outcome = page.getByRole('region', { name: 'Actual outcome', exact: true });
+  await expect(
+    outcome.getByRole('heading', { name: 'Recorded outcome · revision 1' }),
+  ).toBeVisible();
+  await outcome.getByText('Outcome history', { selector: 'summary', exact: true }).click();
+  await outcome.getByRole('button', { name: 'View outcome revision 1', exact: true }).click();
+  await expect(
+    page.getByRole('region', { name: 'Historical actual outcome', exact: true }),
+  ).toBeVisible();
+
+  await page.goto('/deals');
+  await page.setViewportSize({ width: 320, height: 1000 });
+  await expect(page.locator('.outcomes-report-row').first()).toContainText('Real');
+  const day = clock.toISOString().slice(0, 10);
+  await page.getByLabel('From saved date (UTC)', { exact: true }).fill(day);
+  await page.getByLabel('Through saved date (UTC)', { exact: true }).fill(day);
+  const filtered = page.waitForResponse(
+    (response) =>
+      response.request().method() === 'GET' &&
+      new URL(response.url()).pathname === '/api/deal-outcomes/report' &&
+      new URL(response.url()).searchParams.get('from_date') === day,
+  );
+  await page.getByRole('button', { name: 'Apply dates', exact: true }).click();
+  expect((await filtered).status()).toBe(200);
+  await expect(page.locator('.outcomes-report-row').first()).toContainText('Real');
+  expect(await page.evaluate(() => document.documentElement.scrollWidth)).toBeLessThanOrEqual(320);
+  await page.screenshot({ path: `${output}/outcomes-report-320.png`, fullPage: true });
+  expect(classificationWrites).toHaveLength(2);
+  expect(errors).toEqual([]);
+  expect(forbidden).toEqual([]);
+  expect(
+    await page.evaluate(() => ({ local: localStorage.length, session: sessionStorage.length })),
+  ).toEqual({
+    local: 0,
+    session: 0,
+  });
+  console.log(
+    JSON.stringify({
+      classification_conflict_recovered: true,
+      classification_readback: true,
+      missing_information_visible: true,
+      history_opened: true,
+      desktop_and_320px: true,
+      private_browser_storage: false,
+      errors,
+      forbidden,
+    }),
+  );
+} finally {
+  await browser.close();
+}
diff --git a/apps/web/src/DealClassificationControl.tsx b/apps/web/src/DealClassificationControl.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c775744e5156c0d064d1bc10b1254555d839df3f
--- /dev/null
+++ b/apps/web/src/DealClassificationControl.tsx
@@ -0,0 +1,294 @@
+import { useEffect, useState } from 'react';
+import type { FormEvent } from 'react';
+import { useConnection } from './Connectivity';
+import {
+  appendClassification,
+  DealOutcomesRequestError,
+  getClassification,
+} from './deal-outcomes-api';
+import type {
+  Classification,
+  ClassificationAppend,
+  ClassificationResponse,
+} from './deal-outcomes-api';
+
+const classifications: Classification[] = ['UNKNOWN', 'REAL', 'SYNTHETIC', 'EXCLUDED'];
+const classLabel: Record<Classification, string> = {
+  UNKNOWN: 'Unknown',
+  REAL: 'Real',
+  SYNTHETIC: 'Synthetic',
+  EXCLUDED: 'Excluded',
+};
+
+export function DealClassificationControl({
+  identifier,
+  classification: initialClassification,
+  revision: initialRevision,
+  changed,
+}: {
+  identifier: string;
+  classification?: Classification;
+  revision?: number;
+  changed?: () => void;
+}) {
+  const connection = useConnection();
+  const [open, setOpen] = useState(false);
+  const [current, setCurrent] = useState<ClassificationResponse | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [classification, setValue] = useState<Classification>(initialClassification ?? 'UNKNOWN');
+  const [reason, setReason] = useState('');
+  const [evidence, setEvidence] = useState('');
+  const [pending, setPending] = useState<ClassificationAppend | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState('');
+  const [conflict, setConflict] = useState(false);
+  const [loadFailed, setLoadFailed] = useState(false);
+  const [reload, setReload] = useState(0);
+
+  useEffect(() => {
+    if (connection.state === 'LOCKED' || connection.state === 'PUBLIC_OFFLINE_SHELL') {
+      setOpen(false);
+      setCurrent(null);
+      setReason('');
+      setEvidence('');
+      setPending(null);
+      setBusy(false);
+      setConflict(false);
+      setLoadFailed(false);
+      setMessage('');
+    }
+  }, [connection.revision, connection.state]);
+
+  useEffect(() => {
+    if (!open) return;
+    const controller = new AbortController();
+    let active = true;
+    setLoading(true);
+    setLoadFailed(false);
+    void getClassification(identifier, controller.signal)
+      .then((value) => {
+        if (!active) return;
+        setCurrent(value);
+        setValue(value.classification);
+        setConflict(false);
+        setMessage('');
+      })
+      .catch(() => {
+        if (active) {
+          setCurrent(null);
+          setLoadFailed(true);
+          setMessage('Classification history could not be loaded. Try again.');
+        }
+      })
+      .finally(() => {
+        if (active) setLoading(false);
+      });
+    return () => {
+      active = false;
+      controller.abort();
+    };
+  }, [identifier, open, reload]);
+
+  async function loadOlderHistory() {
+    if (!current?.next_before_revision || loading) return;
+    const controller = new AbortController();
+    setLoading(true);
+    setMessage('');
+    try {
+      const older = await getClassification(
+        identifier,
+        controller.signal,
+        current.next_before_revision,
+      );
+      setCurrent({
+        ...current,
+        history: [...current.history, ...older.history],
+        next_before_revision: older.next_before_revision,
+      });
+    } catch {
+      setMessage('Older classification history could not be loaded. Try again.');
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  async function send(body: ClassificationAppend) {
+    setBusy(true);
+    setMessage('');
+    const controller = new AbortController();
+    try {
+      const appended = await appendClassification(identifier, body, controller.signal);
+      const readback = await getClassification(identifier, controller.signal);
+      const confirmed =
+        readback.latest?.id === appended.id
+          ? readback.latest
+          : readback.history.find((entry) => entry.id === appended.id);
+      if (
+        !confirmed ||
+        confirmed.revision !== body.expected_revision + 1 ||
+        confirmed.classification !== body.classification ||
+        confirmed.reason !== body.reason ||
+        confirmed.evidence_ref !== body.evidence_ref
+      )
+        throw new Error('The classification could not be confirmed after saving.');
+      setPending(null);
+      setCurrent(readback);
+      setValue(readback.classification);
+      setMessage('Classification saved and read back.');
+      if (changed) changed();
+      else setReload((value) => value + 1);
+    } catch (error) {
+      if (error instanceof DealOutcomesRequestError && error.status === 409) {
+        setPending(null);
+        setConflict(true);
+        setMessage('Classification changed. Reload it, then make a deliberate new decision.');
+      } else {
+        setPending(body);
+        setMessage(
+          error instanceof Error
+            ? `${error.message} You can retry the same submission safely.`
+            : 'Classification result is uncertain. Retry the same submission safely.',
+        );
+      }
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!current || busy || conflict || pending || !reason.trim() || !evidence.trim()) return;
+    const body: ClassificationAppend = {
+      id: crypto.randomUUID(),
+      expected_revision: current.revision,
+      classification,
+      reason: reason.trim(),
+      evidence_ref: evidence.trim(),
+    };
+    setPending(body);
+    void send(body);
+  }
+
+  const readOnly = busy || loading || conflict || pending !== null;
+  return (
+    <div className="outcomes-classification">
+      <p>
+        Classification:{' '}
+        <strong>
+          {current
+            ? classLabel[current.classification]
+            : classLabel[initialClassification ?? 'UNKNOWN']}
+        </strong>{' '}
+        · revision {current?.revision ?? initialRevision ?? 0}
+      </p>
+      {!open ? (
+        <button type="button" onClick={() => setOpen(true)}>
+          Review classification
+        </button>
+      ) : (
+        <section aria-label="Saved deal classification editor">
+          <button type="button" onClick={() => setOpen(false)}>
+            Close classification
+          </button>
+          {loading && <p role="status">Loading classification…</p>}
+          {loadFailed && (
+            <button
+              type="button"
+              disabled={loading}
+              onClick={() => setReload((value) => value + 1)}
+            >
+              Retry classification read
+            </button>
+          )}
+          {current && (
+            <>
+              <p>
+                Current: {classLabel[current.classification]} · revision {current.revision}. Only
+                Real appears in performance totals. Synthetic is permanent.
+              </p>
+              <ol className="outcomes-classification-history" aria-label="Classification history">
+                {current.history.map((entry) => (
+                  <li key={entry.id}>
+                    {classLabel[entry.classification]} · revision {entry.revision} · {entry.reason}{' '}
+                    <small>Evidence reference key: {entry.evidence_ref}</small>
+                  </li>
+                ))}
+              </ol>
+              {current.next_before_revision !== null && (
+                <button type="button" disabled={loading} onClick={() => void loadOlderHistory()}>
+                  More classification history
+                </button>
+              )}
+              {conflict ? (
+                <button
+                  type="button"
+                  disabled={loading}
+                  onClick={() => {
+                    setCurrent(null);
+                    setConflict(true);
+                    setReason('');
+                    setEvidence('');
+                    setReload((value) => value + 1);
+                  }}
+                >
+                  Reload current classification
+                </button>
+              ) : (
+                <form onSubmit={submit}>
+                  <label>
+                    Classify this saved deal
+                    <select
+                      value={classification}
+                      onChange={(event) => setValue(event.currentTarget.value as Classification)}
+                      disabled={readOnly || current.classification === 'SYNTHETIC'}
+                    >
+                      {classifications.map((value) => (
+                        <option
+                          key={value}
+                          value={value}
+                          disabled={current.classification === 'SYNTHETIC' && value !== 'SYNTHETIC'}
+                        >
+                          {classLabel[value]}
+                        </option>
+                      ))}
+                    </select>
+                  </label>
+                  <label>
+                    Reason
+                    <input
+                      value={reason}
+                      onChange={(event) => setReason(event.currentTarget.value)}
+                      maxLength={500}
+                      required
+                      disabled={readOnly}
+                    />
+                  </label>
+                  <label>
+                    Opaque evidence reference key
+                    <input
+                      value={evidence}
+                      onChange={(event) => setEvidence(event.currentTarget.value)}
+                      pattern="[A-Za-z0-9_-]{1,80}"
+                      maxLength={80}
+                      required
+                      disabled={readOnly}
+                    />
+                  </label>
+                  <button disabled={readOnly || !current || !reason.trim() || !evidence.trim()}>
+                    {busy ? 'Saving…' : 'Save classification'}
+                  </button>
+                </form>
+              )}
+              {pending && !conflict && (
+                <button type="button" disabled={busy} onClick={() => void send(pending)}>
+                  Retry same submission
+                </button>
+              )}
+            </>
+          )}
+          {message && <p role="status">{message}</p>}
+        </section>
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/src/DealOutcomesReport.tsx b/apps/web/src/DealOutcomesReport.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fa57c6b8eac5fbbf48586f54943d1928a3309026
--- /dev/null
+++ b/apps/web/src/DealOutcomesReport.tsx
@@ -0,0 +1,424 @@
+import { useEffect, useState } from 'react';
+import type { FormEvent } from 'react';
+import { useConnection } from './Connectivity';
+import { DealOutcomesRequestError, getOutcomesReport } from './deal-outcomes-api';
+import { DealClassificationControl } from './DealClassificationControl';
+import type { Classification, OutcomesReport, OutcomesReportRow } from './deal-outcomes-api';
+import { ForecastLink } from './RevisionDraftPanel';
+import './outcomes-report.css';
+
+const classLabel: Record<Classification, string> = {
+  UNKNOWN: 'Unknown',
+  REAL: 'Real',
+  SYNTHETIC: 'Synthetic',
+  EXCLUDED: 'Excluded',
+};
+const words = (value: string) => value.replaceAll('_', ' ').toLowerCase();
+
+function amount(value: string | null): string {
+  if (value === null) return 'Unknown';
+  if (value.startsWith('-')) return `−$${value.slice(1)} USD`;
+  return `$${value} USD`;
+}
+
+function counts(value: {
+  cohort_count: number;
+  eligible_count: number;
+  included_count: number;
+  missing_count: number;
+  not_applicable_count: number;
+  excluded_by_classification: { unknown: number; synthetic: number; excluded: number };
+}) {
+  return (
+    <small>
+      Included {value.included_count} of {value.eligible_count} eligible; {value.missing_count}{' '}
+      missing; {value.not_applicable_count} not applicable. Outside real totals: unknown{' '}
+      {value.excluded_by_classification.unknown}, synthetic{' '}
+      {value.excluded_by_classification.synthetic}, excluded{' '}
+      {value.excluded_by_classification.excluded} of {value.cohort_count} selected roots.
+    </small>
+  );
+}
+
+function Subtotal({
+  label,
+  value,
+}: {
+  label: string;
+  value: OutcomesReport['summary']['completed_profit'];
+}) {
+  return (
+    <div className="outcomes-report-metric">
+      <dt>{label}</dt>
+      <dd>
+        {value.label === 'PARTIAL' && <strong>Partial subtotal · </strong>}
+        {value.label === 'UNAVAILABLE' ? 'No known values' : amount(value.amount)}
+      </dd>
+      {counts(value)}
+    </div>
+  );
+}
+
+function ComparisonMetric({
+  label,
+  metric,
+}: {
+  label: string;
+  metric: OutcomesReport['summary']['comparisons']['selected_market']['sale'];
+}) {
+  return (
+    <div className="outcomes-report-metric">
+      <dt>{label}</dt>
+      <dd>
+        {metric.mean_signed_error === null
+          ? 'No comparable values'
+          : `${metric.label === 'PARTIAL' ? 'Partial signed mean error · ' : 'Signed mean error · '}${amount(metric.mean_signed_error)}`}
+      </dd>
+      <small>
+        Comparable {metric.comparable_count} of {metric.candidate_count} candidates;{' '}
+        {metric.noncomparable_count} noncomparable; {metric.unavailable_count} unavailable;{' '}
+        {metric.not_applicable_count} not applicable; classification excluded unknown{' '}
+        {metric.excluded_by_classification.unknown}, synthetic{' '}
+        {metric.excluded_by_classification.synthetic}, excluded{' '}
+        {metric.excluded_by_classification.excluded} of {metric.cohort_count} selected roots.
+        {Object.keys(metric.excluded_reason_counts).length > 0 && (
+          <>
+            {' '}
+            Excluded reasons:{' '}
+            {Object.entries(metric.excluded_reason_counts)
+              .map(([reason, count]) => `${words(reason)} (${count})`)
+              .join(', ')}
+            .
+          </>
+        )}
+        {Object.keys(metric.diagnostic_reason_counts).length > 0 && (
+          <>
+            {' '}
+            Overlapping diagnostics:{' '}
+            {Object.entries(metric.diagnostic_reason_counts)
+              .map(([reason, count]) => `${words(reason)} (${count})`)
+              .join(', ')}
+            .
+          </>
+        )}
+      </small>
+    </div>
+  );
+}
+
+function OutcomeRow({ row, changed }: { row: OutcomesReportRow; changed: () => void }) {
+  const outcome = row.outcome_revision === null ? 'No outcome recorded' : row.purchase_decision;
+  const sale = row.sale_status ? ` · ${words(row.sale_status)}` : '';
+  const missing = row.missing_fields.length
+    ? row.missing_fields.map(words).join(', ')
+    : 'None recorded';
+  const basis =
+    row.sale_basis === 'SELECTED_MARKET'
+      ? row.market_basis === 'sold'
+        ? 'Market based'
+        : 'Active listing what-if'
+      : row.sale_basis === 'MANUAL'
+        ? 'Manual assumption'
+        : 'Unassigned comparison basis';
+  return (
+    <li className="outcomes-report-row">
+      <div className="outcomes-report-row-heading">
+        <h3>Saved deal</h3>
+        <time dateTime={row.saved_at}>{row.saved_at.slice(0, 10)} UTC</time>
+      </div>
+      <p>
+        <ForecastLink id={row.root_forecast_id}>Open deal and outcome history</ForecastLink>
+      </p>
+      <p>
+        {outcome}
+        {sale} · outcome revision {row.outcome_revision ?? '—'}
+      </p>
+      {row.outcome_revision !== null && (
+        <>
+          <p>
+            Acquired {row.acquired_on ?? 'unknown'} · sold {row.sold_on ?? 'unknown'}
+          </p>
+          <p>
+            Acquisition {amount(row.acquisition)} · gross {amount(row.gross)} · net{' '}
+            {amount(row.net)} · profit {amount(row.profit)}
+          </p>
+          <p>
+            Paid labor {amount(row.labor_costs)} · unpaid own labor{' '}
+            {row.labor_minutes === null ? 'unknown minutes' : `${row.labor_minutes} minutes`}
+          </p>
+          <p>Missing information: {missing}.</p>
+          <p>
+            Comparison: {basis} · sale {row.sale_comparison ?? 'unavailable'}, net{' '}
+            {row.net_comparison ?? 'unavailable'}, profit {row.profit_comparison ?? 'unavailable'}.
+          </p>
+          {(row.sale_comparison_reasons.length > 0 ||
+            row.net_comparison_reasons.length > 0 ||
+            row.profit_comparison_reasons.length > 0) && (
+            <p>
+              Comparison reasons: sale {row.sale_comparison_reasons.map(words).join(', ') || 'none'}
+              ; net {row.net_comparison_reasons.map(words).join(', ') || 'none'}; profit{' '}
+              {row.profit_comparison_reasons.map(words).join(', ') || 'none'}.
+            </p>
+          )}
+        </>
+      )}
+      <DealClassificationControl
+        key={`${row.root_forecast_id}-${row.classification_revision}`}
+        identifier={row.root_forecast_id}
+        classification={row.classification}
+        revision={row.classification_revision}
+        changed={changed}
+      />
+    </li>
+  );
+}
+
+function Summary({ report }: { report: OutcomesReport }) {
+  const value = report.summary;
+  const comparisons = value.comparisons;
+  return (
+    <>
+      <dl className="outcomes-report-counts">
+        <div>
+          <dt>Saved roots</dt>
+          <dd>
+            {value.selected_roots} selected of {value.total_roots}; {value.outside_date_range}{' '}
+            outside the date range
+          </dd>
+        </div>
+        {(['REAL', 'UNKNOWN', 'SYNTHETIC', 'EXCLUDED'] as const).map((key) => (
+          <div key={key}>
+            <dt>{classLabel[key]}</dt>
+            <dd>{value.classification_counts[key]} roots in the selected cohort</dd>
+          </div>
+        ))}
+      </dl>
+      <p>
+        Real outcome records ({value.classification_counts.REAL} roots):{' '}
+        {value.real_outcome_counts.NOT_RECORDED} not recorded,{' '}
+        {value.real_outcome_counts.NOT_BOUGHT} not bought, {value.real_outcome_counts.NOT_SOLD}{' '}
+        unsold, {value.real_outcome_counts.PARTIALLY_SOLD} partially sold,{' '}
+        {value.real_outcome_counts.COMPLETE} completed.
+      </p>
+      <dl className="outcomes-report-subtotals">
+        <Subtotal label="Unsold acquisition" value={value.unsold_acquisition} />
+        <Subtotal label="Partially sold acquisition" value={value.partially_sold_acquisition} />
+        <Subtotal label="Partial gross receipts to date" value={value.partial_gross_to_date} />
+        <Subtotal label="Completed sales gross" value={value.completed_gross} />
+        <Subtotal label="Completed sales net" value={value.completed_net} />
+        <Subtotal label="Completed sales profit" value={value.completed_profit} />
+        <Subtotal label="Paid labor costs" value={value.paid_labor} />
+        <div className="outcomes-report-metric">
+          <dt>Unpaid own labor</dt>
+          <dd>
+            {value.unpaid_labor_minutes.value === null
+              ? 'No known minutes'
+              : `${value.unpaid_labor_minutes.label === 'PARTIAL' ? 'Partial total · ' : ''}${value.unpaid_labor_minutes.value} minutes`}
+          </dd>
+          {counts(value.unpaid_labor_minutes)}
+        </div>
+      </dl>
+      <h3>Stored forecast comparison errors</h3>
+      <p>
+        Signed mean is actual minus the immutable original forecast. It can cancel over and under
+        estimates and is not an accuracy score. Manual assumptions and market based forecasts are
+        shown separately; active listing what ifs are not in comparison errors.
+      </p>
+      <div className="outcomes-report-subtotals">
+        <section>
+          <h4>Selected market</h4>
+          <dl>
+            <ComparisonMetric label="Sale" metric={comparisons.selected_market.sale} />
+            <ComparisonMetric label="Net" metric={comparisons.selected_market.net} />
+            <ComparisonMetric label="Profit" metric={comparisons.selected_market.profit} />
+          </dl>
+        </section>
+        <section>
+          <h4>Manual assumption</h4>
+          <dl>
+            <ComparisonMetric label="Sale" metric={comparisons.manual_assumption.sale} />
+            <ComparisonMetric label="Net" metric={comparisons.manual_assumption.net} />
+            <ComparisonMetric label="Profit" metric={comparisons.manual_assumption.profit} />
+          </dl>
+        </section>
+        <section>
+          <h4>Unassigned original basis</h4>
+          <dl>
+            <ComparisonMetric label="Sale" metric={comparisons.unassigned_basis.sale} />
+            <ComparisonMetric label="Net" metric={comparisons.unassigned_basis.net} />
+            <ComparisonMetric label="Profit" metric={comparisons.unassigned_basis.profit} />
+          </dl>
+        </section>
+      </div>
+      <p>{comparisons.no_outcome_count} real roots have no outcome comparison.</p>
+    </>
+  );
+}
+
+export function DealOutcomesReport() {
+  const connection = useConnection();
+  const [fromInput, setFromInput] = useState('');
+  const [toInput, setToInput] = useState('');
+  const [fromDate, setFromDate] = useState('');
+  const [toDate, setToDate] = useState('');
+  const [offset, setOffset] = useState(0);
+  const [snapshot, setSnapshot] = useState<string | null>(null);
+  const [report, setReport] = useState<OutcomesReport | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [retry, setRetry] = useState(0);
+
+  useEffect(() => {
+    if (connection.state !== 'ONLINE_VERIFIED') {
+      setReport(null);
+      setSnapshot(null);
+      setOffset(0);
+      setLoading(false);
+      setError(
+        'Outcomes reporting requires verified connectivity. Saved deals remain available below.',
+      );
+      return;
+    }
+    const controller = new AbortController();
+    let active = true;
+    setLoading(true);
+    setError('');
+    void getOutcomesReport(
+      { from_date: fromDate, to_date: toDate, offset, snapshot },
+      controller.signal,
+    )
+      .then((value) => {
+        if (!active) return;
+        setReport(value);
+        setSnapshot(value.snapshot);
+      })
+      .catch((reason: unknown) => {
+        if (!active || (reason instanceof DOMException && reason.name === 'AbortError')) return;
+        if (reason instanceof DealOutcomesRequestError && reason.code === 'REPORT_CHANGED') {
+          setReport(null);
+          setSnapshot(null);
+          setOffset(0);
+          setRetry((value) => value + 1);
+          setError('Saved outcomes changed between pages. Restarting the report.');
+        } else {
+          setReport(null);
+          setError('Outcomes reporting is unavailable. Saved deals remain available below.');
+        }
+      })
+      .finally(() => {
+        if (active) setLoading(false);
+      });
+    return () => {
+      active = false;
+      controller.abort();
+    };
+  }, [
+    connection.revision,
+    connection.state,
+    fromDate,
+    toDate,
+    offset,
+    snapshot && offset > 0 ? snapshot : null,
+    retry,
+  ]);
+
+  function applyDates(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setFromDate(fromInput);
+    setToDate(toInput);
+    setOffset(0);
+    setSnapshot(null);
+    setReport(null);
+    setRetry((value) => value + 1);
+  }
+
+  function changed() {
+    setOffset(0);
+    setSnapshot(null);
+    setReport(null);
+    setRetry((value) => value + 1);
+  }
+
+  return (
+    <section className="outcomes-report" aria-labelledby="outcomes-report-title">
+      <p className="eyebrow">Deals · Actual outcomes</p>
+      <h2 id="outcomes-report-title">Outcomes report</h2>
+      <p>
+        Saved date (UTC). This saved deal cohort shows each root’s current latest outcome, not sales
+        during a period or a historical as of report. Only explicitly classified Real roots enter
+        real performance totals. Unknown, Synthetic and Excluded roots stay separate.
+      </p>
+      <form className="outcomes-report-filters" onSubmit={applyDates}>
+        <label>
+          From saved date (UTC)
+          <input
+            type="date"
+            value={fromInput}
+            onChange={(event) => setFromInput(event.target.value)}
+          />
+        </label>
+        <label>
+          Through saved date (UTC)
+          <input type="date" value={toInput} onChange={(event) => setToInput(event.target.value)} />
+        </label>
+        <button type="submit" disabled={loading}>
+          Apply dates
+        </button>
+        <button
+          type="button"
+          disabled={loading || (!fromDate && !toDate)}
+          onClick={() => {
+            setFromInput('');
+            setToInput('');
+            setFromDate('');
+            setToDate('');
+            setOffset(0);
+            setSnapshot(null);
+            setRetry((value) => value + 1);
+          }}
+        >
+          Clear dates
+        </button>
+      </form>
+      {loading && <p role="status">Loading outcomes report…</p>}
+      {error && (
+        <div role="alert">
+          <p>{error}</p>
+          <button onClick={() => setRetry((value) => value + 1)}>Retry report</button>
+        </div>
+      )}
+      {report && (
+        <>
+          <Summary report={report} />
+          {report.rows.length === 0 ? (
+            <p>No saved roots match these dates.</p>
+          ) : (
+            <ol className="outcomes-report-list">
+              {report.rows.map((row) => (
+                <OutcomeRow key={row.root_forecast_id} row={row} changed={changed} />
+              ))}
+            </ol>
+          )}
+          <nav aria-label="Outcome report pages" className="outcomes-report-pagination">
+            <button
+              disabled={loading || offset === 0}
+              onClick={() => setOffset(Math.max(0, offset - report.page_size))}
+            >
+              Previous page
+            </button>
+            <span>
+              Roots {report.rows.length ? offset + 1 : 0}–{offset + report.rows.length} of{' '}
+              {report.summary.selected_roots}
+            </span>
+            <button
+              disabled={loading || report.next_offset === null}
+              onClick={() => setOffset(report.next_offset ?? offset)}
+            >
+              Next page
+            </button>
+          </nav>
+        </>
+      )}
+    </section>
+  );
+}
