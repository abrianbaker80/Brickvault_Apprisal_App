diff --git a/services/api/tests/unit/test_outcome_backup_compatibility.py b/services/api/tests/unit/test_outcome_backup_compatibility.py
new file mode 100644
index 0000000..ecbb257
--- /dev/null
+++ b/services/api/tests/unit/test_outcome_backup_compatibility.py
@@ -0,0 +1,73 @@
+"""Only the 0018 operational recovery boundary; no live services or provider work."""
+
+import copy
+import io
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from brickvault_api import backup_format as fmt
+from brickvault_api import image_backup as images
+from brickvault_api import production_admin as admin
+from brickvault_api import production_backup as backup
+
+from .test_image_backup_seams import MARKER, NOW, REPOS, fixture_archive, receipt
+
+
+@pytest.mark.parametrize("revision", ["0017_listing_images", "0018_deal_outcome_revisions"])
+def test_exact_supported_heads_keep_complete_backup_and_recovery_proof(
+    revision: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    value = receipt()
+    value["revisions_at_backup"] = [revision]
+    assert fmt.schema_for_revisions((revision,)) == 3
+    assert fmt.validate_receipt(value["run_id"], value, REPOS, MARKER, NOW) == fmt.IMAGE_ARTIFACTS
+    raw = images.canonical(value)
+    proof = backup._proof_from_receipt(value["run_id"], value, raw, (revision,), NOW)
+    monkeypatch.setattr(admin, "_protected_file", lambda _: images.canonical(proof))
+    monkeypatch.setattr(backup, "verified_receipt", lambda _: (value, raw))
+    cfg = admin.AdminConfig("unused-owner", "unused-runtime", MARKER)
+    admin._recovery_proof(backup._proof_path(value["run_id"]), cfg, (revision,))
+    damaged = copy.deepcopy(value)
+    damaged["artifacts"].pop("image-blobs.tar")
+    with pytest.raises(ValueError):
+        fmt.validate_receipt(damaged["run_id"], damaged, REPOS, MARKER, NOW)
+    with pytest.raises(ValueError):
+        fmt.required_artifacts(2, [revision])
+
+
+def test_unknown_multiple_heads_and_legacy_semantics_are_not_weakened() -> None:
+    assert fmt.schema_for_revisions(()) == 2
+    assert fmt.schema_for_revisions((fmt.LEGACY_REVISION,)) == 2
+    assert fmt.required_artifacts(2, [fmt.LEGACY_REVISION]) == fmt.LEGACY_ARTIFACTS
+    for head in [("0019_unknown",), ("0018_deal_outcome_revisions", "0017_listing_images")]:
+        with pytest.raises(ValueError):
+            fmt.schema_for_revisions(head)
+        with pytest.raises(ValueError):
+            fmt.required_artifacts(3, list(head))
+
+
+def test_0018_archive_roundtrip_keeps_full_database_inventory(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _, source, value = fixture_archive(tmp_path, monkeypatch)
+    value["revisions"] = ["0018_deal_outcome_revisions"]
+    value["database"]["counts"]["deal_outcome_revision"] = 2
+    inventory = tmp_path / "outcomes-inventory.json"
+    inventory.write_bytes(images.canonical(value))
+    out = io.BytesIO()
+    monkeypatch.setattr(images.sys, "stdout", SimpleNamespace(buffer=out))
+    images.write_archive(inventory, source)
+    archive = tmp_path / "outcomes-images.tar"
+    archive.write_bytes(out.getvalue())
+    assert images.extract_archive(archive, tmp_path / "outcomes-recovered") == value
+    for row in value["database"]["blobs"]:
+        assert (source / row["storage_key"]).read_bytes() == (
+            tmp_path / "outcomes-recovered" / row["storage_key"]
+        ).read_bytes()
+    value["revisions"] = ["0019_unknown"]
+    with pytest.raises(ValueError):
+        images.validate_inventory(value)
