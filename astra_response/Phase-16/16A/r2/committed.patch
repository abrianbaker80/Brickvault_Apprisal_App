+            <dt>{label}</dt>
+            <dd>
+              {money(result[key].amount)}
+              {result[key].amount == null && <small>{explain(result[key].reasons)}</small>}
+            </dd>
+          </div>
+        ))}
+        <div>
+          <dt>Days to sell</dt>
+          <dd>
+            {result.days_to_sell ?? 'Unknown'}
