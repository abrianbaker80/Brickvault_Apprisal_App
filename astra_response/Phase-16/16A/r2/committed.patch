+                <button type="button" disabled={busy} onClick={moreHistory}>
+                  More outcome history
+                </button>
+              )}
+            </details>
+          )}
+          {historical && (
+            <>
+              <OutcomeReadout entry={historical} historical />
+              <button type="button" onClick={() => setHistorical(null)}>
+                Close historical outcome
+              </button>
+            </>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
