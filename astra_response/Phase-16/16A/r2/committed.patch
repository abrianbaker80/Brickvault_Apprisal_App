+                            Confirmed match to this one-set forecast
+                          </option>
+                          <option value="CONFIRMED_DIFFERENT">Confirmed different</option>
+                        </select>
+                      </label>
+                      <label>
+                        Inspection date
+                        <input
+                          type="date"
+                          value={draft.contents_checked_on ?? ''}
+                          onChange={(event) =>
+                            field('contents_checked_on', event.target.value || null)
+                          }
+                        />
+                      </label>
+                      <label>
+                        Contents note
