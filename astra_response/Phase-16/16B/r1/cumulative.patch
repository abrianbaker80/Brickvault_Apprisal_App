+    }
+    run(
+        "materialize",
+        None,
+        "--release-id",
+        str(identifier),
+        "--output",
+        str(d.output / "cli-release"),
+    )
+    run("verify", None, "--release-id", str(identifier), "--output", str(d.output / "cli-release"))
+    run(
+        "withdraw",
+        Withdrawal(id=uuid4(), release_id=identifier, reason_code="FIXTURE_COMPLETE").model_dump(
+            mode="json"
+        ),
+    )
