+            _, image = h.ready()
+            active, active_row = h.release([image])
+            withdrawn, _ = h.release([image])
+            h.service.withdraw(
+                token,
+                csrf,
+                Withdrawal(id=uuid4(), release_id=withdrawn, reason_code="RETAIN_WITHDRAWAL"),
+            )
+            h.service.materialize(token, csrf, active, output / "before")
+            with engine.connect() as c:
