new file mode 100644
index 0000000..bc3b5b5
--- /dev/null
+++ b/services/api/tests/unit/test_dataset_admission.py
@@ -0,0 +1,126 @@
+"""Independent dimensions, explicit negatives and strict fixture-only inputs."""
+
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from brickvault_api.datasets.models import (
+    PURPOSE,
+    ImageReview,
+    Permission,
+    Selection,
+    SubjectReview,
+    admission,
+    is_real,
+)
+
+
+def reviewed(**changes: Any) -> ImageReview:
+    permitted = Permission(state="PERMITTED", evidence_ref="synthetic-owner")
+    value: dict[str, Any] = {
+        "id": uuid4(),
+        "expected_revision": 1,
+        "reason": "Fixture visual review",
+        "listing_image_id": uuid4(),
+        "prepared_revision_id": uuid4(),
+        "derivative_sha256": "a" * 64,
+        "positives": [
+            {
+                "key": "independent-toy",
+                "state": "BRIAN_CONFIRMED",
+                "evidence_ref": "fixture-inspection",
+            }
+        ],
+        "privacy": "APPROVED",
+        "privacy_evidence_ref": "pixel-inspection",
+        "source": "SYNTHETIC_GENERATED",
+        "label_provenance": "INDEPENDENT",
+        "source_use": permitted,
+        "export": permitted,
+        "training": permitted,
+    }
+    value.update(changes)
+    return ImageReview.model_validate(value)
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("source", "REBRICKABLE"),
+        ("source", "UNKNOWN"),
+        ("label_provenance", "REBRICKABLE"),
+        ("privacy", "UNREVIEWED"),
+        ("privacy", "REJECTED"),
+        ("positives", []),
+        ("training", Permission()),
+        ("export", Permission(state="REVOKED", evidence_ref="withdrawn")),
+        ("source_use", Permission(state="DENIED", evidence_ref="not-owned")),
+        (
+            "training",
+            Permission(
+                state="PERMITTED",
+                evidence_ref="expired",
+                expires_at=datetime.now(UTC) - timedelta(seconds=1),
+            ),
+        ),
+    ],
+)
+def test_each_dimension_independently_blocks(field: str, value: Any) -> None:
+    assert admission(reviewed(**{field: value}), "SYNTHETIC", datetime.now(UTC))
+
+
+def test_negatives_never_come_from_proposals_omissions_or_actuals() -> None:
+    assert admission(
+        reviewed(positives=[], proposed_keys=["guess"]), "SYNTHETIC", datetime.now(UTC)
+    )
+    assert not admission(
+        reviewed(
+            positives=[],
+            negatives=[
+                {
+                    "key": "wrong-toy",
+                    "state": "CONFIRMED_NOT_THIS_IDENTITY",
+                    "evidence_ref": "explicit-pair-inspection",
+                }
+            ],
+        ),
+        "SYNTHETIC",
+        datetime.now(UTC),
+    )
+    with pytest.raises(ValidationError):
+        reviewed(actuals={"purchase_decision": "BOUGHT"})
+    with pytest.raises(ValidationError):
+        reviewed(
+            negatives=[
+                {
+                    "key": "independent-toy",
+                    "state": "CONFIRMED_NOT_THIS_IDENTITY",
+                    "evidence_ref": "conflict",
+                }
+            ]
+        )
+
+
+@pytest.mark.parametrize("classification", [None, "UNKNOWN", "REAL", "EXCLUDED"])
+def test_fixture_and_analytics_exclusion(classification: str | None) -> None:
+    assert admission(reviewed(), classification, datetime.now(UTC))
+    assert is_real(classification) == (classification == "REAL")
+
+
+def test_explicit_bounded_unique_selection_and_no_real_purpose() -> None:
+    for targets in ([], [uuid4()] * 2, [uuid4() for _ in range(129)]):
+        with pytest.raises(ValidationError):
+            Selection(purpose=PURPOSE, targets=targets, seed=1)
+    with pytest.raises(ValidationError):
+        Selection(purpose="TRAINING", targets=[uuid4()], seed=1)
+    with pytest.raises(ValidationError):
+        SubjectReview(
+            id=uuid4(),
+            expected_revision=0,
+            reason="no subject",
+            classification="REAL",
+            evidence_ref="fixture",
+        )
