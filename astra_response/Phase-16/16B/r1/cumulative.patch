+++ b/services/api/src/brickvault_api/datasets/__main__.py
@@ -0,0 +1,161 @@
+"""Local authenticated fixture CLI. No provider calls, bootstrap or production mode."""
+
+import argparse
+import getpass
+import json
+import sys
+from pathlib import Path
+from typing import Any
+from uuid import UUID
+
+import psycopg
+from pydantic import ValidationError
+
+from brickvault_api.auth import AuthError, AuthService
+from brickvault_api.catalog.connection import CatalogDatabase
+from brickvault_api.datasets.export import safe_output, write_exclusive
+from brickvault_api.datasets.models import (
+    DatasetError,
+    ImageReview,
+    Prepare,
+    ReleaseRequest,
+    Selection,
+    Strict,
+    SubjectReview,
+    Withdrawal,
+    canonical,
+)
+from brickvault_api.datasets.service import DatasetService
+from brickvault_api.images.sanitization import ordinary, private_directory
+from brickvault_api.images.storage import FilesystemBlobStore, ImageError
+from brickvault_api.settings import ConfigurationError, RuntimeSettings
+
+
+def read_input(path: Path, model: type[Strict]) -> Any:
+    ordinary(path)
+    private_directory(path.parent)
+    if not path.is_file() or path.stat().st_size > 65536:
+        raise DatasetError("DATASET_INPUT_LIMIT")
+    return model.model_validate_json(path.read_bytes())
+
+
+def parser() -> argparse.ArgumentParser:
+    result = argparse.ArgumentParser(description="Private fixture-only dataset workflow")
+    commands = result.add_subparsers(dest="command", required=True)
+    for name in ("subject-review", "prepare", "review", "preview", "release", "withdraw"):
+        child = commands.add_parser(name)
+        child.add_argument("--input", type=Path, required=True)
+        if name == "prepare":
+            child.add_argument(
+                "--output", type=Path, required=True, help="Fresh private preview directory"
+            )
+    child = commands.add_parser("status")
+    child.add_argument("--submission-id", type=UUID, required=True)
+    for name in ("materialize", "verify"):
+        child = commands.add_parser(name)
+        child.add_argument("--release-id", type=UUID, required=True)
+        child.add_argument("--output", type=Path, required=True)
+    return result
+
+
+def execute(
+    service: DatasetService, token: str, csrf: str, args: argparse.Namespace
+) -> dict[str, Any]:
+    models: dict[str, type[Strict]] = {
+        "subject-review": SubjectReview,
+        "prepare": Prepare,
+        "review": ImageReview,
+        "preview": Selection,
+        "release": ReleaseRequest,
+        "withdraw": Withdrawal,
+    }
+    if args.command == "status":
+        return service.status(token, args.submission_id)
+    if args.command in ("materialize", "verify"):
+        if args.command == "materialize":
+            service.materialize(token, csrf, args.release_id, args.output)
+        else:
+            service.verify(token, args.release_id, args.output)
+        return {"release_id": str(args.release_id), "state": args.command + "_verified"}
+    body = read_input(args.input, models[args.command])
+    if args.command == "preview":
+        return service.preview(token, body)
+    if args.command == "subject-review":
+        value = service.subject(token, csrf, body)
+    elif args.command == "prepare":
+        value = service.prepare(token, csrf, body)
+    elif args.command == "review":
+        value = service.review(token, csrf, body)
+    elif args.command == "release":
+        value = service.release(token, csrf, body)
+    else:
+        value = service.withdraw(token, csrf, body)
+    if args.command == "prepare":
+        safe_output(args.output)
+        if not args.output.exists():
+            private_directory(args.output, create=True)
+        private_directory(args.output)
+        sha = value["data"]["derivative_sha256"]
+        file = args.output / (sha + ".jpg")
+        service.store.stat(sha)
+        with service.store.read(sha) as stream:
+            raw = stream.read(1024 * 1024 + 1)
+        if file.exists():
+            ordinary(file)
+            if file.read_bytes() != raw:
+                raise DatasetError("DATASET_PREVIEW_MISMATCH")
+        else:
+            write_exclusive(file, raw)
+    return value
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parser().parse_args(argv)
+    token = csrf = None
+    auth = None
+    try:
+        settings = RuntimeSettings.from_environment()
+        if (
+            settings.purpose != "test"
+            or not settings.database_ownership_marker
+            or not settings.image_blob_root
+        ):
+            raise DatasetError("DATASET_OWNED_TEST_REQUIRED")
+        database = CatalogDatabase(
+            settings.database_url.get_secret_value(),
+            "test",
+            settings.database_ownership_marker.get_secret_value(),
+            role="runtime",
+        )
+        auth = AuthService(database)
+        token, csrf, _ = auth.login(getpass.getpass("BrickVault owner password: "), None)
+        service = DatasetService(database, FilesystemBlobStore(Path(settings.image_blob_root)))
+        value = execute(service, token, csrf, args)
+        sys.stdout.buffer.write(canonical(value) + b"\n")
+        return 0
+    except (
+        DatasetError,
+        ImageError,
+        AuthError,
+        ConfigurationError,
+        ValidationError,
+        psycopg.Error,
+        OSError,
+        ValueError,
+    ):
+        # Never print native exceptions, credential-bearing configuration or input values.
+        print(
+            json.dumps({"error": "DATASET_COMMAND_FAILED", "recovery": "status --submission-id"}),
+            file=sys.stderr,
+        )
+        return 1
+    finally:
+        if auth and token and csrf:
+            try:
+                auth.check(token, csrf, logout=True)
+            except (AuthError, psycopg.Error):
+                pass
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
