+            )
+            recovered = DatasetService(recovered_db, FilesystemBlobStore(extracted))
+            assert recovered.status(token, active) == {**active_row, "current_state": "ACTIVE"}
+            recovered.materialize(token, csrf, active, output / "after")
+            recovered.verify(token, active, output / "after")
