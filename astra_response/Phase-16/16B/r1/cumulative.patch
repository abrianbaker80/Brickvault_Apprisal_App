new file mode 100644
index 0000000..f1e48c4
--- /dev/null
+++ b/services/api/src/brickvault_api/images/sanitization.py
@@ -0,0 +1,113 @@
+"""Metadata-free bounded derivatives; private pixels still require human review."""
+
+import io
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import PIL
+from PIL import Image, ImageOps
+
+from brickvault_api.images.processing import process_image
+from brickvault_api.images.storage import ImageError
+
+
+def sanitized_image(
+    data: bytes, crop: tuple[int, int, int, int] | None = None
+) -> tuple[bytes, dict[str, object]]:
+    process_image(data)
+    with Image.open(io.BytesIO(data)) as source:
+        source.load()
+        oriented = ImageOps.exif_transpose(source)
+        if crop:
+            left, top, right, bottom = crop
+            if not (0 <= left < right <= oriented.width and 0 <= top < bottom <= oriented.height):
+                raise ImageError("INVALID_CROP")
+            oriented = oriented.crop(crop)
+        oriented.thumbnail((1024, 1024), Image.Resampling.LANCZOS)
+        rgba = oriented.convert("RGBA")
+        clean = Image.new("RGB", rgba.size, "white")
+        clean.paste(rgba, mask=rgba.getchannel("A"))
+        output = io.BytesIO()
+        clean.save(output, format="JPEG", quality=85)
+        result = output.getvalue()
+        if len(result) > 1024 * 1024:
+            raise ImageError("SANITIZED_IMAGE_SIZE_LIMIT")
+        return result, {
+            "recipe": "dataset-sanitize-v1",
+            "crop": list(crop) if crop else None,
+            "decoder": PIL.__version__,
+            "width": clean.width,
+            "height": clean.height,
+            "fit": [1024, 1024],
+            "mode": "RGB",
+            "background": "white",
+            "format": "JPEG",
+            "quality": 85,
+            "source_metadata": False,
+        }
+
+
+def ordinary(path: Path) -> None:
+    if (
+        not path.is_absolute()
+        or str(path).startswith(("\\\\", "//"))
+        or any(p.is_symlink() or p.is_junction() for p in (path, *path.parents))
+    ):
+        raise ImageError("UNSAFE_PRIVATE_PATH")
+    if os.name == "nt" and ":" in str(path)[2:]:
+        raise ImageError("UNSAFE_PRIVATE_PATH")
+
+
+def private_directory(path: Path, *, create: bool = False) -> None:
+    ordinary(path)
+    if create:
+        path.mkdir(mode=0o700)
+    if not path.is_dir():
+        raise ImageError("PRIVATE_DIRECTORY_REQUIRED")
+    for child in path.rglob("*"):
+        ordinary(child)
+    if sys.platform == "win32":
+        script = """
+$ErrorActionPreference = 'Stop'
+$p = $env:BVA_DATASET_DIRECTORY
+$sid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User
+if ($env:BVA_DATASET_CREATE -eq '1') {
+ $acl = [System.IO.Directory]::GetAccessControl($p,
+ [System.Security.AccessControl.AccessControlSections]::Access)
+ $acl.SetAccessRuleProtection($true, $false)
+ foreach ($existing in @($acl.Access)) { $acl.RemoveAccessRuleSpecific($existing) }
+ $rule = New-Object System.Security.AccessControl.FileSystemAccessRule(
+ $sid, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')
+ $acl.AddAccessRule($rule)
+ [System.IO.Directory]::SetAccessControl($p, $acl)
+}
+foreach ($entry in @((Get-Item -LiteralPath $p)) + @(Get-ChildItem -LiteralPath $p -Force -Recurse)) {
+ $a = Get-Acl -LiteralPath $entry.FullName
+ if ($a.GetOwner([System.Security.Principal.SecurityIdentifier]).Value -ne $sid.Value) { exit 1 }
+ foreach ($r in $a.Access) {
+  $s = $r.IdentityReference.Translate([System.Security.Principal.SecurityIdentifier]).Value
+  if ($r.AccessControlType -eq 'Allow' -and $s -notin @($sid.Value,'S-1-3-4','S-1-5-18','S-1-5-32-544')) { exit 1 }
+ }
+}
+"""
+        result = subprocess.run(
+            ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script],
+            env={
+                **{k: v for k, v in os.environ.items() if k.upper() != "PSMODULEPATH"},
+                "BVA_DATASET_DIRECTORY": str(path),
+                "BVA_DATASET_CREATE": "1" if create else "0",
+            },
+            capture_output=True,
+            timeout=15,
+            check=False,
+            creationflags=subprocess.CREATE_NO_WINDOW,
+        )
+        if result.returncode:
+            raise ImageError("PRIVATE_PERMISSIONS_REQUIRED")
+    elif any(
+        p.stat().st_mode & 0o077 or p.stat().st_uid != os.geteuid()
+        for p in (path, *path.rglob("*"))
+    ):
+        raise ImageError("PRIVATE_PERMISSIONS_REQUIRED")
