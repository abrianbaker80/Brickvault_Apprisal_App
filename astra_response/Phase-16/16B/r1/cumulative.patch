+            archive = io.BytesIO()
+            with monkeypatch.context() as scoped:
+                scoped.setattr(image_backup.sys, "stdout", SimpleNamespace(buffer=archive))
+                image_backup.write_archive(inventory_path, store.root)
+            archive_path = tmp_path / "blobs.tar"
+            archive_path.write_bytes(archive.getvalue())
+            extracted = tmp_path / "recovered-blobs"
+            assert image_backup.extract_archive(archive_path, extracted) == inventory
+            backup_restore(owned_instance, run_id, source, destination, record)
+            recovered_db = CatalogDatabase(
+                owned_instance.target(destination, "runtime"),
+                "test",
+                owner.ownership_marker,
