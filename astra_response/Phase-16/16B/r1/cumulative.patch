index 0000000..feb8b65
--- /dev/null
+++ b/services/api/src/brickvault_api/datasets/models.py
@@ -0,0 +1,188 @@
+"""Bounded review inputs. Independent review dimensions never imply one another."""
+
+import hashlib
+import json
+from datetime import datetime
+from typing import Annotated, Any, Literal, Self
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field, model_validator
+
+PURPOSE = "FIXTURE_ONLY_NOT_TRAINING_DATA"
+VERSION = "dataset-v1"
+TABLES = (
+    "dataset_subject_revision",
+    "dataset_review_revision",
+    "dataset_release",
+    "dataset_item",
+    "dataset_release_event",
+)
+Digest = Annotated[str, Field(pattern=r"^[a-f0-9]{64}$")]
+Key = Annotated[str, Field(pattern=r"^[A-Za-z0-9_-]{1,80}$")]
+Reason = Annotated[str, Field(min_length=1, max_length=500)]
+
+
+class DatasetError(ValueError):
+    """Fixed codes, never input text or native exceptions."""
+
+
+def canonical(value: Any) -> bytes:
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("utf-8")
+
+
+def digest(value: Any) -> str:
+    return hashlib.sha256(canonical(value)).hexdigest()
+
+
+class Strict(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, frozen=True, hide_input_in_errors=True)
+
+
+class Revision(Strict):
+    id: UUID
+    expected_revision: int = Field(ge=0, le=2147483645)
+    reason: Reason
+
+
+class SubjectReview(Revision):
+    listing_id: UUID | None = None
+    root_forecast_id: UUID | None = None
+    classification: Literal["UNKNOWN", "REAL", "SYNTHETIC", "EXCLUDED"]
+    evidence_ref: Key
+    source_groups: list[UUID] = Field(default_factory=list, max_length=32)
+    related_sources_reviewed: bool = False
+
+    @model_validator(mode="after")
+    def subject(self) -> Self:
+        if (self.listing_id is None) == (self.root_forecast_id is None):
+            raise ValueError("exactly_one_subject")
+        if len(set(self.source_groups)) != len(self.source_groups):
+            raise ValueError("duplicate_source_group")
+        if self.root_forecast_id and (self.source_groups or self.related_sources_reviewed):
+            raise ValueError("listing_only_source_groups")
+        return self
+
+
+class Prepare(Revision):
+    purpose: Literal["FIXTURE_ONLY_NOT_TRAINING_DATA"]
+    listing_image_id: UUID
+    crop: tuple[int, int, int, int] | None = None
+
+    @model_validator(mode="after")
+    def bounds(self) -> Self:
+        if self.crop:
+            left, top, right, bottom = self.crop
+            if not (0 <= left < right <= 16000 and 0 <= top < bottom <= 16000):
+                raise ValueError("invalid_crop")
+        return self
+
+
+class Label(Strict):
+    key: Key
+    state: Literal["UNREVIEWED", "BRIAN_CONFIRMED", "PURCHASE_VERIFIED", "WITHDRAWN"]
+    evidence_ref: Key
+    quantity: int | None = Field(default=None, ge=1, le=10000)
+    canonical_identity_id: UUID | None = None  # Private link, never exported.
+
+
+class Negative(Strict):
+    key: Key
+    state: Literal["CONFIRMED_NOT_THIS_IDENTITY"]
+    evidence_ref: Key
+
+
+class Permission(Strict):
+    state: Literal["UNKNOWN", "PERMITTED", "DENIED", "REVOKED"] = "UNKNOWN"
+    evidence_ref: Key | None = None
+    expires_at: datetime | None = None
+
+    @model_validator(mode="after")
+    def evidence(self) -> Self:
+        if self.state != "UNKNOWN" and self.evidence_ref is None:
+            raise ValueError("permission_evidence_required")
+        if self.expires_at and self.expires_at.utcoffset() is None:
+            raise ValueError("timezone_required")
+        return self
+
+
+class ImageReview(Revision):
+    listing_image_id: UUID
+    prepared_revision_id: UUID
+    derivative_sha256: Digest
+    proposed_keys: list[Key] = Field(default_factory=list, max_length=32)
+    positives: list[Label] = Field(default_factory=list, max_length=32)
+    negatives: list[Negative] = Field(default_factory=list, max_length=32)
+    labels_exhaustive: bool = False
+    label_provenance: Literal["INDEPENDENT", "REBRICKABLE", "UNKNOWN"] = "UNKNOWN"
+    privacy: Literal["UNREVIEWED", "APPROVED", "REJECTED"] = "UNREVIEWED"
+    privacy_evidence_ref: Key | None = None
+    source: Literal["SYNTHETIC_GENERATED", "USER_OWNED", "REBRICKABLE", "UNKNOWN"] = "UNKNOWN"
+    source_use: Permission = Field(default_factory=Permission)
+    export: Permission = Field(default_factory=Permission)
+    training: Permission = Field(default_factory=Permission)
+
+    @model_validator(mode="after")
+    def independent(self) -> Self:
+        keys = [x.key for x in self.positives]
+        negative = [x.key for x in self.negatives]
+        if len(set(keys)) != len(keys) or len(set(negative)) != len(negative):
+            raise ValueError("duplicate_labels")
+        if set(keys) & set(negative):
+            raise ValueError("contradictory_labels")
+        if self.privacy == "APPROVED" and self.privacy_evidence_ref is None:
+            raise ValueError("privacy_evidence_required")
+        return self
+
+
+class Selection(Strict):
+    purpose: Literal["FIXTURE_ONLY_NOT_TRAINING_DATA"]
+    targets: list[UUID] = Field(min_length=1, max_length=128)
+    seed: int = Field(ge=0, le=18446744073709551615)
+
+    @model_validator(mode="after")
+    def unique(self) -> Self:
+        if len(set(self.targets)) != len(self.targets):
+            raise ValueError("duplicate_selection")
+        return self
+
+
+class ReleaseRequest(Strict):
+    id: UUID
+    selection: Selection
+    preview_id: Digest
+
+
+class Withdrawal(Strict):
+    id: UUID
+    release_id: UUID
+    reason_code: Key
+
+
+def is_real(classification: str | None) -> bool:
+    """Shared exclusion predicate for future analytics; unknown never means real."""
+    return classification == "REAL"
+
+
+def admission(review: ImageReview, classification: str | None, now: datetime) -> list[str]:
+    reasons = []
+    if classification != "SYNTHETIC":
+        reasons.append("FIXTURE_CLASSIFICATION_REQUIRED")
+    if review.source != "SYNTHETIC_GENERATED":
+        reasons.append("FIXTURE_SOURCE_REQUIRED")
+    if review.label_provenance != "INDEPENDENT":
+        reasons.append("INDEPENDENT_LABEL_PROVENANCE_REQUIRED")
+    if not (review.positives or review.negatives) or any(
+        x.state not in ("BRIAN_CONFIRMED", "PURCHASE_VERIFIED") for x in review.positives
+    ):
+        reasons.append("REVIEWED_LABEL_REQUIRED")
+    if review.privacy != "APPROVED":
+        reasons.append("PRIVACY_REVIEW_REQUIRED")
+    for name in ("source_use", "export", "training"):
+        permission = getattr(review, name)
+        if permission.state != "PERMITTED" or (
+            permission.expires_at is not None and permission.expires_at <= now
+        ):
+            reasons.append(name.upper() + "_PERMISSION_REQUIRED")
+    return reasons
