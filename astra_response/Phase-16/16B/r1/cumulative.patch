index 0000000..11db0af
--- /dev/null
+++ b/services/api/src/brickvault_api/datasets/export.py
@@ -0,0 +1,187 @@
+"""Deterministic connected components and private, recoverable directory publication."""
+
+import hashlib
+import os
+import sys
+import tempfile
+from collections.abc import Callable, Iterator
+from contextlib import AbstractContextManager, contextmanager
+from pathlib import Path
+from typing import Any
+
+from brickvault_api.datasets.models import DatasetError, canonical, digest
+from brickvault_api.images.sanitization import ordinary, private_directory
+from brickvault_api.images.storage import BlobStore
+
+
+def components(edges: list[list[str]]) -> dict[str, list[str]]:
+    parent: dict[str, str] = {}
+
+    def root(node: str) -> str:
+        parent.setdefault(node, node)
+        while parent[node] != node:
+            parent[node] = parent[parent[node]]
+            node = parent[node]
+        return node
+
+    for edge in edges:
+        if edge:
+            first = root(edge[0])
+            for node in edge[1:]:
+                other = root(node)
+                if other != first:
+                    parent[other] = first
+    groups: dict[str, list[str]] = {}
+    for node in sorted(parent):
+        groups.setdefault(root(node), []).append(node)
+    return {node: groups[root(node)] for node in parent}
+
+
+def partition(seed: int, nodes: list[str]) -> tuple[str, str]:
+    group = digest(nodes)
+    bucket = int(digest(["dataset-split-v1", seed, group]), 16) % 10000
+    return group, "train" if bucket < 8000 else "validation" if bucket < 9000 else "test"
+
+
+def payloads(data: dict[str, Any], store: BlobStore) -> Iterator[tuple[str, bytes]]:
+    manifest = canonical(data["manifest"])
+    yield "manifest.json", manifest
+    checksums = {"manifest.json": hashlib.sha256(manifest).hexdigest()}
+    for sha in sorted({item["derivative_sha256"] for item in data["manifest"]["items"]}):
+        store.stat(sha)
+        with store.read(sha) as stream:
+            raw = stream.read(1024 * 1024 + 1)
+        if len(raw) > 1024 * 1024 or hashlib.sha256(raw).hexdigest() != sha:
+            raise DatasetError("DATASET_BLOB_CORRUPT")
+        filename = sha + ".jpg"
+        checksums[filename] = sha
+        yield filename, raw
+    yield "checksums.json", canonical(checksums)
+
+
+def safe_output(path: Path) -> None:
+    ordinary(path)
+    for directory in (path, *path.parents):
+        if (directory / ".git").exists() or (directory / "index.html").exists():
+            raise DatasetError("DATASET_OUTPUT_OUTSIDE_GIT_STATIC_REQUIRED")
+    if not path.parent.is_dir():
+        raise DatasetError("DATASET_OUTPUT_PARENT_REQUIRED")
+    private_directory(path.parent)
+
+
+def write_exclusive(path: Path, raw: bytes, *, temporary_directory: Path | None = None) -> None:
+    ordinary(path)
+    # Atomic publication leaves no partly written named payload after a crash.
+    # Release staging uses its private parent for temporary files, so abandoned
+    # anonymous files can never enter the published dataset directory.
+    temporary: str | None = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            dir=temporary_directory or path.parent, prefix=".dataset-pending-", delete=False
+        ) as stream:
+            temporary = stream.name
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.link(temporary, path)
+    finally:
+        if temporary is not None:
+            Path(temporary).unlink(missing_ok=True)
+
+
+def sync_directory(path: Path) -> None:
+    if os.name == "posix":
+        descriptor = os.open(path, os.O_RDONLY)
+        try:
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+
+
+@contextmanager
+def reservation(path: Path, identity: bytes) -> Iterator[None]:
+    # Kernel locks release on process death. The private exact-ID marker remains
+    # recoverable; no PID guessing or stale-lock deletion is needed.
+    try:
+        write_exclusive(path, identity)
+    except FileExistsError:
+        pass
+    ordinary(path)
+    with path.open("r+b") as stream:
+        try:
+            if sys.platform == "win32":
+                import msvcrt
+
+                msvcrt.locking(stream.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+
+                fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            raise DatasetError("DATASET_OUTPUT_BUSY") from None
+        try:
+            stream.seek(0)
+            if stream.read(4097) != identity:
+                raise DatasetError("DATASET_OUTPUT_RESERVED_FOR_OTHER_RELEASE")
+            yield
+        finally:
+            stream.seek(0)
+            if sys.platform == "win32":
+                msvcrt.locking(stream.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
+
+
+def verify_files(path: Path, data: dict[str, Any], store: BlobStore) -> None:
+    safe_output(path)
+    private_directory(path)
+    expected = set()
+    for name, raw in payloads(data, store):
+        expected.add(name)
+        file = path / name
+        ordinary(file)
+        if not file.is_file() or file.stat().st_size != len(raw) or file.read_bytes() != raw:
+            raise DatasetError("DATASET_OUTPUT_MISMATCH")
+    if {p.name for p in path.iterdir()} != expected:
+        raise DatasetError("DATASET_UNEXPECTED_OUTPUT")
+
+
+def materialize(
+    path: Path,
+    release_id: str,
+    data: dict[str, Any],
+    store: BlobStore,
+    final: Callable[[], AbstractContextManager[None]],
+) -> None:
+    safe_output(path)
+    # A private reservation serializes only this output, not decoding or DB work.
+    claim = path.parent / ("." + path.name + ".claim")
+    with reservation(
+        claim, canonical({"release_id": release_id, "manifest": data["manifest_hash"]})
+    ):
+        if path.exists():
+            verify_files(path, data, store)
+            with final():
+                return  # Exact-ID recovery of a completed publication.
+        stage = path.parent / ("." + path.name + ".stage-" + release_id)
+        if not stage.exists():
+            private_directory(stage, create=True)
+        private_directory(stage)
+        for name, raw in payloads(data, store):
+            target = stage / name
+            ordinary(target)
+            if target.exists():
+                if target.read_bytes() != raw:
+                    raise DatasetError("DATASET_INTERRUPTED_OUTPUT_MISMATCH")
+            else:
+                write_exclusive(target, raw, temporary_directory=path.parent)
+        verify_files(stage, data, store)
+        sync_directory(stage)
+        # Byte processing is complete. This short context owns final reauthorization
+        # and shares coordination with withdrawal, uploads and review mutations.
+        with final():
+            ordinary(path)
+            if path.exists():
+                raise DatasetError("DATASET_OUTPUT_EXISTS")
+            stage.rename(path)
+            sync_directory(path.parent)
