@@ -0,0 +1,131 @@
+"""Real image/metadata processing, deterministic graph and interruption recovery."""
+
+import hashlib
+import io
+import os
+import subprocess
+import sys
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any
+
+import pytest
+from PIL import Image
+
+from brickvault_api.datasets import export
+from brickvault_api.datasets.models import PURPOSE, DatasetError, canonical, digest
+from brickvault_api.images.sanitization import private_directory, sanitized_image
+from brickvault_api.images.storage import FilesystemBlobStore, ImageError
+
+
+def test_metadata_strip_crop_bounds_and_original_unchanged() -> None:
+    image = Image.new("RGB", (100, 50), "red")
+    exif = Image.Exif()
+    exif[270] = "PRIVATE-NOTIFICATION"
+    out = io.BytesIO()
+    image.save(out, "JPEG", exif=exif)
+    raw = out.getvalue()
+    clean, recipe = sanitized_image(raw, (0, 0, 50, 50))
+    assert sanitized_image(raw, (0, 0, 50, 50)) == (clean, recipe)
+    assert b"PRIVATE" in raw and b"PRIVATE" not in clean
+    with Image.open(io.BytesIO(clean)) as decoded:
+        assert decoded.size == (50, 50) and not decoded.getexif()
+    for crop in [(-1, 0, 5, 5), (0, 0, 101, 50), (10, 0, 5, 50)]:
+        with pytest.raises(ImageError):
+            sanitized_image(raw, crop)
+
+
+def test_connected_components_include_transitive_excluded_bridge() -> None:
+    edges = [
+        ["selected-A", "original-1"],
+        ["excluded-B", "original-1", "group-2"],
+        ["selected-C", "group-2", "derived-3"],
+        ["elsewhere", "unrelated"],
+    ]
+    groups = export.components(edges)
+    assert groups["selected-A"] == groups["selected-C"]
+    assert export.partition(42, groups["selected-A"]) == export.partition(42, groups["selected-C"])
+    assert export.components(list(reversed(edges))) == groups
+    assert (
+        export.partition(42, groups["selected-A"])[0]
+        != export.partition(42, groups["elsewhere"])[0]
+    )
+
+
+def test_private_directory_recover_interruption_exact_bytes_and_fail_closed(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    parent = tmp_path / "private"
+    private_directory(parent, create=True)
+    store = FilesystemBlobStore(tmp_path / "blobs")
+    raw = io.BytesIO()
+    Image.new("RGB", (10, 10), "green").save(raw, "JPEG")
+    stored = store.publish(raw.getvalue())
+    manifest = {"purpose": PURPOSE, "items": [{"derivative_sha256": stored.sha256}]}
+    data = {"manifest": manifest, "manifest_hash": digest(manifest)}
+    output = parent / "release"
+    fail = True
+
+    @contextmanager
+    def final() -> Any:
+        if fail:
+            raise DatasetError("WITHDRAWN_BEFORE_PUBLICATION")
+        yield
+
+    with pytest.raises(DatasetError, match="WITHDRAWN"):
+        export.materialize(output, "fixture", data, store, final)
+    assert not output.exists()
+    fail = False
+    export.materialize(output, "fixture", data, store, final)
+    export.verify_files(output, data, store)
+    before = {p.name: p.read_bytes() for p in output.iterdir()}
+    export.materialize(output, "fixture", data, store, final)
+    assert before == {p.name: p.read_bytes() for p in output.iterdir()}
+    assert (output / "manifest.json").read_bytes() == canonical(manifest)
+    checks = output / "checksums.json"
+    assert stored.sha256.encode() in checks.read_bytes()
+    (output / (stored.sha256 + ".jpg")).write_bytes(b"corrupt")
+    with pytest.raises(DatasetError):
+        export.verify_files(output, data, store)
+
+
+def test_reject_git_output_and_unsafe_symlink(tmp_path: Path) -> None:
+    (tmp_path / ".git").mkdir()
+    with pytest.raises(DatasetError):
+        export.safe_output(tmp_path / "output")
+    assert hashlib.sha256(canonical({"b": 1, "a": 2})).hexdigest() == digest({"a": 2, "b": 1})
+
+
+def test_kernel_reservation_recovers_exact_id_after_process_exit(tmp_path: Path) -> None:
+    claim = tmp_path / "fixture.claim"
+    script = "from pathlib import Path; import os,sys; from brickvault_api.datasets.export import reservation\nwith reservation(Path(sys.argv[1]),b'fixture'): os._exit(0)\n"
+    result = subprocess.run(
+        [sys.executable, "-c", script, str(claim)],
+        capture_output=True,
+        timeout=15,
+        creationflags=subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0,
+    )
+    assert result.returncode == 0
+    with export.reservation(claim, b"fixture"):
+        pass
+    with pytest.raises(DatasetError, match="OTHER_RELEASE"):
+        with export.reservation(claim, b"other"):
+            pytest.fail("Another release reused a reserved path")
+
+
+def test_atomic_payload_write_leaves_no_partial_named_file(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    destination = tmp_path / "manifest.json"
+    link = os.link
+
+    def interrupted(*args: Any, **kwargs: Any) -> None:
+        raise OSError("Synthetic failure before atomic link")
+
+    monkeypatch.setattr(os, "link", interrupted)
+    with pytest.raises(OSError):
+        export.write_exclusive(destination, b"fixture")
+    assert not destination.exists()
+    monkeypatch.setattr(os, "link", link)
+    export.write_exclusive(destination, b"fixture")
+    assert destination.read_bytes() == b"fixture"
