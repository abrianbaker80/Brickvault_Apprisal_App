+"""Authenticated append-only reviews and standalone immutable fixture releases."""
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any
+from uuid import UUID, uuid4
+
+import psycopg
+from psycopg.types.json import Jsonb
+
+from brickvault_api.auth import AuthError, AuthService, Session
+from brickvault_api.auth import digest as token_digest
+from brickvault_api.catalog.connection import CatalogConnection, CatalogDatabase
+from brickvault_api.datasets import export
+from brickvault_api.datasets.models import (
+    PURPOSE,
+    TABLES,
+    VERSION,
+    DatasetError,
+    ImageReview,
+    Prepare,
+    ReleaseRequest,
+    Selection,
