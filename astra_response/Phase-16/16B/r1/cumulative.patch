+        )
+        raw = io.BytesIO()
+        Image.new("RGB", (32, 32), color).save(raw, "PNG")
+        position = self.listings.detail(self.token, listing)["next_display_order"]
+        _, value = self.listings.upload(
+            self.token,
+            self.csrf,
+            listing,
+            UploadArguments(client_upload_id=uuid4(), display_order=position),
+            "synthetic.png",
+            raw.getvalue(),
+        )
+        return listing, UUID(value["listing_image_id"])
+
+    def subject(self, listing: UUID, **changes: Any) -> dict[str, Any]:
+        value = {
+            "id": uuid4(),
+            "expected_revision": 0,
+            "reason": "Generated fixture only",
+            "listing_id": listing,
+            "classification": "SYNTHETIC",
+            "evidence_ref": "generated",
+            "related_sources_reviewed": True,
+        }
+        value.update(changes)
+        return self.service.subject(self.token, self.csrf, SubjectReview.model_validate(value))
+
+    def prepare(self, image: UUID) -> dict[str, Any]:
+        return self.service.prepare(
+            self.token,
+            self.csrf,
+            Prepare(
+                id=uuid4(),
+                expected_revision=0,
+                reason="Prepare selected fixture",
+                purpose=PURPOSE,
+                listing_image_id=image,
+            ),
+        )
+
+    def review(self, image: UUID, prepared: dict[str, Any], **changes: Any) -> ImageReview:
+        value = reviewed(
+            listing_image_id=image,
+            prepared_revision_id=UUID(prepared["id"]),
+            derivative_sha256=prepared["data"]["derivative_sha256"],
+            **changes,
+        )
+        self.service.review(self.token, self.csrf, value)
+        return value
+
+    def ready(self, color: str = "red") -> tuple[UUID, UUID]:
+        listing, image = self.image(color)
+        self.subject(listing)
+        self.review(image, self.prepare(image))
+        return listing, image
+
+    def release(self, targets: list[UUID]) -> tuple[UUID, dict[str, Any]]:
+        selection = Selection(purpose=PURPOSE, targets=targets, seed=41)
+        preview = self.service.preview(self.token, selection)
+        identifier = uuid4()
+        value = self.service.release(
+            self.token,
+            self.csrf,
+            ReleaseRequest(id=identifier, selection=selection, preview_id=preview["preview_id"]),
+        )
+        return identifier, value
