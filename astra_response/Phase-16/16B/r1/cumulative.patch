+);
+CREATE INDEX ix_dataset_events_release ON public.dataset_release_event(owner_id,release_id);
+REVOKE ALL ON public.dataset_subject_revision,public.dataset_review_revision,
+ public.dataset_release,public.dataset_item,public.dataset_release_event FROM PUBLIC;
+-- statement-break
+CREATE FUNCTION public.dataset_record_guard() RETURNS trigger LANGUAGE plpgsql
+SET search_path=pg_catalog,public AS $$
+DECLARE n timestamptz; prior record; li uuid; rid uuid; sid uuid; bid uuid;
+BEGIN
+ IF TG_OP<>'INSERT' THEN
+  RAISE EXCEPTION 'DATASET_IMMUTABLE' USING ERRCODE='23514';
+ END IF;
+ PERFORM pg_advisory_xact_lock(hashtextextended(NEW.owner_id::text,19));
+ n=public.forecast_clock();
+ IF NOT EXISTS(SELECT 1 FROM public.auth_session s WHERE s.principal_id=NEW.owner_id
+  AND s.token_hash=NULLIF(current_setting('brickvault.dataset_session',true),'')
+  AND s.revoked_at IS NULL AND n>=s.last_activity_at AND n<s.expires_at
+  AND n<NULLIF(current_setting('brickvault.dataset_auth_until',true),'')::timestamptz) THEN
+  RAISE EXCEPTION 'DATASET_UNAUTHORIZED' USING ERRCODE='23514';
+ END IF;
+ IF TG_TABLE_NAME='dataset_subject_revision' THEN
+  IF NEW.listing_id IS NOT NULL THEN
+   IF NOT EXISTS(SELECT 1 FROM public.listing WHERE id=NEW.listing_id AND owner_id=NEW.owner_id) THEN
+    RAISE EXCEPTION 'DATASET_NOT_FOUND' USING ERRCODE='23514';
+   END IF;
+  ELSIF NOT EXISTS(SELECT 1 FROM public.deal_forecast WHERE id=NEW.root_forecast_id
+   AND owner_id=NEW.owner_id AND root_id IS NULL AND parent_id IS NULL AND saved_at IS NOT NULL) THEN
+   RAISE EXCEPTION 'DATASET_NOT_FOUND' USING ERRCODE='23514';
+  END IF;
+  SELECT revision,data INTO prior FROM public.dataset_subject_revision WHERE owner_id=NEW.owner_id
+   AND listing_id IS NOT DISTINCT FROM NEW.listing_id
+   AND root_forecast_id IS NOT DISTINCT FROM NEW.root_forecast_id ORDER BY revision DESC LIMIT 1;
+  IF prior.data->>'classification'='SYNTHETIC' AND NEW.data->>'classification'<>'SYNTHETIC' THEN
+   RAISE EXCEPTION 'DATASET_FIXTURE_STICKY' USING ERRCODE='23514';
+  END IF;
+ ELSIF TG_TABLE_NAME='dataset_review_revision' THEN
+  IF NOT EXISTS(SELECT 1 FROM public.listing_image i JOIN public.listing l ON l.id=i.listing_id
+   WHERE i.id=NEW.listing_image_id AND l.owner_id=NEW.owner_id) THEN
+   RAISE EXCEPTION 'DATASET_NOT_FOUND' USING ERRCODE='23514';
+  END IF;
+  IF NEW.data->>'derivative_sha256' IS DISTINCT FROM
+   (SELECT sha256 FROM public.blob WHERE id=NEW.derivative_blob_id) THEN
+   RAISE EXCEPTION 'DATASET_DERIVATIVE_MISMATCH' USING ERRCODE='23514';
+  END IF;
+  SELECT revision,data INTO prior FROM public.dataset_review_revision WHERE owner_id=NEW.owner_id
+   AND listing_image_id=NEW.listing_image_id ORDER BY revision DESC LIMIT 1;
+ ELSIF TG_TABLE_NAME='dataset_item' THEN
+  IF NOT EXISTS(SELECT 1 FROM public.dataset_release r,public.dataset_review_revision v,
+   public.dataset_subject_revision s,public.listing_image i
+   WHERE r.id=NEW.release_id AND v.id=NEW.review_id AND s.id=NEW.subject_id
+   AND i.id=NEW.listing_image_id AND r.owner_id=NEW.owner_id AND v.owner_id=NEW.owner_id
+   AND s.owner_id=NEW.owner_id AND v.listing_image_id=i.id AND s.listing_id=i.listing_id
+   AND v.derivative_blob_id=NEW.derivative_blob_id) THEN
+   RAISE EXCEPTION 'DATASET_NOT_FOUND' USING ERRCODE='23514';
+  END IF;
+ ELSIF TG_TABLE_NAME='dataset_release_event' THEN
+  IF NOT EXISTS(SELECT 1 FROM public.dataset_release WHERE id=NEW.release_id AND owner_id=NEW.owner_id) THEN
+   RAISE EXCEPTION 'DATASET_NOT_FOUND' USING ERRCODE='23514';
+  END IF;
+ END IF;
+ IF TG_TABLE_NAME IN ('dataset_subject_revision','dataset_review_revision') THEN
+  IF NEW.revision<>COALESCE(prior.revision,0)+1 OR
+   NEW.revision<>(NEW.request->>'expected_revision')::integer+1 THEN
+   RAISE EXCEPTION 'DATASET_CONFLICT' USING ERRCODE='23514';
+  END IF;
+ END IF;
+ NEW.recorded_at=n;
+ RETURN NEW;
+END $$;
+REVOKE ALL ON FUNCTION public.dataset_record_guard() FROM PUBLIC;
+-- statement-break
+CREATE TRIGGER dataset_subject_guard BEFORE INSERT OR UPDATE OR DELETE ON public.dataset_subject_revision
+ FOR EACH ROW EXECUTE FUNCTION public.dataset_record_guard();
+CREATE TRIGGER dataset_review_guard BEFORE INSERT OR UPDATE OR DELETE ON public.dataset_review_revision
+ FOR EACH ROW EXECUTE FUNCTION public.dataset_record_guard();
+CREATE TRIGGER dataset_release_guard BEFORE INSERT OR UPDATE OR DELETE ON public.dataset_release
+ FOR EACH ROW EXECUTE FUNCTION public.dataset_record_guard();
+CREATE TRIGGER dataset_item_guard BEFORE INSERT OR UPDATE OR DELETE ON public.dataset_item
+ FOR EACH ROW EXECUTE FUNCTION public.dataset_record_guard();
+CREATE TRIGGER dataset_event_guard BEFORE INSERT OR UPDATE OR DELETE ON public.dataset_release_event
+ FOR EACH ROW EXECUTE FUNCTION public.dataset_record_guard();
