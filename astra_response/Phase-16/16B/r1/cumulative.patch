+CREATE TABLE public.dataset_subject_revision (
+ id uuid PRIMARY KEY, owner_id uuid NOT NULL REFERENCES public.auth_principal(id),
+ listing_id uuid REFERENCES public.listing(id),
+ root_forecast_id uuid REFERENCES public.deal_forecast(id),
+ revision integer NOT NULL CHECK(revision>0),
+ recorded_at timestamptz NOT NULL DEFAULT public.forecast_clock(),
+ request_hash varchar(64) NOT NULL CHECK(request_hash ~ '^[a-f0-9]{64}$'),
+ request jsonb NOT NULL CHECK(jsonb_typeof(request)='object' AND octet_length(request::text)<=65536),
+ data jsonb NOT NULL CHECK(jsonb_typeof(data)='object' AND octet_length(data::text)<=65536),
+ CHECK((listing_id IS NULL)<>(root_forecast_id IS NULL)),
+ UNIQUE(owner_id,listing_id,revision), UNIQUE(owner_id,root_forecast_id,revision)
+);
+CREATE TABLE public.dataset_review_revision (
+ id uuid PRIMARY KEY, owner_id uuid NOT NULL REFERENCES public.auth_principal(id),
+ listing_image_id uuid NOT NULL REFERENCES public.listing_image(id),
+ derivative_blob_id uuid NOT NULL REFERENCES public.blob(id),
+ revision integer NOT NULL CHECK(revision>0),
+ recorded_at timestamptz NOT NULL DEFAULT public.forecast_clock(),
+ request_hash varchar(64) NOT NULL CHECK(request_hash ~ '^[a-f0-9]{64}$'),
+ request jsonb NOT NULL CHECK(jsonb_typeof(request)='object' AND octet_length(request::text)<=65536),
+ data jsonb NOT NULL CHECK(jsonb_typeof(data)='object' AND octet_length(data::text)<=65536),
+ UNIQUE(owner_id,listing_image_id,revision)
+);
+CREATE TABLE public.dataset_release (
+ id uuid PRIMARY KEY, owner_id uuid NOT NULL REFERENCES public.auth_principal(id),
+ recorded_at timestamptz NOT NULL DEFAULT public.forecast_clock(),
+ purpose text NOT NULL CHECK(purpose='FIXTURE_ONLY_NOT_TRAINING_DATA'),
+ request_hash varchar(64) NOT NULL CHECK(request_hash ~ '^[a-f0-9]{64}$'),
+ request jsonb NOT NULL CHECK(jsonb_typeof(request)='object' AND octet_length(request::text)<=65536),
+ data jsonb NOT NULL CHECK(jsonb_typeof(data)='object' AND octet_length(data::text)<=8388608)
+);
+CREATE TABLE public.dataset_item (
+ id uuid PRIMARY KEY, owner_id uuid NOT NULL REFERENCES public.auth_principal(id),
+ release_id uuid NOT NULL REFERENCES public.dataset_release(id),
+ listing_image_id uuid NOT NULL REFERENCES public.listing_image(id),
+ review_id uuid NOT NULL REFERENCES public.dataset_review_revision(id),
+ subject_id uuid NOT NULL REFERENCES public.dataset_subject_revision(id),
+ derivative_blob_id uuid NOT NULL REFERENCES public.blob(id),
+ recorded_at timestamptz NOT NULL DEFAULT public.forecast_clock(),
+ data jsonb NOT NULL CHECK(jsonb_typeof(data)='object' AND octet_length(data::text)<=65536),
+ UNIQUE(release_id,listing_image_id)
+);
+CREATE TABLE public.dataset_release_event (
+ id uuid PRIMARY KEY, owner_id uuid NOT NULL REFERENCES public.auth_principal(id),
+ release_id uuid NOT NULL REFERENCES public.dataset_release(id),
+ recorded_at timestamptz NOT NULL DEFAULT public.forecast_clock(),
