+def authorize(
+    c: CatalogConnection, database: CatalogDatabase, token: str | None, csrf: str | None
+) -> Session:
+    clock = c.execute("SELECT public.forecast_clock() AS now").fetchone()
+    assert clock is not None
+    session = AuthService(database, clock=lambda: clock["now"]).check_in_transaction(c, token, csrf)
+    if csrf is not None:
+        assert token is not None
+        c.execute(
+            "SELECT set_config('brickvault.dataset_session',%s,true),"
+            "set_config('brickvault.dataset_auth_until',%s,true)",
+            (
+                token_digest(token),
+                min(session.idle_expires_at, session.absolute_expires_at).isoformat(),
+            ),
+        )
+    return session
+
+
+def lock(c: CatalogConnection, owner: UUID) -> None:
+    c.execute("SELECT pg_advisory_xact_lock(hashtextextended(%s,19))", (str(owner),))
+
+
+def rows(c: CatalogConnection, query: str, owner: UUID) -> list[dict[str, Any]]:
+    result = c.execute(query + " LIMIT 10001", (owner,)).fetchall()
+    if len(result) > 10000:
+        raise DatasetError("DATASET_METADATA_LIMIT")
+    return result
+
+
+def graph(
+    c: CatalogConnection, owner: UUID
+) -> tuple[dict[str, list[str]], dict[str, Any], dict[str, Any]]:
+    images = rows(
+        c,
+        "SELECT i.id,i.listing_id,i.original_asset_id,b.sha256,a.privacy "
+        "FROM listing_image i JOIN listing l ON l.id=i.listing_id "
+        "JOIN image_asset a ON a.id=i.original_asset_id JOIN blob b ON b.id=a.blob_id "
+        "WHERE l.owner_id=%s ORDER BY i.id",
+        owner,
+    )
+    subjects = rows(
+        c,
+        "SELECT DISTINCT ON (listing_id) * FROM dataset_subject_revision "
+        "WHERE owner_id=%s AND listing_id IS NOT NULL ORDER BY listing_id,revision DESC",
+        owner,
+    )
+    reviews = rows(
+        c,
+        "SELECT DISTINCT ON (listing_image_id) * FROM dataset_review_revision "
+        "WHERE owner_id=%s ORDER BY listing_image_id,revision DESC",
+        owner,
+    )
+    by_subject = {str(r["listing_id"]): r for r in subjects}
+    by_review = {str(r["listing_image_id"]): r for r in reviews}
+    edges = []
+    for row in images:
+        edges.append(
+            [
+                "image:" + str(row["id"]),
+                "listing:" + str(row["listing_id"]),
+                "original:" + row["sha256"],
+                "asset:" + str(row["original_asset_id"]),
+                "privacy:" + str(row["original_asset_id"]) + ":" + row["privacy"],
+            ]
+        )
+    # Historical source assertions/derivatives remain conservative edges, even after correction.
+    history = rows(
+        c,
+        "SELECT listing_id,data FROM dataset_subject_revision WHERE owner_id=%s ORDER BY id",
+        owner,
+    )
+    for row in history:
+        if row["listing_id"]:
+            edges.append(
+                [
+                    "listing:" + str(row["listing_id"]),
+                    *["source:" + x for x in row["data"]["source_groups"]],
+                ]
+            )
+    derivatives = rows(
+        c,
+        "SELECT listing_image_id,data FROM dataset_review_revision WHERE owner_id=%s ORDER BY id",
+        owner,
+    )
+    for row in derivatives:
+        edges.append(
+            ["image:" + str(row["listing_image_id"]), "derived:" + row["data"]["derivative_sha256"]]
+        )
+    lineage = rows(
+        c,
+        "SELECT r.parent_id,r.child_id,b.sha256 FROM image_relation r "
+        "JOIN image_asset a ON a.id=r.child_id JOIN blob b ON b.id=a.blob_id "
+        "WHERE EXISTS(SELECT 1 FROM listing_image i JOIN listing l ON l.id=i.listing_id "
+        "WHERE i.original_asset_id=r.parent_id AND l.owner_id=%s) ORDER BY r.id",
+        owner,
+    )
+    for row in lineage:
+        edges.append(
+            [
+                "asset:" + str(row["parent_id"]),
+                "asset:" + str(row["child_id"]),
+                "derived:" + row["sha256"],
+            ]
+        )
+    return (
+        export.components(edges),
+        {str(r["id"]): r for r in images},
+        {
+            "subjects": by_subject,
+            "reviews": by_review,
+        },
+    )
+
+
+def select(c: CatalogConnection, owner: UUID, selection: Selection) -> dict[str, Any]:
+    groups, images, states = graph(c, owner)
+    now_row = c.execute("SELECT public.forecast_clock() AS now").fetchone()
+    assert now_row is not None
+    lineage, items, exclusions = [], [], []
+    for identifier in sorted(selection.targets, key=str):
+        key = str(identifier)
+        image = images.get(key)
+        if image is None:
+            raise DatasetError("DATASET_NOT_FOUND")
+        subject = states["subjects"].get(str(image["listing_id"]))
+        review = states["reviews"].get(key)
+        reasons = []
+        if subject is None or subject["data"]["classification"] != "SYNTHETIC":
+            reasons.append("FIXTURE_CLASSIFICATION_REQUIRED")
+        if not subject or not subject["data"]["related_sources_reviewed"]:
+            reasons.append("SOURCE_GROUP_REVIEW_REQUIRED")
+        if not review or review["data"]["review"] is None:
+            reasons.append("REVIEW_REQUIRED")
+        else:
+            reviewed = ImageReview.model_validate_json(canonical(review["data"]["review"]))
+            reasons += admission(
+                reviewed, subject["data"]["classification"] if subject else None, now_row["now"]
+            )
+        # Equal originals cannot evade fixture/source denial through another listing.
+        for other in images.values():
+            if other["sha256"] != image["sha256"]:
+                continue
+            source = states["subjects"].get(str(other["listing_id"]))
+            if not source or source["data"]["classification"] != "SYNTHETIC":
+                reasons.append("SHARED_SOURCE_EXCLUDED")
+            other_review = states["reviews"].get(str(other["id"]))
+            if other_review and other_review["data"]["review"]:
+                r = other_review["data"]["review"]
+                if (
+                    r["source"] == "REBRICKABLE"
+                    or r["label_provenance"] == "REBRICKABLE"
+                    or any(
+                        r[name]["state"] in ("DENIED", "REVOKED")
+                        for name in ("source_use", "export", "training")
+                    )
+                ):
+                    reasons.append("SHARED_SOURCE_DENIED")
+        if reasons:
+            exclusions.append({"target": key, "reasons": sorted(set(reasons))})
+            continue
+        assert subject and review
+        nodes = groups["image:" + key]
+        group, split = export.partition(selection.seed, nodes)
+        r = review["data"]["review"]
+        # Only independent opaque keys/quantities enter sanitized output.
+        item = {
+            "id": digest(["item", key]),
+            "group": group,
+            "partition": split,
+            "derivative_sha256": review["data"]["derivative_sha256"],
+            "width": review["data"]["recipe"]["width"],
+            "height": review["data"]["recipe"]["height"],
+            "positives": [{"key": x["key"], "quantity": x["quantity"]} for x in r["positives"]],
+            "negatives": [x["key"] for x in r["negatives"]],
+            "labels_exhaustive": r["labels_exhaustive"],
+        }
+        items.append(item)
+        lineage.append(
+            {
+                "listing_image_id": key,
+                "review_id": str(review["id"]),
+                "subject_id": str(subject["id"]),
+                "derivative_blob_id": str(review["derivative_blob_id"]),
+                "original_sha256": image["sha256"],
+                "nodes": nodes,
+                "recipe": review["data"]["recipe"],
+            }
+        )
+    manifest = {
+        "purpose": PURPOSE,
+        "version": VERSION,
+        "sanitizer": "dataset-sanitize-v1",
+        "decoder_versions": sorted({entry["recipe"]["decoder"] for entry in lineage}),
+        "selection_hash": digest(selection.model_dump(mode="json")),
+        "seed": selection.seed,
+        "split": "dataset-split-v1-sha256-mod10000-8000-1000-1000",
+        "items": items,
+        "combine_releases": "NOT_SUPPORTED",
+    }
+    private = {
+        "selection": selection.model_dump(mode="json"),
+        "lineage": lineage,
+        "exclusions": exclusions,
+    }
+    return {
+        "manifest": manifest,
+        "manifest_hash": digest(manifest),
+        "private": private,
+        "preview_id": digest({"manifest": manifest, "private": private}),
+    }
+
+
+def withdraw_stale(c: CatalogConnection, owner: UUID) -> None:
+    active = rows(
+        c,
+        "SELECT * FROM dataset_release r WHERE owner_id=%s AND NOT EXISTS("
+        "SELECT 1 FROM dataset_release_event e WHERE e.release_id=r.id) ORDER BY id",
+        owner,
+    )
+    for row in active:
+        selection = Selection.model_validate_json(canonical(row["data"]["private"]["selection"]))
+        current = select(c, owner, selection)
+        if current["preview_id"] != row["data"]["preview_id"] or current["private"]["exclusions"]:
+            request = {
+                "id": str(uuid4()),
+                "release_id": str(row["id"]),
+                "reason_code": "ADMISSION_OR_GRAPH_CHANGED",
+            }
+            c.execute(
+                "INSERT INTO dataset_release_event(id,owner_id,release_id,request_hash,request,data) "
+                "VALUES(%s,%s,%s,%s,%s,%s)",
+                (
+                    UUID(request["id"]),
+                    owner,
+                    row["id"],
+                    digest(request),
+                    Jsonb(request),
+                    Jsonb(
+                        {
+                            "reason_code": request["reason_code"],
+                            "cause_digest": current["preview_id"],
+                        }
+                    ),
+                ),
+            )
+
+
+class DatasetService:
+    def __init__(self, database: CatalogDatabase, store: BlobStore) -> None:
+        if database.role != "runtime":
+            raise DatasetError("DATASET_RUNTIME_ROLE_REQUIRED")
+        self.database, self.store = database, store
+
+    @contextmanager
+    def transaction(
+        self, token: str | None, csrf: str | None, *, write: bool = False
+    ) -> Iterator[tuple[CatalogConnection, UUID]]:
+        if write and csrf is None:
+            raise AuthError(403)
+        try:
+            with self.database.connect() as c, c.transaction():
+                session = authorize(c, self.database, token, csrf)
+                lock(c, session.principal_id)
+                yield c, session.principal_id
+                authorize(c, self.database, token, csrf)
+        except psycopg.errors.CheckViolation as error:
+            if error.diag.message_primary == "DATASET_UNAUTHORIZED":
+                raise AuthError() from None
+            raise DatasetError("DATASET_INTEGRITY_CONFLICT") from None
+        except psycopg.errors.UniqueViolation:
+            raise DatasetError("DATASET_ID_REUSED") from None
+        except (
+            psycopg.errors.LockNotAvailable,
+            psycopg.errors.DeadlockDetected,
+            psycopg.errors.QueryCanceled,
+            psycopg.errors.SerializationFailure,
+        ):
+            raise DatasetError("DATASET_UNAVAILABLE") from None
+
+    @staticmethod
+    def _status(
+        c: CatalogConnection, owner: UUID, identifier: UUID
+    ) -> tuple[str, dict[str, Any]] | None:
+        for table in TABLES:
+            if table == "dataset_item":
+                continue
+            row = c.execute(
+                f"SELECT * FROM public.{table} WHERE id=%s AND owner_id=%s", (identifier, owner)
+            ).fetchone()
+            if row:
+                return table, row
+        return None
+
+    def status(self, token: str | None, identifier: UUID) -> dict[str, Any]:
+        with self.transaction(token, None) as (c, owner):
+            entry = self._status(c, owner, identifier)
+            if entry is None:
+                raise DatasetError("DATASET_NOT_FOUND")
+            result = self.projection(*entry)
+            if entry[0] == "dataset_release":
+                try:
+                    self._active(c, owner, identifier)
+                    result["current_state"] = "ACTIVE"
+                except DatasetError as error:
+                    result["current_state"] = str(error)
+            return result
+
+    @staticmethod
+    def projection(table: str, row: dict[str, Any]) -> dict[str, Any]:
+        return {
+            "table": table,
+            "id": str(row["id"]),
+            "revision": row.get("revision"),
+            "data": row["data"],
+        }
+
+    def _replay(
+        self, c: CatalogConnection, owner: UUID, table: str, request: Any
+    ) -> dict[str, Any] | None:
+        entry = self._status(c, owner, request.id)
+        if entry is None:
+            return None
+        if entry[0] != table or entry[1]["request_hash"] != digest(request.model_dump(mode="json")):
+            raise DatasetError("DATASET_ID_REUSED")
+        return self.projection(*entry)
+
+    @staticmethod
+    def _image(c: CatalogConnection, owner: UUID, identifier: UUID) -> dict[str, Any]:
+        row = c.execute(
+            "SELECT i.*,b.sha256,a.privacy FROM listing_image i JOIN listing l ON l.id=i.listing_id "
+            "JOIN image_asset a ON a.id=i.original_asset_id JOIN blob b ON b.id=a.blob_id "
+            "WHERE i.id=%s AND l.owner_id=%s",
+            (identifier, owner),
+        ).fetchone()
+        if row is None:
+            raise DatasetError("DATASET_NOT_FOUND")
+        return row
+
+    def subject(
+        self, token: str | None, csrf: str | None, request: SubjectReview
+    ) -> dict[str, Any]:
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            replay = self._replay(c, owner, TABLES[0], request)
+            if replay:
+                return replay
+            if request.listing_id:
+                owned = c.execute(
+                    "SELECT 1 FROM listing WHERE id=%s AND owner_id=%s", (request.listing_id, owner)
+                ).fetchone()
+            else:
+                owned = c.execute(
+                    "SELECT 1 FROM deal_forecast WHERE id=%s AND owner_id=%s AND saved_at IS NOT NULL "
+                    "AND root_id IS NULL AND parent_id IS NULL",
+                    (request.root_forecast_id, owner),
+                ).fetchone()
+            if not owned:
+                raise DatasetError("DATASET_NOT_FOUND")
+            prior = c.execute(
+                "SELECT * FROM dataset_subject_revision WHERE owner_id=%s "
+                "AND listing_id IS NOT DISTINCT FROM %s AND root_forecast_id IS NOT DISTINCT FROM %s "
+                "ORDER BY revision DESC LIMIT 1",
+                (owner, request.listing_id, request.root_forecast_id),
+            ).fetchone()
+            if (prior["revision"] if prior else 0) != request.expected_revision:
+                raise DatasetError("DATASET_CONFLICT")
+            if (
+                prior
+                and prior["data"]["classification"] == "SYNTHETIC"
+                and request.classification != "SYNTHETIC"
+            ):
+                raise DatasetError("DATASET_FIXTURE_STICKY")
+            value = request.model_dump(mode="json")
+            row = c.execute(
+                "INSERT INTO dataset_subject_revision(id,owner_id,listing_id,root_forecast_id,revision,request_hash,request,data) "
+                "VALUES(%s,%s,%s,%s,%s,%s,%s,%s) RETURNING *",
+                (
+                    request.id,
+                    owner,
+                    request.listing_id,
+                    request.root_forecast_id,
+                    request.expected_revision + 1,
+                    digest(value),
+                    Jsonb(value),
+                    Jsonb(value),
+                ),
+            ).fetchone()
+            assert row
+            withdraw_stale(c, owner)
+            return self.projection(TABLES[0], row)
+
+    def prepare(self, token: str | None, csrf: str | None, request: Prepare) -> dict[str, Any]:
+        # Explicit target only. Admission before any image read/encode.
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            replay = self._replay(c, owner, TABLES[1], request)
+            if replay:
+                return replay
+            image = self._image(c, owner, request.listing_image_id)
+            subject = c.execute(
+                "SELECT data FROM dataset_subject_revision WHERE listing_id=%s AND owner_id=%s "
+                "ORDER BY revision DESC LIMIT 1",
+                (image["listing_id"], owner),
+            ).fetchone()
+            if not subject or subject["data"]["classification"] != "SYNTHETIC":
+                raise DatasetError("DATASET_FIXTURE_CLASSIFICATION_REQUIRED")
+        self.store.stat(image["sha256"])
+        with self.store.read(image["sha256"]) as stream:
+            raw = stream.read(25 * 1024 * 1024 + 1)
+        clean, recipe = sanitized_image(raw, request.crop)
+        stored = self.store.publish(clean)
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            replay = self._replay(c, owner, TABLES[1], request)
+            if replay:
+                return replay
+            self._image(c, owner, request.listing_image_id)
+            subject = c.execute(
+                "SELECT data FROM dataset_subject_revision WHERE listing_id=%s AND owner_id=%s "
+                "ORDER BY revision DESC LIMIT 1",
+                (image["listing_id"], owner),
+            ).fetchone()
+            if not subject or subject["data"]["classification"] != "SYNTHETIC":
+                raise DatasetError("DATASET_FIXTURE_CLASSIFICATION_REQUIRED")
+            blob_id = ListingService.record_blob(c, stored)
+            data = {
+                "original_sha256": image["sha256"],
+                "derivative_sha256": stored.sha256,
+                "recipe": recipe,
+                "review": None,
+            }
+            return self._append_review(c, owner, request, blob_id, data)
+
+    def _append_review(
+        self,
+        c: CatalogConnection,
+        owner: UUID,
+        request: Prepare | ImageReview,
+        blob_id: UUID,
+        data: dict[str, Any],
+    ) -> dict[str, Any]:
+        prior = c.execute(
+            "SELECT revision FROM dataset_review_revision WHERE owner_id=%s AND listing_image_id=%s "
+            "ORDER BY revision DESC LIMIT 1",
+            (owner, request.listing_image_id),
+        ).fetchone()
+        if (prior["revision"] if prior else 0) != request.expected_revision:
+            raise DatasetError("DATASET_CONFLICT")
+        value = request.model_dump(mode="json")
+        row = c.execute(
+            "INSERT INTO dataset_review_revision(id,owner_id,listing_image_id,derivative_blob_id,revision,request_hash,request,data) "
+            "VALUES(%s,%s,%s,%s,%s,%s,%s,%s) RETURNING *",
+            (
+                request.id,
+                owner,
+                request.listing_image_id,
+                blob_id,
+                request.expected_revision + 1,
+                digest(value),
+                Jsonb(value),
+                Jsonb(data),
+            ),
+        ).fetchone()
+        assert row
+        withdraw_stale(c, owner)
+        return self.projection(TABLES[1], row)
+
+    def review(self, token: str | None, csrf: str | None, request: ImageReview) -> dict[str, Any]:
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            replay = self._replay(c, owner, TABLES[1], request)
+            if replay:
+                return replay
+            image = self._image(c, owner, request.listing_image_id)
+            prepared = c.execute(
+                "SELECT * FROM dataset_review_revision WHERE id=%s AND owner_id=%s AND listing_image_id=%s",
+                (request.prepared_revision_id, owner, request.listing_image_id),
+            ).fetchone()
+            if not prepared or prepared["data"]["derivative_sha256"] != request.derivative_sha256:
+                raise DatasetError("DATASET_DERIVATIVE_MISMATCH")
+            if image["sha256"] != prepared["data"]["original_sha256"]:
+                raise DatasetError("DATASET_ORIGINAL_MISMATCH")
+            data = {**prepared["data"], "review": request.model_dump(mode="json")}
+            return self._append_review(c, owner, request, prepared["derivative_blob_id"], data)
+
+    def preview(self, token: str | None, selection: Selection) -> dict[str, Any]:
+        with self.transaction(token, None) as (c, owner):
+            return select(c, owner, selection)
+
+    def release(
+        self, token: str | None, csrf: str | None, request: ReleaseRequest
+    ) -> dict[str, Any]:
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            replay = self._replay(c, owner, TABLES[2], request)
+            if replay:
+                return replay
+            value = select(c, owner, request.selection)
+            if value["preview_id"] != request.preview_id:
+                raise DatasetError("DATASET_STALE_PREVIEW")
+            if value["private"]["exclusions"] or not value["manifest"]["items"]:
+                raise DatasetError("DATASET_SELECTION_INELIGIBLE")
+            body = request.model_dump(mode="json")
+            row = c.execute(
+                "INSERT INTO dataset_release(id,owner_id,purpose,request_hash,request,data) VALUES(%s,%s,%s,%s,%s,%s) RETURNING *",
+                (request.id, owner, PURPOSE, digest(body), Jsonb(body), Jsonb(value)),
+            ).fetchone()
+            assert row
+            for private, item in zip(
+                value["private"]["lineage"], value["manifest"]["items"], strict=True
+            ):
+                c.execute(
+                    "INSERT INTO dataset_item(id,owner_id,release_id,listing_image_id,review_id,subject_id,derivative_blob_id,data) "
+                    "VALUES(%s,%s,%s,%s,%s,%s,%s,%s)",
+                    (
+                        uuid4(),
+                        owner,
+                        request.id,
+                        UUID(private["listing_image_id"]),
+                        UUID(private["review_id"]),
+                        UUID(private["subject_id"]),
+                        UUID(private["derivative_blob_id"]),
+                        Jsonb(item),
+                    ),
+                )
+            return self.projection(TABLES[2], row)
+
+    def withdraw(self, token: str | None, csrf: str | None, request: Withdrawal) -> dict[str, Any]:
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            replay = self._replay(c, owner, TABLES[4], request)
+            if replay:
+                return replay
+            if not c.execute(
+                "SELECT 1 FROM dataset_release WHERE id=%s AND owner_id=%s",
+                (request.release_id, owner),
+            ).fetchone():
+                raise DatasetError("DATASET_NOT_FOUND")
+            value = request.model_dump(mode="json")
+            row = c.execute(
+                "INSERT INTO dataset_release_event(id,owner_id,release_id,request_hash,request,data) VALUES(%s,%s,%s,%s,%s,%s) RETURNING *",
+                (
+                    request.id,
+                    owner,
+                    request.release_id,
+                    digest(value),
+                    Jsonb(value),
+                    Jsonb({"reason_code": request.reason_code}),
+                ),
+            ).fetchone()
+            assert row
+            return self.projection(TABLES[4], row)
+
+    def _active(self, c: CatalogConnection, owner: UUID, identifier: UUID) -> dict[str, Any]:
+        row = c.execute(
+            "SELECT * FROM dataset_release WHERE id=%s AND owner_id=%s", (identifier, owner)
+        ).fetchone()
+        if not row:
+            raise DatasetError("DATASET_NOT_FOUND")
+        if c.execute(
+            "SELECT 1 FROM dataset_release_event WHERE release_id=%s AND owner_id=%s",
+            (identifier, owner),
+        ).fetchone():
+            raise DatasetError("DATASET_RELEASE_WITHDRAWN")
+        selection = Selection.model_validate_json(canonical(row["data"]["private"]["selection"]))
+        current = select(c, owner, selection)
+        if current["preview_id"] != row["data"]["preview_id"] or current["private"]["exclusions"]:
+            raise DatasetError("DATASET_RELEASE_INELIGIBLE")
+        if digest(row["data"]["manifest"]) != row["data"]["manifest_hash"]:
+            raise DatasetError("DATASET_MANIFEST_CORRUPT")
+        return dict(row["data"])
+
+    def materialize(
+        self, token: str | None, csrf: str | None, identifier: UUID, output: Path
+    ) -> None:
+        with self.transaction(token, csrf, write=True) as (c, owner):
+            data = self._active(c, owner, identifier)
+
+        @contextmanager
+        def final() -> Iterator[None]:
+            with self.transaction(token, csrf, write=True) as (c, owner):
+                if self._active(c, owner, identifier) != data:
+                    raise DatasetError("DATASET_RELEASE_CHANGED")
+                # Reauthorization must precede the irreversible directory rename.
+                authorize(c, self.database, token, csrf)
+                yield
+
+        export.materialize(output, str(identifier), data, self.store, final)
+
+    def verify(self, token: str | None, identifier: UUID, output: Path) -> None:
+        with self.transaction(token, None) as (c, owner):
+            data = self._active(c, owner, identifier)
+        export.verify_files(output, data, self.store)
+        with self.transaction(token, None) as (c, owner):
+            self._active(c, owner, identifier)
