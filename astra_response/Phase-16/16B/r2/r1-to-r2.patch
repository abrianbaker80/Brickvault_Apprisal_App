+@pytest.mark.parametrize(
+    "field,value",
+    [
+        (field, Permission(state=state, evidence_ref="explicit-fixture-restriction"))
+        for field in ("source_use", "export", "training")
+        for state in ("DENIED", "REVOKED")
+    ]
+    + [("source", "REBRICKABLE"), ("label_provenance", "REBRICKABLE")],
+)
+def test_preparation_preserves_shared_source_prohibition(
+    d: Harness, field: str, value: Any
+) -> None:
+    _, image = d.ready()
+    other, duplicate = d.image()
+    d.subject(other)
+    prepared = d.prepare(duplicate)
+    d.review(duplicate, prepared)
+    identifier, pinned = d.release([image])
+    d.review(duplicate, prepared, expected_revision=2, **{field: value})
+    selection = Selection(purpose=PURPOSE, targets=[image], seed=41)
+
+    def blocked() -> None:
+        preview = d.service.preview(d.token, selection)
+        assert preview["manifest"]["items"] == []
+        assert preview["private"]["exclusions"] == [
+            {"target": str(image), "reasons": ["SHARED_SOURCE_DENIED"]}
+        ]
+        with pytest.raises(DatasetError, match="INELIGIBLE"):
+            d.service.release(
+                d.token,
+                d.csrf,
+                ReleaseRequest(id=uuid4(), selection=selection, preview_id=preview["preview_id"]),
+            )
+        assert d.service.status(d.token, identifier) == {
+            **pinned,
+            "current_state": "DATASET_RELEASE_WITHDRAWN",
+        }
+
+    blocked()
+    # Multiple unreviewed preparations cannot clear the last explicit source review.
+    for revision, size in ((3, 16), (4, 8)):
+        prepared = d.service.prepare(
+            d.token,
+            d.csrf,
+            Prepare(
+                id=uuid4(),
+                expected_revision=revision,
+                purpose=PURPOSE,
+                listing_image_id=duplicate,
+                crop=(0, 0, size, size),
+                reason="New crop is not a permission review",
+            ),
+        )
+        assert prepared["data"]["review"] is None
+        blocked()
+        unreviewed = d.service.preview(
+            d.token, Selection(purpose=PURPOSE, targets=[duplicate], seed=41)
+        )
+        assert "REVIEW_REQUIRED" in unreviewed["private"]["exclusions"][0]["reasons"]
+    # Only an explicit evidence-backed review can correct the source state.
+    # It still cannot reactivate the older immutable release.
+    d.review(duplicate, prepared, expected_revision=5)
+    corrected = d.service.preview(d.token, selection)
+    assert not corrected["private"]["exclusions"]
+    assert len(corrected["manifest"]["items"]) == 1
+    d.release([image, duplicate])
+    assert d.service.status(d.token, identifier) == {
+        **pinned,
+        "current_state": "DATASET_RELEASE_WITHDRAWN",
+    }
+
