+@pytest.mark.parametrize("role", ["dataset", "thumbnail"])
+def test_derivative_uploaded_as_original_connects_before_preparation(d: Harness, role: str) -> None:
+    # Patterned pixels avoid a flat JPEG whose automatic thumbnail re-encode is
+    # byte-identical and would accidentally conceal the cross-role graph defect.
+    pixels = Image.new("RGB", (64, 48))
+    pixels.putdata(
+        [(x * 17 % 256, y * 29 % 256, x * y * 13 % 256) for y in range(48) for x in range(64)]
+    )
+    original = io.BytesIO()
+    pixels.save(original, "PNG")
+    listing, image = d.image(content=original.getvalue())
+    d.subject(listing)
+    prepared = d.prepare(image, crop=(0, 0, 24, 24))
+    d.review(image, prepared)
+    identifier, pinned = d.release([image])
+    derivative_hash = prepared["data"]["derivative_sha256"]
+    if role == "thumbnail":
+        with d.owner.connect() as c:
+            row = c.execute(
+                "SELECT b.sha256 FROM listing_image i "
+                "JOIN image_relation r ON r.parent_id=i.original_asset_id "
+                "JOIN image_asset a ON a.id=r.child_id JOIN blob b ON b.id=a.blob_id "
+                "WHERE i.id=%s",
+                (image,),
+            ).fetchone()
+            assert row is not None
+            derivative_hash = row["sha256"]
+        # Exercise thumbnail lineage independently of dataset-derivative equality.
+        assert derivative_hash != prepared["data"]["derivative_sha256"]
+    with d.service.store.read(derivative_hash) as stream:
+        raw = stream.read()
+    other = UUID(str(d.listings.create(d.token, d.csrf, ListingCreate(currency="USD"))["id"]))
+    assert d.service.status(d.token, identifier)["current_state"] == "ACTIVE"
+    _, uploaded = d.listings.upload(
+        d.token,
+        d.csrf,
+        other,
+        UploadArguments(client_upload_id=uuid4(), display_order=0),
+        "synthetic-derivative.jpg",
+        raw,
+    )
+    duplicate = UUID(uploaded["listing_image_id"])
+    # Upload alone must append withdrawal, before B is classified or prepared.
+    with d.owner.connect() as c:
+        thumbnail = c.execute(
+            "SELECT b.sha256 FROM listing_image i "
+            "JOIN image_relation r ON r.parent_id=i.original_asset_id "
+            "JOIN image_asset a ON a.id=r.child_id JOIN blob b ON b.id=a.blob_id "
+            "WHERE i.id=%s",
+            (duplicate,),
+        ).fetchone()
+        assert thumbnail is not None
+        assert thumbnail["sha256"] not in {derivative_hash, prepared["data"]["derivative_sha256"]}
+        event = c.execute(
+            "SELECT data FROM dataset_release_event WHERE release_id=%s", (identifier,)
+        ).fetchone()
+        assert event is not None
+        assert event["data"]["reason_code"] == "ADMISSION_OR_GRAPH_CHANGED"
+    assert d.service.status(d.token, identifier) == {
+        **pinned,
+        "current_state": "DATASET_RELEASE_WITHDRAWN",
+    }
+    d.subject(other)
+    different = d.service.prepare(
+        d.token,
+        d.csrf,
+        Prepare(
+            id=uuid4(),
+            expected_revision=0,
+            purpose=PURPOSE,
+            listing_image_id=duplicate,
+            crop=(0, 0, 16, 16),
+            reason="Different fixture crop after derivative reupload",
+        ),
+    )
+    assert different["data"]["original_sha256"] == derivative_hash
+    assert different["data"]["derivative_sha256"] not in {
+        derivative_hash,
+        prepared["data"]["derivative_sha256"],
+    }
+    d.review(duplicate, different)
+    _, joined = d.release([image, duplicate])
+    one, two = joined["data"]["manifest"]["items"]
+    assert one["group"] == two["group"]
+    assert one["partition"] == two["partition"]
+    assert d.service.status(d.token, identifier) == {
+        **pinned,
+        "current_state": "DATASET_RELEASE_WITHDRAWN",
+    }
+
