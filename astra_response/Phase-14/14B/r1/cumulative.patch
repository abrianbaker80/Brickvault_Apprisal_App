+                            "supporting_text_clues": ["green armor"],
+                        }
+                    ]
+                }
+            ]
+        },
+        "expected": ["sw5678"],
+    }
+    assert retained_clues(prior, 0).terms == ["green", "helmet"]
+    with pytest.raises(RetrievalError):
+        retained_clues(prior, -1)
