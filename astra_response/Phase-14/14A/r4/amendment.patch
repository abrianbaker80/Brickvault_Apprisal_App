+
+def comparison_body(root: Path) -> bytes:
+    group = comparison_group(root)
+    images = [read_bytes(root / f"{i.transmitted_sha256}.jpg", 1024 * 1024) for i in group.images]
+    return request_body(group, images, amended=True, sol=True)
+
