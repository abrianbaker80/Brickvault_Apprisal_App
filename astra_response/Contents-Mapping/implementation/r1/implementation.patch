+    child_selection = mapping_select("child-mapping").model_copy(
+        update={"revision_id": key("rev-child")}
+    )
+    child_plan = svc.prepare_mapping("80001-1", child_selection)
+    child, _ = svc.confirm_mapping(
+        "80001-1",
+        MappingConfirmation(selection=child_selection, confirmation=child_plan.confirmation),
+    )
+    discover(svc, product, parent)
+    product.advance_clock(5)
+    discover(svc, product, child)
+    # Two independent reviews of the same canonical target also race the other target.
+    contenders = [(op, svc.mapping_status(op).targets[0]) for op in (parent, parent, child)]
+    barrier = Barrier(len(contenders))
+
+    def submit(index: int) -> bool:
+        operation, target = contenders[index]
+        assert target.challenge and target.provider_color == 17
+        barrier.wait(timeout=10)
+        try:
+            svc.review_target(
+                operation,
+                target.target_id,
+                MappingReview(
+                    key=target.challenge.key, decision="approve", challenge=target.challenge
+                ),
+            )
+        except ProductRefreshError:
+            return False
+        return True
+
+    with ThreadPoolExecutor(3) as pool:
+        assert sum(pool.map(submit, range(3))) == 1
+    results = [svc.mapping_status(op).targets[0] for op in (parent, child)]
+    (winner,) = [t for t in results if t.state == "MAPPED"]
+    (loser,) = [t for t in results if t.state == "REVIEW_CONFLICT"]
+    assert winner.mapping_id and loser.conflicting_mapping_ids == [winner.mapping_id]
+    with svc.repository.database.connect() as c:
+        assert c.execute("SELECT count(*) AS n FROM component_mapping_review").fetchone() == {
+            "n": 1
+        }
+        assert c.execute(
+            "SELECT id FROM market_mapping_revision WHERE item_type='PART'"
+        ).fetchall() == [{"id": winner.mapping_id}]
diff --git a/services/api/tests/integration/test_component_mapping_recovery.py b/services/api/tests/integration/test_component_mapping_recovery.py
