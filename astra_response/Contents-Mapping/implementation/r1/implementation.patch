+"""Public component mapping contracts. Source identity and binding authority are server owned."""
+
+from datetime import datetime
+from typing import Literal
+from uuid import UUID
+
+from pydantic import AwareDatetime, Field, model_validator
+
+from .product import PublicModel
+from .refresh_models import RefreshConfirmation
+
+
+class MappingSelection(PublicModel):
+    revision_id: UUID
+    occurrences: list[UUID] = Field(min_length=1, max_length=32)
+    include_extras: bool = False
+
+    @model_validator(mode="after")
+    def unique(self) -> "MappingSelection":
+        if len(set(self.occurrences)) != len(self.occurrences):
+            raise ValueError("duplicate_selection")
+        return self
+
+    def normalized(self) -> dict[str, object]:
+        return {
+            "revision_id": str(self.revision_id),
+            "occurrences": sorted(str(i) for i in self.occurrences),
+            "include_extras": self.include_extras,
+        }
+
+
+class MappingConfirmation(PublicModel):
+    selection: MappingSelection
+    confirmation: RefreshConfirmation
+
+
+class MappingRequest(PublicModel):
+    operation: Literal["item", "element", "color", "known_colors", "subsets"]
+    selector: str
+    action: Literal["FETCH", "REUSE", "JOIN", "BLOCKED"]
+    targets: list[UUID]
+    evidence_at: datetime | None = None
+
+
+class MappingChallenge(RefreshConfirmation):
+    expires_at: AwareDatetime
+
+
+class MappingRequestStatus(MappingRequest):
+    state: str
+    attempts: int
+    eligible_until: datetime | None = None
+
+
+class MappingTarget(PublicModel):
+    target_id: UUID
+    occurrences: list[UUID]
+    kind: Literal["PART", "MINIFIG"]
+    identity: str
+    state: str
+    canonical_color: str | None = None
+    blocker: str | None = None
+    conflicting_mapping_ids: list[UUID] = Field(default_factory=list, max_length=4)
+    source: str | None = None
+    item_no: str | None = None
+    provider_color: int | None = None
+    facts: list[str] = Field(default_factory=list)
+    evidence_dates: list[datetime] = Field(default_factory=list)
+    eligible_until: datetime | None = None
+    challenge: MappingChallenge | None = None
+    mapping_id: UUID | None = None
+
+
+class MappingPlan(PublicModel):
+    set_number: str
+    selection: MappingSelection
+    targets: list[MappingTarget]
+    requests: list[MappingRequest]
+    identity_initials: int
+    price_initials: Literal[0] = 0
+    retry_reserve: int
+    maximum_attempts: int
+    admissible: bool
+    state: str
+    confirmation: RefreshConfirmation
+    expires_at: datetime
+
+
+class MappingReview(PublicModel):
+    key: UUID
+    decision: Literal["approve", "reject"]
+    challenge: MappingChallenge
+
+
+class MappingDecisionReceipt(PublicModel):
+    key: UUID
+    target_id: UUID
+    decision: Literal["approve", "reject"]
+    mapping_id: UUID | None
+    state: str
+
+
+class MappingStatus(PublicModel):
