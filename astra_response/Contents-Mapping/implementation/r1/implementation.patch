+     WHERE b.id=r OR b.parent_id=r)>=(CASE WHEN o.scope IN ('CONTENTS','MAPPING') THEN (o.plan_snapshot->>'maximum_attempts')::integer ELSE 10 END) THEN RAISE EXCEPTION 'run_budget_exhausted' USING ERRCODE='23514'; END IF;
