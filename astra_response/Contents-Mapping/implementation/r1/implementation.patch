diff --git a/services/api/tests/unit/test_component_identity.py b/services/api/tests/unit/test_component_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..1b9b69a91dcf0b4946b8cb089bf40b97560d099f
--- /dev/null
+++ b/services/api/tests/unit/test_component_identity.py
@@ -0,0 +1,176 @@
+from dataclasses import replace
+from datetime import UTC, datetime, timedelta
+from uuid import uuid4
+
+import pytest
+
+from brickvault_api.market.component_identity import (
+    EligibleEvidence,
+    IdentityBlocked,
+    SourceBinding,
+    prove,
+    source_blocker,
+)
+from brickvault_api.providers.bricklink.requests import BrickLinkColor, ItemType, Operation, Request
+from brickvault_api.providers.bricklink.responses import (
+    CatalogEvidence,
+    NativeColor,
+    NativeElement,
+    NativeItem,
+    NativeKnownColor,
+    NativeSubset,
+    NativeSubsetLine,
+)
+
+NOW = datetime(2026, 11, 17, tzinfo=UTC)
+ACCOUNT = uuid4()
+
+
+def source(kind: ItemType = ItemType.PART) -> SourceBinding:
+    return SourceBinding(
+        snapshot_id=uuid4(),
+        source_version_id=uuid4(),
+        revision_id=uuid4(),
+        target_id=uuid4(),
+        evidence_id=uuid4(),
+        namespace="rebrickable",
+        identifier="synthetic-variant-b",
+        kind=kind,
+        canonical_color="15",
+        color_semantics="known",
+        element_id="87654321",
+        parent_mapping_id=uuid4(),
+        parent_item_no="synthetic-parent",
+        regular_quantity=2,
+        parent_figure_rows=1,
+    )
+
+
+def record(evidence: CatalogEvidence) -> EligibleEvidence:
+    return EligibleEvidence(uuid4(), evidence, NOW + timedelta(hours=2), NOW + timedelta(hours=1))
+
+
+def parts() -> tuple[EligibleEvidence, ...]:
+    item = NativeItem(no="synthetic-part-b", type="PART", name="Synthetic part variant B")
+    return tuple(
+        record(e)
+        for e in (
+            CatalogEvidence(
+                Request(Operation.ELEMENT, ACCOUNT, element_id="87654321"),
+                (NativeElement(item=item, color_id=1, element_id="87654321"),),
+                NOW,
+            ),
+            CatalogEvidence(Request(Operation.ITEM, ACCOUNT, ItemType.PART, item.no), item, NOW),
+            CatalogEvidence(
+                Request(Operation.COLOR, ACCOUNT, color=BrickLinkColor(1)),
+                NativeColor(
+                    color_id=1, color_name="White", color_code="FFFFFF", color_type="Solid"
+                ),
+                NOW,
+            ),
+            CatalogEvidence(
+                Request(Operation.KNOWN_COLORS, ACCOUNT, ItemType.PART, item.no),
+                (NativeKnownColor(color_id=1, quantity=3),),
+                NOW,
+            ),
+        )
+    )
+
+
+def test_exact_element_variant_and_distinct_color_namespaces() -> None:
+    s = source()
+    result = prove(s, parts(), account=ACCOUNT, now=NOW)
+    assert result.source.identifier == "synthetic-variant-b"
+    assert result.item_no == "synthetic-part-b"
+    assert result.source.canonical_color == "15"
+    assert result.provider_color == 1
+    assert result.original_fetched_at == (NOW,) * 4
+    assert result.eligible_until == NOW + timedelta(hours=1)
+
+
+def test_ambiguous_element_cannot_be_selected_by_matching_name() -> None:
+    evidence = list(parts())
+    original = evidence[0].evidence
+    assert isinstance(original.data, tuple)
+    other = NativeElement(
+        item=NativeItem(no="synthetic-part-a", type="PART", name="Synthetic part variant B"),
+        color_id=1,
+        element_id="87654321",
+    )
+    evidence[0] = replace(evidence[0], evidence=replace(original, data=(*original.data, other)))
+    with pytest.raises(IdentityBlocked, match="ELEMENT_ASSOCIATION_AMBIGUOUS"):
+        prove(source(), tuple(evidence), account=ACCOUNT, now=NOW)
+
+
+@pytest.mark.parametrize("index", range(4))
+def test_each_proof_leg_is_required_and_expiry_is_not_refreshed(index: int) -> None:
+    records = list(parts())
+    with pytest.raises(IdentityBlocked, match="EVIDENCE_INCOMPLETE"):
+        prove(source(), tuple(records[:index] + records[index + 1 :]), account=ACCOUNT, now=NOW)
+    records[index] = replace(records[index], display_until=NOW)
+    with pytest.raises(IdentityBlocked, match="EVIDENCE_EXPIRED"):
+        prove(source(), tuple(records), account=ACCOUNT, now=NOW)
+
+
+@pytest.mark.parametrize("color", [None, "-1", "9999"])
+def test_unknown_canonical_color_is_not_provider_color(color: str | None) -> None:
+    assert source_blocker(replace(source(), canonical_color=color)) == "EXACT_COLOR_REQUIRED"
+
+
+def test_equal_name_does_not_substitute_a_variant() -> None:
+    records = list(parts())
+    wrong = NativeItem(no="synthetic-part-a", type="PART", name="Synthetic part variant B")
+    records[1] = replace(records[1], evidence=replace(records[1].evidence, data=wrong))
+    with pytest.raises(IdentityBlocked, match="EXACT_ITEM_REQUIRED"):
+        prove(source(), tuple(records), account=ACCOUNT, now=NOW)
+
+
+def figures(
+    *, extra: int = 0, alternate: bool = False, second: bool = False
+) -> tuple[EligibleEvidence, ...]:
+    item = NativeItem(no="synthetic-whole-figure", type="MINIFIG", name="Synthetic figure")
+    line = NativeSubsetLine(
+        item=item,
+        color_id=0,
+        quantity=2,
+        extra_quantity=extra,
+        is_alternate=alternate,
+        is_counterpart=False,
+    )
+    entries = (line, line) if second else (line,)
+    return (
+        record(
+            CatalogEvidence(
+                Request(Operation.SUBSETS, ACCOUNT, ItemType.SET, "synthetic-parent"),
+                (NativeSubset(match_no=0, entries=entries),),
+                NOW,
+            )
+        ),
+        record(
+            CatalogEvidence(Request(Operation.ITEM, ACCOUNT, ItemType.MINIFIG, item.no), item, NOW)
+        ),
+    )
+
+
+def test_whole_figure_requires_unique_exact_parent_and_quantity() -> None:
+    s = source(ItemType.MINIFIG)
+    result = prove(s, figures(), account=ACCOUNT, now=NOW)
+    assert result.item_type == ItemType.MINIFIG and result.provider_color is None
+    with pytest.raises(IdentityBlocked, match="PARENT_MEMBERSHIP_AMBIGUOUS"):
+        prove(replace(s, regular_quantity=1), figures(), account=ACCOUNT, now=NOW)
+    with pytest.raises(IdentityBlocked, match="AUTHORITATIVE_FIGURE_ASSOCIATION_MISSING"):
+        prove(replace(s, parent_figure_rows=2), figures(), account=ACCOUNT, now=NOW)
+    assert source_blocker(replace(s, parent_mapping_id=None)) == "EXACT_PARENT_MAPPING_REQUIRED"
+
+
+@pytest.mark.parametrize("args", [{"extra": 1}, {"alternate": True}, {"second": True}])
+def test_parent_membership_never_guesses(args: dict[str, int | bool]) -> None:
+    with pytest.raises(IdentityBlocked):
+        prove(source(ItemType.MINIFIG), figures(**args), account=ACCOUNT, now=NOW)
+
+
+def test_different_account_and_naive_dates_are_not_eligible() -> None:
+    with pytest.raises(IdentityBlocked, match="EVIDENCE_SCOPE_MISMATCH"):
+        prove(source(), parts(), account=uuid4(), now=NOW)
+    with pytest.raises(IdentityBlocked, match="EVIDENCE_DATE_INVALID"):
+        prove(source(), parts(), account=ACCOUNT, now=NOW.replace(tzinfo=None))
