+def test_late_exact_receipt_after_source_drift(
+    svc: ComponentMappingService, product: ProductHarness, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    plan = svc.prepare_mapping("80000-1", mapping_select("figure-line"))
+    assert plan.admissible and plan.identity_initials == 2
+    body = MappingConfirmation(selection=plan.selection, confirmation=plan.confirmation)
+    duplicate = ComponentMappingService(
+        svc.product, svc.repository, svc.account, svc.signing_key, svc.provider
+    )
+    looked_up, release = Barrier(2), Barrier(2)
+    original = duplicate._existing
+    first = True
+
+    def hold(*args: Any) -> UUID | None:
+        nonlocal first
+        found = original(*args)
+        if first:
+            first = False
+            assert found is None
+            looked_up.wait(timeout=15)
+            release.wait(timeout=15)
+        return found
+
+    monkeypatch.setattr(duplicate, "_existing", hold)
+    with ThreadPoolExecutor(1) as pool:
+        pending = pool.submit(duplicate.confirm_mapping, "80000-1", body)
+        looked_up.wait(timeout=15)
+        try:
+            operation, created = svc.confirm_mapping("80000-1", body)
+            assert created
+            discover(svc, product, operation)
+            target = svc.mapping_status(operation).targets[0]
+            assert target.item_no == "fixture-figure-b" and target.challenge
+            product.market.owner.revoke_mapping(product.market.mapping.id)
+        finally:
+            release.wait(timeout=15)
+        assert pending.result(timeout=15) == (operation, False)
+    assert svc.mapping_status(operation).targets[0].challenge is None
+    with pytest.raises(ProductRefreshError):
+        svc.review_target(
+            operation,
+            target.target_id,
+            MappingReview(key=target.challenge.key, decision="approve", challenge=target.challenge),
+        )
+    assert svc.mapping_status(operation).attempts_consumed == 2
