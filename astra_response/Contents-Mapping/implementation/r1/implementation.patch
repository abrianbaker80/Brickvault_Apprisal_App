+CREATE FUNCTION component_mapping_content_valid(op text,c jsonb) RETURNS boolean
+LANGUAGE plpgsql IMMUTABLE SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE x jsonb; label text;
+BEGIN
+ IF c IS NULL OR jsonb_typeof(c)<>'object' OR octet_length(c::text)>16384 THEN RETURN false; END IF;
+ FOR label IN SELECT value FROM jsonb_each_text(c) WHERE key IN ('item_name','color_name','color_code','color_type') LOOP
+   IF length(label)>2048 OR label ~ '[[:cntrl:]{}<>]' OR label ~* '([a-z][a-z0-9+.-]*://|mailto:|data:|javascript:|www\.|oauth|authorization|bearer |signature|token_secret|consumer_secret|traceback)'
+    OR label ~* '(^[[:space:]]*\[|(cookie|set-cookie|content-type|location|password|credentials?|api[_ -]?key|access[_ -]?token|token|price|avg_price|min_price|max_price|qty_avg_price)[[:space:]]*[:=]|(^|[[:space:]])([A-Za-z_][A-Za-z0-9_]*(Error|Exception)|Exception)[[:space:]]*[:(])' THEN RETURN false; END IF;
+ END LOOP;
+ CASE op
+ WHEN 'item' THEN RETURN (c-'item_type'-'item_no'-'item_name')='{}'::jsonb AND c->>'item_type' IN ('PART','MINIFIG') AND c->>'item_no' ~ '^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$' AND jsonb_typeof(c->'item_name') IN ('null','string');
+ WHEN 'color' THEN RETURN (c-'color_id'-'color_name'-'color_code'-'color_type')='{}'::jsonb AND jsonb_typeof(c->'color_id')='number'
+   AND (c->>'color_id') ~ '^[0-9]{1,10}$' AND c->'color_id'<=to_jsonb(2147483647) AND jsonb_typeof(c->'color_name')='string'
+   AND jsonb_typeof(c->'color_type') IN ('null','string') AND jsonb_typeof(c->'color_code') IN ('null','string');
+ WHEN 'known_colors' THEN
+   IF (c-'colors')<>'{}' OR jsonb_typeof(c->'colors') IS DISTINCT FROM 'array' THEN RETURN false; END IF;
+   RETURN NOT EXISTS(SELECT 1 FROM jsonb_array_elements(c->'colors') z WHERE jsonb_typeof(z)<>'number' OR z::text !~ '^[0-9]{1,10}$' OR z>to_jsonb(2147483647));
+ WHEN 'element' THEN
+   IF (c-'elements')<>'{}' OR jsonb_typeof(c->'elements') IS DISTINCT FROM 'array' THEN RETURN false; END IF;
+   FOR x IN SELECT value FROM jsonb_array_elements(c->'elements') LOOP
+     IF ((x-'item_type'-'item_no'-'color_id'-'element_id')='{}'::jsonb AND x->>'item_type' IN ('PART','MINIFIG','SET','BOOK','GEAR','CATALOG','INSTRUCTION','UNSORTED_LOT','ORIGINAL_BOX')
+       AND jsonb_typeof(x->'item_no')='string' AND (x->>'item_no') ~ '^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$' AND jsonb_typeof(x->'color_id')='number'
+       AND (x->>'color_id') ~ '^[0-9]{1,10}$' AND x->'color_id'<=to_jsonb(2147483647) AND jsonb_typeof(x->'element_id')='string' AND x->>'element_id' ~ '^[0-9]{1,32}$') IS NOT TRUE THEN RETURN false; END IF;
+   END LOOP;
+ WHEN 'subsets' THEN
+   IF (c-'figures')<>'{}' OR jsonb_typeof(c->'figures') IS DISTINCT FROM 'array' THEN RETURN false; END IF;
+   FOR x IN SELECT value FROM jsonb_array_elements(c->'figures') LOOP
+     IF ((x-'item_no'-'quantity'-'extra_quantity'-'alternate'-'counterpart'-'group_size')='{}'::jsonb
+       AND jsonb_typeof(x->'item_no')='string' AND (x->>'item_no') ~ '^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$' AND jsonb_typeof(x->'alternate')='boolean' AND jsonb_typeof(x->'counterpart')='boolean'
+       AND jsonb_typeof(x->'quantity')='number' AND x->>'quantity' ~ '^[0-9]{1,19}$' AND jsonb_typeof(x->'extra_quantity')='number' AND x->>'extra_quantity' ~ '^[0-9]{1,19}$'
+       AND jsonb_typeof(x->'group_size')='number' AND x->>'group_size' ~ '^[1-9][0-9]{0,18}$') IS NOT TRUE THEN RETURN false; END IF;
+   END LOOP;
+ ELSE RETURN false;
+ END CASE;
+ RETURN true;
+END $$;
