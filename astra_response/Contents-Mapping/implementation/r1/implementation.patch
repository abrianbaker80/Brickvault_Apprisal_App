+CREATE FUNCTION component_mapping_node_current(p_op uuid,p_key text) RETURNS boolean
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+ SELECT bool_and(t.payload IS NOT DISTINCT FROM live.value AND d.receipt_key IS NULL AND NOT EXISTS(
+   SELECT 1 FROM market_mapping_revision m WHERE m.provider='bricklink' AND m.closed_at IS NULL AND m.review_state IN ('verified','conflicted')
+   AND m.item_type=t.payload->>'item_type' AND m.item_no=selectors.item->>'item_no'
+   AND (t.minifigure_id IS NOT NULL AND m.color_id IS NULL OR t.part_color_id IS NOT NULL AND m.color_id=(selectors.color->>'color_id')::integer)))
+ FROM product_refresh_operation o JOIN component_mapping_request_target edge ON edge.operation_id=o.id
+ JOIN product_refresh_target t USING(operation_id,target_id)
+ LEFT JOIN component_mapping_review d USING(operation_id,target_id)
+ LEFT JOIN LATERAL (SELECT value FROM jsonb_array_elements(component_mapping_targets(
+   o.canonical_set_id,o.snapshot_id,o.plan_snapshot->'selection')) WHERE value->>'target_id'=edge.target_id::text) live ON true
+ CROSS JOIN LATERAL (SELECT component_mapping_selector(o.id,'item:'||COALESCE(t.part_id,t.target_id)::text) item,
+   CASE WHEN t.color_id IS NOT NULL THEN component_mapping_selector(o.id,'color:'||t.color_id::text) END color) selectors
+ WHERE o.id=p_op AND o.scope='MAPPING' AND edge.node_key=p_key
+$$;
