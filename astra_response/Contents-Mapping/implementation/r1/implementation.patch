+    RAISE EXCEPTION 'group_budget_exhausted' USING ERRCODE='23514'; END IF;
+   IF (SELECT count(*) FROM public.provider_fetch_run WHERE scope_id=NEW.scope_id AND reserved_at>n-interval '1 day')>=p.global_limit THEN
