+BEGIN
+ SELECT * INTO g FROM public.provider_budget_group WHERE id=NEW.budget_group;
+ IF g.operation_type NOT IN ('PRODUCT_SET_REFRESH','PRODUCT_CONTENTS_REFRESH','PRODUCT_CONTENTS_MAPPING') OR g.operation_type IS NULL THEN RETURN NEW; END IF;
+ r=COALESCE(g.parent_id,g.id);
+ IF TG_OP='INSERT' OR (NEW.outcome='dispatched' AND OLD.outcome='reserved') THEN
+  o=public.product_refresh_owned(r);
+  PERFORM public.product_refresh_context(r);
+  IF NEW.scope_id<>g.scope_id OR NEW.policy_id<>o.market_policy_id THEN
+   RAISE EXCEPTION 'PRODUCT_ATTEMPT_SCOPE' USING ERRCODE='23514'; END IF;
+  IF NEW.purpose='IDENTITY_DISCOVERY' THEN
+   IF o.scope='MAPPING' THEN
+    IF NEW.budget_group<>o.identity_budget_group_id OR NEW.discovery_account_scope<>o.account_scope OR NOT EXISTS(
+      SELECT 1 FROM public.component_mapping_request r WHERE r.operation_id=o.id AND r.logical_id=NEW.logical_request_id AND r.node->>'action'='FETCH'
+      AND public.component_mapping_node_current(o.id,r.node_key)
+      AND r.node->'targets'->>0=NEW.discovery_target_id::text AND public.component_mapping_selector(o.id,r.node_key)
+      =jsonb_strip_nulls(jsonb_build_object('operation',NEW.discovery_operation,'item_type',NEW.discovery_item_type,'item_no',NEW.discovery_item_no,'color_id',NEW.discovery_color_id,'element_id',NEW.discovery_element_id))) THEN
+      RAISE EXCEPTION 'PRODUCT_DISCOVERY_NOT_AUTHORIZED' USING ERRCODE='23514'; END IF;
+   ELSIF o.scope='CONTENTS' OR NEW.budget_group<>o.identity_budget_group_id OR NEW.discovery_target_id<>o.canonical_set_id
+    OR NEW.discovery_account_scope<>o.account_scope OR NEW.discovery_operation<>'item' OR NEW.discovery_item_type<>'SET'
+    OR o.resolved_mapping_id IS NOT NULL OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(o.plan_snapshot->'selectors') x
+      WHERE x->>'item_type'=NEW.discovery_item_type AND x->>'item_no'=NEW.discovery_item_no) THEN
+    RAISE EXCEPTION 'PRODUCT_DISCOVERY_NOT_AUTHORIZED' USING ERRCODE='23514';
+   END IF;
+  ELSE
+   SELECT * INTO v FROM public.product_refresh_view WHERE operation_id=r AND cache_id=NEW.cache_id
+    AND job_id=NEW.job_id AND current_generation=NEW.generation AND bound_budget_group=NEW.budget_group;
