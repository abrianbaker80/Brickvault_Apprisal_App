+CREATE FUNCTION component_mapping_selector(p_op uuid,p_key text) RETURNS jsonb
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE n jsonb; op text; seed jsonb; content jsonb; pair jsonb; picked jsonb; current_pair jsonb;
+BEGIN
+ SELECT node INTO n FROM component_mapping_request WHERE operation_id=p_op AND node_key=p_key;
+ op=n->>'operation'; IF op IS NULL THEN RETURN NULL; END IF;
+ IF op='element' THEN RETURN jsonb_build_object('operation',op,'element_id',n->'seeds'->0->>'element'); END IF;
+ IF op='subsets' THEN RETURN jsonb_build_object('operation',op,'item_type','SET','item_no',n->'seeds'->0->>'parent'); END IF;
+ FOR seed IN SELECT value FROM jsonb_array_elements(n->'seeds') LOOP
+   IF seed ? 'element' THEN
+    content=component_mapping_node_evidence(p_op,'element:'||(seed->>'element'))->'content';
+    IF jsonb_typeof(content->'elements') IS DISTINCT FROM 'array' OR jsonb_array_length(content->'elements')=0 THEN RETURN NULL; END IF;
+    pair=content->'elements'->0;
+    IF EXISTS(SELECT 1 FROM jsonb_array_elements(content->'elements')x WHERE x IS DISTINCT FROM pair)
+     OR pair->>'element_id' IS DISTINCT FROM seed->>'element' OR pair->>'item_type' IS DISTINCT FROM 'PART'
+     OR COALESCE(pair->>'item_no','') !~ '^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$' OR jsonb_typeof(pair->'color_id') IS DISTINCT FROM 'number' THEN RETURN NULL; END IF;
+    current_pair=CASE WHEN op='color' THEN jsonb_build_object('color_id',pair->'color_id') ELSE jsonb_build_object('item_type','PART','item_no',pair->>'item_no') END;
+   ELSE
+    content=component_mapping_node_evidence(p_op,'subsets:'||(seed->>'parent'))->'content';
+    IF jsonb_typeof(content->'figures') IS DISTINCT FROM 'array' OR jsonb_array_length(content->'figures')<>1 THEN RETURN NULL; END IF;
+    pair=content->'figures'->0;
+    IF (pair-'item_no') IS DISTINCT FROM jsonb_build_object('quantity',seed->'quantity','extra_quantity',0,'alternate',false,'counterpart',false,'group_size',1)
+      OR COALESCE(pair->>'item_no','') !~ '^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$' THEN RETURN NULL; END IF;
+    current_pair=jsonb_build_object('item_type','MINIFIG','item_no',pair->>'item_no');
+   END IF;
+   IF picked IS NOT NULL AND current_pair IS DISTINCT FROM picked THEN RETURN NULL; END IF;
+   picked=current_pair;
+ END LOOP;
+ RETURN jsonb_build_object('operation',op)||picked;
+END $$;
