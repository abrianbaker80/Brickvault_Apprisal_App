+    assert target.challenge and target.item_no == "fixture-bridge-b" and target.provider_color == 17
+    assert len(target.evidence_dates) == 4
+    decision = MappingReview(
+        key=target.challenge.key, decision="approve", challenge=target.challenge
+    )
+    # Independent simultaneous submissions must recover the same receipt and mapping.
+    barrier = Barrier(2)
+
+    def submit() -> UUID | None:
+        barrier.wait(timeout=10)
+        readback = svc.review_target(operation, target.target_id, decision)
+        assert isinstance(readback, MappingStatus)
+        return next(t.mapping_id for t in readback.targets if t.target_id == target.target_id)
+
+    with ThreadPoolExecutor(2) as pool:
