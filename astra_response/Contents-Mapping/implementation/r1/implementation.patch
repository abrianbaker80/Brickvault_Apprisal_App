+CREATE FUNCTION component_mapping_confirm(p_plan jsonb,p_key uuid,p_created timestamptz,p_digest text,p_request_digest text) RETURNS uuid
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE o public.product_refresh_operation; n timestamptz; r uuid=gen_random_uuid(); ig uuid=gen_random_uuid(); pg uuid=gen_random_uuid();
+ v_scope uuid; sid uuid; snap uuid; policy public.market_policy; t jsonb; v jsonb; initials integer;
+BEGIN
+ PERFORM pg_advisory_xact_lock(hashtextextended(p_key::text,630008));
+ SELECT * INTO o FROM public.product_refresh_operation WHERE idempotency_key=p_key;
+ IF o.id IS NOT NULL THEN
+ IF (o.plan_snapshot,o.plan_digest,o.created_at,o.scope,o.component_receipt_digest) IS DISTINCT FROM (p_plan,p_digest,p_created,'MAPPING'::varchar,p_request_digest) THEN
+ RAISE EXCEPTION 'IDEMPOTENCY_CONFLICT' USING ERRCODE='23514'; END IF; RETURN o.id; END IF;
+ n=public.product_refresh_clock();
+ IF p_key IS NULL OR substring(p_key::text,15,1)<>'4' OR substring(p_key::text,20,1) NOT IN ('8','9','a','b')
+ OR p_created IS NULL OR p_created>n OR n>=p_created+interval '15 minutes' THEN
+ RAISE EXCEPTION 'CONFIRMATION_EXPIRED' USING ERRCODE='23514'; END IF;
+ IF p_plan IS NULL OR p_digest IS DISTINCT FROM public.product_refresh_digest(p_plan) OR p_request_digest IS NULL OR p_request_digest !~ '^[0-9a-f]{64}$' OR octet_length(p_plan::text)>16384 THEN
+ RAISE EXCEPTION 'INVALID_PLAN' USING ERRCODE='23514'; END IF;
+ v_scope=(p_plan->>'scope_id')::uuid; sid=(p_plan->>'canonical_set_id')::uuid; snap=(p_plan->>'snapshot_id')::uuid;
+ PERFORM 1 FROM public.catalog_snapshot WHERE id=snap FOR SHARE;
+ PERFORM 1 FROM public.catalog_active_snapshot WHERE snapshot_id=snap FOR SHARE;
+ PERFORM 1 FROM public.provider_scope_state WHERE id=v_scope FOR UPDATE;
+ PERFORM pg_advisory_xact_lock(630006);
+ n=public.product_refresh_clock();
+ IF n>=p_created+interval '15 minutes' THEN RAISE EXCEPTION 'CONFIRMATION_EXPIRED' USING ERRCODE='23514'; END IF;
+ IF p_plan IS DISTINCT FROM public.component_mapping_plan(sid,snap,v_scope,(p_plan->>'account_scope')::uuid,p_plan->'selection') THEN
+ RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ initials=(p_plan->>'authorized_identity_initials')::integer;
+ IF initials>6 OR jsonb_array_length(p_plan->'nodes')=0 THEN RAISE EXCEPTION 'IDENTITY_LIMIT' USING ERRCODE='23514'; END IF;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE canonical_set_id=sid AND scope='MAPPING' AND state<>'CLOSED';
+ IF o.id IS NOT NULL AND component_mapping_settle(o.id)<>'CLOSED' THEN RAISE EXCEPTION 'OPERATION_IN_PROGRESS' USING ERRCODE='23514',DETAIL=o.id::text; END IF;
+ SELECT * INTO policy FROM public.market_policy WHERE id=(p_plan->>'market_policy_id')::uuid;
+ IF initials>0 AND (policy.effective_at>n OR policy.interactive_limit<initials+2 OR
+   (SELECT count(*) FROM public.provider_fetch_run WHERE scope_id=v_scope AND reserved_at>n-interval '1 day')+initials+2>policy.global_limit
+   OR EXISTS(SELECT 1 FROM public.provider_scope_state WHERE id=v_scope AND (suspended IS NOT NULL OR next_dispatch_at>n))) THEN
+   RAISE EXCEPTION 'BUDGET_EXHAUSTED' USING ERRCODE='23514'; END IF;
+ INSERT INTO public.provider_budget_group(id,scope_id,parent_id,case_id,budget_class,identity_limit,price_limit,retry_limit,total_limit,created_at,operation_type,operation_key)
+ VALUES(r,v_scope,NULL,NULL,'interactive',6,0,2,8,n,'PRODUCT_CONTENTS_MAPPING',sid::text),
+ (ig,v_scope,r,NULL,'interactive',NULL,NULL,NULL,NULL,n,'PRODUCT_CONTENTS_MAPPING',sid::text),
+ (pg,v_scope,r,NULL,'interactive',NULL,NULL,NULL,NULL,n,'PRODUCT_CONTENTS_MAPPING',sid::text);
+ INSERT INTO public.product_refresh_operation(id,canonical_set_id,normalized_set_number,snapshot_id,source_version_id,catalog_evidence_id,
+ identity_budget_group_id,price_budget_group_id,account_scope,market_policy_id,idempotency_key,product_policy_version,plan_semantic_version,
+ plan_digest,plan_snapshot,created_at,confirmed_at,expires_at,retained_until,state,scope,component_receipt_digest)
+ VALUES(r,sid,p_plan->>'normalized_set_number',snap,(p_plan->>'source_version_id')::uuid,(p_plan->>'catalog_evidence_id')::uuid,
+ ig,pg,(p_plan->>'account_scope')::uuid,policy.id,p_key,p_plan->>'product_policy_version',p_plan->>'semantic_version',p_digest,p_plan,
+ p_created,n,n+interval '24 hours',n+make_interval(secs=>GREATEST(86400,policy.metadata_seconds)),'OPEN','MAPPING',p_request_digest);
+ FOR t IN SELECT * FROM jsonb_array_elements(p_plan->'targets') LOOP
+ INSERT INTO public.product_refresh_target(operation_id,target_id,mapping_id,snapshot_id,source_version_id,revision_id,minifigure_id,part_color_id,part_id,color_id,payload)
+ VALUES(r,(t->>'target_id')::uuid,(t->>'mapping_id')::uuid,snap,(p_plan->>'source_version_id')::uuid,(p_plan->'selection'->>'revision_id')::uuid,
+ (t->>'minifigure_id')::uuid,(t->>'part_color_id')::uuid,(t->>'part_id')::uuid,(t->>'color_id')::uuid,t);
