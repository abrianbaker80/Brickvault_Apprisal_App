+  OR (SELECT count(*) FROM public.provider_budget_group WHERE parent_id=p_id)<>2
+  OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group WHERE id=o.identity_budget_group_id AND parent_id=p_id)
+  OR NOT EXISTS(SELECT 1 FROM public.provider_budget_group WHERE id=o.price_budget_group_id AND parent_id=p_id)
+  OR EXISTS(SELECT 1 FROM public.provider_budget_group WHERE parent_id=p_id AND closed_at IS DISTINCT FROM o.closed_at) THEN
+  RAISE EXCEPTION 'PRODUCT_OPERATION_STRUCTURE' USING ERRCODE='23514';
