new file mode 100644
index 0000000000000000000000000000000000000000..629ef48b182e73d83bcca944c9cab5e2d96474b4
--- /dev/null
+++ b/services/api/src/brickvault_api/market/component_evidence.py
@@ -0,0 +1,127 @@
+"""Bounded, typed discovery facts retained for component identity review."""
+
+from typing import Any
+from uuid import UUID
+
+from ..providers.bricklink.requests import ItemType, Operation
+from ..providers.bricklink.responses import (
+    CatalogEvidence,
+    NativeColor,
+    NativeElement,
+    NativeItem,
+    NativeKnownColor,
+    NativeSubset,
+)
+from .component_identity import IdentityBlocked, SourceBinding, unique_parent_figure
+from .models import MarketError
+from .product_refresh_models import canonical
+
+
+def source_binding(plan: dict[str, Any], target: dict[str, Any]) -> SourceBinding:
+    return SourceBinding(
+        snapshot_id=UUID(plan["snapshot_id"]),
+        source_version_id=UUID(plan["source_version_id"]),
+        revision_id=UUID(plan["selection"]["revision_id"]),
+        target_id=UUID(target["target_id"]),
+        evidence_id=UUID(target["evidence_id"]),
+        namespace=target["namespace"],
+        identifier=target["identifier"],
+        kind=ItemType(target["item_type"]),
+        canonical_color=target.get("canonical_color"),
+        color_semantics=target.get("color_semantics"),
+        element_id=target.get("element_id"),
+        parent_item_no=target.get("parent_item_no"),
+        parent_mapping_id=UUID(target["parent_mapping_id"])
+        if target.get("parent_mapping_id")
+        else None,
+        regular_quantity=target["regular_quantity"],
+        extra_quantity=target["extra_quantity"],
+        parent_figure_rows=target.get("parent_figure_rows", 0),
+    )
+
+
+def content(evidence: CatalogEvidence) -> dict[str, Any]:
+    """Discard unrelated subset entries while preserving each figure's group cardinality."""
+    operation, data = evidence.request.operation, evidence.data
+    facts: dict[str, Any]
+    if operation == Operation.ITEM and isinstance(data, NativeItem):
+        facts = {"item_type": data.type, "item_no": data.no, "item_name": data.name}
+    elif operation == Operation.COLOR and isinstance(data, NativeColor):
+        facts = data.model_dump()
+    elif isinstance(data, tuple):
+        if operation == Operation.SUBSETS:
+            # Preserve ambiguity when more than one provider group has the same match_no.
+            sizes: dict[int, int] = {}
+            for subset in data:
+                if not isinstance(subset, NativeSubset):
+                    raise MarketError("EVIDENCE_INVALID")
+                sizes[subset.match_no] = max(sizes.get(subset.match_no, 0), len(subset.entries))
+            figures = []
+            for group in data:
+                if not isinstance(group, NativeSubset):
+                    raise MarketError("EVIDENCE_INVALID")
+                for line in group.entries:
+                    if line.item.type == "MINIFIG":
+                        figures.append(
+                            dict(
+                                item_no=line.item.no,
+                                quantity=line.quantity,
+                                extra_quantity=line.extra_quantity,
+                                alternate=line.is_alternate,
+                                counterpart=line.is_counterpart,
+                                group_size=sizes[group.match_no],
+                            )
+                        )
+            facts = {"figures": figures}
+        elif operation == Operation.KNOWN_COLORS:
+            colors = []
+            for color in data:
+                if not isinstance(color, NativeKnownColor):
+                    raise MarketError("EVIDENCE_INVALID")
+                colors.append(color.color_id)
+            facts = {"colors": sorted(set(colors))}
+        elif operation == Operation.ELEMENT:
+            elements = []
+            for element in data:
+                if not isinstance(element, NativeElement):
+                    raise MarketError("EVIDENCE_INVALID")
+                elements.append(
+                    dict(
+                        item_type=element.item.type,
+                        item_no=element.item.no,
+                        color_id=element.color_id,
+                        element_id=element.element_id,
+                    )
+                )
+            facts = {"elements": elements}
+        else:
+            raise MarketError("EVIDENCE_INVALID")
+    else:
+        raise MarketError("EVIDENCE_INVALID")
+    if len(canonical(facts).encode("utf-8")) > 16384:
+        raise MarketError("EVIDENCE_OVERSIZED")
+    return facts
+
+
+def verify_parent_projection(
+    evidence: CatalogEvidence, facts: dict[str, Any], source: SourceBinding
+) -> None:
+    """A lossy projection must never convert an ambiguous original into admissible proof."""
+    rows = facts["figures"]
+    if len(rows) != 1:
+        return
+    row = rows[0]
+    if (
+        row["quantity"] != source.regular_quantity
+        or row["extra_quantity"] != 0
+        or row["alternate"]
+        or row["counterpart"]
+        or row["group_size"] != 1
+    ):
+        return
+    try:
+        original = unique_parent_figure(evidence, source)
+    except IdentityBlocked as error:
+        raise MarketError("PARENT_EVIDENCE_PROJECTION") from error
+    if original != row["item_no"]:
+        raise MarketError("PARENT_EVIDENCE_PROJECTION")
diff --git a/services/api/src/brickvault_api/market/component_identity.py b/services/api/src/brickvault_api/market/component_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb346699b2a5c3d827ce5ad51b4ca450e9b2cb6c
--- /dev/null
+++ b/services/api/src/brickvault_api/market/component_identity.py
@@ -0,0 +1,238 @@
+"""Pure component proof checks; no dispatch, approval, or persistence authority.
+
+Inputs must be resolved from pinned catalog rows and eligible persisted evidence by
+the repository. A supported result is a review candidate, never a mapping admission.
+The historical three-item proof harness remains unchanged.
+"""
+
+from dataclasses import dataclass
+from datetime import datetime
+from uuid import UUID
+
+from ..providers.bricklink.requests import ItemType, Operation
+from ..providers.bricklink.responses import (
+    ADAPTER_VERSION,
+    CatalogEvidence,
+    NativeColor,
+    NativeElement,
+    NativeItem,
+    NativeKnownColor,
+    NativeSubset,
+)
+
+PROOF_VERSION = "component-identity-v1"
+
+
+class IdentityBlocked(ValueError):
+    """Fixed safe blocker codes only."""
+
+
+@dataclass(frozen=True)
+class SourceBinding:
+    snapshot_id: UUID
+    source_version_id: UUID
+    revision_id: UUID
+    target_id: UUID
+    evidence_id: UUID
+    namespace: str
+    identifier: str
+    kind: ItemType
+    canonical_color: str | None = None
+    color_semantics: str | None = None
+    element_id: str | None = None
+    parent_mapping_id: UUID | None = None
+    parent_item_no: str | None = None
+    regular_quantity: int = 0
+    extra_quantity: int = 0
+    parent_figure_rows: int = 0
+    ambiguous_membership: bool = False
+
+
+@dataclass(frozen=True)
+class EligibleEvidence:
+    attempt_id: UUID
+    evidence: CatalogEvidence
+    retained_until: datetime
+    display_until: datetime
+
+    def check(self, now: datetime, account: UUID) -> None:
+        dates = (now, self.evidence.fetched_at, self.retained_until, self.display_until)
+        if any(d.tzinfo is None or d.utcoffset() is None for d in dates):
+            raise IdentityBlocked("EVIDENCE_DATE_INVALID")
+        if not self.evidence.fetched_at <= now < min(self.retained_until, self.display_until):
+            raise IdentityBlocked("EVIDENCE_EXPIRED")
+        if (
+            self.evidence.request.account_scope != account
+            or self.evidence.adapter_version != ADAPTER_VERSION
+            or self.evidence.request.operation == Operation.PRICE
+        ):
+            raise IdentityBlocked("EVIDENCE_SCOPE_MISMATCH")
+
+
+@dataclass(frozen=True)
+class CandidateBinding:
+    source: SourceBinding
+    item_type: ItemType
+    item_no: str
+    provider_color: int | None
+    evidence_attempts: tuple[UUID, ...]
+    original_fetched_at: tuple[datetime, ...]
+    eligible_until: datetime
+    proof_version: str = PROOF_VERSION
+
+
+def source_blocker(source: SourceBinding) -> str | None:
+    if not source.namespace.strip() or not source.identifier.strip():
+        return "SOURCE_IDENTITY_MISSING"
+    if source.kind == ItemType.PART:
+        if source.color_semantics != "known" or source.canonical_color in (None, "-1", "9999"):
+            return "EXACT_COLOR_REQUIRED"
+        if not source.element_id:
+            return "EXACT_ELEMENT_REQUIRED"
+    elif source.kind == ItemType.MINIFIG:
+        if not source.parent_mapping_id or not source.parent_item_no:
+            return "EXACT_PARENT_MAPPING_REQUIRED"
+        if (
+            source.parent_figure_rows != 1
+            or source.regular_quantity <= 0
+            or source.extra_quantity != 0
+            or source.ambiguous_membership
+        ):
+            return "AUTHORITATIVE_FIGURE_ASSOCIATION_MISSING"
+    else:
+        return "UNSUPPORTED_COMPONENT_KIND"
+    return None
+
+
+def unique_element(evidence: CatalogEvidence, element_id: str) -> tuple[str, int]:
+    """Retain ambiguity across every returned association, including variants."""
+    if evidence.request.operation != Operation.ELEMENT or evidence.request.element_id != element_id:
+        raise IdentityBlocked("ELEMENT_REQUEST_MISMATCH")
+    data = evidence.data
+    if not isinstance(data, tuple) or not data:
+        raise IdentityBlocked("ELEMENT_ASSOCIATION_MISSING")
+    targets: set[tuple[str, int]] = set()
+    for row in data:
+        if (
+            not isinstance(row, NativeElement)
+            or row.element_id != element_id
+            or row.item.type != "PART"
+        ):
+            raise IdentityBlocked("ELEMENT_ASSOCIATION_MISMATCH")
+        targets.add((row.item.no, row.color_id))
+    if len(targets) != 1:
+        raise IdentityBlocked("ELEMENT_ASSOCIATION_AMBIGUOUS")
+    return next(iter(targets))
+
+
+def unique_parent_figure(evidence: CatalogEvidence, source: SourceBinding) -> str:
+    request = evidence.request
+    if (
+        request.operation != Operation.SUBSETS
+        or request.item_type != ItemType.SET
+        or request.item_no != source.parent_item_no
+        or request.break_minifigs
+        or request.break_subsets
+        or request.box
+        or request.instruction
+    ):
+        raise IdentityBlocked("PARENT_REQUEST_MISMATCH")
+    if not isinstance(evidence.data, tuple) or not all(
+        isinstance(group, NativeSubset) for group in evidence.data
+    ):
+        raise IdentityBlocked("PARENT_EVIDENCE_INCOMPLETE")
+    figures = [
+        (group.match_no, row)
+        for group in evidence.data
+        if isinstance(group, NativeSubset)
+        for row in group.entries
+        if row.item.type == "MINIFIG"
+    ]
+    if len(figures) != 1:
+        raise IdentityBlocked("AUTHORITATIVE_FIGURE_ASSOCIATION_MISSING")
+    match, figure = figures[0]
+    if (
+        figure.quantity != source.regular_quantity
+        or figure.extra_quantity != 0
+        or figure.is_alternate
+        or figure.is_counterpart
+        or any(
+            len(group.entries) != 1
+            for group in evidence.data
+            if isinstance(group, NativeSubset) and group.match_no == match
+        )
+    ):
+        raise IdentityBlocked("PARENT_MEMBERSHIP_AMBIGUOUS")
+    return figure.item.no
+
+
+def prove(
+    source: SourceBinding,
+    records: tuple[EligibleEvidence, ...],
+    *,
+    account: UUID,
+    now: datetime,
+) -> CandidateBinding:
+    blocker = source_blocker(source)
+    if blocker:
+        raise IdentityBlocked(blocker)
+    required = (
+        {Operation.ELEMENT, Operation.ITEM, Operation.COLOR, Operation.KNOWN_COLORS}
+        if source.kind == ItemType.PART
+        else {Operation.SUBSETS, Operation.ITEM}
+    )
+    if len(records) != len(required) or len({r.attempt_id for r in records}) != len(records):
+        raise IdentityBlocked("EVIDENCE_INCOMPLETE")
+    for record in records:
+        record.check(now, account)
+    by_operation = {r.evidence.request.operation: r.evidence for r in records}
+    if set(by_operation) != required:
+        raise IdentityBlocked("EVIDENCE_INCOMPLETE")
+    color: int | None = None
+    if source.kind == ItemType.PART:
+        assert source.element_id is not None
+        item_no, color = unique_element(by_operation[Operation.ELEMENT], source.element_id)
+        color_evidence = by_operation[Operation.COLOR]
+        native_color = color_evidence.data
+        if (
+            not isinstance(native_color, NativeColor)
+            or native_color.color_id != color
+            or not native_color.color_name.strip()
+            or color_evidence.request.color is None
+            or color_evidence.request.color.id != color
+        ):
+            raise IdentityBlocked("COLOR_EVIDENCE_MISMATCH")
+        known = by_operation[Operation.KNOWN_COLORS]
+        if (
+            known.request.item_type != ItemType.PART
+            or known.request.item_no != item_no
+            or not isinstance(known.data, tuple)
+            or not all(isinstance(row, NativeKnownColor) for row in known.data)
+            or not any(
+                isinstance(row, NativeKnownColor) and row.color_id == color for row in known.data
+            )
+        ):
+            raise IdentityBlocked("KNOWN_COLORS_MISMATCH")
+    else:
+        item_no = unique_parent_figure(by_operation[Operation.SUBSETS], source)
+    item = by_operation[Operation.ITEM]
+    if (
+        item.request.item_type != source.kind
+        or item.request.item_no != item_no
+        or not isinstance(item.data, NativeItem)
+        or item.data.type != source.kind
+        or item.data.no != item_no
+        or not item.data.name
+        or not item.data.name.strip()
+    ):
+        raise IdentityBlocked("EXACT_ITEM_REQUIRED")
+    ordered = sorted(records, key=lambda r: str(r.attempt_id))
+    return CandidateBinding(
+        source=source,
+        item_type=source.kind,
+        item_no=item_no,
+        provider_color=color,
+        evidence_attempts=tuple(r.attempt_id for r in ordered),
+        original_fetched_at=tuple(r.evidence.fetched_at for r in ordered),
+        eligible_until=min(min(r.retained_until, r.display_until) for r in records),
+    )
