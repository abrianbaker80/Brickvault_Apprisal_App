@@ -0,0 +1,200 @@
+"""HTTP boundaries and durable failure recovery for selected identity discovery."""
+
+from contextlib import closing
+from uuid import uuid4
+
+import pytest
+from fastapi.testclient import TestClient
+
+from brickvault_api.api.component_mapping import mapping_service
+from brickvault_api.component_mapping import ComponentMappingService
+from brickvault_api.component_mapping_models import (
+    MappingDecisionReceipt,
+    MappingReview,
+    MappingStatus,
+)
+from brickvault_api.main import create_app
+from brickvault_api.market.product_refresh import ProductRefreshError
+from brickvault_api.market.retention import purge
+from brickvault_api.providers.bricklink.requests import Failure, Operation, Request
+from brickvault_api.providers.bricklink.transport import FetchResult
+
+from .auth_support import authenticated_client
+from .component_mapping_fixture import ComponentProvider, mapping_select
+from .component_mapping_fixture import mapping_catalog as synthetic  # noqa: F401
+from .test_catalog_queries import owner_engine as owner_engine
+from .test_catalog_schema import key
+from .test_catalog_schema import synthetic as base_synthetic  # noqa: F401
+from .test_component_mapping import confirmed, discover
+from .test_component_mapping import svc as svc
+from .test_market import market as market
+from .test_product import no_provider_network as no_provider_network
+from .test_product_refresh import ProductHarness
+from .test_product_refresh import product as product
+
+
+def test_component_http_access_and_signed_set_binding(
+    svc: ComponentMappingService, product: ProductHarness
+) -> None:
+    app = create_app()
+    app.dependency_overrides[mapping_service] = lambda: svc
+    path = "/api/sets/80000-1/contents-mapping"
+    selection = mapping_select("mapping-line").model_dump(mode="json")
+    with closing(
+        authenticated_client(app, product.market.owner.database, product.market.app.database)
+    ) as client:
+        with closing(TestClient(app, base_url=str(client.base_url))) as anonymous:
+            denied = anonymous.get(path)
+            assert denied.status_code == 401 and denied.headers["cache-control"] == "no-store"
+        for header in ({"Origin": "https://untrusted.invalid"}, {"X-CSRF-Token": "incorrect"}):
+            denied = client.post(path + "/plan", json=selection, headers=header)
+            assert denied.status_code == 403 and denied.headers["cache-control"] == "no-store"
+        response = client.post(path + "/plan", json=selection)
+        assert response.status_code == 200 and response.headers["cache-control"] == "no-store"
+        body = {"selection": selection, "confirmation": response.json()["confirmation"]}
+        wrong = client.post("/api/sets/80000-2/contents-mapping", json=body)
+        assert wrong.status_code == 409 and wrong.headers["cache-control"] == "no-store"
+        invalid = client.post(path + "/plan", json={**selection, "item_no": "provider-override"})
+        assert invalid.status_code == 422
+        assert client.get(path).json() is None
+        # An independently created whole-set operation has no component actions.
+        unrelated = product.app.confirm(product.plan())
+        for response in (
+            client.get(f"/api/contents-mapping/{unrelated}"),
+            client.post(f"/api/contents-mapping/{unrelated}/resume"),
+        ):
+            assert response.status_code == 409
+            assert response.json()["code"] == "OPERATION_MISSING"
+            assert response.headers["cache-control"] == "no-store"
+        assert not product.app.status(unrelated)["operation"]["execution_token"]
+        assert isinstance(svc.provider, ComponentProvider) and not svc.provider.calls
+
+
+def test_interrupted_dispatch_recovery_preserves_unrelated_figure(
+    svc: ComponentMappingService, product: ProductHarness
+) -> None:
+    operation, _ = confirmed(svc, "mapping-line", "figure-line")
+    lease = svc.acquire(operation)
+    assert lease
+    with svc.repository.database.connect() as c:
+        row = c.execute(
+            """SELECT o.identity_budget_group_id,r.logical_id,r.node->'seeds'->0->>'element' AS element
+            FROM product_refresh_operation o JOIN component_mapping_request r ON r.operation_id=o.id
+            WHERE o.id=%s AND r.node->>'operation'='element'""",
+            (operation,),
+        ).fetchone()
+    assert row
+    request = Request(
+        Operation.ELEMENT, product.market.request.account_scope, element_id=row["element"]
+    )
+    reserved = svc.repository.reserve_identity_attempt(
+        product.market.scope,
+        row["identity_budget_group_id"],
+        key("mapping-pc"),
+        request,
+        attempt_id=row["logical_id"],
+        owner=lease.owner,
+        operation_token=lease.token,
+    )
+    assert reserved and svc.repository.mark_identity_dispatched(reserved) == request
+    # Process lost after dispatch. Neither an ordinary read nor a repeat confirm can send it again.
+    assert svc.mapping_status(operation).attempts_consumed == 1
+    product.advance_clock(121)
+    discover(svc, product, operation)
+    status = svc.mapping_status(operation)
+    targets = {t.target_id: t for t in status.targets}
+    assert targets[key("mapping-pc")].state == "DISCOVERY_FAILED"
+    assert not targets[key("mapping-pc")].challenge
+    figure = targets[key("figure")]
+    assert figure.challenge and figure.item_no == "fixture-figure-b"
+    result = svc.review_target(
+        operation,
+        figure.target_id,
+        MappingReview(key=figure.challenge.key, decision="approve", challenge=figure.challenge),
+    )
+    assert isinstance(result, MappingStatus) and result.terminal and result.state == "PARTIAL"
+    used = svc.repository.run_usage(operation)
+    assert used == {"identity": 3, "price": 0, "retries": 0, "total": 3, "uncertain": 1}
+    assert isinstance(svc.provider, ComponentProvider)
+    assert [call.operation for call in svc.provider.calls] == [Operation.SUBSETS, Operation.ITEM]
+
+
+def test_retryable_element_exhausts_only_shared_retry_reserve(
+    svc: ComponentMappingService, product: ProductHarness
+) -> None:
+    class FailingElement(ComponentProvider):
+        def fetch(self, request: Request) -> FetchResult:
+            if request.operation == Operation.ELEMENT:
+                self.calls.append(request)
+                return FetchResult(request, failure=Failure.READ, retryable=True, attempts=1)
+            return super().fetch(request)
+
+    provider = FailingElement(product.market.clock)
+    svc.provider = provider
+    operation, _ = confirmed(svc, "mapping-line", "figure-line")
+    # A retry can pause until its durable due time. Each resume retains the same graph.
+    for _ in range(3):
+        discover(svc, product, operation)
+        if not svc.mapping_status(operation).resumable:
+            break
+        product.advance_clock(10)
+    used = svc.repository.run_usage(operation)
+    assert used == {"identity": 3, "price": 0, "retries": 2, "total": 5, "uncertain": 0}
+    assert sum(c.operation == Operation.ELEMENT for c in provider.calls) == 3
+    with svc.repository.database.connect() as c:
+        failed = c.execute(
+            """SELECT id,logical_request_id,retry_of FROM provider_fetch_run
+            WHERE discovery_operation='element' ORDER BY attempt_number"""
+        ).fetchall()
+    assert len({r["logical_request_id"] for r in failed}) == 1
+    assert [r["retry_of"] for r in failed] == [None, failed[0]["id"], failed[1]["id"]]
+    targets = {t.target_id: t for t in svc.mapping_status(operation).targets}
+    assert not targets[key("mapping-pc")].challenge and targets[key("figure")].challenge
+
+
+def test_rotated_signing_key_and_purged_graph_recover_original_decision(
+    svc: ComponentMappingService, product: ProductHarness
+) -> None:
+    operation, confirmation = confirmed(svc, "mapping-line")
+    discover(svc, product, operation)
+    target = svc.mapping_status(operation).targets[0]
+    assert target.challenge
+    review = MappingReview(key=target.challenge.key, decision="approve", challenge=target.challenge)
+    before = svc.review_target(operation, target.target_id, review)
+    assert isinstance(before, MappingStatus) and before.review_receipt
+    restarted = ComponentMappingService(
+        svc.product, svc.repository, svc.account, b"rotated-test-session", svc.provider
+    )
+    assert restarted.confirm_mapping("80000-1", confirmation) == (operation, False)
+    product.advance_clock(31 * 86400)
+    deleted = purge(product.market.owner, product.market.policy.id, uuid4())["deleted_counts"]
+    assert deleted["product_operations"] == 1
+    recovered = restarted.review_target(operation, target.target_id, review)
+    assert isinstance(recovered, MappingDecisionReceipt) and recovered == before.review_receipt
+    altered = review.model_copy(update={"decision": "reject"})
+    with pytest.raises(ProductRefreshError, match="IDEMPOTENCY_CONFLICT"):
+        restarted.review_target(operation, target.target_id, altered)
+    assert isinstance(svc.provider, ComponentProvider) and len(svc.provider.calls) == 4
+
+
+def test_new_reviews_require_configured_account(
+    svc: ComponentMappingService, product: ProductHarness
+) -> None:
+    operation, _ = confirmed(svc, "mapping-line")
+    discover(svc, product, operation)
+    target = svc.mapping_status(operation).targets[0]
+    assert target.challenge
+    review = MappingReview(key=target.challenge.key, decision="approve", challenge=target.challenge)
+    other = ComponentMappingService(
+        svc.product, svc.repository, uuid4(), svc.signing_key, svc.provider
+    )
+    assert other.active_mapping("80000-1") is None
+    wrong = other.mapping_status(operation)
+    assert not wrong.resumable and not wrong.targets[0].challenge
+    assert wrong.targets[0].blocker == "ACCOUNT_SCOPE_CHANGED"
+    with pytest.raises(ProductRefreshError, match="PROVIDER_UNAVAILABLE"):
+        other.review_target(operation, target.target_id, review)
+    good = svc.review_target(operation, target.target_id, review)
+    assert isinstance(good, MappingStatus) and good.review_receipt
+    recovered = other.review_target(operation, target.target_id, review)
+    assert isinstance(recovered, MappingStatus) and recovered.review_receipt == good.review_receipt
