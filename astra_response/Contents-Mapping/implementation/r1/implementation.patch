+CREATE FUNCTION component_mapping_node_evidence(p_op uuid,p_key text) RETURNS jsonb
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+ SELECT jsonb_build_object('attempt_id',a.id,'digest',e.evidence_digest,'received_at',e.received_at,'eligible_until',d.deadline,'content',e.component_content)
+ FROM component_mapping_request r JOIN product_refresh_operation o ON o.id=r.operation_id
+ JOIN provider_fetch_run a ON a.logical_request_id=COALESCE((r.node->>'owner_logical_id')::uuid,r.logical_id)
+ JOIN provider_discovery_evidence e ON e.attempt_id=a.id JOIN market_policy p ON p.id=o.market_policy_id
+ JOIN provider_scope_state scope ON scope.id=a.scope_id JOIN market_policy active ON active.id=scope.policy_id
+ CROSS JOIN LATERAL (SELECT least(e.retained_until,e.received_at+make_interval(secs=>least(86400,p.retention_seconds,p.hard_display_seconds,active.retention_seconds,active.hard_display_seconds))) deadline)d
+ WHERE r.operation_id=p_op AND r.node_key=p_key AND e.classification='COMPONENT_IDENTITY'
+ AND a.outcome='succeeded' AND a.policy_id=p.id AND a.discovery_account_scope=o.account_scope AND d.deadline>product_refresh_clock()
+ AND (r.node->>'action'<>'REUSE' OR (a.id::text=r.node->>'attempt_id' AND e.evidence_digest=r.node->>'evidence_digest'))
+$$;
