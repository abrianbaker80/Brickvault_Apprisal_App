+"""Real authenticated browser workflow with a disposable PostgreSQL catalog."""
+
+import os
+import secrets
+import socket
+import subprocess
+import threading
+import time
+from collections.abc import Callable
+from datetime import UTC, datetime
+from pathlib import Path
+
+import uvicorn
+from pydantic import SecretStr
+
+from brickvault_api.api.component_mapping import mapping_service
+from brickvault_api.api.contents import contents_service
+from brickvault_api.api.sets import product_service
+from brickvault_api.auth import AuthService
+from brickvault_api.component_mapping import ComponentMappingService
+from brickvault_api.contents import ContentsService
+from brickvault_api.main import create_app
+from brickvault_api.market.contents_refresh import ContentsRefreshRepository
+from brickvault_api.market.product_refresh_models import ExecutionLease
+from brickvault_api.product import ProductService
+from brickvault_api.providers.bricklink.requests import Operation
+from brickvault_api.settings import RuntimeSettings
+
+from .component_mapping_fixture import ComponentProvider
+from .component_mapping_fixture import mapping_catalog as synthetic  # noqa: F401 -- pytest fixture
+from .test_catalog_queries import owner_engine as owner_engine
+from .test_catalog_schema import key
+from .test_catalog_schema import synthetic as base_synthetic  # noqa: F401 -- pytest fixture
+from .test_market import market as market
+from .test_product import no_provider_network as no_provider_network
+from .test_product_refresh import ProductHarness
+from .test_product_refresh import product as product
+
+
+def test_mapping_browser(product: ProductHarness) -> None:
+    h = product.market
+    h.clock.now = datetime.now(UTC)
+    product.advance_clock()
+    h.owner.revoke_mapping(h.mapping.id)
+    catalog = ProductService(h.app.database, clock=h.clock, snapshot_id=key("snapshot"))
+    provider = ComponentProvider(h.clock)
+
+    class BrowserService(ComponentMappingService):
+        def run(self, lease: ExecutionLease, *, wait: Callable[[float], None] = time.sleep) -> None:
+            super().run(lease, wait=lambda _: product.advance_clock(5))
+            # Simulate the time Brian spends reading the binding before its separate price plan.
+            product.advance_clock(5)
+
+    service = BrowserService(catalog, product.app, h.request.account_scope, b"test-only", provider)
+    pricing = ContentsService(
+        catalog,
+        ContentsRefreshRepository(h.app.database, clock=h.clock),
+        h.request.account_scope,
+        b"test-only",
+        provider,
+    )
+    password = secrets.token_urlsafe(32)
+    AuthService(product.market.owner.database).provision(password)
+    listener = socket.socket()
+    if hasattr(socket, "SO_EXCLUSIVEADDRUSE"):
+        listener.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
+    listener.bind(("127.0.0.1", 0))
+    port = listener.getsockname()[1]
+    db = service.repository.database
+    app = create_app(
+        RuntimeSettings(
+            purpose="test",
+            port=port,
+            database_url=SecretStr(db.url),
+            database_ownership_marker=SecretStr(db.ownership_marker),
+            auth_allow_loopback_http=True,
+            static_enabled=True,
+            web_build_dir=str(Path("apps/web/dist").resolve()),
+        )
+    )
+    app.dependency_overrides[mapping_service] = lambda: service
+    app.dependency_overrides[contents_service] = lambda: pricing
+    app.dependency_overrides[product_service] = lambda: catalog
+    server = uvicorn.Server(uvicorn.Config(app, access_log=False, log_level="error"))
+    thread = threading.Thread(target=lambda: server.run(sockets=[listener]), daemon=True)
+    thread.start()
+    try:
+        deadline = time.monotonic() + 20
+        while not server.started and thread.is_alive() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert server.started
+        result = subprocess.run(
+            ["node", "apps/web/e2e/component-mapping-acceptance.mjs", f"http://127.0.0.1:{port}"],
+            env={**os.environ, "CONTENTS_TEST_PASSWORD": password},
+            capture_output=True,
+            text=True,
+            timeout=120,
+        )
+        assert result.returncode == 0, result.stdout + result.stderr
+        print(result.stdout)
+        assert len(provider.calls) == 4
+        assert all(call.operation != Operation.PRICE for call in provider.calls)
+    finally:
+        server.should_exit = True
+        thread.join(timeout=10)
+        listener.close()
+        assert not thread.is_alive()
