+CREATE FUNCTION component_mapping_candidate(p_op uuid,p_target uuid) RETURNS jsonb
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE o product_refresh_operation; t product_refresh_target; d component_mapping_review; r component_mapping_request; e jsonb; fact jsonb; expected jsonb; a provider_fetch_run;
+ facts jsonb='[]'; state text='REVIEW_READY'; provider_item_no text; c_id integer; deadline timestamptz; c_known jsonb; c_color jsonb; c_item jsonb; item_selector jsonb; color_selector jsonb; live jsonb; ret jsonb; conflicts jsonb;
+BEGIN
+ SELECT * INTO o FROM product_refresh_operation WHERE id=p_op AND scope='MAPPING';
+ SELECT * INTO t FROM product_refresh_target WHERE operation_id=p_op AND target_id=p_target;
+ IF o.id IS NULL OR t.target_id IS NULL THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ SELECT * INTO d FROM component_mapping_review WHERE operation_id=p_op AND target_id=p_target;
+ IF FOUND THEN
+   IF d.mapping_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM market_mapping_revision m WHERE m.id=d.mapping_id AND m.review_state='verified' AND m.closed_at IS NULL) THEN
+     RETURN '{"state":"REVIEW_CONFLICT","reason":"MAPPING_CHANGED"}';
+   END IF;
+   RETURN d.result;
+ END IF;
+ IF o.expires_at<=product_refresh_clock() THEN RETURN '{"state":"EVIDENCE_EXPIRED"}'; END IF;
+ BEGIN
+  PERFORM product_refresh_context(p_op);
+  SELECT value INTO live FROM jsonb_array_elements(component_mapping_targets(o.canonical_set_id,o.snapshot_id,o.plan_snapshot->'selection'))
+  WHERE value->>'target_id'=p_target::text;
+ EXCEPTION WHEN check_violation THEN RETURN '{"state":"REVIEW_CONFLICT","reason":"REPLAN_REQUIRED"}'; END;
+ IF live IS NULL OR (live-'blocker'-'mapping_id'-'item_no'-'provider_color') IS DISTINCT FROM
+  (t.payload-'blocker'-'mapping_id'-'item_no'-'provider_color') THEN RETURN '{"state":"REVIEW_CONFLICT","reason":"REPLAN_REQUIRED"}'; END IF;
+ item_selector=component_mapping_selector(p_op,'item:'||COALESCE(t.part_id,t.target_id)::text);
+ IF t.color_id IS NOT NULL THEN color_selector=component_mapping_selector(p_op,'color:'||t.color_id::text); END IF;
+ SELECT jsonb_agg(c.id ORDER BY c.id) INTO conflicts FROM (SELECT m.id FROM market_mapping_revision m WHERE m.provider='bricklink'
+   AND m.closed_at IS NULL AND m.review_state IN ('verified','conflicted')
+   AND (COALESCE(m.part_color_id,m.minifigure_id)=p_target OR (m.item_type=t.payload->>'item_type' AND m.item_no=item_selector->>'item_no'
+     AND (t.minifigure_id IS NOT NULL AND m.color_id IS NULL OR t.part_color_id IS NOT NULL AND m.color_id=(color_selector->>'color_id')::integer)))
+   AND m.id IS DISTINCT FROM (live->>'mapping_id')::uuid ORDER BY m.id LIMIT 4) c;
+ IF conflicts IS NOT NULL THEN RETURN jsonb_build_object('state','REVIEW_CONFLICT','reason','CANONICAL_OR_PROVIDER_BINDING_CONFLICT','conflicting_mapping_ids',conflicts); END IF;
+ IF live->>'mapping_id' IS NOT NULL AND t.payload->>'mapping_id' IS NULL AND
+  ((item_selector->>'item_no') IS DISTINCT FROM (live->>'item_no') OR (color_selector->>'color_id') IS DISTINCT FROM (live->>'provider_color')) THEN
+   RETURN jsonb_build_object('state','REVIEW_CONFLICT','reason','CANONICAL_OR_PROVIDER_BINDING_CONFLICT','conflicting_mapping_ids',jsonb_build_array(live->'mapping_id'));
+ END IF;
+ IF t.payload->>'blocker' IS NOT NULL THEN
+   IF live=t.payload AND live->>'blocker'='ALREADY_MAPPED' THEN RETURN jsonb_build_object('state','MAPPED','mapping_id',live->'mapping_id'); END IF;
+   RETURN jsonb_build_object('state','SOURCE_BLOCKED','reason',COALESCE(live->>'blocker','REPLAN_REQUIRED'));
+ END IF;
+ IF live->>'blocker' IS NOT NULL AND live->>'blocker'<>'ALREADY_MAPPED' THEN RETURN '{"state":"REVIEW_CONFLICT","reason":"REPLAN_REQUIRED"}'; END IF;
+ deadline=o.expires_at;
+ FOR r IN SELECT req.* FROM component_mapping_request req JOIN component_mapping_request_target b USING(operation_id,node_key)
+  WHERE b.operation_id=p_op AND b.target_id=p_target ORDER BY CASE WHEN req.node->>'operation' IN ('element','subsets') THEN 0 ELSE 1 END,req.node_key LOOP
+   e=component_mapping_node_evidence(p_op,r.node_key);
+   SELECT * INTO a FROM provider_fetch_run WHERE logical_request_id=COALESCE((r.node->>'owner_logical_id')::uuid,r.logical_id) ORDER BY attempt_number DESC LIMIT 1;
+   IF e IS NULL THEN
+     IF component_mapping_node_current(p_op,r.node_key) IS NOT TRUE THEN RETURN '{"state":"REVIEW_CONFLICT","reason":"REPLAN_REQUIRED"}'; END IF;
+     IF a.outcome='succeeded' OR r.node->>'action'='REUSE' THEN RETURN '{"state":"EVIDENCE_EXPIRED"}'; END IF;
+     IF a.outcome IN ('failed','uncertain','discarded') AND (r.node->>'action'='JOIN' OR a.retryable IS DISTINCT FROM true OR
+       (SELECT count(*) FROM provider_fetch_run WHERE budget_group=o.identity_budget_group_id AND retry_of IS NOT NULL)>=2) THEN RETURN '{"state":"DISCOVERY_FAILED"}'; END IF;
+     IF r.node->>'action'='JOIN' AND EXISTS(SELECT 1 FROM component_mapping_request owner JOIN product_refresh_operation prev ON prev.id=owner.operation_id
+       WHERE owner.logical_id=(r.node->>'owner_logical_id')::uuid AND (prev.state='CLOSED' OR prev.expires_at<=product_refresh_clock())) THEN RETURN '{"state":"DISCOVERY_FAILED","reason":"JOIN_UNAVAILABLE"}'; END IF;
+     state='DISCOVERY_PENDING';
+   END IF;
+   expected=component_mapping_selector(p_op,r.node_key);
+   IF expected IS NULL THEN
+     IF NOT EXISTS(SELECT 1 FROM jsonb_array_elements(r.node->'seeds') z WHERE component_mapping_node_evidence(p_op,CASE WHEN z ? 'element' THEN 'element:'||(z->>'element') ELSE 'subsets:'||(z->>'parent') END) IS NULL) THEN RETURN '{"state":"EVIDENCE_AMBIGUOUS"}'; END IF;
+     CONTINUE;
+   END IF;
+   IF e IS NULL THEN CONTINUE; END IF;
+   IF expected IS DISTINCT FROM jsonb_strip_nulls(jsonb_build_object('operation',a.discovery_operation,'item_type',a.discovery_item_type,'item_no',a.discovery_item_no,'color_id',a.discovery_color_id,'element_id',a.discovery_element_id)) THEN RETURN '{"state":"EVIDENCE_AMBIGUOUS"}'; END IF;
+   fact=e->'content'; facts=facts||jsonb_build_array(e||jsonb_build_object('operation',r.node->>'operation','selector',expected));
+   deadline=least(deadline,(e->>'eligible_until')::timestamptz);
+   CASE r.node->>'operation' WHEN 'item' THEN c_item=fact; item_selector=expected;
+    WHEN 'color' THEN c_color=fact; color_selector=expected;
+    WHEN 'known_colors' THEN c_known=fact->'colors'; ELSE NULL; END CASE;
+ END LOOP;
+ IF state<>'REVIEW_READY' THEN RETURN jsonb_build_object('state',state); END IF;
+ provider_item_no=item_selector->>'item_no';
+ IF provider_item_no IS NULL OR c_item->>'item_type' IS DISTINCT FROM t.payload->>'item_type' OR c_item->>'item_no' IS DISTINCT FROM provider_item_no OR COALESCE(trim(c_item->>'item_name'),'')='' THEN RETURN '{"state":"EVIDENCE_AMBIGUOUS"}'; END IF;
+ IF t.part_color_id IS NOT NULL THEN
+  c_id=(color_selector->>'color_id')::integer;
+  IF c_id IS NULL OR c_color->'color_id' IS DISTINCT FROM to_jsonb(c_id) OR COALESCE(trim(c_color->>'color_name'),'')='' OR NOT COALESCE(c_known @> jsonb_build_array(c_id),false) THEN RETURN '{"state":"EVIDENCE_AMBIGUOUS"}'; END IF;
+ END IF;
+ IF live->>'mapping_id' IS NOT NULL AND live->>'item_no'=provider_item_no
+    AND (live->>'provider_color')::integer IS NOT DISTINCT FROM c_id AND NOT EXISTS(
+    SELECT 1 FROM market_mapping_revision m WHERE m.provider='bricklink' AND m.closed_at IS NULL AND m.review_state IN ('verified','conflicted')
+    AND m.id<>(live->>'mapping_id')::uuid AND (COALESCE(m.part_color_id,m.minifigure_id)=p_target OR
+    (m.item_type=t.payload->>'item_type' AND m.item_no=provider_item_no AND m.color_id IS NOT DISTINCT FROM c_id))) THEN
+   RETURN jsonb_build_object('state','MAPPED','mapping_id',live->'mapping_id');
+ END IF;
+ ret=jsonb_build_object('state','REVIEW_READY','item_no',provider_item_no,'provider_color',c_id,'eligible_until',deadline,'evidence',facts);
+ RETURN ret||jsonb_build_object('proof_digest',product_refresh_digest(jsonb_build_object('target',t.payload,'operation',p_op,'proof',ret,'version','component-identity-v1')));
+END $$;
+-- statement-break
+CREATE FUNCTION component_mapping_review_target(p_op uuid,p_target uuid,p_key uuid,p_decision text,p_digest text,p_deadline timestamptz,p_request_digest text) RETURNS jsonb
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE existing component_mapping_review; o product_refresh_operation; t product_refresh_target; proof jsonb; result jsonb; lineage jsonb; current_time_utc timestamptz; map_id uuid;
+BEGIN
+ PERFORM pg_advisory_xact_lock(hashtextextended(p_key::text,630021));
+ SELECT * INTO existing FROM component_mapping_review WHERE receipt_key=p_key;
+ IF FOUND THEN
+   IF (p_op,p_target,p_decision,p_digest,p_deadline,p_request_digest) IS DISTINCT FROM (existing.operation_id,existing.target_id,existing.disposition,existing.proof_digest,existing.challenge_expiry,existing.lineage->>'request_digest')
+   THEN RAISE EXCEPTION 'IDEMPOTENCY_CONFLICT' USING ERRCODE='23514'; END IF;
+   RETURN existing.result;
+ END IF;
+ SELECT * INTO o FROM product_refresh_operation WHERE id=p_op AND scope='MAPPING';
+ IF o.id IS NULL THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ PERFORM 1 FROM catalog_snapshot WHERE id=o.snapshot_id FOR SHARE;
+ PERFORM 1 FROM catalog_active_snapshot WHERE snapshot_id=o.snapshot_id FOR SHARE;
+ PERFORM 1 FROM provider_scope_state WHERE id=(SELECT scope_id FROM provider_budget_group WHERE id=p_op) FOR UPDATE;
+ PERFORM pg_advisory_xact_lock(630006);
+ SELECT * INTO o FROM product_refresh_operation WHERE id=p_op FOR UPDATE;
+ SELECT * INTO t FROM product_refresh_target WHERE operation_id=p_op AND target_id=p_target;
+ IF t.target_id IS NULL OR o.state='CLOSED' OR p_key IS NULL OR p_decision IS NULL OR p_decision NOT IN ('APPROVE','REJECT') OR p_request_digest IS NULL OR p_request_digest !~ '^[0-9a-f]{64}$'
+ OR EXISTS(SELECT 1 FROM component_mapping_review WHERE operation_id=p_op AND target_id=p_target) THEN RAISE EXCEPTION 'REVIEW_CONFLICT' USING ERRCODE='23514'; END IF;
+ proof=component_mapping_candidate(p_op,p_target);
+ current_time_utc=product_refresh_clock();
+ IF proof->>'state' IS DISTINCT FROM 'REVIEW_READY' OR proof->>'proof_digest' IS DISTINCT FROM p_digest OR p_deadline IS NULL OR p_deadline<=current_time_utc
+ OR p_deadline>current_time_utc+interval '15 minutes' OR p_deadline>(proof->>'eligible_until')::timestamptz
+ THEN RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ IF p_decision='APPROVE' THEN
+   map_id=gen_random_uuid();
+   INSERT INTO market_mapping_revision(id,provider,item_type,item_no,color_id,minifigure_id,part_color_id,part_id,canonical_color_id,snapshot_id,source_version_id,evidence_id,
+    method,evidence_reference,review_state,reviewer,created_at,reviewed_at)
+   VALUES(map_id,'bricklink',t.payload->>'item_type',proof->>'item_no',(proof->>'provider_color')::int,t.minifigure_id,t.part_color_id,t.part_id,t.color_id,o.snapshot_id,o.source_version_id,(t.payload->>'evidence_id')::uuid,
+    CASE WHEN t.part_id IS NOT NULL THEN 'source_element' ELSE 'parent_figure' END,'component-review:'||p_key,'verified','Brian',current_time_utc,current_time_utc);
+ END IF;
+ result=jsonb_build_object('state',CASE WHEN map_id IS NOT NULL THEN 'MAPPED' ELSE 'REVIEW_REJECTED' END,'receipt_key',p_key,'mapping_id',map_id,'reviewed_at',current_time_utc,'target_id',p_target);
+ SELECT jsonb_build_object('sources',(SELECT jsonb_agg(jsonb_build_object('evidence_id',e.id,'row_sha256',e.row_sha256,'file_sha256',f.decompressed_sha256) ORDER BY e.id)
+  FROM catalog_evidence e JOIN catalog_source_file f ON f.id=e.source_file_id WHERE e.id IN
+    ((t.payload->>'evidence_id')::uuid,(t.payload->>'color_evidence_id')::uuid,(t.payload->>'part_evidence_id')::uuid,(t.payload->>'figure_evidence_id')::uuid,(t.payload->>'parent_evidence_id')::uuid)
+    OR e.id IN (SELECT (x->>'evidence_id')::uuid FROM jsonb_array_elements(t.payload->'occurrences')x)),
+ 'attempts',(SELECT jsonb_agg(x-'content'-'selector') FROM jsonb_array_elements(proof->'evidence')x),'snapshot_id',o.snapshot_id,'source_version_id',o.source_version_id,'parent_mapping_id',t.payload->'parent_mapping_id','rule','component-identity-v1','reviewer','Brian','request_digest',p_request_digest) INTO lineage;
+ INSERT INTO component_mapping_review(receipt_key,operation_id,target_id,disposition,proof_digest,challenge_expiry,reviewed_at,result,lineage,scope_id,market_policy_id,retained_until,mapping_id)
+ SELECT p_key,p_op,p_target,p_decision,p_digest,p_deadline,current_time_utc,result,lineage,g.scope_id,o.market_policy_id,greatest(o.retained_until,current_time_utc+make_interval(secs=>p.metadata_seconds)),map_id FROM provider_budget_group g JOIN market_policy p ON p.id=o.market_policy_id WHERE g.id=p_op;
+ PERFORM component_mapping_settle(p_op);
+ IF product_refresh_clock()>=p_deadline THEN RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ RETURN result;
+END $$;
+-- statement-break
+CREATE FUNCTION component_mapping_settle(p_op uuid) RETURNS text LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE o product_refresh_operation; pending boolean; ready boolean;
+BEGIN
+ PERFORM 1 FROM provider_scope_state WHERE id=(SELECT scope_id FROM provider_budget_group WHERE id=p_op) FOR UPDATE;
+ SELECT * INTO o FROM product_refresh_operation WHERE id=p_op AND scope='MAPPING' FOR UPDATE;
+ IF o.id IS NULL THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ IF o.state='CLOSED' THEN RETURN 'CLOSED'; END IF;
+ IF o.expires_at<=product_refresh_clock() THEN
+   UPDATE provider_fetch_run SET outcome='uncertain',finished_at=product_refresh_now(),retryable=false
+   WHERE budget_group=o.identity_budget_group_id AND outcome IN ('reserved','dispatched') AND discovery_lease_until<=product_refresh_clock();
+   UPDATE provider_scope_state scope SET lease_owner=NULL,lease_token=NULL,lease_until=NULL
+   WHERE scope.lease_until<=product_refresh_clock() AND EXISTS(SELECT 1 FROM provider_fetch_run a WHERE a.scope_id=scope.id
+    AND a.budget_group=o.identity_budget_group_id AND a.discovery_token=scope.lease_token AND a.outcome='uncertain');
+ END IF;
+ SELECT bool_or(s='DISCOVERY_PENDING'),bool_or(s='REVIEW_READY') INTO pending,ready FROM (SELECT component_mapping_candidate(p_op,target_id)->>'state' s FROM product_refresh_target WHERE operation_id=p_op) q;
+ IF NOT pending AND NOT ready THEN
+   IF EXISTS(SELECT 1 FROM provider_fetch_run WHERE budget_group=o.identity_budget_group_id AND outcome IN ('reserved','dispatched')) THEN RETURN 'WORK_PENDING'; END IF;
+   PERFORM product_refresh_close(p_op); RETURN 'CLOSED';
+ END IF;
+ RETURN CASE WHEN pending THEN 'WORK_PENDING' ELSE 'MAPPING_REVIEW' END;
+END $$;
+-- statement-break
+DO $$ DECLARE f record; BEGIN
+ FOR f IN SELECT oid::regprocedure AS signature FROM pg_proc WHERE pronamespace='public'::regnamespace AND proname LIKE 'component_mapping_%' LOOP
+  EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC',f.signature);
+ END LOOP;
+END $$;
