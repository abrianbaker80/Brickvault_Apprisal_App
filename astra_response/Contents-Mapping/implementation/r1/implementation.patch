+class ComponentProvider:
+    def __init__(self, clock: Callable[[], datetime]) -> None:
+        self.clock = clock
+        self.calls: list[Request] = []
+        self.ambiguous = False
+        self.divergent = False
+        self.element_colors = {"87234901": 17, "87234902": 42, "87234903": 42}
+
+    def fetch(self, request: Request) -> FetchResult:
+        self.calls.append(request)
+        item = {"no": "fixture-bridge-b", "type": "PART", "name": "Printed bridge variant B"}
+        figure = {"no": "fixture-figure-b", "type": "MINIFIG", "name": "Fixture figure B"}
+        payload: object
+        if request.operation == Operation.ELEMENT:
+            if self.divergent and request.element_id == "87234902":
+                item = item | {"no": "fixture-other-variant"}
+            payload = [
+                {
+                    "item": item,
+                    "element_id": request.element_id,
+                    "color_id": self.element_colors[request.element_id or ""],
+                }
+            ]
+            if self.ambiguous:
+                payload.append(
+                    {
+                        "item": item | {"no": "fixture-bridge-a"},
+                        "element_id": request.element_id,
+                        "color_id": 17,
+                    }
+                )
+        elif request.operation == Operation.ITEM:
+            payload = figure if request.item_type == "MINIFIG" else item
+        elif request.operation == Operation.COLOR:
+            payload = {
+                "color_id": request.color.id if request.color else None,
+                "color_name": "Synthetic color",
+                "color_code": "AABBCC",
+                "color_type": "Solid",
+            }
+        elif request.operation == Operation.KNOWN_COLORS:
+            payload = [{"color_id": 17, "quantity": 2}, {"color_id": 42, "quantity": 1}]
+        elif request.operation == Operation.SUBSETS:
+            payload = [
+                {
+                    "match_no": 0,
+                    "entries": [
+                        {
+                            "item": figure,
+                            "color_id": 0,
+                            "quantity": 3,
+                            "extra_quantity": 0,
+                            "is_alternate": False,
+                            "is_counterpart": False,
+                        }
+                    ],
+                }
+            ]
+        else:
+            raise AssertionError("Unexpected price dispatch during mapping")
+        return FetchResult(request, evidence=normalize(request, payload, self.clock()), attempts=1)
