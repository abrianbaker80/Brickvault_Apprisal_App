+CREATE FUNCTION component_mapping_plan(p_set uuid,p_snapshot uuid,p_scope uuid,p_account uuid,s jsonb) RETURNS jsonb
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE base jsonb; ts jsonb; nodes jsonb='[]'; n jsonb; previous record; initials integer; result jsonb;
+BEGIN
+ SELECT jsonb_build_object('canonical_set_id',p_set,'normalized_set_number',cs.identifier,'snapshot_id',p_snapshot,'source_version_id',f.source_version_id,
+   'catalog_evidence_id',f.evidence_id,'scope_id',p_scope,'account_scope',p_account,'market_policy_id',ss.policy_id,
+   'review_rule_version','component-identity-v1','adapter_version','bricklink-offline-3a-v1','normalization_version','component-identity-v1') INTO base
+ FROM catalog_set_fact f JOIN catalog_set cs ON cs.id=f.set_id JOIN catalog_snapshot sn ON sn.id=f.snapshot_id
+ JOIN catalog_source_version sv ON sv.id=sn.source_version_id JOIN provider_scope_state ss ON ss.id=p_scope AND ss.provider='bricklink'
+ WHERE f.set_id=p_set AND f.snapshot_id=p_snapshot AND sn.state='accepted' AND p_account IS NOT NULL
+ AND NOT EXISTS(SELECT 1 FROM catalog_active_snapshot ac WHERE ac.provider_id=sv.provider_id AND ac.scope=sn.scope AND ac.snapshot_id IS DISTINCT FROM p_snapshot);
+ IF base IS NULL THEN RAISE EXCEPTION 'REPLAN_REQUIRED' USING ERRCODE='23514'; END IF;
+ ts=public.component_mapping_targets(p_set,p_snapshot,s);
+ FOR n IN WITH legs AS (
+ SELECT t,op, CASE op WHEN 'element' THEN t->>'element_id' WHEN 'subsets' THEN t->>'parent_item_no'
+ WHEN 'color' THEN t->>'color_id' WHEN 'known_colors' THEN t->>'part_id' WHEN 'item' THEN COALESCE(t->>'part_id',t->>'target_id') END k
+ FROM jsonb_array_elements(ts)t CROSS JOIN LATERAL unnest(CASE WHEN t->>'item_type'='PART' THEN ARRAY['element','item','color','known_colors'] ELSE ARRAY['subsets','item'] END)op
+ WHERE t->>'blocker' IS NULL)
+ SELECT jsonb_build_object('key',op||':'||k,'operation',op,'targets',jsonb_agg(t->'target_id' ORDER BY t->>'target_id'),
+ 'seeds',jsonb_agg(jsonb_strip_nulls(jsonb_build_object('element',t->>'element_id','parent',t->>'parent_item_no','quantity',CASE WHEN t->>'item_type'='MINIFIG' THEN t->'regular_quantity' END,'target',t->>'target_id')) ORDER BY t->>'target_id'),
+ 'rule',CASE WHEN op IN ('element','subsets') THEN 'EXACT_SOURCE' WHEN count(*)>1 THEN 'UNIQUE_RESULTS_MUST_CONVERGE' ELSE 'UNIQUE_RESULT_ONLY' END)
+ FROM legs GROUP BY op,k ORDER BY CASE WHEN op IN ('element','subsets') THEN 0 ELSE 1 END,op,k LOOP
+   -- Only refer to earlier confirmed, primary requests. This makes joins acyclic.
+   SELECT req.logical_id,e.attempt_id,e.received_at,e.evidence_digest INTO previous FROM public.component_mapping_request req
+    JOIN public.product_refresh_operation o ON o.id=req.operation_id JOIN public.provider_budget_group g ON g.id=o.id
+    LEFT JOIN public.provider_discovery_evidence e ON e.attempt_id IN (SELECT a.id FROM public.provider_fetch_run a WHERE a.logical_request_id=req.logical_id AND a.outcome='succeeded')
+    WHERE req.node_key=n->>'key' AND req.node->>'action'='FETCH' AND req.node->'seeds'=n->'seeds'
+    AND o.snapshot_id=p_snapshot AND o.account_scope=p_account AND o.market_policy_id=(base->>'market_policy_id')::uuid AND g.scope_id=p_scope
+    AND ((e.attempt_id IS NOT NULL AND e.retained_until>public.product_refresh_clock() AND e.received_at+make_interval(secs=>(SELECT hard_display_seconds FROM public.market_policy WHERE id=o.market_policy_id))>public.product_refresh_clock())
+      OR (e.attempt_id IS NULL AND o.state<>'CLOSED' AND o.expires_at>public.product_refresh_clock()
+      AND NOT EXISTS(SELECT 1 FROM public.provider_fetch_run a WHERE a.logical_request_id=req.logical_id AND a.outcome IN ('discarded','failed','uncertain','succeeded'))))
+    ORDER BY e.received_at DESC NULLS LAST,o.confirmed_at,req.logical_id LIMIT 1;
+   nodes=nodes||jsonb_build_array(n||jsonb_build_object('action',CASE WHEN previous.attempt_id IS NOT NULL THEN 'REUSE' WHEN previous.logical_id IS NOT NULL THEN 'JOIN' ELSE 'FETCH' END,
+      'owner_logical_id',previous.logical_id,'attempt_id',previous.attempt_id,'received_at',previous.received_at,'evidence_digest',previous.evidence_digest));
+ END LOOP;
+ SELECT count(*) INTO initials FROM jsonb_array_elements(nodes)x WHERE x->>'action'='FETCH';
+ result=(base-'selectors'-'views'-'mapping_id'-'mapping_state')||jsonb_build_object('semantic_version','component-mapping-plan-v1','product_policy_version','product-component-mapping-v1',
+ 'selection',s,'targets',ts,'nodes',nodes,'views','[]'::jsonb,'authorized_price_initials',0,'authorized_identity_initials',initials,'maximum_attempts',initials+CASE WHEN initials=0 THEN 0 ELSE 2 END,
+ 'ceilings','{"identity": 6,"price": 0,"retries": 2,"total": 8}'::jsonb);
+ IF octet_length(result::text)>16384 THEN RAISE EXCEPTION 'PLAN_SIZE_LIMIT' USING ERRCODE='23514'; END IF;
+ RETURN result;
+END $$;
