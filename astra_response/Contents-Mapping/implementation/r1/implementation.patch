index 0000000000000000000000000000000000000000..29bffeef9535d3605093301d5bbf90119b501dd0
--- /dev/null
+++ b/services/api/src/brickvault_api/api/component_mapping.py
@@ -0,0 +1,132 @@
+"""Private selected component identity planning, discovery and binding review."""
+
+from typing import Annotated
+from uuid import UUID
+
+from fastapi import APIRouter, BackgroundTasks, Depends, Request, Response
+from starlette.responses import JSONResponse
+
+from ..catalog.query_types import CatalogError
+from ..component_mapping import ComponentMappingService
+from ..component_mapping_models import (
+    MappingConfirmation,
+    MappingDecisionReceipt,
+    MappingPlan,
+    MappingReview,
+    MappingSelection,
+    MappingStatus,
+)
+from ..market.product_refresh import ProductRefreshError, ProductRefreshRepository
+from ..refresh_models import RefreshProblem
+from .refresh import ExplicitProvider, problem
+from .sets import product_service
+
+
+def mapping_service(request: Request) -> ComponentMappingService:
+    product = product_service(request)
+    settings = request.app.state.settings
+    return ComponentMappingService(
+        product,
+        ProductRefreshRepository(product.database),
+        settings.market_account_scope if settings.market_credentials_root else None,
+        request.app.state.refresh_signing_key,
+        ExplicitProvider(settings.market_credentials_root),
+    )
+
+
+def no_store(response: Response) -> None:
+    response.headers["Cache-Control"] = "no-store"
+
+
+Service = Annotated[ComponentMappingService, Depends(mapping_service)]
+router = APIRouter(
+    prefix="/api",
+    dependencies=[Depends(no_store)],
+    responses={409: {"model": RefreshProblem}, 503: {"model": RefreshProblem}},
+)
+
+
+@router.post(
+    "/sets/{set_number}/contents-mapping/plan",
+    operation_id="plan_contents_mapping",
+    response_model=MappingPlan,
+)
+def plan(set_number: str, body: MappingSelection, service: Service) -> MappingPlan | JSONResponse:
+    try:
+        return service.prepare_mapping(set_number, body)
+    except (ProductRefreshError, CatalogError) as exc:
+        return problem(exc)
+
+
+@router.post(
+    "/sets/{set_number}/contents-mapping",
+    operation_id="confirm_contents_mapping",
+    response_model=MappingStatus,
+)
+def confirm(
+    set_number: str, body: MappingConfirmation, service: Service, tasks: BackgroundTasks
+) -> MappingStatus | JSONResponse:
+    try:
+        operation, created = service.confirm_mapping(set_number, body)
+        if created:
+            lease = service.acquire(operation)
+            if lease:
+                tasks.add_task(service.run, lease)
+        return service.mapping_status(operation)
+    except (ProductRefreshError, CatalogError) as exc:
+        return problem(exc)
+
+
+@router.get(
+    "/sets/{set_number}/contents-mapping",
+    operation_id="active_contents_mapping",
+    response_model=MappingStatus | None,
+)
+def active(set_number: str, service: Service) -> MappingStatus | None | JSONResponse:
+    try:
+        return service.active_mapping(set_number)
+    except (ProductRefreshError, CatalogError) as exc:
+        return problem(exc)
+
+
+@router.get(
+    "/contents-mapping/{operation_id}",
+    operation_id="contents_mapping_status",
+    response_model=MappingStatus,
+)
+def status(operation_id: UUID, service: Service) -> MappingStatus | JSONResponse:
+    try:
+        return service.mapping_status(operation_id)
+    except ProductRefreshError as exc:
+        return problem(exc)
+
+
+@router.post(
+    "/contents-mapping/{operation_id}/resume",
+    operation_id="resume_contents_mapping",
+    response_model=MappingStatus,
+)
+def resume(
+    operation_id: UUID, service: Service, tasks: BackgroundTasks
+) -> MappingStatus | JSONResponse:
+    try:
+        lease = service.acquire(operation_id)
+        if lease:
+            tasks.add_task(service.run, lease)
+        return service.mapping_status(operation_id)
+    except ProductRefreshError as exc:
+        return problem(exc)
+
+
+@router.post(
+    "/contents-mapping/{operation_id}/targets/{target_id}/review",
+    operation_id="review_contents_mapping_target",
+    response_model=MappingStatus | MappingDecisionReceipt,
+)
+def review(
+    operation_id: UUID, target_id: UUID, body: MappingReview, service: Service
+) -> MappingStatus | MappingDecisionReceipt | JSONResponse:
+    try:
+        return service.review_target(operation_id, target_id, body)
+    except ProductRefreshError as exc:
+        return problem(exc)
