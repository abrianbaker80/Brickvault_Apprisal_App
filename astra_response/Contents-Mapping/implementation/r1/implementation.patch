+  INSERT INTO public.component_mapping_request_target(operation_id,node_key,target_id)
+  SELECT r,v->>'key',target::uuid FROM jsonb_array_elements_text(v->'targets') target;
+ END LOOP;
+ RETURN r;
+END $$;
