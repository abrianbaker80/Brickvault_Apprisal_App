+CREATE FUNCTION component_mapping_next(p_op uuid) RETURNS jsonb
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE o product_refresh_operation; r component_mapping_request; s jsonb; a provider_fetch_run; n timestamptz=product_refresh_clock();
+BEGIN
+ SELECT * INTO o FROM product_refresh_operation WHERE id=p_op AND scope='MAPPING';
+ IF o.id IS NULL THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ IF o.state='CLOSED' OR o.expires_at<=n THEN RETURN '{"state":"CLOSED"}'; END IF;
+ PERFORM product_refresh_context(p_op);
+ FOR r IN SELECT * FROM component_mapping_request WHERE operation_id=p_op AND node->>'action'='FETCH'
+ ORDER BY CASE WHEN node->>'operation' IN ('element','subsets') THEN 0 ELSE 1 END,node_key LOOP
+   IF component_mapping_node_current(p_op,r.node_key) IS NOT TRUE THEN CONTINUE; END IF;
+   s=component_mapping_selector(p_op,r.node_key);
+   IF s IS NULL THEN CONTINUE; END IF;
+   SELECT * INTO a FROM provider_fetch_run WHERE logical_request_id=r.logical_id ORDER BY attempt_number DESC LIMIT 1;
+   IF a.id IS NULL OR (a.outcome='failed' AND a.retryable AND a.retry_at<=n AND (SELECT count(*) FROM provider_fetch_run WHERE budget_group=o.identity_budget_group_id AND retry_of IS NOT NULL)<2) THEN
+     RETURN jsonb_build_object('logical_id',r.logical_id,'target_id',r.node->'targets'->>0,'selector',s,'retry_of',a.id);
+   END IF;
+ END LOOP;
+ RETURN '{"state":"MAPPING_REVIEW"}';
+END $$;
