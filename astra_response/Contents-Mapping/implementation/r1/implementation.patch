diff --git a/apps/web/e2e/component-mapping-acceptance.mjs b/apps/web/e2e/component-mapping-acceptance.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..40a4daca71ca186336fa786c0b3159b2d073cb2e
--- /dev/null
+++ b/apps/web/e2e/component-mapping-acceptance.mjs
@@ -0,0 +1,96 @@
+import { chromium, expect } from '@playwright/test';
+import { mkdir } from 'node:fs/promises';
+
+const base = process.argv[2];
+if (!/^http:\/\/127\.0\.0\.1:\d+$/.test(base ?? '')) throw new Error('Owned TEST URL required');
+const browser = await chromium.launch({ headless: true });
+try {
+  const context = await browser.newContext({ viewport: { width: 1440, height: 1050 } });
+  await context.route('**/*', (route) =>
+    new URL(route.request().url()).origin === base ? route.continue() : route.abort(),
+  );
+  expect((await context.request.get(`${base}/api/sets/80000-1/contents-mapping`)).status()).toBe(
+    401,
+  );
+  const login = await context.request.post(`${base}/api/auth/login`, {
+    data: { password: process.env.CONTENTS_TEST_PASSWORD },
+    headers: { Origin: base, 'X-BrickVault-Login': '1' },
+  });
+  expect(login.status()).toBe(200);
+  const existing = await context.request.get(`${base}/api/sets/80000-1/contents-mapping`);
+  expect(existing.headers()['cache-control']).toContain('no-store');
+  expect(await existing.json()).toBeNull();
+  const page = await context.newPage();
+  const errors = [];
+  const posts = [];
+  page.on('pageerror', (e) => errors.push(e.message));
+  page.on('request', (req) => {
+    if (req.method() === 'POST') posts.push(new URL(req.url()).pathname);
+  });
+  await page.goto(`${base}/sets/80000-1?section=contents`);
+  const panel = page.getByRole('region', { name: 'Selected contents pricing' });
+  const mapping = page.getByRole('region', { name: 'Component identity review' });
+  const items = panel.locator('.contents-items > li');
+  const part = items
+    .filter({ hasText: 'synthetic:synthetic-part-print' })
+    .filter({ hasText: 'synthetic:4' })
+    .filter({ has: page.locator('input:not(:disabled)') })
+    .first();
+  await part.getByRole('checkbox').check();
+  await items.filter({ hasText: 'synthetic:synthetic-figure-a' }).getByRole('checkbox').check();
+  await mapping.getByRole('button', { name: 'Review identity plan' }).click();
+  await expect(
+    mapping.getByText(/4 initial identity requests · 2 retry reserve · 6 maximum attempts/),
+  ).toBeVisible();
+  await expect(
+    mapping.getByText(/parent set needs an exact reviewed BrickLink mapping/),
+  ).toBeVisible();
+  expect(posts.filter((url) => url.endsWith('/contents-mapping'))).toHaveLength(0);
+  await mkdir('.local/contents113', { recursive: true });
+  await mapping.evaluate((el) => el.scrollIntoView({ block: 'start' }));
+  await page.screenshot({ path: '.local/contents113/browser-desktop.png' });
+  await mapping.getByRole('button', { name: 'Confirm identity discovery' }).click();
+  await expect(mapping.getByRole('button', { name: 'Approve supported binding' })).toBeVisible({
+    timeout: 20000,
+  });
+  await expect(
+    mapping.getByText('BrickLink PART fixture-bridge-b · BrickLink color 17'),
+  ).toBeVisible();
+  await expect(mapping.getByText(/4\/6 attempts/)).toBeVisible();
+  await expect(mapping.getByText('4 dispatched · 0 skipped · 0 remaining')).toBeVisible();
+  await expect(
+    mapping.getByRole('list', { name: 'Identity requests' }).getByText(/1 attempt$/),
+  ).toHaveCount(4);
+
+  // Recover the same collected evidence in the signed-in narrow interface.
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.reload();
+  await expect(mapping.getByText(/4\/6 attempts/)).toBeVisible();
+  await expect(mapping.getByText(/Evidence recorded/)).toBeVisible();
+  await mapping
+    .getByRole('button', { name: 'Approve supported binding' })
+    .evaluate((el) => el.scrollIntoView({ block: 'center' }));
+  await page.screenshot({ path: '.local/contents113/browser-narrow-review.png' });
+  await mapping.getByRole('button', { name: 'Approve supported binding' }).click();
+  await expect(part.getByText(/BrickLink PART fixture-bridge-b color 17/)).toBeVisible();
+  expect(posts.filter((url) => url.includes('contents-market-refresh'))).toHaveLength(0);
+  for (const name of ['New / Sold', 'New / Active', 'Used / Active'])
+    await panel.getByRole('checkbox', { name, exact: true }).uncheck();
+  await mapping.getByRole('button', { name: 'Prepare price plan' }).click();
+  await expect(panel.getByText(/0 identity · 1 new price requests/)).toBeVisible();
+  await expect(panel.getByRole('button', { name: 'Confirm selected refresh' })).toBeEnabled();
+  expect(posts.filter((url) => url.endsWith('/contents-market-refresh'))).toHaveLength(0);
+  expect(posts.filter((url) => url.endsWith('/contents-mapping'))).toHaveLength(1);
+  expect(posts.filter((url) => url.endsWith('/review'))).toHaveLength(1);
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
+  expect(errors).toEqual([]);
+  await panel
+    .getByRole('heading', { name: 'Selected refresh plan', exact: true })
+    .evaluate((el) => el.scrollIntoView({ block: 'start' }));
+  await page.screenshot({ path: '.local/contents113/browser-narrow-price.png' });
+  console.log(
+    'PASS desktop discovery, blocked figure, narrow reload, individual approval, price-plan handoff.',
+  );
+} finally {
+  await browser.close();
+}
diff --git a/apps/web/src/ContentsMapping.tsx b/apps/web/src/ContentsMapping.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..27f679e4d05c0a048337ba923110d9ab5cdacd84
--- /dev/null
+++ b/apps/web/src/ContentsMapping.tsx
@@ -0,0 +1,316 @@
+import { useState } from 'react';
+import {
+  activeMapping,
+  confirmMapping,
+  mappingStatus,
+  planMapping,
+  resumeMapping,
+  reviewMapping,
+} from './mapping-api';
+import type {
+  MappingPlan,
+  MappingRequest,
+  MappingRequestStatus,
+  MappingReview,
+  MappingSelection,
+  MappingStatus,
+  MappingTarget,
+} from './mapping-api';
+import { useRefreshWorkflow } from './useRefreshWorkflow';
+
+const labels: Record<string, string> = {
+  AUTHORITATIVE_FIGURE_ASSOCIATION_MISSING:
+    'This inventory does not uniquely identify the whole BrickLink figure.',
+  EXACT_PARENT_MAPPING_REQUIRED: 'The parent set needs an exact reviewed BrickLink mapping.',
+  EXACT_ELEMENT_REQUIRED: 'The source lacks an exact element association for this part and color.',
+  EXACT_COLOR_REQUIRED: 'The catalog color is unresolved.',
+  MAPPING_CONFLICT: 'An existing binding conflicts with this candidate.',
+  REVIEW_CONFLICT: 'This target was already decided or changed. Recheck identity progress.',
+  IDENTITY_LIMIT: 'This selection exceeds six initial identity requests. Select fewer targets.',
+  EVIDENCE_EXPIRED: 'Evidence expired. Prepare a new identity plan.',
+  REPLAN_REQUIRED: 'The inventory, evidence or mapping changed. Prepare a new identity plan.',
+  BUDGET_EXHAUSTED: 'The available provider allowance cannot cover this plan.',
+  REVIEW_READY: 'Ready for individual review',
+  PROVIDER_UNAVAILABLE: 'Identity discovery is unavailable.',
+  DISCOVERY_READY: 'Eligible for identity discovery',
+  ALREADY_MAPPED: 'Binding already verified',
+  UNSUPPORTED_OCCURRENCE: 'Identity discovery unavailable for this occurrence',
+};
+export const describeMapping = (code: string) =>
+  labels[code] || code.replaceAll('_', ' ').toLowerCase();
+const describe = describeMapping;
+const api = { active: activeMapping, status: mappingStatus, message: describe };
+const selectionKey = (selection: MappingSelection | null) =>
+  selection &&
+  JSON.stringify([
+    selection.revision_id,
+    selection.include_extras,
+    [...selection.occurrences].sort(),
+  ]);
+
+function Target({ target, now }: { target: MappingTarget; now: number }) {
+  const expired = !!target.eligible_until && now >= Date.parse(target.eligible_until);
+  return (
+    <>
+      <strong>{target.identity}</strong>
+      {target.canonical_color ? ` · ${target.canonical_color}` : ''}
+      <p>{describe(target.blocker || target.state)}</p>
+      {!!target.conflicting_mapping_ids?.length && (
+        <p>Conflicting mapping revisions · {target.conflicting_mapping_ids.join(', ')}</p>
+      )}
+      {target.challenge && now >= Date.parse(target.challenge.expires_at) && (
+        <p>Review confirmation expired. Recheck identity progress for a current decision.</p>
+      )}
+      {target.source && <p>{target.source}</p>}
+      {expired ? (
+        <p>{describe('EVIDENCE_EXPIRED')}</p>
+      ) : (
+        <>
+          {target.item_no && (
+            <p>
+              BrickLink {target.kind} {target.item_no}
+              {target.provider_color != null && ` · BrickLink color ${target.provider_color}`}
+            </p>
+          )}
+          {!!target.facts?.length && (
+            <ul>
+              {target.facts.map((fact, i) => (
+                <li key={i}>{fact}</li>
+              ))}
+            </ul>
+          )}
+          {!!target.evidence_dates?.length && (
+            <p>
+              Evidence recorded{' '}
+              {Array.from(new Set(target.evidence_dates))
+                .map((date) => new Date(date).toLocaleString())
+                .join(', ')}
+            </p>
+          )}
+        </>
+      )}
+    </>
+  );
+}
+
+function Requests({
+  requests,
+  targets,
+  now,
+}: {
+  requests: (MappingRequest | MappingRequestStatus)[];
+  targets: MappingTarget[];
+  now: number;
+}) {
+  return (
+    <ol aria-label="Identity requests">
+      {requests.map((req, i) => {
+        const expired =
+          'eligible_until' in req && !!req.eligible_until && now >= Date.parse(req.eligible_until);
+        return (
+          <li key={i}>
+            {req.action} {req.operation.toUpperCase()} ·{' '}
+            {expired ? 'evidence expired' : req.selector}
+            <div>
+              For{' '}
+              {req.targets
+                .map((id) => targets.find((t) => t.target_id === id)?.identity ?? id)
+                .join(', ')}
+            </div>
+            {'state' in req && (
+              <div>
+                {describe(req.state)} · {req.attempts} {req.attempts === 1 ? 'attempt' : 'attempts'}
+              </div>
+            )}
+            {!expired &&
+              req.evidence_at &&
+              `Evidence from ${new Date(req.evidence_at).toLocaleString()}`}
+          </li>
+        );
+      })}
+    </ol>
+  );
+}
+
+export function ContentsMapping({
+  number,
+  selection,
+  now,
+  onMapped,
+  onPricePlan,
+  canPrice,
+}: {
+  number: string;
+  selection: MappingSelection | null;
+  now: number;
+  onMapped: () => void;
+  onPricePlan: (operation: MappingStatus, target: MappingTarget) => Promise<void>;
+  canPrice: boolean;
+}) {
+  const flow = useRefreshWorkflow<MappingPlan, MappingStatus>(number, () => {}, api);
+  const [retainedDecision, setRetainedDecision] = useState('');
+  const { operation, setOperation, setPlan, mounted, act, busy } = flow;
+  const plan =
+    selectionKey(flow.plan?.selection ?? null) === selectionKey(selection) ? flow.plan : null;
+  async function decide(target: MappingTarget, decision: MappingReview['decision']) {
+    if (!operation || !target.challenge) return;
+    const body: MappingReview = {
+      key: target.challenge.key,
+      challenge: target.challenge,
+      decision,
+    };
+    const updated = await reviewMapping(operation.operation_id, target.target_id, body);
+    if (mounted.current) {
+      if ('operation_id' in updated) {
+        setOperation(updated);
+        if (updated.review_receipt?.mapping_id) onMapped();
+      } else {
+        setOperation(null);
+        setRetainedDecision(
+          `${target.identity} · ${describe(updated.state)} · saved review recovered`,
+        );
+        if (updated.mapping_id) onMapped();
+      }
+    }
+  }
+  return (
+    <section className="contents-mapping" aria-label="Component identity review">
+      <h4>Component identity</h4>
+      <button
+        type="button"
+        ref={flow.planTrigger}
+        disabled={busy || !selection || !!operation?.running}
+        onClick={() =>
+          void act(async () => {
+            if (!selection) return;
+            const value = await planMapping(number, selection);
+            if (mounted.current) setPlan(value);
+          })
+        }
+      >
+        Review identity plan
+      </button>
+      <button
+        type="button"
+        disabled={busy}
+        onClick={() =>
+          void act(async () => {
+            const value = operation
+              ? await mappingStatus(operation.operation_id)
+              : await activeMapping(number);
+            if (mounted.current) {
+              setOperation(value);
+              flow.setProgressUnknown(false);
+            }
+          })
+        }
+      >
+        Recheck identity progress
+      </button>
+      {flow.error && <p role="alert">{flow.error}</p>}
+      {retainedDecision && <p role="status">{retainedDecision}</p>}
+      {plan && (
+        <div className="contents-plan">
+          <h5 ref={flow.planHeading} tabIndex={-1}>
+            Identity discovery plan
+          </h5>
+          <p>
+            {plan.identity_initials} initial identity requests · {plan.retry_reserve} retry reserve
+            · {plan.maximum_attempts} maximum attempts · zero prices
+          </p>
+          <p>Provider account cost and remaining allowance are unknown.</p>
+          <p>
+            {describe(plan.state)} · expires {new Date(plan.expires_at).toLocaleTimeString()}
+          </p>
+          <ul>
+            {plan.targets.map((t) => (
+              <li key={t.target_id}>
+                <Target target={t} now={now} />
+              </li>
+            ))}
+          </ul>
+          <Requests requests={plan.requests} targets={plan.targets} now={now} />
+          <button
+            type="button"
+            disabled={!plan.admissible || busy || now >= Date.parse(plan.expires_at)}
+            onClick={() =>
+              void act(async () => {
+                const value = await confirmMapping(number, plan);
+                if (mounted.current) {
+                  setOperation(value);
+                  setPlan(null);
+                }
+              })
+            }
+          >
+            Confirm identity discovery
+          </button>
+          <button type="button" onClick={() => setPlan(null)}>
+            Cancel identity plan
+          </button>
+        </div>
+      )}
+      {operation && (
+        <div className="contents-plan">
+          <h5>Identity progress</h5>
+          <p role="status">
+            {describe(operation.state)} · {operation.attempts_consumed}/{operation.maximum_attempts}{' '}
+            attempts
+          </p>
+          <p>
+            {operation.dispatched} dispatched · {operation.skipped} skipped · {operation.remaining}{' '}
+            remaining
+          </p>
+          {flow.progressUnknown && (
+            <p>Progress unknown. Recheck identity progress before resuming.</p>
+          )}
+          <Requests requests={operation.requests ?? []} targets={operation.targets} now={now} />
+          {operation.resumable && !flow.progressUnknown && (
+            <button
+              disabled={busy}
+              type="button"
+              onClick={() =>
+                void act(async () => {
+                  const value = await resumeMapping(operation.operation_id);
+                  if (mounted.current) setOperation(value);
+                })
+              }
+            >
+              Resume identity discovery
+            </button>
+          )}
+          <ul>
+            {operation.targets.map((t) => (
+              <li key={t.target_id}>
+                <Target target={t} now={now} />
+                {t.challenge &&
+                  t.eligible_until &&
+                  now <
+                    Math.min(Date.parse(t.eligible_until), Date.parse(t.challenge.expires_at)) &&
+                  (['approve', 'reject'] as const).map((decision) => (
+                    <button
+                      key={decision}
+                      type="button"
+                      disabled={busy}
+                      onClick={() => void act(() => decide(t, decision))}
+                    >
+                      {decision === 'approve' ? 'Approve supported binding' : 'Reject binding'}
+                    </button>
+                  ))}
+                {t.state === 'MAPPED' && t.mapping_id && (
+                  <button
+                    type="button"
+                    disabled={busy || !canPrice}
+                    onClick={() => void act(() => onPricePlan(operation, t))}
+                  >
+                    Prepare price plan
+                  </button>
+                )}
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+    </section>
+  );
+}
