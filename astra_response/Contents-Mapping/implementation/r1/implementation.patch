+ IF o.id IS NULL OR r.parent_id IS NOT NULL OR r.operation_type<>(CASE o.scope WHEN 'MAPPING' THEN 'PRODUCT_CONTENTS_MAPPING' WHEN 'CONTENTS' THEN 'PRODUCT_CONTENTS_REFRESH' ELSE 'PRODUCT_SET_REFRESH' END)
