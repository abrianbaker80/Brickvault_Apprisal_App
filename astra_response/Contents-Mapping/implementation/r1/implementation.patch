+                source_identifier="76",
+                source_name="Fixture pearlescent",
+                display_name="Fixture pearlescent",
+            )
+        ),
+    )
+    for label, part, element in (
+        ("alternate-color", "print", "87234902"),
+        ("other-part", "part", "87234903"),
+    ):
+        binding = dict(part_id=key(part), color_id=key("mapping-color"), part_color_id=key(label))
+        catalog.insert(
+            "part_color_identity",
