+  IF NEW.operation_type NOT IN ('PRODUCT_SET_REFRESH','PRODUCT_CONTENTS_REFRESH') THEN RETURN NULL; END IF;
+  p_id=COALESCE(NEW.parent_id,NEW.id);
+ ELSIF TG_TABLE_NAME IN ('product_refresh_view','product_refresh_target') THEN
+  p_id=COALESCE(NEW.operation_id,OLD.operation_id);
