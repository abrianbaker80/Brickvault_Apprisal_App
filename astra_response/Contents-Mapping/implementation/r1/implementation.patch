diff --git a/apps/web/src/mapping-api.ts b/apps/web/src/mapping-api.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9cc512171d76bc1e095e74cffc3ee4fb547cab7f
--- /dev/null
+++ b/apps/web/src/mapping-api.ts
@@ -0,0 +1,63 @@
+import createClient from 'openapi-fetch';
+import type { components, paths } from '@brickvault/contracts';
+import { sessionFetch } from './session-client';
+import { contentsOptions, contentsResult } from './contents-api';
+
+export type MappingSelection = components['schemas']['MappingSelection'];
+export type MappingPlan = components['schemas']['MappingPlan'];
+export type MappingStatus = components['schemas']['MappingStatus'];
+export type MappingReview = components['schemas']['MappingReview'];
+export type MappingRequest = components['schemas']['MappingRequest'];
+export type MappingRequestStatus = components['schemas']['MappingRequestStatus'];
+export type MappingTarget = components['schemas']['MappingTarget'];
+
+const client = createClient<paths>({ fetch: sessionFetch });
+
+export async function planMapping(set_number: string, body: MappingSelection) {
+  const { data, error } = await client.POST('/api/sets/{set_number}/contents-mapping/plan', {
+    params: { path: { set_number } },
+    body,
+    ...contentsOptions(),
+  });
+  return contentsResult(data, error);
+}
+export async function confirmMapping(set_number: string, plan: MappingPlan) {
+  const { data, error } = await client.POST('/api/sets/{set_number}/contents-mapping', {
+    params: { path: { set_number } },
+    body: { selection: plan.selection, confirmation: plan.confirmation },
+    ...contentsOptions(),
+  });
+  return contentsResult(data, error);
+}
+export async function activeMapping(set_number: string, signal?: AbortSignal) {
+  const { data, error } = await client.GET('/api/sets/{set_number}/contents-mapping', {
+    params: { path: { set_number } },
+    ...contentsOptions(signal),
+  });
+  return contentsResult(data, error);
+}
+export async function mappingStatus(operation_id: string, signal?: AbortSignal) {
+  const { data, error } = await client.GET('/api/contents-mapping/{operation_id}', {
+    params: { path: { operation_id } },
+    ...contentsOptions(signal),
+  });
+  return contentsResult(data, error);
+}
+export async function resumeMapping(operation_id: string) {
+  const { data, error } = await client.POST('/api/contents-mapping/{operation_id}/resume', {
+    params: { path: { operation_id } },
+    ...contentsOptions(),
+  });
+  return contentsResult(data, error);
+}
+export async function reviewMapping(operation_id: string, target_id: string, body: MappingReview) {
+  const { data, error } = await client.POST(
+    '/api/contents-mapping/{operation_id}/targets/{target_id}/review',
+    {
+      params: { path: { operation_id, target_id } },
+      body,
+      ...contentsOptions(),
+    },
+  );
+  return contentsResult(data, error);
+}
