+CREATE OR REPLACE FUNCTION product_refresh_review(p_id uuid) RETURNS text LANGUAGE plpgsql SECURITY DEFINER
+ SET search_path=pg_catalog,public,pg_temp AS $$
+DECLARE o public.product_refresh_operation; e public.provider_discovery_evidence; f public.catalog_set_fact;
+ reason text; mapping uuid=gen_random_uuid(); n timestamptz; p public.market_policy;
+BEGIN
+ PERFORM 1 FROM public.provider_scope_state WHERE id=(SELECT scope_id FROM public.provider_budget_group WHERE id=p_id) FOR UPDATE;
+ o=public.product_refresh_owned(p_id);
+ IF o.scope<>'COMPLETE_SET' THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ n=public.product_refresh_clock();
+ PERFORM public.product_refresh_context(p_id);
+ IF o.resolved_mapping_id IS NOT NULL THEN RETURN 'VERIFIED'; END IF;
+ SELECT * INTO f FROM public.catalog_set_fact WHERE snapshot_id=o.snapshot_id AND set_id=o.canonical_set_id;
+ SELECT p1.* INTO p FROM public.market_policy p1 JOIN public.provider_scope_state s ON s.policy_id=p1.id
+   JOIN public.provider_budget_group g ON g.scope_id=s.id WHERE g.id=p_id;
+ SELECT * INTO e FROM public.provider_discovery_evidence WHERE operation_id=p_id ORDER BY received_at,attempt_id LIMIT 1 FOR UPDATE;
+ IF e.attempt_id IS NULL THEN
+  IF EXISTS(SELECT 1 FROM public.provider_fetch_run WHERE budget_group=o.identity_budget_group_id AND outcome='succeeded') THEN
+   RETURN 'EVIDENCE_EXPIRED';
+  END IF;
+  RETURN 'INSUFFICIENT_EVIDENCE';
+ END IF;
+ IF e.review_state<>'PENDING' THEN RETURN e.review_reason; END IF;
+ IF LEAST(e.retained_until,e.received_at+make_interval(secs=>LEAST(86400,p.retention_seconds)))<=n THEN
+  reason='EVIDENCE_EXPIRED';
+ ELSIF (SELECT count(*) FROM public.provider_discovery_evidence WHERE operation_id=p_id)<>1
+   OR EXISTS(SELECT 1 FROM public.provider_fetch_run a WHERE a.budget_group=o.identity_budget_group_id
+      AND NOT EXISTS(SELECT 1 FROM public.provider_fetch_run child WHERE child.retry_of=a.id)
+      AND a.outcome<>'succeeded') THEN reason='AMBIGUOUS_EVIDENCE';
+ ELSIF e.item_name IS NULL OR length(public.product_refresh_name(e.item_name))<3
+   OR e.item_name !~ '[A-Za-z]' OR public.product_refresh_name(e.item_name)<>public.product_refresh_name(f.display_name)
+   OR e.item_no<>o.normalized_set_number OR jsonb_array_length(o.plan_snapshot->'selectors')<>1
+   OR NOT EXISTS(SELECT 1 FROM public.provider_fetch_run a WHERE a.id=e.attempt_id
+     AND a.discovery_target_id=o.canonical_set_id AND a.discovery_item_type='SET'
+     AND a.discovery_item_no=e.item_no AND a.discovery_operation='item' AND a.outcome='succeeded') THEN
+  reason='INSUFFICIENT_EVIDENCE';
+ ELSE
+  PERFORM pg_advisory_xact_lock(630006);
+  n=public.product_refresh_clock();
+  IF LEAST(e.retained_until,e.received_at+make_interval(secs=>LEAST(86400,p.retention_seconds)))<=n THEN
+   reason='EVIDENCE_EXPIRED';
+  ELSIF EXISTS(SELECT 1 FROM public.market_mapping_revision m WHERE m.provider='bricklink' AND m.closed_at IS NULL
+    AND (m.set_id=o.canonical_set_id OR (m.item_type='SET' AND m.item_no=e.item_no))) THEN
+   reason='MAPPING_CONFLICT';
+  ELSE reason='EXACT_MATCH'; END IF;
+ END IF;
+ UPDATE public.provider_discovery_evidence SET
+  review_state=CASE reason WHEN 'EXACT_MATCH' THEN 'VERIFIED' WHEN 'EVIDENCE_EXPIRED' THEN 'EXPIRED' ELSE 'UNRESOLVED' END,
+  reviewed_at=n,review_rule_version='whole-set-exact-name-v1',review_reason=reason WHERE attempt_id=e.attempt_id;
+ IF reason='EXACT_MATCH' THEN
+  INSERT INTO public.market_mapping_revision(id,provider,item_type,item_no,set_id,snapshot_id,source_version_id,
+   evidence_id,method,evidence_reference,review_state,reviewer,created_at,reviewed_at,discovery_evidence_id)
+   VALUES(mapping,'bricklink','SET',e.item_no,o.canonical_set_id,o.snapshot_id,o.source_version_id,o.catalog_evidence_id,
+    'exact_item','discovery:'||e.attempt_id::text,'verified','whole-set-exact-name-v1',n,n,e.attempt_id);
+  UPDATE public.product_refresh_operation SET resolved_mapping_id=mapping WHERE id=p_id;
+  RETURN 'VERIFIED';
+ END IF;
+ RETURN reason;
+END $$;
