+   OR a.discovery_item_type<>'SET' OR a.budget_group<>o.identity_budget_group_id
+   OR a.discovery_target_id<>o.canonical_set_id OR a.discovery_account_scope<>o.account_scope
+   OR a.discovery_item_no<>NEW.item_no OR a.outcome<>'dispatched'
+   OR NEW.received_at<a.started_at OR NEW.completed_at<>public.product_refresh_now()
+   OR NEW.received_at>NEW.completed_at OR NEW.completed_at>=a.discovery_lease_until
+   OR public.product_refresh_clock()>=a.discovery_lease_until
+   OR NEW.retained_until>LEAST(o.expires_at,NEW.received_at+make_interval(secs=>LEAST(86400,p.retention_seconds)))
+   OR NEW.review_state<>'PENDING'
+   OR NEW.evidence_digest<>public.product_refresh_digest(jsonb_build_object(
+     'item_type',NEW.item_type,'item_no',NEW.item_no,'item_name',NEW.item_name,
+     'adapter_version',NEW.adapter_version,'normalization_version',NEW.normalization_version)) THEN
