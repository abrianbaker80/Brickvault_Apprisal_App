+CREATE OR REPLACE FUNCTION product_refresh_close(p_id uuid) RETURNS text LANGUAGE plpgsql SECURITY DEFINER
+ SET search_path=pg_catalog,public AS $$
+DECLARE o public.product_refresh_operation; n timestamptz; outcome text;
+BEGIN
+ PERFORM 1 FROM public.provider_scope_state WHERE id=(SELECT scope_id FROM public.provider_budget_group WHERE id=p_id) FOR UPDATE;
+ SELECT * INTO o FROM public.product_refresh_operation WHERE id=p_id FOR UPDATE;
+ n=public.product_refresh_clock();
+ IF o.id IS NULL THEN RAISE EXCEPTION 'OPERATION_MISSING' USING ERRCODE='23514'; END IF;
+ IF o.state='CLOSED' THEN RETURN o.terminal_outcome; END IF;
+ IF EXISTS(SELECT 1 FROM public.provider_fetch_run a WHERE a.budget_group IN (o.identity_budget_group_id,o.price_budget_group_id)
+    AND a.outcome IN ('reserved','dispatched'))
+   OR EXISTS(SELECT 1 FROM public.provider_refresh_job WHERE budget_group=o.price_budget_group_id AND state IN ('running','queued','retry','deferred')) THEN
+  RAISE EXCEPTION 'OPERATION_HAS_PENDING_WORK' USING ERRCODE='23514'; END IF;
+ IF o.expires_at<=n THEN outcome='EXPIRED';
+ ELSIF o.resolved_mapping_id IS NULL AND EXISTS(SELECT 1 FROM public.provider_fetch_run a WHERE a.budget_group=o.identity_budget_group_id AND a.outcome='succeeded')
+   AND NOT EXISTS(SELECT 1 FROM public.provider_discovery_evidence e WHERE e.operation_id=p_id AND e.retained_until>n AND e.review_state<>'EXPIRED') THEN
+  outcome='EVIDENCE_EXPIRED';
+ ELSIF NOT EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=p_id AND (completed_at IS NULL OR completion_kind='FAILED')) THEN
+  outcome=CASE WHEN EXISTS(SELECT 1 FROM public.provider_fetch_run WHERE budget_group IN(o.identity_budget_group_id,o.price_budget_group_id))
+   THEN 'COMPLETE' ELSE 'ALREADY_CURRENT' END;
+ ELSE
+  IF EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=p_id AND completed_at IS NULL) THEN
+   PERFORM public.product_refresh_owned(p_id);
+  END IF;
+  outcome=CASE WHEN EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=p_id AND completed_at IS NOT NULL AND completion_kind<>'FAILED')
+   THEN 'PARTIAL' WHEN EXISTS(SELECT 1 FROM public.product_refresh_view WHERE operation_id=p_id AND failure_code IN ('run_budget_exhausted','group_budget_exhausted'))
+   THEN 'BUDGET_EXHAUSTED' ELSE 'BLOCKED' END;
+ END IF;
+ UPDATE public.provider_budget_group SET closed_at=n WHERE (id=p_id OR parent_id=p_id) AND closed_at IS NULL;
+ UPDATE public.product_refresh_operation SET state='CLOSED',terminal_outcome=outcome,closed_at=n,pause_reason=NULL,
+  execution_owner=NULL,execution_token=NULL,execution_lease_until=NULL WHERE id=p_id;
+ RETURN outcome;
+END $$;
