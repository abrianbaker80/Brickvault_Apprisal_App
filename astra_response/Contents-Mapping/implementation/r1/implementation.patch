index 0000000000000000000000000000000000000000..c063ae86384b0e3a48d049a8e2bbc394d436529f
--- /dev/null
+++ b/services/api/src/brickvault_api/component_mapping.py
@@ -0,0 +1,656 @@
+"""Selected identity discovery and per-candidate review over shared refresh operations."""
+
+import hashlib
+import hmac
+import time
+from collections.abc import Callable
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+from psycopg.types.json import Jsonb
+
+from .catalog.connection import CatalogConnection, read_transaction
+from .catalog.normalization import normalize_set_number
+from .catalog.query_types import CatalogError
+from .component_mapping_models import (
+    MappingChallenge,
+    MappingConfirmation,
+    MappingDecisionReceipt,
+    MappingPlan,
+    MappingRequest,
+    MappingRequestStatus,
+    MappingReview,
+    MappingSelection,
+    MappingStatus,
+    MappingTarget,
+)
+from .market.accounting import usage
+from .market.component_evidence import source_binding
+from .market.component_identity import (
+    IdentityBlocked,
+    source_blocker,
+    unique_element,
+)
+from .market.models import MarketError
+from .market.product_refresh import ProductRefreshError, product_errors
+from .market.product_refresh_models import ExecutionLease, canonical, digest
+from .providers.bricklink.requests import BrickLinkColor, ItemType, Operation, Request
+from .providers.bricklink.responses import CatalogEvidence, NativeElement, NativeItem
+from .refresh import RefreshService
+from .refresh_models import RefreshConfirmation
+
+
+def _date(value: datetime | str) -> datetime:
+    return datetime.fromisoformat(value) if isinstance(value, str) else value
+
+
+def _selector(node: dict[str, Any]) -> str:
+    sources = [
+        (f"element {s['element']}" if s.get("element") else f"SET {s['parent']}")
+        for s in node["seeds"]
+    ]
+    seeds = ", ".join(dict.fromkeys(sources))
+    if node["operation"] in ("element", "subsets"):
+        return seeds
+    name = "color" if node["operation"] == "color" else "item"
+    if node["rule"] == "UNIQUE_RESULTS_MUST_CONVERGE":
+        return f"Only if all results for {seeds} identify the same BrickLink {name}"
+    return f"Only the unique BrickLink {name} established by {seeds}"
+
+
+def _proof_facts(evidence: list[dict[str, Any]]) -> list[str]:
+    facts = []
+    for leg in evidence:
+        content = leg["content"]
+        if leg["operation"] == "element":
+            for row in content["elements"]:
+                facts.append(
+                    f"Element {row['element_id']} identifies PART {row['item_no']} "
+                    f"in BrickLink color {row['color_id']}."
+                )
+        elif leg["operation"] == "item":
+            facts.append(
+                f"BrickLink {content['item_type']} {content['item_no']}: {content['item_name']}"
+            )
+        elif leg["operation"] == "color":
+            details = ", ".join(v for v in (content["color_type"], content["color_code"]) if v)
+            facts.append(
+                f"BrickLink color {content['color_id']}: {content['color_name']}"
+                + (f" ({details})" if details else "")
+            )
+        elif leg["operation"] == "known_colors":
+            facts.append("BrickLink lists the exact candidate color for this PART variant.")
+        elif leg["operation"] == "subsets":
+            for row in content["figures"]:
+                facts.append(
+                    f"Sole regular whole figure {row['item_no']}, quantity {row['quantity']}, "
+                    f"extras {row['extra_quantity']}, no alternative or counterpart."
+                )
+    return list(dict.fromkeys(facts))
+
+
+def _target(target: dict[str, Any], candidate: dict[str, Any]) -> MappingTarget:
+    blocker = candidate.get("reason") or target.get("blocker")
+    evidence = candidate.get("evidence", [])
+    dates = [e["received_at"] for e in evidence if isinstance(e, dict) and e.get("received_at")]
+    source = (
+        f"Element {target['element_id']}"
+        if target.get("element_id")
+        else f"Parent SET {target['parent_item_no']}"
+        if target.get("parent_item_no")
+        else None
+    )
+    color = target.get("canonical_color")
+    if color is not None:
+        name = target.get("canonical_color_name")
+        color = f"{target['namespace']} color {color}" + (f" ({name})" if name else "")
+    return MappingTarget(
+        target_id=target["target_id"],
+        occurrences=[r["id"] for r in target["occurrences"]],
+        kind=target["item_type"],
+        identity=f"{target['namespace']} {target['identifier']}",
+        canonical_color=color,
+        state=candidate.get("state") or ("SOURCE_BLOCKED" if blocker else "DISCOVERY_READY"),
+        source=source,
+        blocker=blocker,
+        conflicting_mapping_ids=candidate.get("conflicting_mapping_ids", []),
+        item_no=candidate.get("item_no"),
+        provider_color=candidate.get("provider_color"),
+        facts=_proof_facts(evidence),
+        eligible_until=candidate.get("eligible_until"),
+        evidence_dates=dates,
+        mapping_id=candidate.get("mapping_id") if candidate else target.get("mapping_id"),
+    )
+
+
+def _request_progress(
+    c: CatalogConnection, op: dict[str, Any], candidates: list[MappingTarget], expired: bool
+) -> tuple[list[MappingRequestStatus], int]:
+    pending = {str(t.target_id) for t in candidates if t.state == "DISCOVERY_PENDING"}
+    rows = c.execute(
+        """SELECT r.node,a.outcome,a.retryable,a.reservations,a.dispatched,a.discovery_item_type,
+        a.discovery_item_no,a.discovery_color_id,e.received_at,
+        least(o.expires_at,e.retained_until,e.received_at+make_interval(secs=>
+          least(86400,p.retention_seconds,p.hard_display_seconds,current_p.retention_seconds,
+          current_p.hard_display_seconds))) AS deadline
+        FROM component_mapping_request r JOIN product_refresh_operation o ON o.id=r.operation_id
+        JOIN market_policy p ON p.id=o.market_policy_id
+        JOIN provider_budget_group g ON g.id=o.id JOIN provider_scope_state s ON s.id=g.scope_id
+        JOIN market_policy current_p ON current_p.id=s.policy_id
+        LEFT JOIN LATERAL (
+          SELECT f.*,count(*) OVER () AS reservations,count(started_at) OVER () AS dispatched
+          FROM provider_fetch_run f
+          WHERE f.logical_request_id=coalesce((r.node->>'owner_logical_id')::uuid,r.logical_id)
+          ORDER BY f.attempt_number DESC LIMIT 1
+        ) a ON true LEFT JOIN provider_discovery_evidence e ON e.attempt_id=a.id
+        WHERE r.operation_id=%s ORDER BY r.node_key""",
+        (op["id"],),
+    ).fetchall()
+    requests = []
+    dispatched = 0
+    for row in rows:
+        node, outcome = row["node"], row["outcome"]
+        owned = node["action"] == "FETCH"
+        if owned:
+            dispatched += row["dispatched"] or 0
+        eligible = row["received_at"] is not None and row["deadline"] > op["now"]
+        awaiting = bool(pending.intersection(node["targets"])) and not expired
+        if outcome == "succeeded":
+            state = "COMPLETE" if eligible else "EVIDENCE_EXPIRED"
+        elif outcome == "failed" and row["retryable"] and awaiting:
+            state = "RETRY_PENDING"
+        elif outcome:
+            state = outcome.upper()
+        elif node["action"] == "REUSE":
+            state = "EVIDENCE_EXPIRED"
+        else:
+            state = "PENDING" if awaiting else "SKIPPED"
+        selector = _selector(node)
+        if eligible and row["discovery_item_no"]:
+            selector = f"{row['discovery_item_type']} {row['discovery_item_no']}"
+        elif eligible and row["discovery_color_id"] is not None:
+            selector = f"BrickLink color {row['discovery_color_id']}"
+        requests.append(
+            MappingRequestStatus(
+                operation=node["operation"],
+                action=node["action"],
+                targets=node["targets"],
+                selector=selector,
+                state=state,
+                attempts=(row["reservations"] or 0) if owned else 0,
+                evidence_at=row["received_at"] if eligible else None,
+                eligible_until=row["deadline"] if eligible else None,
+            )
+        )
+    return requests, dispatched
+
+
+class ComponentMappingService(RefreshService):
+    operation_scope = "MAPPING"
+
+    def selected_plan(self, number: str, selection: MappingSelection) -> dict[str, Any]:
+        sid, snapshot = self.identity(number)
+        if self.account is None:
+            raise ProductRefreshError("PROVIDER_UNAVAILABLE")
+        with product_errors(), read_transaction(self.repository.database, repeatable=True) as c:
+            row = c.execute(
+                """SELECT component_mapping_plan(%s,%s,s.id,%s,%s) AS plan,
+                product_refresh_now() AS created_at FROM provider_scope_state s
+                WHERE provider='bricklink'""",
+                (sid, snapshot, self.account, Jsonb(selection.normalized())),
+            ).fetchone()
+            if row is None:
+                raise ProductRefreshError("PROVIDER_UNAVAILABLE")
+            return row
+
+    def _availability(self, plan: dict[str, Any]) -> str:
+        if plan["authorized_identity_initials"] > 6 or plan["maximum_attempts"] > 8:
+            return "IDENTITY_LIMIT"
+        if not plan["nodes"]:
+            return "EVIDENCE_UNRESOLVED"
+        maximum = plan["maximum_attempts"]
+        if maximum == 0:
+            return "READY"
+        state, _ = self.availability(UUID(plan["scope_id"]), maximum, maximum)
+        return state
+
+    def prepare_mapping(self, number: str, selection: MappingSelection) -> MappingPlan:
+        raw = self.selected_plan(number, selection)
+        plan = raw["plan"]
+        receipt = RefreshConfirmation(
+            key=uuid4(), digest=digest(plan), signature="0" * 64, created_at=raw["created_at"]
+        )
+        receipt = receipt.model_copy(
+            update={"signature": self.signature(receipt, UUID(plan["canonical_set_id"]))}
+        )
+        state = self._availability(plan)
+        return MappingPlan(
+            set_number=plan["normalized_set_number"],
+            selection=selection,
+            targets=[_target(t, {}) for t in plan["targets"]],
+            requests=[
+                MappingRequest(
+                    operation=n["operation"],
+                    selector=_selector(n),
+                    targets=n["targets"],
+                    action=n["action"],
+                    evidence_at=n.get("received_at"),
+                )
+                for n in plan["nodes"]
+            ],
+            identity_initials=plan["authorized_identity_initials"],
+            maximum_attempts=plan["maximum_attempts"],
+            retry_reserve=2 if plan["authorized_identity_initials"] else 0,
+            admissible=state == "READY",
+            state=state,
+            confirmation=receipt,
+            expires_at=receipt.created_at + timedelta(minutes=15),
+        )
+
+    def _existing(
+        self, c: CatalogConnection, number: str, body: MappingConfirmation
+    ) -> UUID | None:
+        receipt = body.confirmation
+        op = c.execute(
+            """SELECT id,scope,canonical_set_id,normalized_set_number,plan_digest,created_at,component_receipt_digest,plan_snapshot->'selection' AS selection
+            FROM product_refresh_operation WHERE idempotency_key=%s""",
+            (receipt.key,),
+        ).fetchone()
+        if op is None:
+            return None
+        sid = op["canonical_set_id"]
+        if normalize_set_number(number) != op["normalized_set_number"]:
+            # A currently supported alias can also identify this set. The canonical
+            # route on a retained receipt remains recoverable after catalog drift.
+            if self.identity(number)[0] != sid:
+                raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+        if op["component_receipt_digest"] != self._confirmation_digest(body):
+            raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+        if (
+            op["scope"],
+            op["plan_digest"],
+            op["created_at"],
+            op["selection"],
+        ) != (
+            self.operation_scope,
+            receipt.digest,
+            receipt.created_at,
+            body.selection.normalized(),
+        ):
+            raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+        return UUID(str(op["id"]))
+
+    @staticmethod
+    def _confirmation_digest(body: MappingConfirmation) -> str:
+        return digest(
+            {
+                "selection": body.selection.normalized(),
+                "confirmation": body.confirmation.model_dump(mode="json"),
+            }
+        )
+
+    def confirm_mapping(self, number: str, body: MappingConfirmation) -> tuple[UUID, bool]:
+        receipt = body.confirmation
+        with read_transaction(self.repository.database) as c:
+            existing = self._existing(c, number, body)
+        if existing:
+            return existing, False
+        try:
+            plan = self.selected_plan(number, body.selection)["plan"]
+            if (
+                not hmac.compare_digest(
+                    receipt.signature, self.signature(receipt, UUID(plan["canonical_set_id"]))
+                )
+                or digest(plan) != receipt.digest
+            ):
+                raise ProductRefreshError("REPLAN_REQUIRED")
+            state = self._availability(plan)
+            if state != "READY":
+                raise ProductRefreshError(state)
+            with product_errors(), self.repository.database.connect() as c, c.transaction():
+                # The SQL capability uses this same key lock. Distinguish a newly admitted
+                # operation from a concurrent replay before scheduling any executor.
+                c.execute(
+                    "SELECT pg_advisory_xact_lock(hashtextextended(%s,630008))", (str(receipt.key),)
+                )
+                existing = self._existing(c, number, body)
+                if existing:
+                    return existing, False
+                row = c.execute(
+                    "SELECT component_mapping_confirm(%s,%s,%s,%s,%s) AS id",
+                    (
+                        Jsonb(plan),
+                        receipt.key,
+                        receipt.created_at,
+                        receipt.digest,
+                        self._confirmation_digest(body),
+                    ),
+                ).fetchone()
+                assert row
+                return UUID(str(row["id"])), True
+        except (ProductRefreshError, CatalogError):
+            with read_transaction(self.repository.database) as c:
+                existing = self._existing(c, number, body)
+            if existing:
+                return existing, False
+            raise
+
+    def _review_signature(self, op: UUID, target: UUID, challenge: MappingChallenge) -> str:
+        value = [
+            "component-review-v1",
+            str(op),
+            str(target),
+            str(challenge.key),
+            challenge.digest,
+            challenge.created_at.astimezone(UTC).isoformat(),
+            challenge.expires_at.astimezone(UTC).isoformat(),
+        ]
+        return hmac.new(self.signing_key, canonical(value).encode(), hashlib.sha256).hexdigest()
+
+    def mapping_status(self, operation_id: UUID) -> MappingStatus:
+        with product_errors(), read_transaction(self.repository.database, repeatable=True) as c:
+            op = c.execute(
+                """SELECT *,product_refresh_clock() AS now FROM product_refresh_operation
+                WHERE id=%s AND scope='MAPPING'""",
+                (operation_id,),
+            ).fetchone()
+            if op is None:
+                raise ProductRefreshError("OPERATION_MISSING")
+            now, plan = op["now"], op["plan_snapshot"]
+            candidates = []
+            for target in plan["targets"]:
+                tid = UUID(target["target_id"])
+                row = c.execute(
+                    "SELECT component_mapping_candidate(%s,%s) AS candidate", (operation_id, tid)
+                ).fetchone()
+                assert row
+                candidate = row["candidate"]
+                if candidate["state"] == "REVIEW_READY" and op["account_scope"] != self.account:
+                    candidate = {
+                        **candidate,
+                        "state": "REVIEW_CONFLICT",
+                        "reason": "ACCOUNT_SCOPE_CHANGED",
+                    }
+                projection = _target(target, candidate)
+                if candidate["state"] == "REVIEW_READY" and op["state"] != "CLOSED":
+                    # SQL repeats the proof under publication locks. Issue a challenge only
+                    # for the same pinned source and unique element association in our
+                    # independent Phase 3B-derived validator.
+                    source = source_binding(plan, target)
+                    blocker = source_blocker(source)
+                    if not blocker and source.kind == ItemType.PART:
+                        assert source.element_id is not None
+                        leg = next(e for e in candidate["evidence"] if e["operation"] == "element")
+                        elements = tuple(
+                            NativeElement(
+                                item=NativeItem(no=row["item_no"], type=row["item_type"]),
+                                element_id=row["element_id"],
+                                color_id=row["color_id"],
+                            )
+                            for row in leg["content"]["elements"]
+                        )
+                        try:
+                            binding = unique_element(
+                                CatalogEvidence(
+                                    Request(
+                                        Operation.ELEMENT,
+                                        op["account_scope"],
+                                        element_id=leg["selector"]["element_id"],
+                                    ),
+                                    elements,
+                                    _date(leg["received_at"]),
+                                ),
+                                source.element_id,
+                            )
+                            if binding != (candidate["item_no"], candidate["provider_color"]):
+                                blocker = "ELEMENT_ASSOCIATION_MISMATCH"
+                        except IdentityBlocked as error:
+                            blocker = str(error)
+                    if blocker:
+                        candidates.append(
+                            _target(target, {"state": "EVIDENCE_AMBIGUOUS", "reason": blocker})
+                        )
+                        continue
+                    until = min(
+                        now + timedelta(minutes=15),
+                        op["expires_at"],
+                        _date(candidate["eligible_until"]),
+                    )
+                    if now < until:
+                        challenge = MappingChallenge(
+                            key=uuid4(),
+                            digest=candidate["proof_digest"],
+                            created_at=now,
+                            expires_at=until,
+                            signature="0" * 64,
+                        )
+                        projection = projection.model_copy(
+                            update={
+                                "challenge": challenge.model_copy(
+                                    update={
+                                        "signature": self._review_signature(
+                                            operation_id, tid, challenge
+                                        )
+                                    }
+                                )
+                            }
+                        )
+                candidates.append(projection)
+            used = usage(c, operation_id)
+            terminal = op["state"] == "CLOSED"
+            running = bool(
+                not terminal and op["execution_lease_until"] and op["execution_lease_until"] > now
+            )
+            expired = op["expires_at"] <= now
+            requests, dispatched = _request_progress(c, op, candidates, expired or terminal)
+            state = (
+                op["terminal_outcome"]
+                or ("EXPIRED" if expired else op["pause_reason"])
+                or ("DISCOVERING" if running else "WORK_PENDING")
+            )
+            if state == "MAPPING_REVIEW" and not any(t.challenge for t in candidates):
+                state = "WORK_PENDING"
+            return MappingStatus(
+                operation_id=operation_id,
+                set_number=op["normalized_set_number"],
+                selection=MappingSelection.model_validate(plan["selection"]),
+                state=state,
+                terminal=terminal,
+                running=running,
+                resumable=not terminal
+                and not expired
+                and not running
+                and op["account_scope"] == self.account
+                and state != "MAPPING_REVIEW",
+                attempts_consumed=used["total"],
+                dispatched=dispatched,
+                remaining=sum(r.state == "PENDING" and r.action == "FETCH" for r in requests),
+                skipped=sum(r.state == "SKIPPED" and r.action == "FETCH" for r in requests),
+                requests=requests,
+                maximum_attempts=plan["maximum_attempts"],
+                targets=candidates,
+            )
+
+    def active_mapping(self, number: str) -> MappingStatus | None:
+        sid, _ = self.identity(number)
+        with read_transaction(self.repository.database) as c:
+            op = c.execute(
+                """SELECT id FROM product_refresh_operation WHERE canonical_set_id=%s
+                AND scope='MAPPING' AND account_scope=%s ORDER BY confirmed_at DESC,id DESC LIMIT 1""",
+                (sid, self.account),
+            ).fetchone()
+        return self.mapping_status(op["id"]) if op else None
+
+    def review_target(
+        self, operation_id: UUID, target_id: UUID, body: MappingReview
+    ) -> MappingStatus | MappingDecisionReceipt:
+        challenge = body.challenge
+        if body.key != challenge.key:
+            raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+        request_digest = digest(body.model_dump(mode="json"))
+        with product_errors(), self.repository.database.connect() as c, c.transaction():
+            # Serialize with the SQL capability. A retained decision is recoverable
+            # even after an account or signing-key change. New authority must match both.
+            c.execute("SELECT pg_advisory_xact_lock(hashtextextended(%s,630021))", (str(body.key),))
+            previous = c.execute(
+                """SELECT operation_id,target_id,lineage->>'request_digest' AS digest
+                FROM component_mapping_review WHERE receipt_key=%s""",
+                (body.key,),
+            ).fetchone()
+            if previous:
+                if (previous["operation_id"], previous["target_id"], previous["digest"]) != (
+                    operation_id,
+                    target_id,
+                    request_digest,
+                ):
+                    raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+            else:
+                if not hmac.compare_digest(
+                    challenge.signature, self._review_signature(operation_id, target_id, challenge)
+                ):
+                    raise ProductRefreshError("IDEMPOTENCY_CONFLICT")
+                owner = c.execute(
+                    "SELECT account_scope FROM product_refresh_operation WHERE id=%s AND scope='MAPPING'",
+                    (operation_id,),
+                ).fetchone()
+                if not owner:
+                    raise ProductRefreshError("OPERATION_MISSING")
+                if self.account != owner["account_scope"]:
+                    raise ProductRefreshError("PROVIDER_UNAVAILABLE")
+            row = c.execute(
+                "SELECT component_mapping_review_target(%s,%s,%s,%s,%s,%s,%s) AS result",
+                (
+                    operation_id,
+                    target_id,
+                    body.key,
+                    body.decision.upper(),
+                    challenge.digest,
+                    challenge.expires_at,
+                    request_digest,
+                ),
+            ).fetchone()
+            assert row
+            result = row["result"]
+        receipt = MappingDecisionReceipt(
+            key=body.key,
+            target_id=target_id,
+            decision=body.decision,
+            mapping_id=result.get("mapping_id"),
+            state=result["state"],
+        )
+        try:
+            status = self.mapping_status(operation_id)
+        except ProductRefreshError as error:
+            if str(error) != "OPERATION_MISSING":
+                raise
+            # Operation content and graph may be purged before review lineage.
+            return receipt
+        return status.model_copy(update={"review_receipt": receipt})
+
+    def run(self, lease: ExecutionLease, *, wait: Callable[[float], None] = time.sleep) -> None:
+        deadline = time.monotonic() + 90
+        reason = "WORK_PENDING"
+        try:
+            while time.monotonic() < deadline:
+                lease = self.repository.renew_execution(lease)
+                with product_errors(), self.repository.database.connect() as c, c.transaction():
+                    op = self.repository._owned(c, lease)
+                    if op["scope"] != "MAPPING":
+                        raise ProductRefreshError("OPERATION_MISSING")
+                    row = c.execute(
+                        "SELECT component_mapping_next(%s) AS node", (lease.operation_id,)
+                    ).fetchone()
+                    assert row
+                    node = row["node"]
+                if "selector" not in node or node["selector"] is None:
+                    with product_errors(), self.repository.database.connect() as c, c.transaction():
+                        self.repository._owned(c, lease)
+                        settled = c.execute(
+                            "SELECT component_mapping_settle(%s) AS state", (lease.operation_id,)
+                        ).fetchone()
+                        assert settled
+                        reason = (
+                            "MAPPING_REVIEW"
+                            if settled["state"] == "MAPPING_REVIEW"
+                            else "WORK_PENDING"
+                        )
+                    break
+                selector = node["selector"]
+                request = Request(
+                    Operation(selector["operation"]),
+                    op["account_scope"],
+                    ItemType(selector["item_type"]) if selector.get("item_type") else None,
+                    selector.get("item_no"),
+                    BrickLinkColor(selector["color_id"])
+                    if selector.get("color_id") is not None
+                    else None,
+                    element_id=selector.get("element_id"),
+                )
+                root_scope = UUID(op["plan_snapshot"]["scope_id"])
+                retry = node.get("retry_of")
+                with product_errors():
+                    attempt = self.repository.reserve_identity_attempt(
+                        root_scope,
+                        op["identity_budget_group_id"],
+                        UUID(node["target_id"]),
+                        request,
+                        attempt_id=uuid4() if retry else UUID(node["logical_id"]),
+                        owner=lease.owner,
+                        retry_of=UUID(retry) if retry else None,
+                        operation_token=lease.token,
+                    )
+                if attempt is None:
+                    state, cooldown = self.availability(root_scope)
+                    if cooldown is not None and state == "RATE_LIMITED":
+                        delay = (cooldown - self.repository.clock()).total_seconds()
+                        if 0 < delay <= 15:
+                            wait(min(delay, 1))
+                            continue
+                    reason = (
+                        "SUSPENDED"
+                        if state == "SUSPENDED"
+                        else "RATE_LIMITED"
+                        if cooldown
+                        else "WORK_PENDING"
+                    )
+                    break
+                with product_errors():
+                    dispatched = self.repository.mark_identity_dispatched(attempt)
+                try:
+                    result = self.provider.fetch(dispatched)
+                except Exception:
+                    self.repository.fail_identity_attempt(attempt)
+                    continue
+                if result.attempts != 1:
+                    self.repository.fail_identity_attempt(attempt)
+                else:
+                    with product_errors():
+                        self.repository.complete_identity_attempt(attempt, result)
+        except MarketError as error:
+            code = str(error)
+            if code == "REPLAN_REQUIRED":
+                with product_errors(), self.repository.database.connect() as c, c.transaction():
+                    self.repository._owned(c, lease)
+                    c.execute("SELECT component_mapping_settle(%s)", (lease.operation_id,))
+            elif code == "daily_budget_exhausted":
+                reason = "DAILY_BUDGET_EXHAUSTED"
+            elif code == "provider_cooldown":
+                reason = "RATE_LIMITED"
+            elif code not in (
+                "discovery_dispatch_not_admitted",
+                "discovery_retry_not_admitted",
+                "group_budget_exhausted",
+                "run_budget_exhausted",
+                "OPERATION_CLOSED",
+                "STALE_EXECUTION_LEASE",
+                "EXPIRED",
+            ):
+                raise
+        finally:
+            try:
+                self.repository.pause(lease, reason)
+            except MarketError as error:
+                # Settling the last target closes the operation and releases its lease.
+                if str(error) not in ("OPERATION_CLOSED", "STALE_EXECUTION_LEASE", "EXPIRED"):
+                    raise
