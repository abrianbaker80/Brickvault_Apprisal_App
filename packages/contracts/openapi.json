{
  "components": {
    "schemas": {
      "DatabaseUnavailable": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "const": "unavailable",
            "default": "unavailable",
            "title": "Database",
            "type": "string"
          },
          "migrations": {
            "const": "not_checked",
            "default": "not_checked",
            "title": "Migrations",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "default": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "DatabaseUnavailable",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "brickvault-api",
            "default": "brickvault-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "MigrationUnavailable": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "const": "ok",
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "migrations": {
            "enum": [
              "missing",
              "mismatch"
            ],
            "title": "Migrations",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "default": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "migrations"
        ],
        "title": "MigrationUnavailable",
        "type": "object"
      },
      "Ready": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "const": "ok",
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "migrations": {
            "const": "current",
            "default": "current",
            "title": "Migrations",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Ready",
        "type": "object"
      }
    }
  },
